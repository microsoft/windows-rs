#[win32]
mod Windows {
    mod Win32 {
        type NODE_REQUIREMENT = ULONG;
        type PBUS_HANDLER = *mut _BUS_HANDLER;
        type PCALLBACK_OBJECT = *mut _CALLBACK_OBJECT;
        #[arch(Arm64)]
        type PCMC_EXCEPTION = PVOID;
        #[arch(X86 | X64)]
        type PCMC_EXCEPTION = *mut MCA_EXCEPTION;
        #[arch(Arm64)]
        type PCPE_EXCEPTION = PVOID;
        #[arch(X86 | X64)]
        type PCPE_EXCEPTION = *mut MCA_EXCEPTION;
        type PDEVICE_HANDLER_OBJECT = *mut _DEVICE_HANDLER_OBJECT;
        type PEPROCESS = *mut _KPROCESS;
        type PETHREAD = *mut _KTHREAD;
        type PIO_TIMER = *mut _IO_TIMER;
        type PKAFFINITY_EX = *mut _KAFFINITY_EX;
        type PKINTERRUPT = *mut _KINTERRUPT;
        type PKPROCESS = *mut _KPROCESS;
        type PKTHREAD = *mut _KTHREAD;
        type POBJECT_TYPE = *mut _OBJECT_TYPE;
        extern fn POWER_SETTING_CALLBACK(#[in] SettingGuid: LPCGUID, #[buffer(bytes(ValueLength))] #[in] Value: PVOID, #[in] ValueLength: ULONG, #[in] #[opt] #[out] Context: PVOID) -> NTSTATUS;
        extern fn PPOWER_SETTING_CALLBACK(#[in] SettingGuid: LPCGUID, #[buffer(bytes(ValueLength))] #[in] Value: PVOID, #[in] ValueLength: ULONG, #[in] #[opt] #[out] Context: PVOID) -> NTSTATUS;
        type PRKPROCESS = *mut _KPROCESS;
        type PRKTHREAD = *mut _KTHREAD;
        extern fn PS_AVAILABLE_CPUS_CHANGE_CALLBACK(#[in] Parameter: PVOID);
        type PS_AVAILABLE_CPUS_CHANGE_REGISTRATION = PVOID;
        #[arch(X64 | Arm64)]
        const RESULT_NEGATIVE: i32 = 1;
        #[arch(X86)]
        const RESULT_NEGATIVE: i32 = 32768;
        #[arch(X64 | Arm64)]
        const RESULT_POSITIVE: i32 = 2;
        #[arch(X86)]
        const RESULT_POSITIVE: i32 = 0;
        #[arch(X64 | Arm64)]
        const RESULT_ZERO: i32 = 0;
        #[arch(X86)]
        const RESULT_ZERO: i32 = 16384;
        #[library("ntdll.dll")]
        extern fn RtlInitUTF8StringEx(#[out] DestinationString: PUTF8_STRING, #[in] #[incomplete] #[null_terminated(entry)] #[opt] SourceString: PCSZ) -> NTSTATUS;
        #[library("ntdll.dll")]
        extern fn RtlIsUntrustedObject(#[in] #[opt] Handle: HANDLE, #[in] #[opt] Object: PVOID, #[out] UntrustedObject: PBOOLEAN) -> NTSTATUS;
        #[library("ntdll.dll")]
        #[must_use]
        extern fn RtlUTF8StringToUnicodeString(#[incomplete] DestinationString: PUNICODE_STRING, #[in] SourceString: PUTF8_STRING, #[in] AllocateDestinationString: BOOLEAN) -> NTSTATUS;
        #[library("ntdll.dll")]
        #[must_use]
        extern fn RtlUTF8ToUnicodeN(#[buffer(bytes(UnicodeStringMaxByteCount))] #[out] UnicodeStringDestination: PWSTR, #[in] UnicodeStringMaxByteCount: ULONG, #[out] UnicodeStringActualByteCount: PULONG, #[buffer(bytes(UTF8StringByteCount))] #[in] UTF8StringSource: PCCH, #[in] UTF8StringByteCount: ULONG) -> NTSTATUS;
        #[library("ntdll.dll")]
        extern fn RtlUnicodeStringToUTF8String(#[incomplete] DestinationString: PUTF8_STRING, #[in] SourceString: PCUNICODE_STRING, #[in] AllocateDestinationString: BOOLEAN) -> NTSTATUS;
        #[library("ntdll.dll")]
        #[must_use]
        extern fn RtlUnicodeToUTF8N(#[buffer(bytes(UTF8StringMaxByteCount))] #[out] UTF8StringDestination: PCHAR, #[in] UTF8StringMaxByteCount: ULONG, #[out] UTF8StringActualByteCount: PULONG, #[buffer(bytes(UnicodeStringByteCount))] #[in] UnicodeStringSource: PCWCH, #[in] UnicodeStringByteCount: ULONG) -> NTSTATUS;
        #[library("ntdll.dll")]
        extern fn ZwDeviceIoControlFile(#[in] FileHandle: HANDLE, #[in] #[opt] Event: HANDLE, #[in] #[opt] ApcRoutine: PIO_APC_ROUTINE, #[in] #[opt] ApcContext: PVOID, #[out] IoStatusBlock: PIO_STATUS_BLOCK, #[in] IoControlCode: ULONG, #[buffer(bytes(InputBufferLength))] #[in] #[opt] InputBuffer: PVOID, #[in] InputBufferLength: ULONG, #[buffer(bytes(OutputBufferLength))] #[opt] #[out] OutputBuffer: PVOID, #[in] OutputBufferLength: ULONG) -> NTSTATUS;
        #[library("ntdll.dll")]
        extern fn ZwQueryVolumeInformationFile(#[in] FileHandle: HANDLE, #[out] IoStatusBlock: PIO_STATUS_BLOCK, #[buffer(bytes(Length))] #[out] FsInformation: PVOID, #[in] Length: ULONG, #[in] FsInformationClass: FS_INFORMATION_CLASS) -> NTSTATUS;
    }
}
