#[win32]
mod Windows {
    mod Win32 {
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORCloseHive(#[in] Handle: ORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORCloseKey(#[in] KeyHandle: ORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORCreateHive(#[out] HORKey: PORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORCreateKey(#[in] KeyHandle: ORHKEY, #[in] lpSubKey: PCWSTR, #[in] #[opt] lpClass: PWSTR, #[in] #[opt] dwOptions: DWORD, #[in] #[opt] pSecurityDescriptor: PSECURITY_DESCRIPTOR, #[out] phkResult: PORHKEY, #[opt] #[out] pdwDisposition: PDWORD) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORDeleteKey(#[in] Handle: ORHKEY, #[in] #[opt] lpSubKey: PCWSTR) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORDeleteValue(#[in] Handle: ORHKEY, #[in] #[opt] lpValueName: PCWSTR) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn OREnumKey(#[in] Handle: ORHKEY, #[in] dwIndex: DWORD, #[out] #[writable(entry, *lpcName)] lpName: PWSTR, #[in] #[out] lpcName: PDWORD, #[opt] #[out] #[writable(entry, if_present(*lpcClass))] lpClass: PWSTR, #[in] #[opt] #[out] lpcClass: PDWORD, #[opt] #[out] lpftLastWriteTime: PFILETIME) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn OREnumValue(#[in] Handle: ORHKEY, #[in] dwIndex: DWORD, #[out] #[writable(entry, *lpcValueName)] lpValueName: PWSTR, #[in] #[out] lpcValueName: PDWORD, #[opt] #[out] lpType: PDWORD, #[opt] #[out] #[writable(entry, bytes(if_present(*lpcbData)))] lpData: PBYTE, #[in] #[opt] #[out] lpcbData: PDWORD) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORGetKeySecurity(#[in] Handle: ORHKEY, #[in] SecurityInformation: SECURITY_INFORMATION, #[opt] #[out] pSecurityDescriptor: PSECURITY_DESCRIPTOR, #[in] #[out] lpcbSecurityDescriptor: PDWORD) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORGetValue(#[in] Handle: ORHKEY, #[in] #[opt] lpSubKey: PCWSTR, #[in] #[opt] lpValue: PCWSTR, #[opt] #[out] pdwType: PDWORD, #[opt] #[out] #[writable(entry, bytes(if_present(*pcbData)))] pvData: PVOID, #[in] #[opt] #[out] pcbData: PDWORD) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORGetVersion(#[out] pdwMajorVersion: PDWORD, #[out] pdwMinorVersion: PDWORD);
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORGetVirtualFlags(#[in] Handle: ORHKEY, #[out] pdwFlags: PDWORD) -> DWORD;
        type ORHKEY = PVOID;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORMergeHives(#[in] #[readable(entry, HiveCount)] HiveHandles: *mut ORHKEY, #[in] HiveCount: ULONG, #[out] phkResult: PORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn OROpenHive(#[in] FilePath: PCWSTR, #[out] HORKey: PORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn OROpenHiveByHandle(#[in] FileHandle: HANDLE, #[out] HORKey: PORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn OROpenKey(#[in] Handle: ORHKEY, #[in] #[opt] lpSubKey: PCWSTR, #[out] phkResult: PORHKEY) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORQueryInfoKey(#[in] Handle: ORHKEY, #[opt] #[out] #[writable(entry, if_present(*lpcClass))] lpClass: PWSTR, #[in] #[opt] #[out] lpcClass: PDWORD, #[opt] #[out] lpcSubKeys: PDWORD, #[opt] #[out] lpcMaxSubKeyLen: PDWORD, #[opt] #[out] lpcMaxClassLen: PDWORD, #[opt] #[out] lpcValues: PDWORD, #[opt] #[out] lpcMaxValueNameLen: PDWORD, #[opt] #[out] lpcMaxValueLen: PDWORD, #[opt] #[out] lpcbSecurityDescriptor: PDWORD, #[opt] #[out] lpftLastWriteTime: PFILETIME) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORRenameKey(#[in] Handle: ORHKEY, #[in] lpNewName: PCWSTR) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORSaveHive(#[in] HORKey: ORHKEY, #[in] HivePath: PCWSTR, #[in] OsMajorVersion: DWORD, #[in] OsMinorVersion: DWORD) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORSetKeySecurity(#[in] Handle: ORHKEY, #[in] SecurityInformation: SECURITY_INFORMATION, #[in] pSecurityDescriptor: PSECURITY_DESCRIPTOR) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORSetValue(#[in] Handle: ORHKEY, #[in] #[opt] lpValueName: PCWSTR, #[in] dwType: DWORD, #[in] #[opt] #[readable(entry, bytes(cbData))] lpData: *const BYTE, #[in] cbData: DWORD) -> DWORD;
        #[arch(X64 | Arm64)]
        #[library("OFFREG.dll")]
        extern fn ORSetVirtualFlags(#[in] Handle: ORHKEY, #[in] dwFlags: DWORD) -> DWORD;
        type PORHKEY = *mut ORHKEY;
    }
}
