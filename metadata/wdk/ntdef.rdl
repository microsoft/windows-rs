#[win32]
mod Windows {
    mod Win32 {
        type CLONG = ULONG;
        type CSHORT = i16;
        type KIRQL = UCHAR;
        type LOGICAL = ULONG;
        type PNT_PRODUCT_TYPE = *mut _NT_PRODUCT_TYPE;
        type PPHYSICAL_ADDRESS = *mut LARGE_INTEGER;
        type PUTF8_STRING = PSTRING;
        #[repr(i32)]
        enum _NT_PRODUCT_TYPE {
            NtProductWinNt = 1,
            NtProductLanManNt = 2,
            NtProductServer = 3,
        }
    }
}
