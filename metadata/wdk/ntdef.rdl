#[win32]
mod Windows {
    mod Win32 {
        type CLONG = ULONG;
        type CSHORT = i16;
        #[repr(i32)]
        enum EVENT_TYPE {
            NotificationEvent = 0,
            SynchronizationEvent = 1,
        }
        type KIRQL = UCHAR;
        type LOGICAL = ULONG;
        type PNT_PRODUCT_TYPE = *mut _NT_PRODUCT_TYPE;
        type PPHYSICAL_ADDRESS = *mut LARGE_INTEGER;
        type PUTF8_STRING = PSTRING;
        #[arch(X64 | Arm64)]
        #[repr(i32)]
        enum TIMER_TYPE {
            NotificationTimer = 0,
            SynchronizationTimer = 1,
        }
        #[repr(i32)]
        enum _NT_PRODUCT_TYPE {
            NtProductWinNt = 1,
            NtProductLanManNt = 2,
            NtProductServer = 3,
        }
    }
}
