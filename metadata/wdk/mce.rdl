#[win32]
mod Windows {
    mod Win32 {
        #[arch(X86 | X64)]
        type CMC_EXCEPTION = MCA_EXCEPTION;
        #[arch(X86 | X64)]
        type CPE_EXCEPTION = MCA_EXCEPTION;
        #[arch(X64)]
        type ERROR_SEVERITY = UCHAR;
        #[arch(X64)]
        #[repr(i32)]
        enum ERROR_SEVERITY_VALUE {
            ErrorRecoverable = 0,
            ErrorFatal = 1,
            ErrorCorrected = 2,
            ErrorOthers = 3,
        }
        #[arch(Arm64)]
        struct MCA_EXCEPTION {
            Dummy: ULONG,
        }
        #[arch(X86 | X64)]
        struct MCA_EXCEPTION {
            VersionNumber: ULONG,
            ExceptionType: MCA_EXCEPTION_TYPE,
            TimeStamp: LARGE_INTEGER,
            ProcessorNumber: ULONG,
            Reserved1: ULONG,
            u: union {
                Mca: struct {
                    BankNumber: UCHAR,
                    Reserved2: [UCHAR; 7],
                    Status: MCI_STATS,
                    Address: MCI_ADDR,
                    Misc: ULONGLONG,
                },
                Mce: struct {
                    Address: ULONGLONG,
                    Type: ULONGLONG,
                },
            },
            ExtCnt: ULONG,
            Reserved3: ULONG,
            ExtReg: [ULONGLONG; 24],
        }
        #[repr(i32)]
        enum MCA_EXCEPTION_TYPE {
            HAL_MCE_RECORD = 0,
            HAL_MCA_RECORD = 1,
        }
        #[arch(X86 | X64)]
        const MCA_EXCEPTION_V1_SIZE: LONG = 56;
        #[arch(X64)]
        const MCA_EXCEPTION_V2_SIZE: u64 = 256;
        #[arch(X86)]
        const MCA_EXCEPTION_V2_SIZE: u32 = 256;
        #[arch(X86 | X64)]
        const MCA_EXTREG_V2MAX: i32 = 24;
        #[arch(X86 | X64)]
        union MCI_ADDR {
            Anonymous: struct {
                Address: ULONG,
                Reserved: ULONG,
            },
            QuadPart: ULONGLONG,
        }
        #[arch(X64)]
        union MCI_STATS {
            MciStatus: struct {
                McaErrorCode: USHORT,
                ModelErrorCode: USHORT,
                _bitfield: u32 {
                    OtherInformation: ULONG: 25,
                    ContextCorrupt: ULONG: 1,
                    AddressValid: ULONG: 1,
                    MiscValid: ULONG: 1,
                    ErrorEnabled: ULONG: 1,
                    UncorrectedError: ULONG: 1,
                    StatusOverFlow: ULONG: 1,
                    Valid: ULONG: 1,
                },
            },
            QuadPart: ULONG64,
        }
        #[arch(X86)]
        union MCI_STATS {
            MciStats: struct {
                McaCod: USHORT,
                MsCod: USHORT,
                _bitfield: u32 {
                    OtherInfo: ULONG: 25,
                    Damage: ULONG: 1,
                    AddressValid: ULONG: 1,
                    MiscValid: ULONG: 1,
                    Enabled: ULONG: 1,
                    UnCorrected: ULONG: 1,
                    OverFlow: ULONG: 1,
                    Valid: ULONG: 1,
                },
            },
            QuadPart: ULONGLONG,
        }
        #[arch(X64)]
        type PERROR_SEVERITY = *mut UCHAR;
        type PMCA_EXCEPTION = *mut MCA_EXCEPTION;
        #[arch(X86 | X64)]
        type PMCI_ADDR = *mut MCI_ADDR;
        #[arch(X86 | X64)]
        type PMCI_STATS = *mut MCI_STATS;
    }
}
