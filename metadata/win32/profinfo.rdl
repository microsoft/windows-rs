#[win32]
mod Windows {
    mod Win32 {
        type LPPROFILEINFO = *mut PROFILEINFOA;
        type LPPROFILEINFOA = *mut PROFILEINFOA;
        type LPPROFILEINFOW = *mut PROFILEINFOW;
        type PROFILEINFO = PROFILEINFOA;
        struct PROFILEINFOA {
            dwSize: DWORD,
            dwFlags: DWORD,
            lpUserName: LPSTR,
            lpProfilePath: LPSTR,
            lpDefaultPath: LPSTR,
            lpServerName: LPSTR,
            lpPolicyPath: LPSTR,
            hProfile: HANDLE,
        }
        struct PROFILEINFOW {
            dwSize: DWORD,
            dwFlags: DWORD,
            lpUserName: LPWSTR,
            lpProfilePath: LPWSTR,
            lpDefaultPath: LPWSTR,
            lpServerName: LPWSTR,
            lpPolicyPath: LPWSTR,
            hProfile: HANDLE,
        }
    }
}
