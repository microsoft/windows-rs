#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum AudioSessionDisconnectReason {
            DisconnectReasonDeviceRemoval = 0,
            DisconnectReasonServerShutdown = 1,
            DisconnectReasonFormatChanged = 2,
            DisconnectReasonSessionLogoff = 3,
            DisconnectReasonSessionDisconnected = 4,
            DisconnectReasonExclusiveModeOverride = 5,
        }
        #[guid(0xf4b1a599_7266_4319_a8ca_e70acb11e8cd)]
        interface IAudioSessionControl: IUnknown {
            fn GetState(&self, #[out] pRetVal: *mut AudioSessionState) -> HRESULT;
            fn GetDisplayName(&self, #[out] pRetVal: *mut LPWSTR) -> HRESULT;
            fn SetDisplayName(&self, #[in] Value: LPCWSTR, #[in] EventContext: LPCGUID) -> HRESULT;
            fn GetIconPath(&self, #[out] pRetVal: *mut LPWSTR) -> HRESULT;
            fn SetIconPath(&self, #[in] Value: LPCWSTR, #[in] EventContext: LPCGUID) -> HRESULT;
            fn GetGroupingParam(&self, #[out] pRetVal: *mut GUID) -> HRESULT;
            fn SetGroupingParam(&self, #[in] Override: LPCGUID, #[in] EventContext: LPCGUID) -> HRESULT;
            fn RegisterAudioSessionNotification(&self, #[in] NewNotifications: IAudioSessionEvents) -> HRESULT;
            fn UnregisterAudioSessionNotification(&self, #[in] NewNotifications: IAudioSessionEvents) -> HRESULT;
        }
        #[guid(0xbfb7ff88_7239_4fc9_8fa2_07c950be9c6d)]
        interface IAudioSessionControl2: IAudioSessionControl {
            fn GetSessionIdentifier(&self, #[out] pRetVal: *mut LPWSTR) -> HRESULT;
            fn GetSessionInstanceIdentifier(&self, #[out] pRetVal: *mut LPWSTR) -> HRESULT;
            fn GetProcessId(&self, #[out] pRetVal: *mut DWORD) -> HRESULT;
            fn IsSystemSoundsSession(&self) -> HRESULT;
            fn SetDuckingPreference(&self, #[in] optOut: BOOL) -> HRESULT;
        }
        #[guid(0xe2f5bb11_0570_40ca_acdd_3aa01277dee8)]
        interface IAudioSessionEnumerator: IUnknown {
            fn GetCount(&self, #[out] SessionCount: *mut i32) -> HRESULT;
            fn GetSession(&self, #[in] SessionCount: i32, #[out] Session: *mut IAudioSessionControl) -> HRESULT;
        }
        #[guid(0x24918acc_64b3_37c1_8ca9_74a66e9957a8)]
        interface IAudioSessionEvents: IUnknown {
            fn OnDisplayNameChanged(&self, #[in] NewDisplayName: LPCWSTR, #[in] EventContext: LPCGUID) -> HRESULT;
            fn OnIconPathChanged(&self, #[in] NewIconPath: LPCWSTR, #[in] EventContext: LPCGUID) -> HRESULT;
            fn OnSimpleVolumeChanged(&self, #[in] NewVolume: f32, #[in] NewMute: BOOL, #[in] EventContext: LPCGUID) -> HRESULT;
            fn OnChannelVolumeChanged(&self, #[in] ChannelCount: DWORD, #[in] #[readable(entry, ChannelCount)] NewChannelVolumeArray: *mut f32, #[in] ChangedChannel: DWORD, #[in] EventContext: LPCGUID) -> HRESULT;
            fn OnGroupingParamChanged(&self, #[in] NewGroupingParam: LPCGUID, #[in] EventContext: LPCGUID) -> HRESULT;
            fn OnStateChanged(&self, #[in] NewState: AudioSessionState) -> HRESULT;
            fn OnSessionDisconnected(&self, #[in] DisconnectReason: AudioSessionDisconnectReason) -> HRESULT;
        }
        #[guid(0xbfa971f1_4d5e_40bb_935e_967039bfbee4)]
        interface IAudioSessionManager: IUnknown {
            fn GetAudioSessionControl(&self, #[in] #[opt] AudioSessionGuid: LPCGUID, #[in] StreamFlags: DWORD, #[out] #[out_ptr] #[retval] SessionControl: *mut IAudioSessionControl) -> HRESULT;
            fn GetSimpleAudioVolume(&self, #[in] #[opt] AudioSessionGuid: LPCGUID, #[in] StreamFlags: DWORD, #[out] #[out_ptr] #[retval] AudioVolume: *mut ISimpleAudioVolume) -> HRESULT;
        }
        #[guid(0x77aa99a0_1bd6_484f_8bc7_2c654c9a9b6f)]
        interface IAudioSessionManager2: IAudioSessionManager {
            fn GetSessionEnumerator(&self, #[out] #[retval] SessionEnum: *mut IAudioSessionEnumerator) -> HRESULT;
            fn RegisterSessionNotification(&self, SessionNotification: IAudioSessionNotification) -> HRESULT;
            fn UnregisterSessionNotification(&self, SessionNotification: IAudioSessionNotification) -> HRESULT;
            fn RegisterDuckNotification(&self, #[in] sessionID: LPCWSTR, #[in] duckNotification: IAudioVolumeDuckNotification) -> HRESULT;
            fn UnregisterDuckNotification(&self, #[in] duckNotification: IAudioVolumeDuckNotification) -> HRESULT;
        }
        #[guid(0x641dd20b_4d41_49cc_aba3_174b9477bb08)]
        interface IAudioSessionNotification: IUnknown {
            fn OnSessionCreated(&self, #[in] NewSession: IAudioSessionControl) -> HRESULT;
        }
        #[guid(0xc3b284d4_6d39_4359_b3cf_b56ddb3bb39c)]
        interface IAudioVolumeDuckNotification: IUnknown {
            fn OnVolumeDuckNotification(&self, #[in] sessionID: LPCWSTR, #[in] countCommunicationSessions: UINT32) -> HRESULT;
            fn OnVolumeUnduckNotification(&self, #[in] sessionID: LPCWSTR) -> HRESULT;
        }
    }
}
