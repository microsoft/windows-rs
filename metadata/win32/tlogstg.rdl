        interface ITravelLogStg: IUnknown {
            fn CreateEntry(&self, #[in] pszUrl: LPCWSTR, #[in] pszTitle: LPCWSTR, #[in] #[opt] ptleRelativeTo: ITravelLogEntry, #[in] fPrepend: BOOL, #[out] #[out_ptr] pptle: *mut ITravelLogEntry) -> HRESULT;
