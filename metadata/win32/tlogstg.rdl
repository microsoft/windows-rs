#[win32]
mod Windows {
    mod Win32 {
        #[guid(0x7ebfdd85_ad18_11d3_a4c5_00c04f72d6b8)]
        interface IEnumTravelLogEntry: IUnknown {
            fn Next(&self, #[in] cElt: ULONG, #[out] #[readable(success, *pcEltFetched)] #[writable(entry, cElt)] #[writable(success, cElt)] rgElt: *mut ITravelLogEntry, #[out] pcEltFetched: *mut ULONG) -> HRESULT;
            fn Skip(&self, #[in] cElt: ULONG) -> HRESULT;
