#[win32]
mod Windows {
    mod Win32 {
        struct DYNAMIC_TIME_ZONE_INFORMATION {
            Bias: i32,
            StandardName: [u16; 32],
            StandardDate: SYSTEMTIME,
            StandardBias: i32,
            DaylightName: [u16; 32],
            DaylightDate: SYSTEMTIME,
            DaylightBias: i32,
            TimeZoneKeyName: [u16; 128],
            DynamicDaylightTimeDisabled: BOOLEAN,
        }
        #[library("ADVAPI32.dll")]
        extern fn EnumDynamicTimeZoneInformation(dwIndex: u32, #[out] lpTimeZoneInformation: PDYNAMIC_TIME_ZONE_INFORMATION) -> u32;
        #[library("KERNEL32.dll")]
        extern fn FileTimeToSystemTime(lpFileTime: *const FILETIME, #[out] lpSystemTime: LPSYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetDynamicTimeZoneInformation(#[out] pTimeZoneInformation: PDYNAMIC_TIME_ZONE_INFORMATION) -> u32;
        #[library("ADVAPI32.dll")]
        extern fn GetDynamicTimeZoneInformationEffectiveYears(lpTimeZoneInformation: PDYNAMIC_TIME_ZONE_INFORMATION, #[out] FirstYear: LPDWORD, #[out] LastYear: LPDWORD) -> u32;
        #[library("KERNEL32.dll")]
        extern fn GetTimeZoneInformation(#[out] lpTimeZoneInformation: LPTIME_ZONE_INFORMATION) -> u32;
        #[library("KERNEL32.dll")]
        extern fn GetTimeZoneInformationForYear(wYear: u16, #[opt] pdtzi: PDYNAMIC_TIME_ZONE_INFORMATION, #[out] ptzi: LPTIME_ZONE_INFORMATION) -> BOOL;
        type LPTIME_ZONE_INFORMATION = *mut TIME_ZONE_INFORMATION;
        #[library("KERNEL32.dll")]
        extern fn LocalFileTimeToLocalSystemTime(#[opt] timeZoneInformation: *const TIME_ZONE_INFORMATION, localFileTime: *const FILETIME, localSystemTime: *mut SYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn LocalSystemTimeToLocalFileTime(#[opt] timeZoneInformation: *const TIME_ZONE_INFORMATION, localSystemTime: *const SYSTEMTIME, localFileTime: *mut FILETIME) -> BOOL;
        type PDYNAMIC_TIME_ZONE_INFORMATION = *mut DYNAMIC_TIME_ZONE_INFORMATION;
        type PTIME_ZONE_INFORMATION = *mut TIME_ZONE_INFORMATION;
        #[library("KERNEL32.dll")]
        extern fn SetDynamicTimeZoneInformation(lpTimeZoneInformation: *const DYNAMIC_TIME_ZONE_INFORMATION) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetTimeZoneInformation(lpTimeZoneInformation: *const TIME_ZONE_INFORMATION) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SystemTimeToFileTime(lpSystemTime: *const SYSTEMTIME, #[out] lpFileTime: LPFILETIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SystemTimeToTzSpecificLocalTime(#[opt] lpTimeZoneInformation: *const TIME_ZONE_INFORMATION, lpUniversalTime: *const SYSTEMTIME, #[out] lpLocalTime: LPSYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SystemTimeToTzSpecificLocalTimeEx(#[opt] lpTimeZoneInformation: *const DYNAMIC_TIME_ZONE_INFORMATION, lpUniversalTime: *const SYSTEMTIME, #[out] lpLocalTime: LPSYSTEMTIME) -> BOOL;
        const TIME_ZONE_ID_INVALID: u32 = 4294967295;
        struct TIME_ZONE_INFORMATION {
            Bias: i32,
            StandardName: [u16; 32],
            StandardDate: SYSTEMTIME,
            StandardBias: i32,
            DaylightName: [u16; 32],
            DaylightDate: SYSTEMTIME,
            DaylightBias: i32,
        }
        #[library("KERNEL32.dll")]
        extern fn TzSpecificLocalTimeToSystemTime(#[opt] lpTimeZoneInformation: *const TIME_ZONE_INFORMATION, lpLocalTime: *const SYSTEMTIME, #[out] lpUniversalTime: LPSYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn TzSpecificLocalTimeToSystemTimeEx(#[opt] lpTimeZoneInformation: *const DYNAMIC_TIME_ZONE_INFORMATION, lpLocalTime: *const SYSTEMTIME, #[out] lpUniversalTime: LPSYSTEMTIME) -> BOOL;
    }
}
