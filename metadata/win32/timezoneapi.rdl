#[win32]
mod Windows {
    mod Win32 {
        struct DYNAMIC_TIME_ZONE_INFORMATION {
            Bias: LONG,
            StandardName: [WCHAR; 32],
            StandardDate: SYSTEMTIME,
            StandardBias: LONG,
            DaylightName: [WCHAR; 32],
            DaylightDate: SYSTEMTIME,
            DaylightBias: LONG,
            TimeZoneKeyName: [WCHAR; 128],
            DynamicDaylightTimeDisabled: BOOLEAN,
        }
        #[library("ADVAPI32.dll")]
        extern fn EnumDynamicTimeZoneInformation(#[in] dwIndex: DWORD, #[out] lpTimeZoneInformation: PDYNAMIC_TIME_ZONE_INFORMATION) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn FileTimeToSystemTime(#[in] lpFileTime: *const FILETIME, #[out] lpSystemTime: LPSYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetDynamicTimeZoneInformation(#[out] pTimeZoneInformation: PDYNAMIC_TIME_ZONE_INFORMATION) -> DWORD;
        #[library("ADVAPI32.dll")]
        extern fn GetDynamicTimeZoneInformationEffectiveYears(#[in] lpTimeZoneInformation: PDYNAMIC_TIME_ZONE_INFORMATION, #[out] FirstYear: LPDWORD, #[out] LastYear: LPDWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetTimeZoneInformation(#[out] lpTimeZoneInformation: LPTIME_ZONE_INFORMATION) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetTimeZoneInformationForYear(#[in] wYear: USHORT, #[in] #[opt] pdtzi: PDYNAMIC_TIME_ZONE_INFORMATION, #[out] ptzi: LPTIME_ZONE_INFORMATION) -> BOOL;
        type LPTIME_ZONE_INFORMATION = *mut TIME_ZONE_INFORMATION;
        #[library("KERNEL32.dll")]
        extern fn LocalFileTimeToLocalSystemTime(#[in] #[opt] timeZoneInformation: *const TIME_ZONE_INFORMATION, #[in] localFileTime: *const FILETIME, #[out] localSystemTime: *mut SYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn LocalSystemTimeToLocalFileTime(#[in] #[opt] timeZoneInformation: *const TIME_ZONE_INFORMATION, #[in] localSystemTime: *const SYSTEMTIME, #[out] localFileTime: *mut FILETIME) -> BOOL;
        type PDYNAMIC_TIME_ZONE_INFORMATION = *mut DYNAMIC_TIME_ZONE_INFORMATION;
        type PTIME_ZONE_INFORMATION = *mut TIME_ZONE_INFORMATION;
        #[library("KERNEL32.dll")]
        extern fn SetDynamicTimeZoneInformation(#[in] lpTimeZoneInformation: *const DYNAMIC_TIME_ZONE_INFORMATION) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetTimeZoneInformation(#[in] lpTimeZoneInformation: *const TIME_ZONE_INFORMATION) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SystemTimeToFileTime(#[in] lpSystemTime: *const SYSTEMTIME, #[out] lpFileTime: LPFILETIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SystemTimeToTzSpecificLocalTime(#[in] #[opt] lpTimeZoneInformation: *const TIME_ZONE_INFORMATION, #[in] lpUniversalTime: *const SYSTEMTIME, #[out] lpLocalTime: LPSYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SystemTimeToTzSpecificLocalTimeEx(#[in] #[opt] lpTimeZoneInformation: *const DYNAMIC_TIME_ZONE_INFORMATION, #[in] lpUniversalTime: *const SYSTEMTIME, #[out] lpLocalTime: LPSYSTEMTIME) -> BOOL;
        const TIME_ZONE_ID_INVALID: DWORD = 4294967295;
        struct TIME_ZONE_INFORMATION {
            Bias: LONG,
            StandardName: [WCHAR; 32],
            StandardDate: SYSTEMTIME,
            StandardBias: LONG,
            DaylightName: [WCHAR; 32],
            DaylightDate: SYSTEMTIME,
            DaylightBias: LONG,
        }
        #[library("KERNEL32.dll")]
        extern fn TzSpecificLocalTimeToSystemTime(#[in] #[opt] lpTimeZoneInformation: *const TIME_ZONE_INFORMATION, #[in] lpLocalTime: *const SYSTEMTIME, #[out] lpUniversalTime: LPSYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn TzSpecificLocalTimeToSystemTimeEx(#[in] #[opt] lpTimeZoneInformation: *const DYNAMIC_TIME_ZONE_INFORMATION, #[in] lpLocalTime: *const SYSTEMTIME, #[out] lpUniversalTime: LPSYSTEMTIME) -> BOOL;
    }
}
