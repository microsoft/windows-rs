#[win32]
mod Windows {
    mod Win32 {
        #[library("ACTIVEDS.dll")]
        extern fn ADsBuildEnumerator(pADsContainer: IADsContainer, ppEnumVariant: *mut IEnumVARIANT) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsBuildVarArrayInt(lpdwObjectTypes: LPDWORD, dwObjectTypes: DWORD, pVar: *mut VARIANT) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsBuildVarArrayStr(#[in] #[readable(entry, dwPathNames)] lppPathNames: *mut LPWSTR, dwPathNames: DWORD, pVar: *mut VARIANT) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsDecodeBinaryData(szSrcData: LPCWSTR, ppbDestData: *mut PBYTE, pdwDestLen: *mut ULONG) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsEncodeBinaryData(pbSrcData: PBYTE, dwSrcLen: DWORD, #[out] #[out_ptr] ppszDestData: *mut LPWSTR) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsEnumerateNext(pEnumVariant: IEnumVARIANT, cElements: ULONG, pvar: *mut VARIANT, pcElementsFetched: *mut ULONG) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsFreeEnumerator(pEnumVariant: IEnumVARIANT) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsGetLastError(lpError: LPDWORD, #[out] #[writable(entry, dwErrorBufLen)] lpErrorBuf: LPWSTR, dwErrorBufLen: DWORD, #[out] #[writable(entry, dwNameBufLen)] lpNameBuf: LPWSTR, dwNameBufLen: DWORD) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsGetObject(lpszPathName: LPCWSTR, riid: &IID, ppObject: *mut *mut void) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsOpenObject(lpszPathName: LPCWSTR, lpszUserName: LPCWSTR, lpszPassword: LPCWSTR, dwReserved: DWORD, riid: &IID, ppObject: *mut *mut void) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ADsSetLastError(dwErr: DWORD, pszError: LPCWSTR, pszProvider: LPCWSTR);
        #[library("ACTIVEDS.dll")]
        extern fn AdsFreeAdsValues(pAdsValues: PADSVALUE, dwNumValues: DWORD);
        #[library("ACTIVEDS.dll")]
        extern fn AdsTypeToPropVariant(pAdsValues: PADSVALUE, dwNumValues: DWORD, pVariant: *mut VARIANT) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn AllocADsMem(cb: DWORD) -> LPVOID;
        #[library("ACTIVEDS.dll")]
        extern fn AllocADsStr(pStr: LPCWSTR) -> LPWSTR;
        #[library("ACTIVEDS.dll")]
        extern fn BinarySDToSecurityDescriptor(pSecurityDescriptor: PSECURITY_DESCRIPTOR, pVarsec: *mut VARIANT, pszServerName: LPCWSTR, userName: LPCWSTR, passWord: LPCWSTR, dwFlags: DWORD) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn FreeADsMem(pMem: LPVOID) -> BOOL;
        #[library("ACTIVEDS.dll")]
        extern fn FreeADsStr(#[in] pStr: LPWSTR) -> BOOL;
        #[library("ACTIVEDS.dll")]
        extern fn PropVariantToAdsType(pVariant: *mut VARIANT, dwNumVariant: DWORD, ppAdsValues: *mut PADSVALUE, pdwNumValues: PDWORD) -> HRESULT;
        #[library("ACTIVEDS.dll")]
        extern fn ReallocADsMem(pOldMem: LPVOID, cbOld: DWORD, cbNew: DWORD) -> LPVOID;
        #[library("ACTIVEDS.dll")]
        extern fn ReallocADsStr(#[in] #[out] ppStr: *mut LPWSTR, #[in] pStr: LPWSTR) -> BOOL;
        #[library("ACTIVEDS.dll")]
        extern fn SecurityDescriptorToBinarySD(vVarSecDes: VARIANT, ppSecurityDescriptor: *mut PSECURITY_DESCRIPTOR, pdwSDLength: PDWORD, pszServerName: LPCWSTR, userName: LPCWSTR, passWord: LPCWSTR, dwFlags: DWORD) -> HRESULT;
    }
}
