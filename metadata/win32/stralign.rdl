#[win32]
mod Windows {
    mod Win32 {
        #[arch(X64 | Arm64)]
        type PUWSTR_C = *const u16;
        const _STRALIGN_USE_SECURE_CRT: i32 = 1;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern fn uaw_lstrcmpW(String1: PCUWSTR, String2: PCUWSTR) -> i32;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern fn uaw_lstrcmpiW(String1: PCUWSTR, String2: PCUWSTR) -> i32;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern fn uaw_lstrlenW(String: LPCUWSTR) -> i32;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern "C" fn uaw_wcschr(String: PCUWSTR, Character: u16) -> PUWSTR;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern "C" fn uaw_wcscpy(#[out] Destination: PUWSTR, Source: PCUWSTR) -> PUWSTR;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern "C" fn uaw_wcsicmp(String1: PCUWSTR, String2: PCUWSTR) -> i32;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern "C" fn uaw_wcslen(String: PCUWSTR) -> usize;
        #[arch(X64 | Arm64)]
        #[library("KERNEL32.dll")]
        extern "C" fn uaw_wcsrchr(String: PCUWSTR, Character: u16) -> PUWSTR;
    }
}
