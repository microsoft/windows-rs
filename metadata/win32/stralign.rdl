#[win32]
mod Windows {
    mod Win32 {
        const _STRALIGN_USE_SECURE_CRT: i32 = 1;
        #[library("USER32.dll", import = "CharUpperA")]
        extern fn ua_CharUpper(#[in] #[out] lpsz: LPSTR) -> LPSTR;
        #[library("KERNEL32.dll", import = "lstrcmpA")]
        extern fn ua_lstrcmp(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpString1: LPCSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpString2: LPCSTR) -> i32;
        #[library("KERNEL32.dll", import = "lstrcmpiA")]
        extern fn ua_lstrcmpi(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpString1: LPCSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpString2: LPCSTR) -> i32;
        #[library("KERNEL32.dll", import = "lstrlenA")]
        extern fn ua_lstrlen(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpString: LPCSTR) -> i32;
    }
}
