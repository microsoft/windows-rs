#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn ExpandEnvironmentStringsA(#[in] lpSrc: LPCSTR, #[buffer(nSize)] #[incomplete] #[opt] #[out] lpDst: LPSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn ExpandEnvironmentStringsW(#[in] lpSrc: LPCWSTR, #[buffer(nSize)] #[incomplete] #[opt] #[out] lpDst: LPWSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn FreeEnvironmentStringsA(#[in] #[null_null_terminated] penv: LPCH) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn FreeEnvironmentStringsW(#[in] #[null_null_terminated] penv: LPWCH) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetCommandLineA() -> LPSTR;
        #[library("KERNEL32.dll")]
        extern fn GetCommandLineW() -> LPWSTR;
        #[library("KERNEL32.dll")]
        extern fn GetCurrentDirectoryA(#[in] nBufferLength: DWORD, #[buffer(nBufferLength)] #[incomplete] #[opt] #[out] lpBuffer: LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetCurrentDirectoryW(#[in] nBufferLength: DWORD, #[buffer(nBufferLength)] #[incomplete] #[opt] #[out] lpBuffer: LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetEnvironmentStrings() -> LPCH;
        #[library("KERNEL32.dll")]
        extern fn GetEnvironmentStringsW() -> LPWCH;
        #[library("KERNEL32.dll")]
        extern fn GetEnvironmentVariableA(#[in] #[opt] lpName: LPCSTR, #[buffer(nSize)] #[incomplete] #[opt] #[out] lpBuffer: LPSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetEnvironmentVariableW(#[in] #[opt] lpName: LPCWSTR, #[buffer(nSize)] #[incomplete] #[opt] #[out] lpBuffer: LPWSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetStdHandle(#[in] nStdHandle: DWORD) -> HANDLE;
        #[library("KERNEL32.dll")]
        extern fn NeedCurrentDirectoryForExePathA(#[in] ExeName: LPCSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn NeedCurrentDirectoryForExePathW(#[in] ExeName: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SearchPathA(#[in] #[opt] lpPath: LPCSTR, #[in] lpFileName: LPCSTR, #[in] #[opt] lpExtension: LPCSTR, #[in] nBufferLength: DWORD, #[buffer(nBufferLength)] #[incomplete] #[opt] #[out] lpBuffer: LPSTR, #[opt] #[out] lpFilePart: *mut LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn SearchPathW(#[in] #[opt] lpPath: LPCWSTR, #[in] lpFileName: LPCWSTR, #[in] #[opt] lpExtension: LPCWSTR, #[in] nBufferLength: DWORD, #[buffer(nBufferLength)] #[incomplete] #[opt] #[out] lpBuffer: LPWSTR, #[opt] #[out] lpFilePart: *mut LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn SetCurrentDirectoryA(#[in] lpPathName: LPCSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetCurrentDirectoryW(#[in] lpPathName: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetEnvironmentStringsW(#[in] #[null_null_terminated] NewEnvironment: LPWCH) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetEnvironmentVariableA(#[in] lpName: LPCSTR, #[in] #[opt] lpValue: LPCSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetEnvironmentVariableW(#[in] lpName: LPCWSTR, #[in] #[opt] lpValue: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetStdHandle(#[in] nStdHandle: DWORD, #[in] hHandle: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetStdHandleEx(#[in] nStdHandle: DWORD, #[in] hHandle: HANDLE, #[opt] #[out] phPrevValue: PHANDLE) -> BOOL;
    }
}
