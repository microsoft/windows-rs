        struct MIB_IPMCAST_IF_TABLE {
            dwNumEntries: DWORD,
            table: [MIB_IPMCAST_IF_ENTRY; 1],
        }
        struct MIB_IPMCAST_MFE {
            dwGroup: DWORD,
            dwSource: DWORD,
            dwSrcMask: DWORD,
            dwUpStrmNgbr: DWORD,
            dwInIfIndex: DWORD,
            dwInIfProtocol: DWORD,
