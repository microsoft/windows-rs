#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum ICMP4_TYPE {
            ICMP4_ECHO_REPLY = 0,
            ICMP4_DST_UNREACH = 3,
            ICMP4_SOURCE_QUENCH = 4,
            ICMP4_REDIRECT = 5,
            ICMP4_ECHO_REQUEST = 8,
            ICMP4_ROUTER_ADVERT = 9,
            ICMP4_ROUTER_SOLICIT = 10,
            ICMP4_TIME_EXCEEDED = 11,
            ICMP4_PARAM_PROB = 12,
            ICMP4_TIMESTAMP_REQUEST = 13,
            ICMP4_TIMESTAMP_REPLY = 14,
            ICMP4_MASK_REQUEST = 17,
            ICMP4_MASK_REPLY = 18,
        }
        const ICMP6_INFOMSG_MASK: i32 = 128;
        #[repr(i32)]
        enum ICMP6_TYPE {
            ICMP6_DST_UNREACH = 1,
            ICMP6_PACKET_TOO_BIG = 2,
            ICMP6_TIME_EXCEEDED = 3,
            ICMP6_PARAM_PROB = 4,
            ICMP6_ECHO_REQUEST = 128,
            ICMP6_ECHO_REPLY = 129,
            ICMP6_MEMBERSHIP_QUERY = 130,
            ICMP6_MEMBERSHIP_REPORT = 131,
            ICMP6_MEMBERSHIP_REDUCTION = 132,
            ND_ROUTER_SOLICIT = 133,
            ND_ROUTER_ADVERT = 134,
            ND_NEIGHBOR_SOLICIT = 135,
            ND_NEIGHBOR_ADVERT = 136,
            ND_REDIRECT = 137,
            ICMP6_V2_MEMBERSHIP_REPORT = 143,
        }
        struct MIBICMPINFO {
            icmpInStats: MIBICMPSTATS,
            icmpOutStats: MIBICMPSTATS,
        }
        struct MIBICMPSTATS {
            dwMsgs: DWORD,
            dwErrors: DWORD,
            dwDestUnreachs: DWORD,
            dwTimeExcds: DWORD,
            dwParmProbs: DWORD,
            dwSrcQuenchs: DWORD,
            dwRedirects: DWORD,
            dwEchos: DWORD,
            dwEchoReps: DWORD,
            dwTimestamps: DWORD,
            dwTimestampReps: DWORD,
            dwAddrMasks: DWORD,
            dwAddrMaskReps: DWORD,
        }
        type MIBICMPSTATS_EX = MIBICMPSTATS_EX_XPSP1;
        struct MIBICMPSTATS_EX_XPSP1 {
            dwMsgs: DWORD,
            dwErrors: DWORD,
            rgdwTypeCount: [DWORD; 256],
        }
        struct MIB_ICMP {
            stats: MIBICMPINFO,
        }
        type MIB_ICMP_EX = MIB_ICMP_EX_XPSP1;
        struct MIB_ICMP_EX_XPSP1 {
            icmpInStats: MIBICMPSTATS_EX,
            icmpOutStats: MIBICMPSTATS_EX,
        }
        type MIB_IPADDRROW = MIB_IPADDRROW_XP;
        struct MIB_IPADDRROW_W2K {
            dwAddr: DWORD,
            dwIndex: DWORD,
            dwMask: DWORD,
            dwBCastAddr: DWORD,
            dwReasmSize: DWORD,
            unused1: u16,
            unused2: u16,
        }
        struct MIB_IPADDRROW_XP {
            dwAddr: DWORD,
            dwIndex: IF_INDEX,
            dwMask: DWORD,
            dwBCastAddr: DWORD,
            dwReasmSize: DWORD,
            unused1: u16,
            wType: u16,
        }
        struct MIB_IPADDRTABLE {
            dwNumEntries: DWORD,
            table: [MIB_IPADDRROW; 1],
        }
        const MIB_IPADDR_DELETED: i32 = 64;
        const MIB_IPADDR_DISCONNECTED: i32 = 8;
        const MIB_IPADDR_DNS_ELIGIBLE: i32 = 256;
        const MIB_IPADDR_DYNAMIC: i32 = 4;
        const MIB_IPADDR_PRIMARY: i32 = 1;
        const MIB_IPADDR_TRANSIENT: i32 = 128;
        struct MIB_IPFORWARDNUMBER {
            dwValue: DWORD,
        }
        struct MIB_IPFORWARDROW {
            dwForwardDest: DWORD,
            dwForwardMask: DWORD,
            dwForwardPolicy: DWORD,
            dwForwardNextHop: DWORD,
            dwForwardIfIndex: IF_INDEX,
            Anonymous: union {
                dwForwardType: DWORD,
                ForwardType: MIB_IPFORWARD_TYPE,
            },
            Anonymous2: union {
                dwForwardProto: DWORD,
                ForwardProto: MIB_IPFORWARD_PROTO,
            },
            dwForwardAge: DWORD,
            dwForwardNextHopAS: DWORD,
            dwForwardMetric1: DWORD,
            dwForwardMetric2: DWORD,
            dwForwardMetric3: DWORD,
            dwForwardMetric4: DWORD,
            dwForwardMetric5: DWORD,
        }
        struct MIB_IPFORWARDTABLE {
            dwNumEntries: DWORD,
            table: [MIB_IPFORWARDROW; 1],
        }
        type MIB_IPFORWARD_PROTO = NL_ROUTE_PROTOCOL;
        #[repr(i32)]
        enum MIB_IPFORWARD_TYPE {
            MIB_IPROUTE_TYPE_OTHER = 1,
