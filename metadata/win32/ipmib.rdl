        type PMIB_MFE_STATS_TABLE_EX_XP = *mut MIB_MFE_STATS_TABLE_EX_XP;
        type PMIB_MFE_TABLE = *mut MIB_MFE_TABLE;
        const SIZEOF_BASIC_MIB_MFE: ULONG = 60;
        const SIZEOF_BASIC_MIB_MFE_STATS: ULONG = 64;
        const SIZEOF_BASIC_MIB_MFE_STATS_EX: ULONG = 84;
