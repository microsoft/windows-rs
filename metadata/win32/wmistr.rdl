#[win32]
mod Windows {
    mod Win32 {
        struct OFFSETINSTANCEDATAANDLENGTH {
            OffsetInstanceData: ULONG,
            LengthInstanceData: ULONG,
        }
        type POFFSETINSTANCEDATAANDLENGTH = *mut OFFSETINSTANCEDATAANDLENGTH;
        type PWMIREGGUID = *mut WMIREGGUIDW;
        type PWMIREGGUIDW = *mut WMIREGGUIDW;
        type PWNODE_EVENT_ITEM = *mut WNODE_EVENT_ITEM;
        type PWNODE_HEADER = *mut WNODE_HEADER;
        type PWNODE_TOO_SMALL = *mut WNODE_TOO_SMALL;
        const TRACELOG_ACCESS_KERNEL_LOGGER: i32 = 256;
        const TRACELOG_ACCESS_REALTIME: i32 = 1024;
        const TRACELOG_CREATE_INPROC: i32 = 512;
        const TRACELOG_CREATE_ONDISK: i32 = 64;
        const TRACELOG_CREATE_REALTIME: i32 = 32;
        const TRACELOG_GUID_ENABLE: i32 = 128;
        const TRACELOG_JOIN_GROUP: i32 = 4096;
        const TRACELOG_LOG_EVENT: i32 = 512;
        const TRACELOG_REGISTER_GUIDS: i32 = 2048;
        #[repr(i32)]
        enum WMIDPREQUESTCODE {
            WMI_GET_ALL_DATA = 0,
            WMI_GET_SINGLE_INSTANCE = 1,
            WMI_SET_SINGLE_INSTANCE = 2,
            WMI_SET_SINGLE_ITEM = 3,
            WMI_ENABLE_EVENTS = 4,
            WMI_DISABLE_EVENTS = 5,
            WMI_ENABLE_COLLECTION = 6,
            WMI_DISABLE_COLLECTION = 7,
            WMI_REGINFO = 8,
            WMI_EXECUTE_METHOD = 9,
            WMI_CAPTURE_STATE = 10,
        }
        const WMIGUID_ALL_ACCESS: i32 = 1187839;
        const WMIGUID_ALL_ACCESS_RS1: i32 = 1187839;
        const WMIGUID_ALL_ACCESS_WIN2K: i32 = 133119;
        const WMIGUID_ALL_ACCESS_WINXP: i32 = 1183743;
        const WMIGUID_EXECUTE: i32 = 16;
        const WMIGUID_NOTIFICATION: i32 = 4;
        const WMIGUID_QUERY: i32 = 1;
        const WMIGUID_READ_DESCRIPTION: i32 = 8;
        const WMIGUID_SET: i32 = 2;
        type WMIREGGUID = WMIREGGUIDW;
        struct WMIREGGUIDW {
            Guid: GUID,
            Flags: ULONG,
            InstanceCount: ULONG,
            Anonymous: union {
                InstanceNameList: ULONG,
                BaseNameOffset: ULONG,
                Pdo: ULONG_PTR,
                InstanceInfo: ULONG_PTR,
            },
        }
        const WMIREG_FLAG_EVENT_ONLY_GUID: i32 = 64;
        const WMIREG_FLAG_EXPENSIVE: i32 = 1;
        const WMIREG_FLAG_INSTANCE_BASENAME: i32 = 8;
        const WMIREG_FLAG_INSTANCE_LIST: i32 = 4;
        const WMIREG_FLAG_INSTANCE_PDO: i32 = 32;
        const WMIREG_FLAG_REMOVE_GUID: i32 = 65536;
        const WMIREG_FLAG_RESERVED1: i32 = 131072;
        const WMIREG_FLAG_RESERVED2: i32 = 262144;
        const WMIREG_FLAG_TRACED_GUID: i32 = 524288;
        const WMIREG_FLAG_TRACE_CONTROL_GUID: i32 = 4096;
        const WMI_GLOBAL_LOGGER_ID: i32 = 1;
        const WMI_GUIDTYPE_DATA: i32 = 2;
        const WMI_GUIDTYPE_EVENT: i32 = 3;
        const WMI_GUIDTYPE_TRACE: i32 = 1;
        const WMI_GUIDTYPE_TRACECONTROL: i32 = 0;
        struct WNODE_EVENT_ITEM {
            WnodeHeader: WNODE_HEADER,
        }
        const WNODE_FLAG_ALL_DATA: i32 = 1;
        const WNODE_FLAG_ANSI_INSTANCENAMES: i32 = 16384;
        const WNODE_FLAG_EVENT_ITEM: i32 = 8;
        const WNODE_FLAG_EVENT_REFERENCE: i32 = 8192;
        const WNODE_FLAG_FIXED_INSTANCE_SIZE: i32 = 16;
        const WNODE_FLAG_INSTANCES_SAME: i32 = 64;
        const WNODE_FLAG_INTERNAL: i32 = 256;
        const WNODE_FLAG_LOG_WNODE: i32 = 262144;
        const WNODE_FLAG_METHOD_ITEM: i32 = 32768;
        const WNODE_FLAG_NO_HEADER: i32 = 2097152;
        const WNODE_FLAG_PDO_INSTANCE_NAMES: i32 = 65536;
        const WNODE_FLAG_PERSIST_EVENT: i32 = 1024;
        const WNODE_FLAG_SEND_DATA_BLOCK: i32 = 4194304;
        const WNODE_FLAG_SEVERITY_MASK: u32 = 4278190080;
        const WNODE_FLAG_SINGLE_INSTANCE: i32 = 2;
        const WNODE_FLAG_SINGLE_ITEM: i32 = 4;
        const WNODE_FLAG_STATIC_INSTANCE_NAMES: i32 = 128;
        const WNODE_FLAG_TOO_SMALL: i32 = 32;
        const WNODE_FLAG_TRACED_GUID: i32 = 131072;
        const WNODE_FLAG_USE_GUID_PTR: i32 = 524288;
        const WNODE_FLAG_USE_MOF_PTR: i32 = 1048576;
        const WNODE_FLAG_USE_TIMESTAMP: i32 = 512;
        const WNODE_FLAG_VERSIONED_PROPERTIES: i32 = 8388608;
        struct WNODE_HEADER {
            BufferSize: ULONG,
            ProviderId: ULONG,
            Anonymous: union {
                HistoricalContext: ULONG64,
                Anonymous: struct {
                    Version: ULONG,
                    Linkage: ULONG,
                },
            },
            Anonymous2: union {
                CountLost: ULONG,
                KernelHandle: HANDLE,
                TimeStamp: LARGE_INTEGER,
            },
            Guid: GUID,
            ClientContext: ULONG,
            Flags: ULONG,
        }
        struct WNODE_TOO_SMALL {
            WnodeHeader: WNODE_HEADER,
            SizeNeeded: ULONG,
        }
    }
}
