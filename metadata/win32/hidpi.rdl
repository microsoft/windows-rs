#[win32]
mod Windows {
    mod Win32 {
        struct HIDP_BUTTON_ARRAY_DATA {
            ArrayIndex: u16,
            On: BOOLEAN,
        }
        struct HIDP_BUTTON_CAPS {
            UsagePage: USAGE,
            ReportID: u8,
            IsAlias: BOOLEAN,
            BitField: u16,
            LinkCollection: u16,
            LinkUsage: USAGE,
            LinkUsagePage: USAGE,
            IsRange: BOOLEAN,
            IsStringRange: BOOLEAN,
            IsDesignatorRange: BOOLEAN,
            IsAbsolute: BOOLEAN,
            ReportCount: u16,
            Reserved2: u16,
            Reserved: [u32; 9],
            Anonymous: union {
                Range: struct {
                    UsageMin: USAGE,
                    UsageMax: USAGE,
                    StringMin: u16,
                    StringMax: u16,
                    DesignatorMin: u16,
                    DesignatorMax: u16,
                    DataIndexMin: u16,
                    DataIndexMax: u16,
                },
                NotRange: struct {
                    Usage: USAGE,
                    Reserved1: USAGE,
                    StringIndex: u16,
                    Reserved2: u16,
                    DesignatorIndex: u16,
                    Reserved3: u16,
                    DataIndex: u16,
                    Reserved4: u16,
                },
            },
        }
        struct HIDP_CAPS {
            Usage: USAGE,
            UsagePage: USAGE,
            InputReportByteLength: u16,
            OutputReportByteLength: u16,
            FeatureReportByteLength: u16,
            Reserved: [u16; 17],
            NumberLinkCollectionNodes: u16,
            NumberInputButtonCaps: u16,
            NumberInputValueCaps: u16,
            NumberInputDataIndices: u16,
            NumberOutputButtonCaps: u16,
            NumberOutputValueCaps: u16,
            NumberOutputDataIndices: u16,
            NumberFeatureButtonCaps: u16,
            NumberFeatureValueCaps: u16,
            NumberFeatureDataIndices: u16,
        }
        struct HIDP_DATA {
            DataIndex: u16,
            Reserved: u16,
            Anonymous: union {
                RawValue: u32,
                On: BOOLEAN,
            },
        }
        #[arch(X86)]
        struct HIDP_EXTENDED_ATTRIBUTES {
            NumGlobalUnknowns: u8,
            Reserved: [u8; 3],
            GlobalUnknowns: PHIDP_UNKNOWN_TOKEN,
            Data: [u32; 1],
        }
        #[packed(4)]
        #[arch(X64 | Arm64)]
        struct HIDP_EXTENDED_ATTRIBUTES {
            NumGlobalUnknowns: u8,
            Reserved: [u8; 3],
            GlobalUnknowns: PHIDP_UNKNOWN_TOKEN,
            Data: [u32; 1],
        }
        #[repr(i32)]
        enum HIDP_KEYBOARD_DIRECTION {
            HidP_Keyboard_Break = 0,
            HidP_Keyboard_Make = 1,
        }
        struct HIDP_KEYBOARD_MODIFIER_STATE {
            Anonymous: union {
                Anonymous: struct {
                    _bitfield: u32 {
                        LeftControl: 1,
                        LeftShift: 1,
                        LeftAlt: 1,
                        LeftGUI: 1,
                        RightControl: 1,
                        RightShift: 1,
                        RightAlt: 1,
                        RigthGUI: 1,
                        CapsLock: 1,
                        ScollLock: 1,
                        NumLock: 1,
                        Reserved: 21,
                    },
                },
                ul: u32,
            },
        }
        #[arch(X86)]
        struct HIDP_LINK_COLLECTION_NODE {
            LinkUsage: USAGE,
            LinkUsagePage: USAGE,
            Parent: u16,
            NumberOfChildren: u16,
            NextSibling: u16,
            FirstChild: u16,
            _bitfield: u32 {
                CollectionType: 8,
                IsAlias: 1,
                Reserved: 23,
            },
            UserContext: *mut void,
        }
        #[packed(4)]
        #[arch(X64 | Arm64)]
        struct HIDP_LINK_COLLECTION_NODE {
            LinkUsage: USAGE,
            LinkUsagePage: USAGE,
            Parent: u16,
            NumberOfChildren: u16,
            NextSibling: u16,
            FirstChild: u16,
            _bitfield: u32 {
                CollectionType: 8,
                IsAlias: 1,
                Reserved: 23,
            },
            UserContext: *mut void,
        }
        const HIDP_LINK_COLLECTION_ROOT: u16 = 65535;
        const HIDP_LINK_COLLECTION_UNSPECIFIED: u16 = 0;
        struct HIDP_PREPARSED_DATA {}
        #[repr(i32)]
        enum HIDP_REPORT_TYPE {
            HidP_Input = 0,
            HidP_Output = 1,
            HidP_Feature = 2,
        }
        const HIDP_STATUS_BAD_LOG_PHY_VALUES: NTSTATUS = -1072627706;
        const HIDP_STATUS_BUFFER_TOO_SMALL: NTSTATUS = -1072627705;
        const HIDP_STATUS_BUTTON_NOT_PRESSED: NTSTATUS = -1072627697;
        const HIDP_STATUS_DATA_INDEX_NOT_FOUND: NTSTATUS = -1072627699;
        const HIDP_STATUS_DATA_INDEX_OUT_OF_RANGE: NTSTATUS = -1072627698;
        const HIDP_STATUS_I8042_TRANS_UNKNOWN: NTSTATUS = -1072627703;
        const HIDP_STATUS_I8242_TRANS_UNKNOWN: NTSTATUS = -1072627703;
        const HIDP_STATUS_INCOMPATIBLE_REPORT_ID: NTSTATUS = -1072627702;
        const HIDP_STATUS_INTERNAL_ERROR: NTSTATUS = -1072627704;
        const HIDP_STATUS_INVALID_PREPARSED_DATA: NTSTATUS = -1072627711;
        const HIDP_STATUS_INVALID_REPORT_LENGTH: NTSTATUS = -1072627709;
        const HIDP_STATUS_INVALID_REPORT_TYPE: NTSTATUS = -1072627710;
        const HIDP_STATUS_IS_VALUE_ARRAY: NTSTATUS = -1072627700;
        const HIDP_STATUS_NOT_BUTTON_ARRAY: NTSTATUS = -1072627679;
        const HIDP_STATUS_NOT_IMPLEMENTED: NTSTATUS = -1072627680;
        const HIDP_STATUS_NOT_VALUE_ARRAY: NTSTATUS = -1072627701;
        const HIDP_STATUS_NULL: NTSTATUS = -2146369535;
        const HIDP_STATUS_REPORT_DOES_NOT_EXIST: NTSTATUS = -1072627696;
        const HIDP_STATUS_SUCCESS: NTSTATUS = 1114112;
        const HIDP_STATUS_USAGE_NOT_FOUND: NTSTATUS = -1072627708;
        const HIDP_STATUS_VALUE_OUT_OF_RANGE: NTSTATUS = -1072627707;
        struct HIDP_UNKNOWN_TOKEN {
            Token: u8,
            Reserved: [u8; 3],
            BitField: u32,
        }
        struct HIDP_VALUE_CAPS {
            UsagePage: USAGE,
            ReportID: u8,
            IsAlias: BOOLEAN,
            BitField: u16,
            LinkCollection: u16,
            LinkUsage: USAGE,
            LinkUsagePage: USAGE,
            IsRange: BOOLEAN,
            IsStringRange: BOOLEAN,
            IsDesignatorRange: BOOLEAN,
            IsAbsolute: BOOLEAN,
            HasNull: BOOLEAN,
            Reserved: u8,
            BitSize: u16,
            ReportCount: u16,
            Reserved2: [u16; 5],
            UnitsExp: u32,
            Units: u32,
            LogicalMin: i32,
            LogicalMax: i32,
            PhysicalMin: i32,
            PhysicalMax: i32,
            Anonymous: union {
                Range: struct {
                    UsageMin: USAGE,
                    UsageMax: USAGE,
                    StringMin: u16,
                    StringMax: u16,
                    DesignatorMin: u16,
                    DesignatorMax: u16,
                    DataIndexMin: u16,
                    DataIndexMax: u16,
                },
                NotRange: struct {
                    Usage: USAGE,
                    Reserved1: USAGE,
                    StringIndex: u16,
                    Reserved2: u16,
                    DesignatorIndex: u16,
                    Reserved3: u16,
                    DataIndex: u16,
                    Reserved4: u16,
                },
            },
        }
        #[library("HID.DLL")]
        extern fn HidP_GetButtonArray(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, #[len_param(5)] #[out] ButtonData: PHIDP_BUTTON_ARRAY_DATA, #[in] #[out] ButtonDataLength: PUSHORT, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(8)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetButtonCaps(ReportType: HIDP_REPORT_TYPE, #[len_param(2)] #[out] ButtonCaps: PHIDP_BUTTON_CAPS, #[in] #[out] ButtonCapsLength: PUSHORT, PreparsedData: PHIDP_PREPARSED_DATA) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetCaps(PreparsedData: PHIDP_PREPARSED_DATA, #[out] Capabilities: PHIDP_CAPS) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetData(ReportType: HIDP_REPORT_TYPE, #[len_param(2)] #[out] DataList: PHIDP_DATA, #[in] #[out] DataLength: PULONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(5)] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetExtendedAttributes(ReportType: HIDP_REPORT_TYPE, DataIndex: u16, PreparsedData: PHIDP_PREPARSED_DATA, #[len_param(4)] #[out] Attributes: PHIDP_EXTENDED_ATTRIBUTES, #[in] #[out] LengthAttributes: PULONG) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetLinkCollectionNodes(#[len_param(1)] #[out] LinkCollectionNodes: PHIDP_LINK_COLLECTION_NODE, #[in] #[out] LinkCollectionNodesLength: PULONG, PreparsedData: PHIDP_PREPARSED_DATA) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetScaledUsageValue(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, #[out] UsageValue: PLONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetSpecificButtonCaps(ReportType: HIDP_REPORT_TYPE, #[opt] UsagePage: USAGE, #[opt] LinkCollection: u16, #[opt] Usage: USAGE, #[len_param(5)] #[out] ButtonCaps: PHIDP_BUTTON_CAPS, #[in] #[out] ButtonCapsLength: PUSHORT, PreparsedData: PHIDP_PREPARSED_DATA) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetSpecificValueCaps(ReportType: HIDP_REPORT_TYPE, #[opt] UsagePage: USAGE, #[opt] LinkCollection: u16, #[opt] Usage: USAGE, #[len_param(5)] #[out] ValueCaps: PHIDP_VALUE_CAPS, #[in] #[out] ValueCapsLength: PUSHORT, PreparsedData: PHIDP_PREPARSED_DATA) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetUsageValue(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, #[out] UsageValue: PULONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetUsageValueArray(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, #[size_param(5)] #[in] #[out] UsageValue: PCHAR, UsageValueByteLength: u16, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(8)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetUsages(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, #[len_param(4)] #[out] UsageList: PUSAGE, #[in] #[out] UsageLength: PULONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetUsagesEx(ReportType: HIDP_REPORT_TYPE, #[opt] LinkCollection: u16, #[len_param(3)] #[in] #[out] ButtonList: PUSAGE_AND_PAGE, #[in] #[out] UsageLength: *mut u32, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(6)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_GetValueCaps(ReportType: HIDP_REPORT_TYPE, #[len_param(2)] #[out] ValueCaps: PHIDP_VALUE_CAPS, #[in] #[out] ValueCapsLength: PUSHORT, PreparsedData: PHIDP_PREPARSED_DATA) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_InitializeReportForID(ReportType: HIDP_REPORT_TYPE, ReportID: u8, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(4)] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_MaxDataListLength(ReportType: HIDP_REPORT_TYPE, PreparsedData: PHIDP_PREPARSED_DATA) -> u32;
        #[library("HID.DLL")]
