        extern fn HidP_SetButtonArray(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, #[len_param(5)] ButtonData: PHIDP_BUTTON_ARRAY_DATA, ButtonDataLength: u16, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(8)] #[in] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_SetData(ReportType: HIDP_REPORT_TYPE, #[len_param(2)] #[in] #[out] DataList: PHIDP_DATA, #[in] #[out] DataLength: PULONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(5)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_SetScaledUsageValue(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, UsageValue: i32, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] #[in] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_SetUsageValue(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, UsageValue: u32, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] #[in] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_SetUsageValueArray(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, Usage: USAGE, #[size_param(5)] UsageValue: PCHAR, UsageValueByteLength: u16, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(8)] #[in] #[out] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_SetUsages(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, #[len_param(4)] #[in] #[out] UsageList: PUSAGE, #[in] #[out] UsageLength: PULONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_TranslateUsagesToI8042ScanCodes(#[len_param(1)] ChangedUsageList: PUSAGE, UsageListLength: u32, KeyAction: HIDP_KEYBOARD_DIRECTION, #[in] #[out] ModifierState: PHIDP_KEYBOARD_MODIFIER_STATE, InsertCodesProcedure: PHIDP_INSERT_SCANCODES, #[in] #[opt] InsertCodesContext: *mut void) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_UnsetUsages(ReportType: HIDP_REPORT_TYPE, UsagePage: USAGE, #[opt] LinkCollection: u16, #[len_param(4)] #[in] #[out] UsageList: PUSAGE, #[in] #[out] UsageLength: PULONG, PreparsedData: PHIDP_PREPARSED_DATA, #[size_param(7)] Report: PCHAR, ReportLength: u32) -> NTSTATUS;
        #[library("HID.DLL")]
        extern fn HidP_UsageListDifference(#[len_param(4)] PreviousUsageList: PUSAGE, #[len_param(4)] CurrentUsageList: PUSAGE, #[len_param(4)] #[out] BreakUsageList: PUSAGE, #[len_param(4)] #[out] MakeUsageList: PUSAGE, UsageListLength: u32) -> NTSTATUS;
        extern "C" fn PFN_HidP_GetVersionInternal(Version: *mut u32) -> NTSTATUS;
        type PHIDP_BUTTON_ARRAY_DATA = *mut HIDP_BUTTON_ARRAY_DATA;
        type PHIDP_BUTTON_CAPS = *mut HIDP_BUTTON_CAPS;
        type PHIDP_CAPS = *mut HIDP_CAPS;
        type PHIDP_DATA = *mut HIDP_DATA;
        type PHIDP_EXTENDED_ATTRIBUTES = *mut HIDP_EXTENDED_ATTRIBUTES;
        extern "C" fn PHIDP_INSERT_SCANCODES(#[in] #[opt] Context: *mut void, #[size_param(2)] NewScanCodes: PCHAR, Length: u32) -> BOOLEAN;
        type PHIDP_KEYBOARD_MODIFIER_STATE = *mut HIDP_KEYBOARD_MODIFIER_STATE;
        type PHIDP_LINK_COLLECTION_NODE = *mut HIDP_LINK_COLLECTION_NODE;
        type PHIDP_PREPARSED_DATA = *mut HIDP_PREPARSED_DATA;
        type PHIDP_REPORT_DESCRIPTOR = PUCHAR;
        type PHIDP_UNKNOWN_TOKEN = *mut HIDP_UNKNOWN_TOKEN;
        type PHIDP_VALUE_CAPS = *mut HIDP_VALUE_CAPS;
        type PUSAGE_AND_PAGE = *mut USAGE_AND_PAGE;
        struct USAGE_AND_PAGE {
            Usage: USAGE,
            UsagePage: USAGE,
        }
