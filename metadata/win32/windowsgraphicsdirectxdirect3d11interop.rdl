#[win32]
mod Windows {
    mod Win32 {
        #[library("d3d11.dll")]
        extern fn CreateDirect3D11DeviceFromDXGIDevice(#[in] dxgiDevice: IDXGIDevice, #[out] #[out_ptr(null_on_failure)] graphicsDevice: *mut IInspectable) -> HRESULT;
        #[library("d3d11.dll")]
        extern fn CreateDirect3D11SurfaceFromDXGISurface(#[in] dgxiSurface: IDXGISurface, #[out] #[out_ptr(null_on_failure)] graphicsSurface: *mut IInspectable) -> HRESULT;
    }
}
