#[win32]
mod Windows {
    mod Win32 {
        #[guid(0xd396ec8c_605e_4249_978d_72ad1c312872)]
        interface IMFSpatialAudioObjectBuffer: IMFMediaBuffer {
            fn SetID(&self, #[in] u32ID: UINT32) -> HRESULT;
            fn GetID(&self, #[out] pu32ID: *mut UINT32) -> HRESULT;
            fn SetType(&self, #[in] r#type: AudioObjectType) -> HRESULT;
            fn GetType(&self, #[out] pType: *mut AudioObjectType) -> HRESULT;
            fn GetMetadataItems(&self, #[out] #[out_ptr(null_on_failure)] ppMetadataItems: *mut ISpatialAudioMetadataItems) -> HRESULT;
        }
        #[guid(0xabf28a9b_3393_4290_ba79_5ffc46d986b2)]
        interface IMFSpatialAudioSample: IMFSample {
            fn GetObjectCount(&self, #[out] pdwObjectCount: *mut DWORD) -> HRESULT;
            fn AddSpatialAudioObject(&self, #[in] pAudioObjBuffer: IMFSpatialAudioObjectBuffer) -> HRESULT;
            fn GetSpatialAudioObjectByIndex(&self, #[in] dwIndex: DWORD, #[out] #[out_ptr(null_on_failure)] #[retval] ppAudioObjBuffer: *mut IMFSpatialAudioObjectBuffer) -> HRESULT;
        }
    }
}
