#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn GetProcessGroupAffinity(hProcess: HANDLE, #[in] #[out] GroupCount: PUSHORT, #[len_param(1)] #[out] GroupArray: PUSHORT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetThreadGroupAffinity(hThread: HANDLE, #[out] GroupAffinity: PGROUP_AFFINITY) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetThreadGroupAffinity(hThread: HANDLE, GroupAffinity: *const GROUP_AFFINITY, #[out] #[opt] PreviousGroupAffinity: PGROUP_AFFINITY) -> BOOL;
    }
}
