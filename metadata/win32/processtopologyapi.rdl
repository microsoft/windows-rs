#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn GetProcessGroupAffinity(#[in] hProcess: HANDLE, #[in] #[out] GroupCount: PUSHORT, #[out] #[writable(entry, *GroupCount)] GroupArray: PUSHORT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetThreadGroupAffinity(#[in] hThread: HANDLE, #[out] GroupAffinity: PGROUP_AFFINITY) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetThreadGroupAffinity(#[in] hThread: HANDLE, #[in] GroupAffinity: *const GROUP_AFFINITY, #[out] #[opt] PreviousGroupAffinity: PGROUP_AFFINITY) -> BOOL;
    }
}
