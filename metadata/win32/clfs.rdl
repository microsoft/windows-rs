#[win32]
mod Windows {
    mod Win32 {
        type CLFSSTATUS = u32;
        type CLFS_ARCHIVE_DESCRIPTOR = CLS_ARCHIVE_DESCRIPTOR;
        #[encoding("utf-16")]
        const CLFS_BASELOG_EXTENSION: String = ".blf";
        extern "C" fn CLFS_BLOCK_ALLOCATION(cbBufferLength: ULONG, pvUserContext: PVOID) -> PVOID;
        extern "C" fn CLFS_BLOCK_DEALLOCATION(pvBuffer: PVOID, pvUserContext: PVOID);
        type CLFS_CONTAINER_ID = u32;
        type CLFS_CONTAINER_INFORMATION = CLS_CONTAINER_INFORMATION;
        #[encoding("utf-16")]
        const CLFS_CONTAINER_RELATIVE_PREFIX: String = "%BLF%\\";
        type CLFS_CONTAINER_STATE = u32;
        #[encoding("utf-16")]
        const CLFS_CONTAINER_STREAM_PREFIX: String = "%BLF%:";
        #[repr(i32)]
        enum CLFS_CONTEXT_MODE {
            ClfsContextNone = 0,
            ClfsContextUndoNext = 1,
            ClfsContextPrevious = 2,
            ClfsContextForward = 3,
        }
        const CLFS_FLAG_FILTER_INTERMEDIATE_LEVEL: i32 = 16;
        const CLFS_FLAG_FILTER_TOP_LEVEL: i32 = 32;
        const CLFS_FLAG_FORCE_APPEND: i32 = 1;
        const CLFS_FLAG_FORCE_FLUSH: i32 = 2;
        const CLFS_FLAG_HIDDEN_SYSTEM_LOG: i32 = 512;
        const CLFS_FLAG_IGNORE_SHARE_ACCESS: i32 = 64;
        const CLFS_FLAG_MINIFILTER_LEVEL: i32 = 256;
        const CLFS_FLAG_NON_REENTRANT_FILTER: i32 = 16;
        const CLFS_FLAG_NO_FLAGS: i32 = 0;
        const CLFS_FLAG_READ_IN_PROGRESS: i32 = 128;
        const CLFS_FLAG_REENTRANT_FILE_SYSTEM: i32 = 8;
        const CLFS_FLAG_REENTRANT_FILTER: i32 = 32;
        const CLFS_FLAG_USE_RESERVATION: i32 = 4;
        type CLFS_INFORMATION = CLS_INFORMATION;
        #[repr(i32)]
        enum CLFS_IOSTATS_CLASS {
            ClfsIoStatsDefault = 0,
            ClfsIoStatsMax = 65535,
        }
        type CLFS_IO_STATISTICS = CLS_IO_STATISTICS;
        type CLFS_IO_STATISTICS_HEADER = CLS_IO_STATISTICS_HEADER;
        #[repr(i32)]
        enum CLFS_LOG_ARCHIVE_MODE {
            ClfsLogArchiveEnabled = 1,
            ClfsLogArchiveDisabled = 2,
        }
        type CLFS_LOG_ID = GUID;
        type CLFS_LOG_INFORMATION_CLASS = CLS_LOG_INFORMATION_CLASS;
        struct CLFS_LOG_NAME_INFORMATION {
            NameLengthInBytes: USHORT,
            Name: [WCHAR; 1],
        }
        type CLFS_LSN = CLS_LSN;
        const CLFS_MARSHALLING_FLAG_DISABLE_BUFF_INIT: i32 = 1;
        const CLFS_MARSHALLING_FLAG_NONE: i32 = 0;
        const CLFS_MAX_CONTAINER_INFO: ULONG = 256;
        struct CLFS_NODE_ID {
            cType: ULONG,
            cbNode: ULONG,
        }
        #[packed(8)]
        struct CLFS_PHYSICAL_LSN_INFORMATION {
            StreamIdentifier: UCHAR,
            VirtualLsn: CLFS_LSN,
            PhysicalLsn: CLFS_LSN,
        }
        type CLFS_RECORD_TYPE = u8;
        const CLFS_SCAN_BACKWARD: UCHAR = 4;
        const CLFS_SCAN_BUFFERED: UCHAR = 32;
        const CLFS_SCAN_CLOSE: UCHAR = 8;
        type CLFS_SCAN_CONTEXT = CLS_SCAN_CONTEXT;
        const CLFS_SCAN_FORWARD: UCHAR = 2;
        const CLFS_SCAN_INIT: UCHAR = 1;
        const CLFS_SCAN_INITIALIZED: UCHAR = 16;
        type CLFS_SCAN_MODE = u8;
        struct CLFS_STREAM_ID_INFORMATION {
            StreamIdentifier: UCHAR,
        }
        type CLFS_WRITE_ENTRY = CLS_WRITE_ENTRY;
        struct CLS_ARCHIVE_DESCRIPTOR {
            coffLow: ULONGLONG,
            coffHigh: ULONGLONG,
            infoContainer: CLS_CONTAINER_INFORMATION,
        }
        struct CLS_CONTAINER_INFORMATION {
            FileAttributes: ULONG,
            CreationTime: ULONGLONG,
            LastAccessTime: ULONGLONG,
            LastWriteTime: ULONGLONG,
            ContainerSize: LONGLONG,
            FileNameActualLength: ULONG,
            FileNameLength: ULONG,
            FileName: [WCHAR; 256],
            State: CLFS_CONTAINER_STATE,
            PhysicalContainerId: CLFS_CONTAINER_ID,
            LogicalContainerId: CLFS_CONTAINER_ID,
        }
        type CLS_CONTAINER_STATE = u32;
        #[repr(i32)]
        enum CLS_CONTEXT_MODE {
            ClsContextNone = 0,
            ClsContextUndoNext = 1,
            ClsContextPrevious = 2,
            ClsContextForward = 3,
        }
        struct CLS_INFORMATION {
            TotalAvailable: LONGLONG,
            CurrentAvailable: LONGLONG,
            TotalReservation: LONGLONG,
            BaseFileSize: ULONGLONG,
            ContainerSize: ULONGLONG,
            TotalContainers: ULONG,
            FreeContainers: ULONG,
            TotalClients: ULONG,
            Attributes: ULONG,
            FlushThreshold: ULONG,
            SectorSize: ULONG,
            MinArchiveTailLsn: CLS_LSN,
            BaseLsn: CLS_LSN,
            LastFlushedLsn: CLS_LSN,
            LastLsn: CLS_LSN,
            RestartLsn: CLS_LSN,
            Identity: GUID,
        }
        #[repr(i32)]
        enum CLS_IOSTATS_CLASS {
            ClsIoStatsDefault = 0,
            ClsIoStatsMax = 65535,
        }
        struct CLS_IO_STATISTICS {
            hdrIoStats: CLS_IO_STATISTICS_HEADER,
            cFlush: ULONGLONG,
            cbFlush: ULONGLONG,
            cMetaFlush: ULONGLONG,
            cbMetaFlush: ULONGLONG,
        }
        struct CLS_IO_STATISTICS_HEADER {
            ubMajorVersion: UCHAR,
            ubMinorVersion: UCHAR,
            eStatsClass: CLFS_IOSTATS_CLASS,
            cbLength: USHORT,
            coffData: ULONG,
        }
        #[repr(i32)]
        enum CLS_LOG_INFORMATION_CLASS {
            ClfsLogBasicInformation = 0,
            ClfsLogBasicInformationPhysical = 1,
            ClfsLogPhysicalNameInformation = 2,
            ClfsLogStreamIdentifierInformation = 3,
            ClfsLogSystemMarkingInformation = 4,
            ClfsLogPhysicalLsnInformation = 5,
        }
        struct CLS_LSN {
            Internal: ULONGLONG,
        }
        type CLS_RECORD_TYPE = u8;
        struct CLS_SCAN_CONTEXT {
            cidNode: CLFS_NODE_ID,
            hLog: HANDLE,
            #[Windows::Win32::Metadata::Alignment(8)]
            cIndex: ULONG,
            #[Windows::Win32::Metadata::Alignment(8)]
            cContainers: ULONG,
            #[Windows::Win32::Metadata::Alignment(8)]
            cContainersReturned: ULONG,
            #[Windows::Win32::Metadata::Alignment(8)]
            eScanMode: CLFS_SCAN_MODE,
            #[Windows::Win32::Metadata::Alignment(8)]
            pinfoContainer: PCLS_CONTAINER_INFORMATION,
        }
        struct CLS_WRITE_ENTRY {
            Buffer: PVOID,
            ByteLength: ULONG,
        }
        const ClfsClientRecord: UCHAR = 3;
        const ClfsContainerActive: CLFS_CONTAINER_STATE = 4;
        const ClfsContainerActivePendingDelete: CLFS_CONTAINER_STATE = 8;
        const ClfsContainerInactive: CLFS_CONTAINER_STATE = 2;
        const ClfsContainerInitializing: CLFS_CONTAINER_STATE = 1;
        const ClfsContainerPendingArchive: CLFS_CONTAINER_STATE = 16;
        const ClfsContainerPendingArchiveAndDelete: CLFS_CONTAINER_STATE = 32;
        const ClfsDataRecord: UCHAR = 1;
        #[library("clfsw32.dll", import = "LsnBlockOffset")]
        extern fn ClfsLsnBlockOffset(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> ULONG;
        #[library("clfsw32.dll", import = "LsnContainer")]
        extern fn ClfsLsnContainer(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> CLFS_CONTAINER_ID;
        #[library("clfsw32.dll", import = "LsnCreate")]
        extern fn ClfsLsnCreate(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cidContainer: CLFS_CONTAINER_ID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] offBlock: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cRecord: ULONG) -> CLFS_LSN;
        #[library("clfsw32.dll", import = "LsnEqual")]
        extern fn ClfsLsnEqual(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn1: *const CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn2: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll", import = "LsnGreater")]
        extern fn ClfsLsnGreater(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn1: *const CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn2: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll", import = "LsnIncrement")]
        extern fn ClfsLsnIncrement(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: PCLFS_LSN) -> CLFS_LSN;
        #[library("clfsw32.dll", import = "LsnInvalid")]
        extern fn ClfsLsnInvalid(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll", import = "LsnLess")]
        extern fn ClfsLsnLess(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn1: *const CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn2: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll", import = "LsnNull")]
        extern fn ClfsLsnNull(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll", import = "LsnRecordSequence")]
        extern fn ClfsLsnRecordSequence(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> ULONG;
        const ClfsNullRecord: UCHAR = 0;
        const ClfsRestartRecord: UCHAR = 2;
        const ClsContainerActive: CLFS_CONTAINER_STATE = 4;
        const ClsContainerActivePendingDelete: CLFS_CONTAINER_STATE = 8;
        const ClsContainerInactive: CLFS_CONTAINER_STATE = 2;
        const ClsContainerInitializing: CLFS_CONTAINER_STATE = 1;
        const ClsContainerPendingArchive: CLFS_CONTAINER_STATE = 16;
        const ClsContainerPendingArchiveAndDelete: CLFS_CONTAINER_STATE = 32;
        #[encoding("ansi")]
        const EA_CONTAINER_NAME: String = "ContainerName";
        #[encoding("ansi")]
        const EA_CONTAINER_SIZE: String = "ContainerSize";
        const FILE_ATTRIBUTE_DEDICATED: i32 = 256;
        #[library("clfsw32.dll")]
        extern fn LsnEqual(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn1: *const CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn2: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll")]
        extern fn LsnGreater(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn1: *const CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn2: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll")]
        extern fn LsnIncrement(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: PCLFS_LSN) -> CLFS_LSN;
        #[library("clfsw32.dll")]
        extern fn LsnInvalid(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll")]
        extern fn LsnLess(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn1: *const CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn2: *const CLFS_LSN) -> BOOLEAN;
        #[library("clfsw32.dll")]
        extern fn LsnNull(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] plsn: *const CLFS_LSN) -> BOOLEAN;
        type PCLFS_ARCHIVE_DESCRIPTOR = *mut CLS_ARCHIVE_DESCRIPTOR;
        type PCLFS_CONTAINER_ID = *mut u32;
        type PCLFS_CONTAINER_INFORMATION = *mut CLS_CONTAINER_INFORMATION;
        type PCLFS_CONTAINER_STATE = *mut u32;
        type PCLFS_CONTEXT_MODE = *mut CLFS_CONTEXT_MODE;
        type PCLFS_INFORMATION = *mut CLS_INFORMATION;
        type PCLFS_IOSTATS_CLASS = *mut CLFS_IOSTATS_CLASS;
        type PCLFS_IO_STATISTICS = *mut CLS_IO_STATISTICS;
        type PCLFS_IO_STATISTICS_HEADER = *mut CLS_IO_STATISTICS_HEADER;
        type PCLFS_LOG_ARCHIVE_MODE = *mut CLFS_LOG_ARCHIVE_MODE;
        type PCLFS_LOG_INFORMATION_CLASS = *mut CLS_LOG_INFORMATION_CLASS;
        type PCLFS_LOG_NAME_INFORMATION = *mut CLFS_LOG_NAME_INFORMATION;
        type PCLFS_LSN = *mut CLS_LSN;
        type PCLFS_NODE_ID = *mut CLFS_NODE_ID;
        type PCLFS_PHYSICAL_LSN_INFORMATION = *mut CLFS_PHYSICAL_LSN_INFORMATION;
        type PCLFS_RECORD_TYPE = *mut u8;
        type PCLFS_SCAN_CONTEXT = *mut CLS_SCAN_CONTEXT;
        type PCLFS_SCAN_MODE = *mut u8;
        type PCLFS_STREAM_ID_INFORMATION = *mut CLFS_STREAM_ID_INFORMATION;
        type PCLFS_WRITE_ENTRY = *mut CLS_WRITE_ENTRY;
        type PCLS_ARCHIVE_DESCRIPTOR = *mut CLS_ARCHIVE_DESCRIPTOR;
        type PCLS_CONTAINER_INFORMATION = *mut CLS_CONTAINER_INFORMATION;
        type PCLS_CONTAINER_STATE = *mut u32;
        type PCLS_CONTEXT_MODE = *mut CLS_CONTEXT_MODE;
        type PCLS_INFORMATION = *mut CLS_INFORMATION;
        type PCLS_IOSTATS_CLASS = *mut CLS_IOSTATS_CLASS;
        type PCLS_IO_STATISTICS = *mut CLS_IO_STATISTICS;
        type PCLS_IO_STATISTICS_HEADER = *mut CLS_IO_STATISTICS_HEADER;
        type PCLS_LOG_INFORMATION_CLASS = *mut CLS_LOG_INFORMATION_CLASS;
        type PCLS_LSN = *mut CLS_LSN;
        type PCLS_RECORD_TYPE = *mut u8;
        type PCLS_SCAN_CONTEXT = *mut CLS_SCAN_CONTEXT;
        type PCLS_WRITE_ENTRY = *mut CLS_WRITE_ENTRY;
        type PFILE = *mut FILE;
        type PPCLFS_ARCHIVE_DESCRIPTOR = *mut *mut CLS_ARCHIVE_DESCRIPTOR;
        type PPCLFS_CONTAINER_ID = *mut *mut u32;
        type PPCLFS_CONTAINER_INFORMATION = *mut *mut CLS_CONTAINER_INFORMATION;
        type PPCLFS_CONTAINER_STATE = *mut u32;
        type PPCLFS_CONTEXT_MODE = *mut *mut CLFS_CONTEXT_MODE;
        type PPCLFS_INFORMATION = *mut CLS_INFORMATION;
        type PPCLFS_IOSTATS_CLASS = *mut *mut CLFS_IOSTATS_CLASS;
