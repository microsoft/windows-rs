#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CreateToolhelp32Snapshot(dwFlags: DWORD, th32ProcessID: DWORD) -> HANDLE;
        struct HEAPENTRY32 {
            dwSize: SIZE_T,
            hHandle: HANDLE,
            dwAddress: ULONG_PTR,
            dwBlockSize: SIZE_T,
            dwFlags: DWORD,
            dwLockCount: DWORD,
            dwResvd: DWORD,
            th32ProcessID: DWORD,
            th32HeapID: ULONG_PTR,
        }
        struct HEAPLIST32 {
            dwSize: SIZE_T,
            th32ProcessID: DWORD,
            th32HeapID: ULONG_PTR,
            dwFlags: DWORD,
        }
        const HF32_DEFAULT: i32 = 1;
        const HF32_SHARED: i32 = 2;
        #[library("KERNEL32.dll")]
        extern fn Heap32First(lphe: LPHEAPENTRY32, th32ProcessID: DWORD, th32HeapID: ULONG_PTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Heap32ListFirst(hSnapshot: HANDLE, lphl: LPHEAPLIST32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Heap32ListNext(hSnapshot: HANDLE, lphl: LPHEAPLIST32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Heap32Next(lphe: LPHEAPENTRY32) -> BOOL;
        const LF32_FIXED: i32 = 1;
        const LF32_FREE: i32 = 2;
        const LF32_MOVEABLE: i32 = 4;
        type LPHEAPENTRY32 = *mut HEAPENTRY32;
        type LPHEAPLIST32 = *mut HEAPLIST32;
        type LPMODULEENTRY32 = *mut MODULEENTRY32;
        type LPMODULEENTRY32W = *mut MODULEENTRY32W;
        type LPPROCESSENTRY32 = *mut PROCESSENTRY32;
        type LPPROCESSENTRY32W = *mut PROCESSENTRY32W;
        type LPTHREADENTRY32 = *mut THREADENTRY32;
        const MAX_MODULE_NAME32: i32 = 255;
        struct MODULEENTRY32 {
            dwSize: DWORD,
            th32ModuleID: DWORD,
            th32ProcessID: DWORD,
            GlblcntUsage: DWORD,
            ProccntUsage: DWORD,
            modBaseAddr: *mut BYTE,
            modBaseSize: DWORD,
            hModule: HMODULE,
            szModule: [i8; 256],
            szExePath: [i8; 260],
        }
        struct MODULEENTRY32W {
            dwSize: DWORD,
            th32ModuleID: DWORD,
            th32ProcessID: DWORD,
            GlblcntUsage: DWORD,
            ProccntUsage: DWORD,
            modBaseAddr: *mut BYTE,
            modBaseSize: DWORD,
            hModule: HMODULE,
            szModule: [WCHAR; 256],
            szExePath: [WCHAR; 260],
        }
        #[library("KERNEL32.dll")]
        extern fn Module32First(hSnapshot: HANDLE, lpme: LPMODULEENTRY32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Module32FirstW(hSnapshot: HANDLE, lpme: LPMODULEENTRY32W) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Module32Next(hSnapshot: HANDLE, lpme: LPMODULEENTRY32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Module32NextW(hSnapshot: HANDLE, lpme: LPMODULEENTRY32W) -> BOOL;
        type PHEAPENTRY32 = *mut HEAPENTRY32;
        type PHEAPLIST32 = *mut HEAPLIST32;
        type PMODULEENTRY32 = *mut MODULEENTRY32;
        type PMODULEENTRY32W = *mut MODULEENTRY32W;
        type PPROCESSENTRY32 = *mut PROCESSENTRY32;
        type PPROCESSENTRY32W = *mut PROCESSENTRY32W;
        struct PROCESSENTRY32 {
            dwSize: DWORD,
            cntUsage: DWORD,
            th32ProcessID: DWORD,
            th32DefaultHeapID: ULONG_PTR,
            th32ModuleID: DWORD,
            cntThreads: DWORD,
            th32ParentProcessID: DWORD,
            pcPriClassBase: LONG,
            dwFlags: DWORD,
            szExeFile: [CHAR; 260],
        }
        struct PROCESSENTRY32W {
            dwSize: DWORD,
            cntUsage: DWORD,
            th32ProcessID: DWORD,
            th32DefaultHeapID: ULONG_PTR,
            th32ModuleID: DWORD,
            cntThreads: DWORD,
            th32ParentProcessID: DWORD,
            pcPriClassBase: LONG,
            dwFlags: DWORD,
            szExeFile: [WCHAR; 260],
        }
        type PTHREADENTRY32 = *mut THREADENTRY32;
        #[library("KERNEL32.dll")]
        extern fn Process32First(hSnapshot: HANDLE, lppe: LPPROCESSENTRY32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Process32FirstW(hSnapshot: HANDLE, lppe: LPPROCESSENTRY32W) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Process32Next(hSnapshot: HANDLE, lppe: LPPROCESSENTRY32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Process32NextW(hSnapshot: HANDLE, lppe: LPPROCESSENTRY32W) -> BOOL;
        const TH32CS_INHERIT: u32 = 2147483648;
        const TH32CS_SNAPALL: i32 = 15;
        const TH32CS_SNAPHEAPLIST: i32 = 1;
        const TH32CS_SNAPMODULE: i32 = 8;
        const TH32CS_SNAPMODULE32: i32 = 16;
        const TH32CS_SNAPPROCESS: i32 = 2;
        const TH32CS_SNAPTHREAD: i32 = 4;
        struct THREADENTRY32 {
            dwSize: DWORD,
            cntUsage: DWORD,
            th32ThreadID: DWORD,
            th32OwnerProcessID: DWORD,
            tpBasePri: LONG,
            tpDeltaPri: LONG,
            dwFlags: DWORD,
        }
        #[library("KERNEL32.dll")]
        extern fn Thread32First(hSnapshot: HANDLE, lpte: LPTHREADENTRY32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Thread32Next(hSnapshot: HANDLE, lpte: LPTHREADENTRY32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Toolhelp32ReadProcessMemory(th32ProcessID: DWORD, lpBaseAddress: LPCVOID, lpBuffer: LPVOID, cbRead: SIZE_T, lpNumberOfBytesRead: *mut SIZE_T) -> BOOL;
    }
}
