#[win32]
mod Windows {
    mod Win32 {
        #[no_guid]
        interface CFunctionDiscoveryNotificationWrapper: IFunctionDiscoveryNotification {}
        const FD_EVENTID: i32 = 1000;
        const FD_EVENTID_ASYNCTHREADEXIT: i32 = 1001;
        const FD_EVENTID_IPADDRESSCHANGE: i32 = 1003;
        const FD_EVENTID_PRIVATE: i32 = 100;
        const FD_EVENTID_QUERYREFRESH: i32 = 1004;
        const FD_EVENTID_SEARCHCOMPLETE: i32 = 1000;
        const FD_EVENTID_SEARCHSTART: i32 = 1002;
    }
}
