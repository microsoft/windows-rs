#[win32]
mod Windows {
    mod Win32 {
        type LPTIMECAPS = *mut TIMECAPS;
        type NPTIMECAPS = *mut TIMECAPS;
        type PTIMECAPS = *mut TIMECAPS;
        #[packed(1)]
        struct TIMECAPS {
            wPeriodMin: UINT,
            wPeriodMax: UINT,
        }
        const TIMERR_NOCANDO: i32 = 97;
        const TIMERR_NOERROR: i32 = 0;
        const TIMERR_STRUCT: i32 = 129;
        #[library("WINMM.dll")]
        extern fn timeBeginPeriod(#[in] uPeriod: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeEndPeriod(#[in] uPeriod: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeGetDevCaps(#[buffer(bytes(cbtc))] #[out] ptc: LPTIMECAPS, #[in] cbtc: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeGetSystemTime(#[buffer(bytes(cbmmt))] #[out] pmmt: LPMMTIME, #[in] cbmmt: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeGetTime() -> DWORD;
    }
}
