#[win32]
mod Windows {
    mod Win32 {
        type LPTIMECAPS = *mut TIMECAPS;
        type NPTIMECAPS = *mut TIMECAPS;
        type PTIMECAPS = *mut TIMECAPS;
        #[packed(1)]
        struct TIMECAPS {
            wPeriodMin: UINT,
            wPeriodMax: UINT,
        }
        const TIMERR_NOCANDO: i32 = 97;
        const TIMERR_NOERROR: i32 = 0;
        const TIMERR_STRUCT: i32 = 129;
        #[library("WINMM.dll")]
        extern fn timeBeginPeriod(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] uPeriod: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeEndPeriod(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] uPeriod: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeGetDevCaps(#[out] #[size_param(1)] ptc: LPTIMECAPS, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cbtc: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeGetSystemTime(#[out] #[size_param(1)] pmmt: LPMMTIME, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cbmmt: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeGetTime() -> DWORD;
    }
}
