#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CompareStringEx(#[in] #[opt] lpLocaleName: LPCWSTR, #[in] dwCmpFlags: DWORD, #[incomplete] lpString1: LPCWCH, #[in] cchCount1: i32, #[incomplete] lpString2: LPCWCH, #[in] cchCount2: i32, #[reserved] lpVersionInformation: LPNLSVERSIONINFO, #[reserved] lpReserved: LPVOID, #[reserved] lParam: LPARAM) -> i32;
        #[library("KERNEL32.dll")]
        extern fn CompareStringOrdinal(#[incomplete] lpString1: LPCWCH, #[in] cchCount1: i32, #[incomplete] lpString2: LPCWCH, #[in] cchCount2: i32, #[in] bIgnoreCase: BOOL) -> i32;
        #[library("KERNEL32.dll")]
        extern fn CompareStringW(#[in] Locale: LCID, #[in] dwCmpFlags: DWORD, #[incomplete] lpString1: PCNZWCH, #[in] cchCount1: i32, #[incomplete] lpString2: PCNZWCH, #[in] cchCount2: i32) -> i32;
        #[library("KERNEL32.dll")]
        extern fn FoldStringW(#[in] dwMapFlags: DWORD, #[incomplete] lpSrcStr: LPCWCH, #[in] cchSrc: i32, #[buffer(cchDest)] #[opt] #[out] lpDestStr: LPWSTR, #[in] cchDest: i32) -> i32;
        #[library("KERNEL32.dll")]
        extern fn GetStringTypeExW(#[in] Locale: LCID, #[in] dwInfoType: DWORD, #[incomplete] lpSrcStr: LPCWCH, #[in] cchSrc: i32, #[buffer(cchSrc)] #[out] lpCharType: LPWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetStringTypeW(#[in] dwInfoType: DWORD, #[incomplete] lpSrcStr: LPCWCH, #[in] cchSrc: i32, #[out] lpCharType: LPWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn MultiByteToWideChar(#[in] CodePage: UINT, #[in] dwFlags: DWORD, #[incomplete] lpMultiByteStr: LPCCH, #[in] cbMultiByte: i32, #[buffer(cchWideChar)] #[incomplete] #[opt] #[out] lpWideCharStr: LPWSTR, #[in] cchWideChar: i32) -> i32;
        #[library("KERNEL32.dll")]
        extern fn WideCharToMultiByte(#[in] CodePage: UINT, #[in] dwFlags: DWORD, #[incomplete] lpWideCharStr: LPCWCH, #[in] cchWideChar: i32, #[buffer(bytes(cbMultiByte))] #[incomplete] #[opt] #[out] lpMultiByteStr: LPSTR, #[in] cbMultiByte: i32, #[in] #[opt] lpDefaultChar: LPCCH, #[opt] #[out] lpUsedDefaultChar: LPBOOL) -> i32;
    }
}
