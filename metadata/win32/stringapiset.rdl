#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CompareStringEx(#[opt] lpLocaleName: PCWSTR, dwCmpFlags: u32, lpString1: LPCWCH, cchCount1: i32, lpString2: LPCWCH, cchCount2: i32, #[reserved] lpVersionInformation: LPNLSVERSIONINFO, #[reserved] lpReserved: *mut void, #[reserved] lParam: LPARAM) -> i32;
        #[library("KERNEL32.dll")]
        extern fn CompareStringOrdinal(lpString1: LPCWCH, cchCount1: i32, lpString2: LPCWCH, cchCount2: i32, bIgnoreCase: BOOL) -> i32;
        #[library("KERNEL32.dll")]
        extern fn CompareStringW(Locale: LCID, dwCmpFlags: u32, lpString1: PCNZWCH, cchCount1: i32, lpString2: PCNZWCH, cchCount2: i32) -> i32;
        #[library("KERNEL32.dll")]
        extern fn FoldStringW(dwMapFlags: u32, lpSrcStr: LPCWCH, cchSrc: i32, #[len_param(4)] #[out] #[opt] lpDestStr: PWSTR, cchDest: i32) -> i32;
        #[library("KERNEL32.dll")]
        extern fn GetStringTypeExW(Locale: LCID, dwInfoType: u32, lpSrcStr: LPCWCH, cchSrc: i32, #[len_param(3)] #[out] lpCharType: LPWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetStringTypeW(dwInfoType: u32, lpSrcStr: LPCWCH, cchSrc: i32, #[out] lpCharType: LPWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn MultiByteToWideChar(CodePage: u32, dwFlags: u32, lpMultiByteStr: LPCCH, cbMultiByte: i32, #[len_param(5)] #[out] #[opt] lpWideCharStr: PWSTR, cchWideChar: i32) -> i32;
        #[library("KERNEL32.dll")]
        extern fn WideCharToMultiByte(CodePage: u32, dwFlags: u32, lpWideCharStr: LPCWCH, cchWideChar: i32, #[size_param(5)] #[out] #[opt] lpMultiByteStr: PSTR, cbMultiByte: i32, #[opt] lpDefaultChar: LPCCH, #[out] #[opt] lpUsedDefaultChar: LPBOOL) -> i32;
    }
}
