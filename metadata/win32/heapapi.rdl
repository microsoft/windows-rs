#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn GetProcessHeap() -> HANDLE;
        #[library("KERNEL32.dll")]
        extern fn GetProcessHeaps(#[in] NumberOfHeaps: DWORD, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_to_", "NumberOfHeaps,return", "NumberOfHeaps,return")] #[out] #[writable(entry, NumberOfHeaps)] ProcessHeaps: PHANDLE) -> DWORD;
        struct HEAP_SUMMARY {
            cb: DWORD,
            cbAllocated: SIZE_T,
            cbCommitted: SIZE_T,
            cbReserved: SIZE_T,
            cbMaxReserve: SIZE_T,
        }
        #[Windows::Win32::Metadata::NativeSal("2", "_Post_writable_byte_size_", "dwBytes", "dwBytes")]
        #[library("KERNEL32.dll")]
        extern fn HeapAlloc(#[in] hHeap: HANDLE, #[in] dwFlags: DWORD, #[in] dwBytes: SIZE_T) -> #[nullable] LPVOID;
        #[library("KERNEL32.dll")]
        extern fn HeapCompact(#[in] hHeap: HANDLE, #[in] dwFlags: DWORD) -> SIZE_T;
        #[library("KERNEL32.dll")]
        extern fn HeapCreate(#[in] flOptions: DWORD, #[in] dwInitialSize: SIZE_T, #[in] dwMaximumSize: SIZE_T) -> #[nullable] HANDLE;
        #[library("KERNEL32.dll")]
        extern fn HeapDestroy(#[in] hHeap: HANDLE) -> BOOL;
        #[success(return != 0)]
        #[library("KERNEL32.dll")]
        extern fn HeapFree(#[in] #[out] hHeap: HANDLE, #[in] dwFlags: DWORD, #[Windows::Win32::Metadata::NativeSal("L", "_Frees_ptr_opt_", "", "")] #[Windows::Win32::Metadata::NativeSal("L", "__drv_freesMem", "Mem", "Mem")] lpMem: LPVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn HeapLock(#[in] hHeap: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn HeapQueryInformation(#[in] #[opt] HeapHandle: HANDLE, #[in] HeapInformationClass: HEAP_INFORMATION_CLASS, #[out] #[opt] #[writable(entry, bytes(HeapInformationLength))] #[readable(success, bytes(if_present(*ReturnLength)))] HeapInformation: PVOID, #[in] HeapInformationLength: SIZE_T, #[out] #[opt] ReturnLength: PSIZE_T) -> BOOL;
        #[Windows::Win32::Metadata::NativeSal("2", "_Post_writable_byte_size_", "dwBytes", "dwBytes")]
        #[success(return != 0)]
        #[library("KERNEL32.dll")]
        extern fn HeapReAlloc(#[in] #[out] hHeap: HANDLE, #[in] dwFlags: DWORD, #[Windows::Win32::Metadata::NativeSal("L", "_Frees_ptr_opt_", "", "")] lpMem: LPVOID, #[in] dwBytes: SIZE_T) -> #[nullable] LPVOID;
        #[library("KERNEL32.dll")]
        extern fn HeapSetInformation(#[in] #[opt] HeapHandle: HANDLE, #[in] HeapInformationClass: HEAP_INFORMATION_CLASS, #[in] #[opt] #[readable(entry, bytes(HeapInformationLength))] HeapInformation: PVOID, #[in] HeapInformationLength: SIZE_T) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn HeapSize(#[in] hHeap: HANDLE, #[in] dwFlags: DWORD, #[in] lpMem: LPCVOID) -> SIZE_T;
        #[library("KERNEL32.dll")]
        extern fn HeapSummary(#[in] hHeap: HANDLE, #[in] dwFlags: DWORD, #[out] lpSummary: LPHEAP_SUMMARY) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn HeapUnlock(#[in] hHeap: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn HeapValidate(#[in] hHeap: HANDLE, #[in] dwFlags: DWORD, #[in] #[opt] lpMem: LPCVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn HeapWalk(#[in] hHeap: HANDLE, #[in] #[out] lpEntry: LPPROCESS_HEAP_ENTRY) -> BOOL;
        type LPHEAP_SUMMARY = *mut HEAP_SUMMARY;
        type PHEAP_SUMMARY = *mut HEAP_SUMMARY;
    }
}
