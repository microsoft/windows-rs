        extern fn WerUnregisterRuntimeExceptionModule(#[in] pwszOutOfProcessCallbackDll: PCWSTR, #[in] pContext: PVOID) -> HRESULT;
        struct _WER_REPORT_PARAMETER {
            Name: [WCHAR; 129],
            Value: [WCHAR; 260],
        }
    }
}
