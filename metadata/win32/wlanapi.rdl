        extern fn WlanSetSecuritySettings(#[in] hClientHandle: HANDLE, #[in] SecurableObject: WLAN_SECURABLE_OBJECT, #[in] strModifiedSDDL: LPCWSTR) -> DWORD;
        #[library("wlanui.dll")]
        extern fn WlanUIEditProfile(#[in] dwClientVersion: DWORD, #[in] wstrProfileName: LPCWSTR, #[in] pInterfaceGuid: *mut GUID, #[in] hWnd: HWND, #[in] wlStartPage: WL_DISPLAY_PAGES, #[reserved] pReserved: PVOID, #[opt] #[out] pWlanReasonCode: PWLAN_REASON_CODE) -> DWORD;
    }
}
