        extern fn ValidateLog(pszLogFileName: PCWSTR, #[opt] psaLogFile: *const SECURITY_ATTRIBUTES, #[opt] pinfoBuffer: *mut CLFS_INFORMATION, #[in] #[out] pcbBuffer: *mut u32) -> BOOL;
        #[library("clfsw32.dll")]
        extern fn WriteLogRestartArea(#[in] #[out] pvMarshal: *mut void, pvRestartBuffer: *const void, cbRestartBuffer: u32, #[opt] plsnBase: *const CLFS_LSN, fFlags: u32, #[opt] pcbWritten: *mut u32, #[opt] plsnNext: *mut CLFS_LSN, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
