        extern fn GetLogContainerName(hLog: HANDLE, cidLogicalContainer: CLFS_CONTAINER_ID, #[in] #[out] pwstrContainerName: PWSTR, cLenContainerName: u32, #[in] #[out] #[opt] pcActualLenContainerName: *mut u32) -> BOOL;
