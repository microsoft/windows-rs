        extern fn CreateLogFile(pszLogFileName: PCWSTR, fDesiredAccess: ACCESS_MASK, dwShareMode: u32, #[opt] psaLogFile: *const SECURITY_ATTRIBUTES, fCreateDisposition: u32, fFlagsAndAttributes: u32) -> HANDLE;
        #[library("clfsw32.dll")]
        extern fn CreateLogMarshallingArea(hLog: HANDLE, #[opt] pfnAllocBuffer: CLFS_BLOCK_ALLOCATION, #[opt] pfnFreeBuffer: CLFS_BLOCK_DEALLOCATION, #[opt] pvBlockAllocContext: *const void, cbMarshallingBuffer: u32, cMaxWriteBuffers: u32, cMaxReadBuffers: u32, ppvMarshal: *mut *mut void) -> BOOL;
