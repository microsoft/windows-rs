        extern fn ReadNextLogRecord(#[in] #[out] pvReadContext: *mut void, ppvBuffer: *mut *mut void, pcbBuffer: *mut u32, #[in] #[out] peRecordType: *mut CLS_RECORD_TYPE, #[opt] plsnUser: *const CLFS_LSN, plsnUndoNext: *mut CLFS_LSN, plsnPrevious: *mut CLFS_LSN, plsnRecord: *mut CLFS_LSN, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
        #[library("clfsw32.dll")]
        extern fn ReadPreviousLogRestartArea(pvReadContext: *const void, ppvRestartBuffer: *mut *mut void, pcbRestartBuffer: *mut u32, plsnRestart: *mut CLFS_LSN, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
        #[library("clfsw32.dll")]
        extern fn RemoveLogContainer(hLog: HANDLE, pwszContainerPath: PCWSTR, fForce: BOOL, #[in] #[out] #[opt] pReserved: *mut void) -> BOOL;
