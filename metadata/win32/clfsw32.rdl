        extern fn FlushLogToLsn(pvMarshalContext: *const void, plsnFlush: *const CLFS_LSN, #[opt] plsnLastFlushed: *mut CLFS_LSN, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
