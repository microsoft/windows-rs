        extern fn RemoveLogContainerSet(hLog: HANDLE, cContainer: u16, #[len_param(1)] rgwszContainerPath: *const PWSTR, fForce: BOOL, #[in] #[out] #[opt] pReserved: *mut void) -> BOOL;
        #[library("clfsw32.dll")]
        extern fn ReserveAndAppendLog(pvMarshal: *const void, #[opt] rgWriteEntries: *const CLFS_WRITE_ENTRY, cWriteEntries: u32, #[opt] plsnUndoNext: *const CLFS_LSN, #[opt] plsnPrevious: *const CLFS_LSN, cReserveRecords: u32, #[in] #[out] #[opt] rgcbReservation: *mut i64, fFlags: u32, #[opt] plsn: *mut CLFS_LSN, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
        #[library("clfsw32.dll")]
        extern fn ReserveAndAppendLogAligned(pvMarshal: *const void, #[opt] rgWriteEntries: *const CLFS_WRITE_ENTRY, cWriteEntries: u32, cbEntryAlignment: u32, #[opt] plsnUndoNext: *const CLFS_LSN, #[opt] plsnPrevious: *const CLFS_LSN, cReserveRecords: u32, #[in] #[out] #[opt] rgcbReservation: *mut i64, fFlags: u32, #[opt] plsn: *mut CLFS_LSN, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
