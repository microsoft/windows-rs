        extern fn ReadLogArchiveMetadata(pvArchiveContext: CLFS_LOG_ARCHIVE_CONTEXT, cbOffset: u32, cbBytesToRead: u32, #[in] #[out] pbReadBuffer: *mut u8, pcbBytesRead: *mut u32) -> BOOL;
        #[library("clfsw32.dll")]
        extern fn ReadLogRecord(pvMarshal: *const void, plsnFirst: *const CLFS_LSN, eContextMode: CLFS_CONTEXT_MODE, ppvReadBuffer: *mut *mut void, pcbReadBuffer: *mut u32, peRecordType: *mut CLS_RECORD_TYPE, plsnUndoNext: *mut CLFS_LSN, plsnPrevious: *mut CLFS_LSN, ppvReadContext: *mut *mut void, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
