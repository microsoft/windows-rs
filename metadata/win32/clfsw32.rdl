        extern fn AdvanceLogBase(#[in] #[out] pvMarshal: *mut void, plsnBase: *const CLFS_LSN, fFlags: u32, #[in] #[out] #[opt] pOverlapped: *mut OVERLAPPED) -> BOOL;
