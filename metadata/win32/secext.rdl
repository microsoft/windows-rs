#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum EXTENDED_NAME_FORMAT {
            NameUnknown = 0,
            NameFullyQualifiedDN = 1,
            NameSamCompatible = 2,
            NameDisplay = 3,
            NameUniqueId = 6,
            NameCanonical = 7,
            NameUserPrincipal = 8,
            NameCanonicalEx = 9,
            NameServicePrincipal = 10,
            NameDnsDomain = 12,
            NameGivenName = 13,
            NameSurname = 14,
        }
        #[library("Secur32.dll")]
        extern fn GetComputerObjectNameA(#[in] NameFormat: EXTENDED_NAME_FORMAT, #[opt] #[out] #[readable(success, *nSize)] #[writable(entry, *nSize)] lpNameBuffer: LPSTR, #[in] #[out] nSize: PULONG) -> BOOLEAN;
        #[library("Secur32.dll")]
        extern fn GetComputerObjectNameW(#[in] NameFormat: EXTENDED_NAME_FORMAT, #[opt] #[out] #[readable(success, *nSize)] #[writable(entry, *nSize)] lpNameBuffer: LPWSTR, #[in] #[out] nSize: PULONG) -> BOOLEAN;
        #[library("Secur32.dll")]
        extern fn GetUserNameExA(#[in] NameFormat: EXTENDED_NAME_FORMAT, #[opt] #[out] #[readable(success, *nSize)] #[writable(entry, *nSize)] lpNameBuffer: LPSTR, #[in] #[out] nSize: PULONG) -> BOOLEAN;
        #[library("Secur32.dll")]
        extern fn GetUserNameExW(#[in] NameFormat: EXTENDED_NAME_FORMAT, #[opt] #[out] #[readable(success, *nSize)] #[writable(entry, *nSize)] lpNameBuffer: LPWSTR, #[in] #[out] nSize: PULONG) -> BOOLEAN;
        type PEXTENDED_NAME_FORMAT = *mut EXTENDED_NAME_FORMAT;
        #[library("Secur32.dll")]
        extern fn TranslateNameA(#[in] lpAccountName: LPCSTR, #[in] AccountNameFormat: EXTENDED_NAME_FORMAT, #[in] DesiredNameFormat: EXTENDED_NAME_FORMAT, #[opt] #[out] #[readable(success, *nSize)] #[writable(entry, *nSize)] lpTranslatedName: LPSTR, #[in] #[out] nSize: PULONG) -> BOOLEAN;
        #[library("Secur32.dll")]
        extern fn TranslateNameW(#[in] lpAccountName: LPCWSTR, #[in] AccountNameFormat: EXTENDED_NAME_FORMAT, #[in] DesiredNameFormat: EXTENDED_NAME_FORMAT, #[opt] #[out] #[readable(success, *nSize)] #[writable(entry, *nSize)] lpTranslatedName: LPWSTR, #[in] #[out] nSize: PULONG) -> BOOLEAN;
    }
}
