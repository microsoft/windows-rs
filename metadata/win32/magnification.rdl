#[win32]
mod Windows {
    mod Win32 {
        struct MAGCOLOREFFECT {
            transform: [[f32; 5]; 5],
        }
        struct MAGIMAGEHEADER {
            width: UINT,
            height: UINT,
            format: WICPixelFormatGUID,
            stride: UINT,
            offset: UINT,
            cbSize: SIZE_T,
        }
        struct MAGTRANSFORM {
            v: [[f32; 3]; 3],
        }
        const MS_CLIPAROUNDCURSOR: i32 = 2;
        const MS_INVERTCOLORS: i32 = 4;
        const MS_SHOWMAGNIFIEDCURSOR: i32 = 1;
        const MW_FILTERMODE_EXCLUDE: i32 = 0;
        const MW_FILTERMODE_INCLUDE: i32 = 1;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetColorEffect(hwnd: HWND, pEffect: PMAGCOLOREFFECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetFullscreenColorEffect(#[out] pEffect: PMAGCOLOREFFECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetFullscreenTransform(#[out] pMagLevel: *mut f32, #[out] pxOffset: *mut i32, #[out] pyOffset: *mut i32) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetImageScalingCallback(hwnd: HWND) -> MagImageScalingCallback;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetInputTransform(#[out] pfEnabled: *mut BOOL, #[out] pRectSource: LPRECT, #[out] pRectDest: LPRECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetWindowFilterList(hwnd: HWND, pdwFilterMode: *mut DWORD, count: i32, pHWND: *mut HWND) -> i32;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetWindowSource(hwnd: HWND, pRect: *mut RECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagGetWindowTransform(hwnd: HWND, pTransform: PMAGTRANSFORM) -> BOOL;
        extern fn MagImageScalingCallback(hwnd: HWND, srcdata: *mut void, srcheader: MAGIMAGEHEADER, destdata: *mut void, destheader: MAGIMAGEHEADER, unclipped: RECT, clipped: RECT, dirty: HRGN) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagInitialize() -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetColorEffect(hwnd: HWND, pEffect: PMAGCOLOREFFECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetFullscreenColorEffect(#[in] pEffect: PMAGCOLOREFFECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetFullscreenTransform(#[in] magLevel: f32, #[in] xOffset: i32, #[in] yOffset: i32) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetImageScalingCallback(hwnd: HWND, callback: MagImageScalingCallback) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetInputTransform(#[in] fEnabled: BOOL, #[in] pRectSource: LPRECT, #[in] pRectDest: LPRECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetWindowFilterList(hwnd: HWND, dwFilterMode: DWORD, count: i32, pHWND: *mut HWND) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetWindowSource(hwnd: HWND, rect: RECT) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagSetWindowTransform(hwnd: HWND, pTransform: PMAGTRANSFORM) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagShowSystemCursor(#[in] fShowCursor: BOOL) -> BOOL;
        #[library("MAGNIFICATION.dll")]
        extern fn MagUninitialize() -> BOOL;
        type PMAGCOLOREFFECT = *mut MAGCOLOREFFECT;
        type PMAGIMAGEHEADER = *mut MAGIMAGEHEADER;
        type PMAGTRANSFORM = *mut MAGTRANSFORM;
        #[encoding("ansi")]
        const WC_MAGNIFIER: String = "Magnifier";
        #[encoding("ansi")]
        const WC_MAGNIFIERA: String = "Magnifier";
        #[encoding("utf-16")]
        const WC_MAGNIFIERW: String = "Magnifier";
    }
}
