#[win32]
mod Windows {
    mod Win32 {
        #[library("ADVAPI32.dll")]
        extern fn ConvertSecurityDescriptorToStringSecurityDescriptorA(SecurityDescriptor: PSECURITY_DESCRIPTOR, RequestedStringSDRevision: u32, SecurityInformation: SECURITY_INFORMATION, StringSecurityDescriptor: *mut PSTR, #[out] #[opt] StringSecurityDescriptorLen: PULONG) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertSecurityDescriptorToStringSecurityDescriptorW(SecurityDescriptor: PSECURITY_DESCRIPTOR, RequestedStringSDRevision: u32, SecurityInformation: SECURITY_INFORMATION, StringSecurityDescriptor: *mut PWSTR, #[out] #[opt] StringSecurityDescriptorLen: PULONG) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertSidToStringSidA(Sid: PSID, StringSid: *mut PSTR) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertSidToStringSidW(Sid: PSID, StringSid: *mut PWSTR) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertStringSecurityDescriptorToSecurityDescriptorA(StringSecurityDescriptor: PCSTR, StringSDRevision: u32, SecurityDescriptor: *mut PSECURITY_DESCRIPTOR, #[out] #[opt] SecurityDescriptorSize: PULONG) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertStringSecurityDescriptorToSecurityDescriptorW(StringSecurityDescriptor: PCWSTR, StringSDRevision: u32, SecurityDescriptor: *mut PSECURITY_DESCRIPTOR, #[out] #[opt] SecurityDescriptorSize: PULONG) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertStringSidToSidA(StringSid: PCSTR, Sid: *mut PSID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ConvertStringSidToSidW(StringSid: PCWSTR, Sid: *mut PSID) -> BOOL;
        const SDDL_ACE_BEGINC: i8 = 40;
        const SDDL_ACE_COND_BEGINC: i8 = 40;
        const SDDL_ACE_COND_BLOB_PREFIXC: i8 = 35;
        const SDDL_ACE_COND_COMPOSITEVALUE_BEGINC: i8 = 123;
        const SDDL_ACE_COND_COMPOSITEVALUE_ENDC: i8 = 125;
        const SDDL_ACE_COND_COMPOSITEVALUE_SEPERATORC: i8 = 44;
        const SDDL_ACE_COND_ENDC: i8 = 41;
        const SDDL_ACE_COND_SID_BEGINC: i8 = 40;
        const SDDL_ACE_COND_SID_ENDC: i8 = 41;
        const SDDL_ACE_COND_STRING_BEGINC: i8 = 34;
        const SDDL_ACE_COND_STRING_ENDC: i8 = 34;
        const SDDL_ACE_ENDC: i8 = 41;
        const SDDL_ALIAS_SIZE: i32 = 2;
        const SDDL_DELIMINATORC: i8 = 58;
        const SDDL_REVISION: i32 = 1;
        const SDDL_REVISION_1: i32 = 1;
        const SDDL_SEPERATORC: i8 = 59;
        const SDDL_SPACEC: i8 = 32;
    }
}
