#[win32]
mod Windows {
    mod Win32 {
        struct ACTION_HEADER {
            transport_id: ULONG,
            action_code: USHORT,
            reserved: USHORT,
        }
        struct ADAPTER_STATUS {
            adapter_address: [UCHAR; 6],
            rev_major: UCHAR,
            reserved0: UCHAR,
            adapter_type: UCHAR,
            rev_minor: UCHAR,
            duration: WORD,
            frmr_recv: WORD,
            frmr_xmit: WORD,
            iframe_recv_err: WORD,
            xmit_aborts: WORD,
            xmit_success: DWORD,
            recv_success: DWORD,
            iframe_xmit_err: WORD,
            recv_buff_unavail: WORD,
            t1_timeouts: WORD,
            ti_timeouts: WORD,
            reserved1: DWORD,
            free_ncbs: WORD,
            max_cfg_ncbs: WORD,
            max_ncbs: WORD,
            xmit_buf_unavail: WORD,
            max_dgram_size: WORD,
            pending_sess: WORD,
            max_cfg_sess: WORD,
            max_sess: WORD,
            max_sess_pkt_size: WORD,
            name_count: WORD,
        }
        #[encoding("ansi")]
        const ALL_TRANSPORTS: String = "M\0\0\0";
        const ASYNCH: i32 = 128;
        const CALL_PENDING: i32 = 2;
        const DEREGISTERED: i32 = 5;
        const DUPLICATE: i32 = 6;
        const DUPLICATE_DEREG: i32 = 7;
        struct FIND_NAME_BUFFER {
            length: UCHAR,
            access_control: UCHAR,
            frame_control: UCHAR,
            destination_addr: [UCHAR; 6],
            source_addr: [UCHAR; 6],
            routing_info: [UCHAR; 18],
        }
        struct FIND_NAME_HEADER {
            node_count: WORD,
            reserved: UCHAR,
            unique_group: UCHAR,
        }
        const GROUP_NAME: i32 = 128;
        const HANGUP_COMPLETE: i32 = 5;
        const HANGUP_PENDING: i32 = 4;
        struct LANA_ENUM {
            length: UCHAR,
            lana: [UCHAR; 255],
        }
        const LISTEN_OUTSTANDING: i32 = 1;
        const MAX_LANA: i32 = 254;
        #[encoding("ansi")]
        const MS_NBF: String = "MNBF";
        struct NAME_BUFFER {
            name: [UCHAR; 16],
            name_num: UCHAR,
            name_flags: UCHAR,
        }
        const NAME_FLAGS_MASK: i32 = 135;
        #[arch(X64 | Arm64)]
        struct NCB {
            ncb_command: UCHAR,
            ncb_retcode: UCHAR,
            ncb_lsn: UCHAR,
            ncb_num: UCHAR,
            ncb_buffer: PUCHAR,
            ncb_length: WORD,
            ncb_callname: [UCHAR; 16],
            ncb_name: [UCHAR; 16],
            ncb_rto: UCHAR,
            ncb_sto: UCHAR,
            ncb_post: extern fn(*mut NCB),
            ncb_lana_num: UCHAR,
            ncb_cmd_cplt: UCHAR,
            ncb_reserve: [UCHAR; 18],
            ncb_event: HANDLE,
        }
        #[arch(X86)]
        struct NCB {
            ncb_command: UCHAR,
            ncb_retcode: UCHAR,
            ncb_lsn: UCHAR,
            ncb_num: UCHAR,
            ncb_buffer: PUCHAR,
            ncb_length: WORD,
            ncb_callname: [UCHAR; 16],
            ncb_name: [UCHAR; 16],
            ncb_rto: UCHAR,
            ncb_sto: UCHAR,
            ncb_post: extern fn(*mut NCB),
            ncb_lana_num: UCHAR,
            ncb_cmd_cplt: UCHAR,
            ncb_reserve: [UCHAR; 10],
            ncb_event: HANDLE,
        }
        const NCBACTION: i32 = 119;
        const NCBADDGRNAME: i32 = 54;
        const NCBADDNAME: i32 = 48;
        const NCBASTAT: i32 = 51;
        const NCBCALL: i32 = 16;
        const NCBCANCEL: i32 = 53;
        const NCBCHAINSEND: i32 = 23;
        const NCBCHAINSENDNA: i32 = 114;
        const NCBDELNAME: i32 = 49;
        const NCBDGRECV: i32 = 33;
        const NCBDGRECVBC: i32 = 35;
        const NCBDGSEND: i32 = 32;
        const NCBDGSENDBC: i32 = 34;
        const NCBENUM: i32 = 55;
        const NCBFINDNAME: i32 = 120;
        const NCBHANGUP: i32 = 18;
        const NCBLANSTALERT: i32 = 115;
        const NCBLISTEN: i32 = 17;
        const NCBNAMSZ: i32 = 16;
        const NCBRECV: i32 = 21;
        const NCBRECVANY: i32 = 22;
        const NCBRESET: i32 = 50;
        const NCBSEND: i32 = 20;
        const NCBSENDNA: i32 = 113;
        const NCBSSTAT: i32 = 52;
        const NCBTRACE: i32 = 121;
        const NCBUNLINK: i32 = 112;
        const NRC_ACTSES: i32 = 15;
        const NRC_BADDR: i32 = 7;
        const NRC_BRIDGE: i32 = 35;
        const NRC_BUFLEN: i32 = 1;
        const NRC_CANCEL: i32 = 38;
        const NRC_CANOCCR: i32 = 36;
        const NRC_CMDCAN: i32 = 11;
        const NRC_CMDTMO: i32 = 5;
        const NRC_DUPENV: i32 = 48;
        const NRC_DUPNAME: i32 = 13;
        const NRC_ENVNOTDEF: i32 = 52;
        const NRC_GOODRET: i32 = 0;
        const NRC_IFBUSY: i32 = 33;
        const NRC_ILLCMD: i32 = 3;
        const NRC_ILLNN: i32 = 19;
        const NRC_INCOMP: i32 = 6;
        const NRC_INUSE: i32 = 22;
        const NRC_INVADDRESS: i32 = 57;
        const NRC_INVDDID: i32 = 59;
        const NRC_LOCKFAIL: i32 = 60;
        const NRC_LOCTFUL: i32 = 17;
        const NRC_MAXAPPS: i32 = 54;
        const NRC_NAMCONF: i32 = 25;
        const NRC_NAMERR: i32 = 23;
        const NRC_NAMTFUL: i32 = 14;
        const NRC_NOCALL: i32 = 20;
        const NRC_NORES: i32 = 9;
        const NRC_NORESOURCES: i32 = 56;
        const NRC_NOSAPS: i32 = 55;
        const NRC_NOWILD: i32 = 21;
        const NRC_OPENERR: i32 = 63;
        const NRC_OSRESNOTAV: i32 = 53;
        const NRC_PENDING: i32 = 255;
        const NRC_REMTFUL: i32 = 18;
        const NRC_SABORT: i32 = 24;
        const NRC_SCLOSED: i32 = 10;
        const NRC_SNUMOUT: i32 = 8;
        const NRC_SYSTEM: i32 = 64;
        const NRC_TOOMANY: i32 = 34;
        #[library("NETAPI32.dll")]
        extern fn Netbios(pncb: PNCB) -> UCHAR;
        type PACTION_HEADER = *mut ACTION_HEADER;
        type PADAPTER_STATUS = *mut ADAPTER_STATUS;
        type PFIND_NAME_BUFFER = *mut FIND_NAME_BUFFER;
        type PFIND_NAME_HEADER = *mut FIND_NAME_HEADER;
        type PLANA_ENUM = *mut LANA_ENUM;
        type PNAME_BUFFER = *mut NAME_BUFFER;
        type PNCB = *mut NCB;
        type PSESSION_BUFFER = *mut SESSION_BUFFER;
        type PSESSION_HEADER = *mut SESSION_HEADER;
        const REGISTERED: i32 = 4;
        const REGISTERING: i32 = 0;
        const SESSION_ABORTED: i32 = 6;
        struct SESSION_BUFFER {
            lsn: UCHAR,
            state: UCHAR,
            local_name: [UCHAR; 16],
            remote_name: [UCHAR; 16],
            rcvs_outstanding: UCHAR,
            sends_outstanding: UCHAR,
        }
        const SESSION_ESTABLISHED: i32 = 3;
        struct SESSION_HEADER {
            sess_name: UCHAR,
            num_sess: UCHAR,
            rcv_dg_outstanding: UCHAR,
            rcv_any_outstanding: UCHAR,
        }
        const UNIQUE_NAME: i32 = 0;
    }
}
