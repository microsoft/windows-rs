        type LPHSE_VERSION_INFO = *mut HSE_VERSION_INFO;
        extern fn PFN_GETEXTENSIONVERSION(pVer: *mut HSE_VERSION_INFO) -> BOOL;
        extern fn PFN_HSE_CACHE_INVALIDATION_CALLBACK(pszUrl: *mut WCHAR) -> HRESULT;
        extern fn PFN_HSE_GET_PROTOCOL_MANAGER_CUSTOM_INTERFACE_CALLBACK(pszProtocolManagerDll: LPCWSTR, pszProtocolManagerDllInitFunction: LPCWSTR, dwCustomInterfaceId: DWORD, ppCustomInterface: *mut PVOID) -> HRESULT;
        extern fn PFN_HSE_IO_COMPLETION(pECB: *mut EXTENSION_CONTROL_BLOCK, pContext: PVOID, cbIO: DWORD, dwError: DWORD);
        extern fn PFN_HTTPEXTENSIONPROC(pECB: *mut EXTENSION_CONTROL_BLOCK) -> DWORD;
