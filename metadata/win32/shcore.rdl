#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum BSOS_OPTIONS {
            BSOS_DEFAULT = 0,
            BSOS_PREFERDESTINATIONSTREAM = 1,
        }
        #[library("api-ms-win-shcore-stream-winrt-l1-1-0.dll")]
        extern fn CreateRandomAccessStreamOnFile(#[in] filePath: PCWSTR, #[in] accessMode: DWORD, #[in] riid: &IID, #[iid_is] #[out] #[out_ptr(null_on_failure)] ppv: *mut *mut void) -> HRESULT;
        #[library("api-ms-win-shcore-stream-winrt-l1-1-0.dll")]
        extern fn CreateRandomAccessStreamOverStream(#[in] stream: IStream, #[in] options: BSOS_OPTIONS, #[in] riid: &IID, #[iid_is] #[out] #[out_ptr(null_on_failure)] ppv: *mut *mut void) -> HRESULT;
        #[library("api-ms-win-shcore-stream-winrt-l1-1-0.dll")]
        extern fn CreateStreamOverRandomAccessStream(#[in] randomAccessStream: IUnknown, #[in] riid: &IID, #[iid_is] #[out] #[out_ptr(null_on_failure)] ppv: *mut *mut void) -> HRESULT;
    }
}
