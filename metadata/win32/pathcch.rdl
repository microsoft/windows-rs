#[win32]
mod Windows {
    mod Win32 {
        const PATHCCH_MAX_CCH: i32 = 32768;
        #[flags]
        #[repr(i32)]
        enum PATHCCH_OPTIONS {
            PATHCCH_NONE = 0,
            PATHCCH_ALLOW_LONG_PATHS = 1,
            PATHCCH_FORCE_ENABLE_LONG_NAME_PROCESS = 2,
            PATHCCH_FORCE_DISABLE_LONG_NAME_PROCESS = 4,
            PATHCCH_DO_NOT_NORMALIZE_SEGMENTS = 8,
            PATHCCH_ENSURE_IS_EXTENDED_LENGTH_PATH = 16,
            PATHCCH_ENSURE_TRAILING_SLASH = 32,
            PATHCCH_CANONICALIZE_SLASHES = 64,
        }
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathAllocCanonicalize(#[in] pszPathIn: PCWSTR, #[in] dwFlags: ULONG, #[out] #[out_ptr] ppszPathOut: *mut PWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathAllocCombine(#[in] #[opt] pszPathIn: PCWSTR, #[in] #[opt] pszMore: PCWSTR, #[in] dwFlags: ULONG, #[out] #[out_ptr] ppszPathOut: *mut PWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchAddBackslash(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchAddBackslashEx(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t, #[incomplete] #[opt] #[out] ppszEnd: *mut PWSTR, #[opt] #[out] pcchRemaining: *mut size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchAddExtension(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t, #[in] pszExt: PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchAppend(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t, #[in] #[opt] pszMore: PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchAppendEx(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t, #[in] #[opt] pszMore: PCWSTR, #[in] dwFlags: ULONG) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchCanonicalize(#[buffer(cchPathOut)] #[out] pszPathOut: PWSTR, #[in] cchPathOut: size_t, #[in] pszPathIn: PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchCanonicalizeEx(#[buffer(cchPathOut)] #[out] pszPathOut: PWSTR, #[in] cchPathOut: size_t, #[in] pszPathIn: PCWSTR, #[in] dwFlags: ULONG) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchCombine(#[buffer(cchPathOut)] #[out] pszPathOut: PWSTR, #[in] cchPathOut: size_t, #[in] #[opt] pszPathIn: PCWSTR, #[in] #[opt] pszMore: PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchCombineEx(#[buffer(cchPathOut)] #[out] pszPathOut: PWSTR, #[in] cchPathOut: size_t, #[in] #[opt] pszPathIn: PCWSTR, #[in] #[opt] pszMore: PCWSTR, #[in] dwFlags: ULONG) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchFindExtension(#[in] #[incomplete] pszPath: PCWSTR, #[in] cchPath: size_t, #[out] #[out_ptr] ppszExt: *mut PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchIsRoot(#[in] #[opt] pszPath: PCWSTR) -> BOOL;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchRemoveBackslash(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchRemoveBackslashEx(#[in] #[incomplete] #[out] pszPath: PWSTR, #[in] cchPath: size_t, #[incomplete] #[opt] #[out] ppszEnd: *mut PWSTR, #[opt] #[out] pcchRemaining: *mut size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchRemoveExtension(#[in] #[incomplete] #[out] pszPath: PWSTR, #[in] cchPath: size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchRemoveFileSpec(#[in] #[incomplete] #[out] pszPath: PWSTR, #[in] cchPath: size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchRenameExtension(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t, #[in] pszExt: PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchSkipRoot(#[in] pszPath: PCWSTR, #[out] #[out_ptr] ppszRootEnd: *mut PCWSTR) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchStripPrefix(#[buffer(cchPath)] #[in] #[out] pszPath: PWSTR, #[in] cchPath: size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathCchStripToRoot(#[in] #[incomplete] #[out] pszPath: PWSTR, #[in] cchPath: size_t) -> HRESULT;
        #[library("api-ms-win-core-path-l1-1-0.dll")]
        extern fn PathIsUNCEx(#[in] pszPath: PCWSTR, #[opt] #[out] #[out_ptr] ppszServer: *mut PCWSTR) -> BOOL;
        #[encoding("utf-16")]
        const VOLUME_PREFIX: String = "\\\\?\\Volume";
        #[arch(X64 | Arm64)]
        const VOLUME_PREFIX_LEN: u64 = 10;
        #[arch(X86)]
        const VOLUME_PREFIX_LEN: u32 = 10;
    }
}
