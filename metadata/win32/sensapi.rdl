#[win32]
mod Windows {
    mod Win32 {
        #[library("SensApi.dll")]
        extern fn IsDestinationReachableA(lpszDestination: LPCSTR, lpQOCInfo: LPQOCINFO) -> BOOL;
        #[library("SensApi.dll")]
        extern fn IsDestinationReachableW(lpszDestination: LPCWSTR, lpQOCInfo: LPQOCINFO) -> BOOL;
        #[library("SensApi.dll")]
        extern fn IsNetworkAlive(lpdwFlags: LPDWORD) -> BOOL;
        type LPQOCINFO = *mut QOCINFO;
        const NETWORK_ALIVE_AOL: i32 = 4;
        const NETWORK_ALIVE_INTERNET: i32 = 8;
        const NETWORK_ALIVE_LAN: i32 = 1;
        const NETWORK_ALIVE_WAN: i32 = 2;
        struct QOCINFO {
            dwSize: DWORD,
            dwFlags: DWORD,
            dwInSpeed: DWORD,
            dwOutSpeed: DWORD,
        }
    }
}
