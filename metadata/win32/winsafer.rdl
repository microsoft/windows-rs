#[win32]
mod Windows {
    mod Win32 {
        type PSAFER_CODE_PROPERTIES = *mut SAFER_CODE_PROPERTIES_V2;
        type PSAFER_CODE_PROPERTIES_V1 = *mut SAFER_CODE_PROPERTIES_V1;
        type PSAFER_CODE_PROPERTIES_V2 = *mut SAFER_CODE_PROPERTIES_V2;
        type PSAFER_HASH_IDENTIFICATION = *mut SAFER_HASH_IDENTIFICATION;
        type PSAFER_HASH_IDENTIFICATION2 = *mut SAFER_HASH_IDENTIFICATION2;
        type PSAFER_IDENTIFICATION_HEADER = *mut SAFER_IDENTIFICATION_HEADER;
        type PSAFER_PATHNAME_IDENTIFICATION = *mut SAFER_PATHNAME_IDENTIFICATION;
        type PSAFER_URLZONE_IDENTIFICATION = *mut SAFER_URLZONE_IDENTIFICATION;
        type SAFER_CODE_PROPERTIES = SAFER_CODE_PROPERTIES_V2;
        #[packed(8)]
        struct SAFER_CODE_PROPERTIES_V1 {
            cbSize: DWORD,
            dwCheckFlags: DWORD,
            ImagePath: LPCWSTR,
            hImageFileHandle: HANDLE,
            UrlZoneId: DWORD,
            ImageHash: [BYTE; 64],
            dwImageHashSize: DWORD,
            ImageSize: LARGE_INTEGER,
            HashAlgorithm: ALG_ID,
            pByteBlock: LPBYTE,
            hWndParent: HWND,
            dwWVTUIChoice: DWORD,
        }
        #[packed(8)]
        struct SAFER_CODE_PROPERTIES_V2 {
            cbSize: DWORD,
            dwCheckFlags: DWORD,
            ImagePath: LPCWSTR,
            hImageFileHandle: HANDLE,
            UrlZoneId: DWORD,
            ImageHash: [BYTE; 64],
            dwImageHashSize: DWORD,
            ImageSize: LARGE_INTEGER,
            HashAlgorithm: ALG_ID,
            pByteBlock: LPBYTE,
            hWndParent: HWND,
            dwWVTUIChoice: DWORD,
            PackageMoniker: LPCWSTR,
            PackagePublisher: LPCWSTR,
            PackageName: LPCWSTR,
            PackageVersion: ULONG64,
            PackageIsFramework: BOOL,
        }
        const SAFER_CRITERIA_APPX_PACKAGE: i32 = 32;
        const SAFER_CRITERIA_AUTHENTICODE: i32 = 8;
        const SAFER_CRITERIA_IMAGEHASH: i32 = 4;
        const SAFER_CRITERIA_IMAGEPATH: i32 = 1;
        const SAFER_CRITERIA_IMAGEPATH_NT: i32 = 4096;
        const SAFER_CRITERIA_NOSIGNEDHASH: i32 = 2;
        const SAFER_CRITERIA_URLZONE: i32 = 16;
        #[packed(8)]
        struct SAFER_HASH_IDENTIFICATION {
            header: SAFER_IDENTIFICATION_HEADER,
            Description: [WCHAR; 256],
            FriendlyName: [WCHAR; 256],
            HashSize: DWORD,
            ImageHash: [BYTE; 64],
            HashAlgorithm: ALG_ID,
            ImageSize: LARGE_INTEGER,
            dwSaferFlags: DWORD,
        }
        #[packed(8)]
        struct SAFER_HASH_IDENTIFICATION2 {
            hashIdentification: SAFER_HASH_IDENTIFICATION,
            HashSize: DWORD,
            ImageHash: [BYTE; 64],
            HashAlgorithm: ALG_ID,
        }
        #[packed(8)]
        struct SAFER_IDENTIFICATION_HEADER {
            dwIdentificationType: SAFER_IDENTIFICATION_TYPES,
            cbStructSize: DWORD,
            IdentificationGuid: GUID,
            lastModified: FILETIME,
        }
        #[repr(i32)]
        enum SAFER_IDENTIFICATION_TYPES {
            SaferIdentityDefault = 0,
            SaferIdentityTypeImageName = 1,
            SaferIdentityTypeImageHash = 2,
            SaferIdentityTypeUrlZone = 3,
            SaferIdentityTypeCertificate = 4,
        }
        const SAFER_LEVELID_CONSTRAINED: i32 = 65536;
        const SAFER_LEVELID_DISALLOWED: i32 = 0;
        const SAFER_LEVELID_FULLYTRUSTED: i32 = 262144;
        const SAFER_LEVELID_NORMALUSER: i32 = 131072;
        const SAFER_LEVELID_UNTRUSTED: i32 = 4096;
        type SAFER_LEVEL_HANDLE = *mut SAFER_LEVEL_HANDLE__;
        struct SAFER_LEVEL_HANDLE__ {
            unused: i32,
        }
        const SAFER_LEVEL_OPEN: i32 = 1;
        const SAFER_MAX_DESCRIPTION_SIZE: i32 = 256;
        const SAFER_MAX_FRIENDLYNAME_SIZE: i32 = 256;
        const SAFER_MAX_HASH_SIZE: i32 = 64;
        #[repr(i32)]
        enum SAFER_OBJECT_INFO_CLASS {
            SaferObjectLevelId = 1,
            SaferObjectScopeId = 2,
            SaferObjectFriendlyName = 3,
            SaferObjectDescription = 4,
            SaferObjectBuiltin = 5,
            SaferObjectDisallowed = 6,
            SaferObjectDisableMaxPrivilege = 7,
            SaferObjectInvertDeletedPrivileges = 8,
            SaferObjectDeletedPrivileges = 9,
            SaferObjectDefaultOwner = 10,
            SaferObjectSidsToDisable = 11,
            SaferObjectRestrictedSidsInverted = 12,
            SaferObjectRestrictedSidsAdded = 13,
            SaferObjectAllIdentificationGuids = 14,
            SaferObjectSingleIdentification = 15,
            SaferObjectExtendedError = 16,
        }
        #[packed(8)]
        struct SAFER_PATHNAME_IDENTIFICATION {
            header: SAFER_IDENTIFICATION_HEADER,
            Description: [WCHAR; 256],
            ImageName: PWCHAR,
            dwSaferFlags: DWORD,
        }
        const SAFER_POLICY_BLOCK_CLIENT_UI: i32 = 8192;
        const SAFER_POLICY_HASH_DUPLICATE: i32 = 262144;
        #[repr(i32)]
        enum SAFER_POLICY_INFO_CLASS {
            SaferPolicyLevelList = 1,
            SaferPolicyEnableTransparentEnforcement = 2,
            SaferPolicyDefaultLevel = 3,
            SaferPolicyEvaluateUserScope = 4,
            SaferPolicyScopeFlags = 5,
            SaferPolicyDefaultLevelFlags = 6,
            SaferPolicyAuthenticodeEnabled = 7,
        }
        const SAFER_POLICY_JOBID_CONSTRAINED: i32 = 67108864;
        const SAFER_POLICY_JOBID_MASK: u32 = 4278190080;
        const SAFER_POLICY_JOBID_UNTRUSTED: i32 = 50331648;
        const SAFER_POLICY_ONLY_AUDIT: i32 = 4096;
        const SAFER_POLICY_ONLY_EXES: i32 = 65536;
        const SAFER_POLICY_SANDBOX_INERT: i32 = 131072;
        const SAFER_POLICY_UIFLAGS_HIDDEN: i32 = 4;
        const SAFER_POLICY_UIFLAGS_INFORMATION_PROMPT: i32 = 1;
        const SAFER_POLICY_UIFLAGS_MASK: i32 = 255;
        const SAFER_POLICY_UIFLAGS_OPTION_PROMPT: i32 = 2;
        const SAFER_SCOPEID_MACHINE: i32 = 1;
        const SAFER_SCOPEID_USER: i32 = 2;
        const SAFER_TOKEN_COMPARE_ONLY: i32 = 2;
        const SAFER_TOKEN_MAKE_INERT: i32 = 4;
        const SAFER_TOKEN_NULL_IF_EQUAL: i32 = 1;
        const SAFER_TOKEN_WANT_FLAGS: i32 = 8;
        #[packed(8)]
        struct SAFER_URLZONE_IDENTIFICATION {
            header: SAFER_IDENTIFICATION_HEADER,
            UrlZoneId: DWORD,
            dwSaferFlags: DWORD,
        }
        #[encoding("utf-16")]
        const SRP_POLICY_APPX: String = "APPX";
        #[encoding("utf-16")]
        const SRP_POLICY_DLL: String = "DLL";
        #[encoding("utf-16")]
        const SRP_POLICY_EXE: String = "EXE";
        #[encoding("utf-16")]
        const SRP_POLICY_MANAGEDINSTALLER: String = "MANAGEDINSTALLER";
        #[encoding("utf-16")]
        const SRP_POLICY_MSI: String = "MSI";
        #[encoding("utf-16")]
        const SRP_POLICY_NOV2: String = "IGNORESRPV2";
        #[encoding("utf-16")]
        const SRP_POLICY_SCRIPT: String = "SCRIPT";
        #[encoding("utf-16")]
        const SRP_POLICY_SHELL: String = "SHELL";
        #[encoding("utf-16")]
        const SRP_POLICY_WLDPCONFIGCI: String = "WLDPCONFIGCI";
        #[encoding("utf-16")]
        const SRP_POLICY_WLDPMSI: String = "WLDPMSI";
        #[encoding("utf-16")]
        const SRP_POLICY_WLDPSCRIPT: String = "WLDPSCRIPT";
        #[library("ADVAPI32.dll")]
        extern fn SaferCloseLevel(#[in] hLevelHandle: SAFER_LEVEL_HANDLE) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferComputeTokenFromLevel(#[in] LevelHandle: SAFER_LEVEL_HANDLE, #[in] #[opt] InAccessToken: HANDLE, #[out] OutAccessToken: PHANDLE, #[in] dwFlags: DWORD, #[in] #[opt] #[out] lpReserved: LPVOID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferCreateLevel(#[in] dwScopeId: DWORD, #[in] dwLevelId: DWORD, #[in] OpenFlags: DWORD, #[out] #[out_ptr] pLevelHandle: *mut SAFER_LEVEL_HANDLE, #[reserved] lpReserved: LPVOID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferGetLevelInformation(#[in] LevelHandle: SAFER_LEVEL_HANDLE, #[in] dwInfoType: SAFER_OBJECT_INFO_CLASS, #[opt] #[out] #[writable(entry, bytes(dwInBufferSize))] lpQueryBuffer: LPVOID, #[in] dwInBufferSize: DWORD, #[out] lpdwOutBufferSize: LPDWORD) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferGetPolicyInformation(#[in] dwScopeId: DWORD, #[in] SaferPolicyInfoClass: SAFER_POLICY_INFO_CLASS, #[in] InfoBufferSize: DWORD, #[out] #[writable(entry, bytes(InfoBufferSize))] InfoBuffer: PVOID, #[out] InfoBufferRetSize: PDWORD, #[reserved] lpReserved: LPVOID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferIdentifyLevel(#[in] dwNumProperties: DWORD, #[in] #[opt] #[readable(entry, dwNumProperties)] pCodeProperties: PSAFER_CODE_PROPERTIES, #[out] #[out_ptr] pLevelHandle: *mut SAFER_LEVEL_HANDLE, #[in] #[opt] lpReserved: LPVOID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferRecordEventLogEntry(#[in] hLevel: SAFER_LEVEL_HANDLE, #[in] szTargetPath: LPCWSTR, #[reserved] lpReserved: LPVOID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferSetLevelInformation(#[in] LevelHandle: SAFER_LEVEL_HANDLE, #[in] dwInfoType: SAFER_OBJECT_INFO_CLASS, #[in] #[readable(entry, bytes(dwInBufferSize))] lpQueryBuffer: LPVOID, #[in] dwInBufferSize: DWORD) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferSetPolicyInformation(#[in] dwScopeId: DWORD, #[in] SaferPolicyInfoClass: SAFER_POLICY_INFO_CLASS, #[in] InfoBufferSize: DWORD, #[in] #[readable(entry, bytes(InfoBufferSize))] InfoBuffer: PVOID, #[reserved] lpReserved: LPVOID) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SaferiIsExecutableFileType(#[in] szFullPathname: LPCWSTR, #[in] bFromShellExecute: BOOLEAN) -> BOOL;
    }
}
