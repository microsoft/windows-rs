#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum CONDITION_OPERATION {
            COP_IMPLICIT = 0,
            COP_EQUAL = 1,
            COP_NOTEQUAL = 2,
            COP_LESSTHAN = 3,
            COP_GREATERTHAN = 4,
            COP_LESSTHANOREQUAL = 5,
            COP_GREATERTHANOREQUAL = 6,
            COP_VALUE_STARTSWITH = 7,
            COP_VALUE_ENDSWITH = 8,
            COP_VALUE_CONTAINS = 9,
            COP_VALUE_NOTCONTAINS = 10,
            COP_DOSWILDCARDS = 11,
            COP_WORD_EQUAL = 12,
            COP_WORD_STARTSWITH = 13,
            COP_APPLICATION_SPECIFIC = 14,
        }
        #[repr(i32)]
        enum CONDITION_TYPE {
            CT_AND_CONDITION = 0,
            CT_OR_CONDITION = 1,
            CT_NOT_CONDITION = 2,
            CT_LEAF_CONDITION = 3,
        }
        #[guid(0x0fc988d4_c935_4b97_a973_46282ea175c8)]
        interface ICondition: IPersistStream {
            fn GetConditionType(&self, #[out] #[retval] pNodeType: *mut CONDITION_TYPE) -> HRESULT;
            fn GetSubConditions(&self, #[in] riid: &IID, #[iid_is] #[out] #[out_ptr] #[retval] ppv: *mut *mut void) -> HRESULT;
            fn GetComparisonInfo(&self, #[nullable] #[opt] #[out] #[out_ptr] ppszPropertyName: *mut LPWSTR, #[opt] #[out] pcop: *mut CONDITION_OPERATION, #[opt] #[out] ppropvar: *mut PROPVARIANT) -> HRESULT;
            fn GetValueType(&self, #[out] #[out_ptr] #[retval] ppszValueTypeName: *mut LPWSTR) -> HRESULT;
            fn GetValueNormalization(&self, #[out] #[out_ptr] #[retval] ppszNormalization: *mut LPWSTR) -> HRESULT;
            fn GetInputTerms(&self, #[opt] #[out] ppPropertyTerm: *mut IRichChunk, #[opt] #[out] ppOperationTerm: *mut IRichChunk, #[opt] #[out] ppValueTerm: *mut IRichChunk) -> HRESULT;
            fn Clone(&self, #[out] #[out_ptr] #[retval] ppc: *mut ICondition) -> HRESULT;
        }
        #[guid(0x0db8851d_2e5b_47eb_9208_d28c325a01d7)]
        interface ICondition2: ICondition {
            fn GetLocale(&self, #[out] #[out_ptr] ppszLocaleName: *mut LPWSTR) -> HRESULT;
            fn GetLeafConditionInfo(&self, #[opt] #[out] ppropkey: *mut PROPERTYKEY, #[opt] #[out] pcop: *mut CONDITION_OPERATION, #[opt] #[out] ppropvar: *mut PROPVARIANT) -> HRESULT;
        }
        #[guid(0x4fdef69c_dbc9_454e_9910_b34f3c64b510)]
        interface IRichChunk: IUnknown {
            fn GetData(&self, #[opt] #[out] pFirstPos: *mut ULONG, #[opt] #[out] pLength: *mut ULONG, #[nullable] #[opt] #[out] #[out_ptr] ppsz: *mut LPWSTR, #[opt] #[out] pValue: *mut PROPVARIANT) -> HRESULT;
        }
    }
}
