#[win32]
mod Windows {
    mod Win32 {
        struct BLUETOOTH_ADDRESS_STRUCT {
            Anonymous: union {
                ullLong: BTH_ADDR,
                rgBytes: [BYTE; 6],
            },
        }
        struct BLUETOOTH_AUTHENTICATE_RESPONSE {
            bthAddressRemote: BLUETOOTH_ADDRESS_STRUCT,
            authMethod: BLUETOOTH_AUTHENTICATION_METHOD,
            Anonymous: union {
                pinInfo: BLUETOOTH_PIN_INFO,
                oobInfo: BLUETOOTH_OOB_DATA_INFO,
                numericCompInfo: BLUETOOTH_NUMERIC_COMPARISON_INFO,
                passkeyInfo: BLUETOOTH_PASSKEY_INFO,
            },
            negativeResponse: UCHAR,
        }
        struct BLUETOOTH_AUTHENTICATION_CALLBACK_PARAMS {
            deviceInfo: BLUETOOTH_DEVICE_INFO_STRUCT,
            authenticationMethod: BLUETOOTH_AUTHENTICATION_METHOD,
            ioCapability: BLUETOOTH_IO_CAPABILITY,
            authenticationRequirements: BLUETOOTH_AUTHENTICATION_REQUIREMENTS,
            Anonymous: union {
                Numeric_Value: ULONG,
                Passkey: ULONG,
            },
        }
        #[repr(i32)]
        enum BLUETOOTH_AUTHENTICATION_METHOD {
            BLUETOOTH_AUTHENTICATION_METHOD_LEGACY = 1,
            BLUETOOTH_AUTHENTICATION_METHOD_OOB = 2,
            BLUETOOTH_AUTHENTICATION_METHOD_NUMERIC_COMPARISON = 3,
            BLUETOOTH_AUTHENTICATION_METHOD_PASSKEY_NOTIFICATION = 4,
            BLUETOOTH_AUTHENTICATION_METHOD_PASSKEY = 5,
        }
        #[repr(i32)]
        enum BLUETOOTH_AUTHENTICATION_REQUIREMENTS {
            BLUETOOTH_MITM_ProtectionNotRequired = 0,
            BLUETOOTH_MITM_ProtectionRequired = 1,
            BLUETOOTH_MITM_ProtectionNotRequiredBonding = 2,
            BLUETOOTH_MITM_ProtectionRequiredBonding = 3,
            BLUETOOTH_MITM_ProtectionNotRequiredGeneralBonding = 4,
            BLUETOOTH_MITM_ProtectionRequiredGeneralBonding = 5,
            BLUETOOTH_MITM_ProtectionNotDefined = 255,
        }
        struct BLUETOOTH_COD_PAIRS {
            ulCODMask: ULONG,
            pcszDescription: LPCWSTR,
        }
        struct BLUETOOTH_DEVICE_INFO_STRUCT {
            dwSize: DWORD,
            Address: BLUETOOTH_ADDRESS_STRUCT,
            ulClassofDevice: ULONG,
            fConnected: BOOL,
            fRemembered: BOOL,
            fAuthenticated: BOOL,
            stLastSeen: SYSTEMTIME,
            stLastUsed: SYSTEMTIME,
            szName: [WCHAR; 248],
        }
        const BLUETOOTH_DEVICE_NAME_SIZE: i32 = 256;
        struct BLUETOOTH_DEVICE_SEARCH_PARAMS {
            dwSize: DWORD,
            fReturnAuthenticated: BOOL,
            fReturnRemembered: BOOL,
            fReturnUnknown: BOOL,
            fReturnConnected: BOOL,
            fIssueInquiry: BOOL,
            cTimeoutMultiplier: UCHAR,
            hRadio: HANDLE,
        }
        struct BLUETOOTH_FIND_RADIO_PARAMS {
            dwSize: DWORD,
        }
        #[repr(i32)]
        enum BLUETOOTH_IO_CAPABILITY {
            BLUETOOTH_IO_CAPABILITY_DISPLAYONLY = 0,
            BLUETOOTH_IO_CAPABILITY_DISPLAYYESNO = 1,
            BLUETOOTH_IO_CAPABILITY_KEYBOARDONLY = 2,
            BLUETOOTH_IO_CAPABILITY_NOINPUTNOOUTPUT = 3,
            BLUETOOTH_IO_CAPABILITY_UNDEFINED = 255,
        }
        struct BLUETOOTH_LOCAL_SERVICE_INFO_STRUCT {
            Enabled: BOOL,
            btAddr: BLUETOOTH_ADDRESS_STRUCT,
            szName: [WCHAR; 256],
            szDeviceString: [WCHAR; 256],
        }
        const BLUETOOTH_MAX_NAME_SIZE: i32 = 248;
        const BLUETOOTH_MAX_PASSKEY_BUFFER_SIZE: i32 = 17;
        const BLUETOOTH_MAX_PASSKEY_SIZE: i32 = 16;
        const BLUETOOTH_MAX_SERVICE_NAME_SIZE: i32 = 256;
        const BLUETOOTH_NULL_ADDRESS: ULONGLONG = 0;
        struct BLUETOOTH_NUMERIC_COMPARISON_INFO {
            NumericValue: ULONG,
        }
        struct BLUETOOTH_OOB_DATA_INFO {
            C: [UCHAR; 16],
            R: [UCHAR; 16],
        }
        struct BLUETOOTH_PASSKEY_INFO {
            passkey: ULONG,
        }
        struct BLUETOOTH_PIN_INFO {
            pin: [UCHAR; 16],
            pinLength: UCHAR,
        }
        struct BLUETOOTH_RADIO_INFO {
            dwSize: DWORD,
            address: BLUETOOTH_ADDRESS_STRUCT,
            szName: [WCHAR; 248],
            ulClassofDevice: ULONG,
            lmpSubversion: USHORT,
            manufacturer: USHORT,
        }
        struct BLUETOOTH_SELECT_DEVICE_PARAMS {
            dwSize: DWORD,
            cNumOfClasses: ULONG,
            prgClassOfDevices: *mut BLUETOOTH_COD_PAIRS,
            pszInfo: LPWSTR,
            hwndParent: HWND,
            fForceAuthentication: BOOL,
            fShowAuthenticated: BOOL,
            fShowRemembered: BOOL,
            fShowUnknown: BOOL,
            fAddNewDeviceWizard: BOOL,
            fSkipServicesPage: BOOL,
            pfnDeviceCallback: PFN_DEVICE_CALLBACK,
            pvParam: LPVOID,
            cNumDevices: DWORD,
            #[nullable]
            #[writable(cNumDevices)]
            pDevices: PBLUETOOTH_DEVICE_INFO,
        }
        const BLUETOOTH_SERVICE_DISABLE: i32 = 0;
        const BLUETOOTH_SERVICE_ENABLE: i32 = 1;
        const BLUETOOTH_SERVICE_MASK: i32 = 1;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothAuthenticateDevice(#[in] #[opt] hwndParent: HWND, #[in] #[opt] hRadio: HANDLE, #[in] #[out] pbtbi: *mut BLUETOOTH_DEVICE_INFO_STRUCT, #[in] #[opt] #[readable(entry, ulPasskeyLength)] pszPasskey: PWSTR, #[in] ulPasskeyLength: ULONG) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothAuthenticateDeviceEx(#[in] #[opt] hwndParentIn: HWND, #[in] #[opt] hRadioIn: HANDLE, #[in] #[out] pbtdiInout: *mut BLUETOOTH_DEVICE_INFO_STRUCT, #[in] #[opt] pbtOobData: PBLUETOOTH_OOB_DATA_INFO, #[in] authenticationRequirement: AUTHENTICATION_REQUIREMENTS) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothAuthenticateMultipleDevices(#[in] #[opt] hwndParent: HWND, #[in] #[opt] hRadio: HANDLE, #[in] cDevices: DWORD, #[in] #[out] #[writable(entry, cDevices)] rgbtdi: *mut BLUETOOTH_DEVICE_INFO_STRUCT) -> DWORD;
        #[library("bthprops.cpl")]
        extern fn BluetoothDisplayDeviceProperties(#[in] #[opt] hwndParent: HWND, #[in] #[out] pbtdi: *mut BLUETOOTH_DEVICE_INFO_STRUCT) -> BOOL;
        #[library("bthprops.cpl")]
        extern fn BluetoothEnableDiscovery(#[in] #[opt] hRadio: HANDLE, #[in] fEnabled: BOOL) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothEnableIncomingConnections(#[in] #[opt] hRadio: HANDLE, #[in] fEnabled: BOOL) -> BOOL;
        #[library("bthprops.cpl", import = "BluetoothSdpEnumAttributes")]
        #[must_use]
        extern fn BluetoothEnumAttributes(#[in] #[readable(entry, bytes(cbStreamSize))] pSDPStream: LPBYTE, #[in] cbStreamSize: ULONG, #[in] pfnCallback: PFN_BLUETOOTH_ENUM_ATTRIBUTES_CALLBACK, #[in] pvParam: LPVOID) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothEnumerateInstalledServices(#[in] #[opt] hRadio: HANDLE, #[in] pbtdi: *const BLUETOOTH_DEVICE_INFO_STRUCT, #[in] #[out] pcServiceInout: *mut DWORD, #[opt] #[out] #[readable(success, *pcServiceInout)] #[writable(entry, *pcServiceInout)] pGuidServices: *mut GUID) -> DWORD;
        #[library("bthprops.cpl")]
        extern fn BluetoothFindDeviceClose(#[in] hFind: HBLUETOOTH_DEVICE_FIND) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothFindFirstDevice(#[in] pbtsp: *const BLUETOOTH_DEVICE_SEARCH_PARAMS, #[in] #[out] pbtdi: *mut BLUETOOTH_DEVICE_INFO_STRUCT) -> HBLUETOOTH_DEVICE_FIND;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothFindFirstRadio(#[in] pbtfrp: *const BLUETOOTH_FIND_RADIO_PARAMS, #[out] phRadio: *mut HANDLE) -> HBLUETOOTH_RADIO_FIND;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothFindNextDevice(#[in] hFind: HBLUETOOTH_DEVICE_FIND, #[in] #[out] pbtdi: *mut BLUETOOTH_DEVICE_INFO_STRUCT) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothFindNextRadio(#[in] hFind: HBLUETOOTH_RADIO_FIND, #[out] phRadio: *mut HANDLE) -> BOOL;
        #[library("bthprops.cpl")]
        extern fn BluetoothFindRadioClose(#[in] hFind: HBLUETOOTH_RADIO_FIND) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothGetDeviceInfo(#[in] #[opt] hRadio: HANDLE, #[in] #[out] pbtdi: *mut BLUETOOTH_DEVICE_INFO_STRUCT) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothGetRadioInfo(#[in] hRadio: HANDLE, #[in] #[out] pRadioInfo: PBLUETOOTH_RADIO_INFO) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothIsConnectable(#[in] #[opt] hRadio: HANDLE) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothIsDiscoverable(#[in] #[opt] hRadio: HANDLE) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothIsVersionAvailable(#[in] MajorVersion: UCHAR, #[in] MinorVersion: UCHAR) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothRegisterForAuthentication(#[in] #[opt] pbtdi: *const BLUETOOTH_DEVICE_INFO_STRUCT, #[out] phRegHandle: *mut HBLUETOOTH_AUTHENTICATION_REGISTRATION, #[in] #[opt] pfnCallback: PFN_AUTHENTICATION_CALLBACK, #[in] #[opt] pvParam: PVOID) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothRegisterForAuthenticationEx(#[in] #[opt] pbtdiIn: *const BLUETOOTH_DEVICE_INFO_STRUCT, #[out] phRegHandleOut: *mut HBLUETOOTH_AUTHENTICATION_REGISTRATION, #[in] #[opt] pfnCallbackIn: PFN_AUTHENTICATION_CALLBACK_EX, #[in] #[opt] pvParam: PVOID) -> DWORD;
        #[library("bthprops.cpl")]
        extern fn BluetoothRemoveDevice(#[in] pAddress: *const BLUETOOTH_ADDRESS_STRUCT) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSdpEnumAttributes(#[in] #[readable(entry, bytes(cbStreamSize))] pSDPStream: LPBYTE, #[in] cbStreamSize: ULONG, #[in] pfnCallback: PFN_BLUETOOTH_ENUM_ATTRIBUTES_CALLBACK, #[in] pvParam: LPVOID) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSdpGetAttributeValue(#[in] #[readable(entry, bytes(cbRecordLength))] pRecordStream: LPBYTE, #[in] cbRecordLength: ULONG, #[in] usAttributeId: USHORT, #[out] pAttributeData: PSDP_ELEMENT_DATA) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSdpGetContainerElementData(#[in] #[readable(entry, bytes(cbContainerLength))] pContainerStream: LPBYTE, #[in] cbContainerLength: ULONG, #[in] #[out] pElement: *mut HBLUETOOTH_CONTAINER_ELEMENT, #[out] pData: PSDP_ELEMENT_DATA) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSdpGetElementData(#[in] #[readable(entry, bytes(cbSdpStreamLength))] pSdpStream: LPBYTE, #[in] cbSdpStreamLength: ULONG, #[out] pData: PSDP_ELEMENT_DATA) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSdpGetString(#[in] #[readable(entry, bytes(cbRecordLength))] pRecordStream: LPBYTE, #[in] cbRecordLength: ULONG, #[in] #[opt] pStringData: PSDP_STRING_TYPE_DATA, #[in] usStringOffset: USHORT, #[out] #[readable(success, *pcchStringLength)] #[writable(entry, *pcchStringLength)] pszString: PWSTR, #[in] #[out] pcchStringLength: PULONG) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSelectDevices(#[in] #[out] pbtsdp: *mut BLUETOOTH_SELECT_DEVICE_PARAMS) -> BOOL;
        #[library("bthprops.cpl")]
        extern fn BluetoothSelectDevicesFree(#[in] #[out] pbtsdp: *mut BLUETOOTH_SELECT_DEVICE_PARAMS) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSendAuthenticationResponse(#[in] #[opt] hRadio: HANDLE, #[in] pbtdi: *const BLUETOOTH_DEVICE_INFO_STRUCT, #[in] pszPasskey: LPCWSTR) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSendAuthenticationResponseEx(#[in] #[opt] hRadioIn: HANDLE, #[in] pauthResponse: PBLUETOOTH_AUTHENTICATE_RESPONSE) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSetLocalServiceInfo(#[in] #[opt] hRadioIn: HANDLE, #[in] pClassGuid: *const GUID, #[in] ulInstance: ULONG, #[in] pServiceInfoIn: *const BLUETOOTH_LOCAL_SERVICE_INFO_STRUCT) -> DWORD;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothSetServiceState(#[in] #[opt] hRadio: HANDLE, #[in] pbtdi: *const BLUETOOTH_DEVICE_INFO_STRUCT, #[in] pGuidService: *const GUID, #[in] dwServiceFlags: DWORD) -> DWORD;
        #[library("bthprops.cpl")]
        extern fn BluetoothUnregisterAuthentication(#[in] hRegHandle: HBLUETOOTH_AUTHENTICATION_REGISTRATION) -> BOOL;
        #[library("bthprops.cpl")]
        #[must_use]
        extern fn BluetoothUpdateDeviceRecord(#[in] pbtdi: *const BLUETOOTH_DEVICE_INFO_STRUCT) -> DWORD;
        type HBLUETOOTH_AUTHENTICATION_REGISTRATION = *mut void;
        type HBLUETOOTH_CONTAINER_ELEMENT = *mut void;
        type HBLUETOOTH_DEVICE_FIND = *mut void;
        type HBLUETOOTH_RADIO_FIND = *mut void;
        type PBLUETOOTH_AUTHENTICATE_RESPONSE = *mut BLUETOOTH_AUTHENTICATE_RESPONSE;
        type PBLUETOOTH_AUTHENTICATION_CALLBACK_PARAMS = *mut BLUETOOTH_AUTHENTICATION_CALLBACK_PARAMS;
        type PBLUETOOTH_AUTHENTICATION_METHOD = *mut BLUETOOTH_AUTHENTICATION_METHOD;
        type PBLUETOOTH_DEVICE_INFO = *mut BLUETOOTH_DEVICE_INFO_STRUCT;
        type PBLUETOOTH_LOCAL_SERVICE_INFO = *mut BLUETOOTH_LOCAL_SERVICE_INFO_STRUCT;
        type PBLUETOOTH_NUMERIC_COMPARISON_INFO = *mut BLUETOOTH_NUMERIC_COMPARISON_INFO;
        type PBLUETOOTH_OOB_DATA_INFO = *mut BLUETOOTH_OOB_DATA_INFO;
        type PBLUETOOTH_PASSKEY_INFO = *mut BLUETOOTH_PASSKEY_INFO;
        type PBLUETOOTH_PIN_INFO = *mut BLUETOOTH_PIN_INFO;
        type PBLUETOOTH_RADIO_INFO = *mut BLUETOOTH_RADIO_INFO;
        extern fn PFN_AUTHENTICATION_CALLBACK(pvParam: LPVOID, pDevice: PBLUETOOTH_DEVICE_INFO) -> BOOL;
        extern fn PFN_AUTHENTICATION_CALLBACK_EX(#[in] #[opt] pvParam: LPVOID, #[in] pAuthCallbackParams: PBLUETOOTH_AUTHENTICATION_CALLBACK_PARAMS) -> BOOL;
        extern fn PFN_BLUETOOTH_ENUM_ATTRIBUTES_CALLBACK(#[in] uAttribId: ULONG, #[in] #[readable(entry, bytes(cbStreamSize))] pValueStream: LPBYTE, #[in] cbStreamSize: ULONG, #[in] #[opt] pvParam: LPVOID) -> BOOL;
        extern fn PFN_DEVICE_CALLBACK(pvParam: LPVOID, pDevice: *const BLUETOOTH_DEVICE_INFO_STRUCT) -> BOOL;
        type PSDP_ELEMENT_DATA = *mut SDP_ELEMENT_DATA;
        type PSDP_STRING_TYPE_DATA = *mut SDP_STRING_TYPE_DATA;
        struct SDP_ELEMENT_DATA {
            r#type: SDP_TYPE,
            specificType: SDP_SPECIFICTYPE,
            data: union {
                int128: SDP_LARGE_INTEGER_16,
                int64: LONGLONG,
                int32: LONG,
                int16: SHORT,
                int8: CHAR,
                uint128: SDP_ULARGE_INTEGER_16,
                uint64: ULONGLONG,
                uint32: ULONG,
                uint16: USHORT,
                uint8: UCHAR,
                booleanVal: UCHAR,
                uuid128: GUID,
                uuid32: ULONG,
                uuid16: USHORT,
                string: struct {
                    value: LPBYTE,
                    length: ULONG,
                },
                url: struct {
                    value: LPBYTE,
                    length: ULONG,
                },
                sequence: struct {
                    value: LPBYTE,
                    length: ULONG,
                },
                alternative: struct {
                    value: LPBYTE,
                    length: ULONG,
                },
            },
        }
        struct SDP_STRING_TYPE_DATA {
            encoding: USHORT,
            mibeNum: USHORT,
            attributeId: USHORT,
        }
    }
}
