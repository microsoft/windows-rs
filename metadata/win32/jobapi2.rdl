#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn AssignProcessToJobObject(#[in] hJob: HANDLE, #[in] hProcess: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn CreateJobObjectW(#[in] #[opt] lpJobAttributes: LPSECURITY_ATTRIBUTES, #[in] #[opt] lpName: LPCWSTR) -> HANDLE;
        #[library("KERNEL32.dll")]
        extern fn FreeMemoryJobObject(#[Windows::Win32::Metadata::NativeSal("L", "_Frees_ptr_", "", "")] #[in] Buffer: *mut void);
        struct JOBOBJECT_IO_RATE_CONTROL_INFORMATION {
            MaxIops: LONG64,
            MaxBandwidth: LONG64,
            ReservationIops: LONG64,
            VolumeName: PCWSTR,
            BaseIoSize: ULONG,
            ControlFlags: ULONG,
        }
        #[library("KERNEL32.dll")]
        extern fn OpenJobObjectW(#[in] dwDesiredAccess: DWORD, #[in] bInheritHandle: BOOL, #[in] lpName: LPCWSTR) -> HANDLE;
        #[library("KERNEL32.dll")]
        extern fn QueryInformationJobObject(#[in] #[opt] hJob: HANDLE, #[in] JobObjectInformationClass: JOBOBJECTINFOCLASS, #[out] #[writable(entry, bytes(cbJobObjectInformationLength))] #[readable(success, bytes(if_present(*lpReturnLength)))] lpJobObjectInformation: LPVOID, #[in] cbJobObjectInformationLength: DWORD, #[out] #[opt] lpReturnLength: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn QueryIoRateControlInformationJobObject(#[in] #[opt] hJob: HANDLE, #[in] #[opt] VolumeName: PCWSTR, #[out] #[writable(success, *InfoBlockCount, indirect)] InfoBlocks: *mut *mut JOBOBJECT_IO_RATE_CONTROL_INFORMATION, #[out] InfoBlockCount: *mut ULONG) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn SetInformationJobObject(#[in] hJob: HANDLE, #[in] JobObjectInformationClass: JOBOBJECTINFOCLASS, #[in] #[readable(entry, bytes(cbJobObjectInformationLength))] lpJobObjectInformation: LPVOID, #[in] cbJobObjectInformationLength: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetIoRateControlInformationJobObject(#[in] hJob: HANDLE, #[in] IoRateControlInfo: *mut JOBOBJECT_IO_RATE_CONTROL_INFORMATION) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn TerminateJobObject(#[in] hJob: HANDLE, #[in] uExitCode: UINT) -> BOOL;
    }
}
