#[win32]
mod Windows {
    mod Win32 {
        type CLSID = GUID;
        const CLSID_NULL: GUID = 0x00000000_0000_0000_0000_000000000000;
        type FMTID = GUID;
        const FMTID_NULL: GUID = 0x00000000_0000_0000_0000_000000000000;
        struct GUID {
            Data1: u32,
            Data2: u16,
            Data3: u16,
            Data4: [u8; 8],
        }
        type IID = GUID;
        const IID_NULL: GUID = 0x00000000_0000_0000_0000_000000000000;
        type LPCGUID = *const GUID;
        type LPCLSID = *mut GUID;
        type LPFMTID = *mut GUID;
        type LPGUID = *mut GUID;
        type LPIID = *mut GUID;
    }
}
