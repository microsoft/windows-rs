#[win32]
mod Windows {
    mod Win32 {
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn CopyFileFromAppW(#[in] lpExistingFileName: LPCWSTR, #[in] lpNewFileName: LPCWSTR, #[in] bFailIfExists: BOOL) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn CreateDirectoryFromAppW(#[in] lpPathName: LPCWSTR, #[in] #[opt] lpSecurityAttributes: LPSECURITY_ATTRIBUTES) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn CreateFile2FromAppW(#[in] lpFileName: LPCWSTR, #[in] dwDesiredAccess: DWORD, #[in] dwShareMode: DWORD, #[in] dwCreationDisposition: DWORD, #[in] #[opt] pCreateExParams: LPCREATEFILE2_EXTENDED_PARAMETERS) -> HANDLE;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn CreateFileFromAppW(#[in] lpFileName: LPCWSTR, #[in] dwDesiredAccess: DWORD, #[in] dwShareMode: DWORD, #[in] #[opt] lpSecurityAttributes: LPSECURITY_ATTRIBUTES, #[in] dwCreationDisposition: DWORD, #[in] dwFlagsAndAttributes: DWORD, #[in] #[opt] hTemplateFile: HANDLE) -> HANDLE;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn DeleteFileFromAppW(#[in] lpFileName: LPCWSTR) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn FindFirstFileExFromAppW(#[in] lpFileName: LPCWSTR, #[in] fInfoLevelId: FINDEX_INFO_LEVELS, #[incomplete] #[out] lpFindFileData: LPVOID, #[in] fSearchOp: FINDEX_SEARCH_OPS, #[reserved] lpSearchFilter: LPVOID, #[in] dwAdditionalFlags: DWORD) -> HANDLE;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn GetFileAttributesExFromAppW(#[in] lpFileName: LPCWSTR, #[in] fInfoLevelId: GET_FILEEX_INFO_LEVELS, #[incomplete] #[out] lpFileInformation: LPVOID) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn MoveFileFromAppW(#[in] lpExistingFileName: LPCWSTR, #[in] lpNewFileName: LPCWSTR) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn RemoveDirectoryFromAppW(#[in] lpPathName: LPCWSTR) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn ReplaceFileFromAppW(#[in] lpReplacedFileName: LPCWSTR, #[in] lpReplacementFileName: LPCWSTR, #[in] #[opt] lpBackupFileName: LPCWSTR, #[in] dwReplaceFlags: DWORD, #[reserved] lpExclude: LPVOID, #[reserved] lpReserved: LPVOID) -> BOOL;
        #[library("api-ms-win-core-file-fromapp-l1-1-0.dll")]
        extern fn SetFileAttributesFromAppW(#[in] lpFileName: LPCWSTR, #[in] dwFileAttributes: DWORD) -> BOOL;
    }
}
