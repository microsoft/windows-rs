            NVME_STATE_ZSIO = 2,
            NVME_STATE_ZSEO = 3,
            NVME_STATE_ZSC = 4,
            NVME_STATE_ZSRO = 13,
            NVME_STATE_ZSF = 14,
            NVME_STATE_ZSO = 15,
        }
    }
}
