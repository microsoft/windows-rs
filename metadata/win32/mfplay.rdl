        #[guid(0x90eb3e6b_ecbf_45cc_b1da_c6fe3ea70d57)]
        interface IMFPMediaItem: IUnknown {
            fn GetMediaPlayer(&self, #[out] ppMediaPlayer: *mut IMFPMediaPlayer) -> HRESULT;
            fn GetURL(&self, #[out] ppwszURL: *mut LPWSTR) -> HRESULT;
            fn GetObject(&self, #[out] ppIUnknown: *mut IUnknown) -> HRESULT;
            fn GetUserData(&self, #[out] pdwUserData: *mut DWORD_PTR) -> HRESULT;
            fn SetUserData(&self, #[in] dwUserData: DWORD_PTR) -> HRESULT;
            fn GetStartStopPosition(&self, #[opt] #[out] pguidStartPositionType: *mut GUID, #[opt] #[out] pvStartValue: *mut PROPVARIANT, #[opt] #[out] pguidStopPositionType: *mut GUID, #[opt] #[out] pvStopValue: *mut PROPVARIANT) -> HRESULT;
            fn SetStartStopPosition(&self, #[in] #[opt] pguidStartPositionType: *const GUID, #[in] #[opt] pvStartValue: *const PROPVARIANT, #[in] #[opt] pguidStopPositionType: *const GUID, #[in] #[opt] pvStopValue: *const PROPVARIANT) -> HRESULT;
            fn HasVideo(&self, #[opt] #[out] pfHasVideo: *mut BOOL, #[opt] #[out] pfSelected: *mut BOOL) -> HRESULT;
            fn HasAudio(&self, #[opt] #[out] pfHasAudio: *mut BOOL, #[opt] #[out] pfSelected: *mut BOOL) -> HRESULT;
            fn IsProtected(&self, #[out] pfProtected: *mut BOOL) -> HRESULT;
            fn GetDuration(&self, #[in] guidPositionType: &GUID, #[out] pvDurationValue: *mut PROPVARIANT) -> HRESULT;
            fn GetNumberOfStreams(&self, #[out] pdwStreamCount: *mut DWORD) -> HRESULT;
            fn GetStreamSelection(&self, #[in] dwStreamIndex: DWORD, #[out] pfEnabled: *mut BOOL) -> HRESULT;
            fn SetStreamSelection(&self, #[in] dwStreamIndex: DWORD, #[in] fEnabled: BOOL) -> HRESULT;
            fn GetStreamAttribute(&self, #[in] dwStreamIndex: DWORD, #[in] guidMFAttribute: &GUID, #[out] pvValue: *mut PROPVARIANT) -> HRESULT;
            fn GetPresentationAttribute(&self, #[in] guidMFAttribute: &GUID, #[out] pvValue: *mut PROPVARIANT) -> HRESULT;
            fn GetCharacteristics(&self, #[out] pCharacteristics: *mut MFP_MEDIAITEM_CHARACTERISTICS) -> HRESULT;
            fn SetStreamSink(&self, #[in] dwStreamIndex: DWORD, #[in] #[opt] pMediaSink: IUnknown) -> HRESULT;
            fn GetMetadata(&self, #[out] ppMetadataStore: *mut IPropertyStore) -> HRESULT;
        }
        #[guid(0xa714590a_58af_430a_85bf_44f5ec838d85)]
        interface IMFPMediaPlayer: IUnknown {
            fn Play(&self) -> HRESULT;
            fn Pause(&self) -> HRESULT;
            fn Stop(&self) -> HRESULT;
            fn FrameStep(&self) -> HRESULT;
            fn SetPosition(&self, #[in] guidPositionType: &GUID, #[in] pvPositionValue: *const PROPVARIANT) -> HRESULT;
            fn GetPosition(&self, #[in] guidPositionType: &GUID, #[out] pvPositionValue: *mut PROPVARIANT) -> HRESULT;
            fn GetDuration(&self, #[in] guidPositionType: &GUID, #[out] pvDurationValue: *mut PROPVARIANT) -> HRESULT;
            fn SetRate(&self, #[in] flRate: f32) -> HRESULT;
            fn GetRate(&self, #[out] pflRate: *mut f32) -> HRESULT;
            fn GetSupportedRates(&self, #[in] fForwardDirection: BOOL, #[out] pflSlowestRate: *mut f32, #[out] pflFastestRate: *mut f32) -> HRESULT;
            fn GetState(&self, #[out] peState: *mut MFP_MEDIAPLAYER_STATE) -> HRESULT;
            fn CreateMediaItemFromURL(&self, #[in] pwszURL: LPCWSTR, #[in] fSync: BOOL, #[in] dwUserData: DWORD_PTR, #[opt] #[out] ppMediaItem: *mut IMFPMediaItem) -> HRESULT;
            fn CreateMediaItemFromObject(&self, #[in] pIUnknownObj: IUnknown, #[in] fSync: BOOL, #[in] dwUserData: DWORD_PTR, #[opt] #[out] ppMediaItem: *mut IMFPMediaItem) -> HRESULT;
            fn SetMediaItem(&self, #[in] pIMFPMediaItem: IMFPMediaItem) -> HRESULT;
            fn ClearMediaItem(&self) -> HRESULT;
            fn GetMediaItem(&self, #[out] ppIMFPMediaItem: *mut IMFPMediaItem) -> HRESULT;
            fn GetVolume(&self, #[out] pflVolume: *mut f32) -> HRESULT;
            fn SetVolume(&self, #[in] flVolume: f32) -> HRESULT;
            fn GetBalance(&self, #[out] pflBalance: *mut f32) -> HRESULT;
            fn SetBalance(&self, #[in] flBalance: f32) -> HRESULT;
            fn GetMute(&self, #[out] pfMute: *mut BOOL) -> HRESULT;
            fn SetMute(&self, #[in] fMute: BOOL) -> HRESULT;
            fn GetNativeVideoSize(&self, #[opt] #[out] pszVideo: *mut SIZE, #[opt] #[out] pszARVideo: *mut SIZE) -> HRESULT;
            fn GetIdealVideoSize(&self, #[opt] #[out] pszMin: *mut SIZE, #[opt] #[out] pszMax: *mut SIZE) -> HRESULT;
            fn SetVideoSourceRect(&self, #[in] pnrcSource: *const MFVideoNormalizedRect) -> HRESULT;
            fn GetVideoSourceRect(&self, #[out] pnrcSource: *mut MFVideoNormalizedRect) -> HRESULT;
            fn SetAspectRatioMode(&self, #[in] dwAspectRatioMode: DWORD) -> HRESULT;
            fn GetAspectRatioMode(&self, #[out] pdwAspectRatioMode: *mut DWORD) -> HRESULT;
            fn GetVideoWindow(&self, #[out] phwndVideo: *mut HWND) -> HRESULT;
            fn UpdateVideo(&self) -> HRESULT;
            fn SetBorderColor(&self, #[in] Clr: COLORREF) -> HRESULT;
            fn GetBorderColor(&self, #[out] pClr: *mut COLORREF) -> HRESULT;
            fn InsertEffect(&self, #[in] pEffect: IUnknown, #[in] fOptional: BOOL) -> HRESULT;
            fn RemoveEffect(&self, #[in] pEffect: IUnknown) -> HRESULT;
            fn RemoveAllEffects(&self) -> HRESULT;
            fn Shutdown(&self) -> HRESULT;
        }
        #[guid(0x766c8ffb_5fdb_4fea_a28d_b912996f51bd)]
        interface IMFPMediaPlayerCallback: IUnknown {
            fn OnMediaPlayerEvent(&self, #[in] pEventHeader: *mut MFP_EVENT_HEADER);
