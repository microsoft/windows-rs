        const TS_TC_CORRECTION: i32 = 1;
        struct TS_TEXTCHANGE {
            acpStart: LONG,
            acpOldEnd: LONG,
            acpNewEnd: LONG,
        }
        const TS_VCOOKIE_NUL: u32 = 4294967295;
        #[repr(i32)]
        enum TsActiveSelEnd {
            TS_AE_NONE = 0,
            TS_AE_START = 1,
            TS_AE_END = 2,
        }
        #[repr(i32)]
        enum TsGravity {
            TS_GR_BACKWARD = 0,
            TS_GR_FORWARD = 1,
        }
        #[repr(i32)]
        enum TsLayoutCode {
            TS_LC_CREATE = 0,
            TS_LC_CHANGE = 1,
            TS_LC_DESTROY = 2,
        }
        #[repr(i32)]
        enum TsRunType {
            TS_RT_PLAIN = 0,
            TS_RT_HIDDEN = 1,
            TS_RT_OPAQUE = 2,
        }
        #[repr(i32)]
        enum TsShiftDir {
            TS_SD_BACKWARD = 0,
            TS_SD_FORWARD = 1,
        }
        type TsViewCookie = u32;
    }
}
