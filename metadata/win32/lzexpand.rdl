#[win32]
mod Windows {
    mod Win32 {
        #[library("LZ32.dll")]
        #[must_use]
        extern fn CopyLZFile(#[in] hfSource: INT, #[in] hfDest: INT) -> LONG;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn GetExpandedNameA(#[in] lpszSource: LPSTR, #[out] #[writable(entry, 260)] lpszBuffer: LPSTR) -> INT;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn GetExpandedNameW(#[in] lpszSource: LPWSTR, #[out] #[writable(entry, 260)] lpszBuffer: LPWSTR) -> INT;
        #[library("LZ32.dll")]
        extern fn LZClose(#[in] hFile: INT);
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZCopy(#[in] hfSource: INT, #[in] hfDest: INT) -> LONG;
        #[library("LZ32.dll")]
        extern fn LZDone();
        const LZERROR_BADINHANDLE: i32 = -1;
        const LZERROR_BADOUTHANDLE: i32 = -2;
        const LZERROR_BADVALUE: i32 = -7;
        const LZERROR_GLOBALLOC: i32 = -5;
        const LZERROR_GLOBLOCK: i32 = -6;
        const LZERROR_READ: i32 = -3;
        const LZERROR_UNKNOWNALG: i32 = -8;
        const LZERROR_WRITE: i32 = -4;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZInit(#[in] hfSource: INT) -> INT;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZOpenFileA(#[in] lpFileName: LPSTR, #[in] #[out] lpReOpenBuf: LPOFSTRUCT, #[in] wStyle: WORD) -> INT;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZOpenFileW(#[in] lpFileName: LPWSTR, #[in] #[out] lpReOpenBuf: LPOFSTRUCT, #[in] wStyle: WORD) -> INT;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZRead(#[in] hFile: INT, #[incomplete] #[out] #[writable(entry, bytes(cbRead))] lpBuffer: *mut CHAR, #[in] cbRead: INT) -> INT;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZSeek(#[in] hFile: INT, #[in] lOffset: LONG, #[in] iOrigin: INT) -> LONG;
        #[library("LZ32.dll")]
        #[must_use]
        extern fn LZStart() -> INT;
    }
}
