#[win32]
mod Windows {
    mod Win32 {
        struct CONFIG_INFO_0 {
            cfgi0_key: LPWSTR,
            cfgi0_data: LPWSTR,
        }
        type LPCONFIG_INFO_0 = *mut CONFIG_INFO_0;
        #[library("NETAPI32.dll")]
        extern fn NetConfigGet(server: LPCWSTR, component: LPCWSTR, parameter: LPCWSTR, bufptr: *mut LPBYTE) -> DWORD;
        #[library("NETAPI32.dll")]
        extern fn NetConfigGetAll(server: LPCWSTR, component: LPCWSTR, bufptr: *mut LPBYTE) -> DWORD;
        #[library("NETAPI32.dll")]
        extern fn NetConfigSet(server: LPCWSTR, reserved1: LPCWSTR, component: LPCWSTR, level: DWORD, reserved2: DWORD, buf: LPBYTE, reserved3: DWORD) -> DWORD;
        type PCONFIG_INFO_0 = *mut CONFIG_INFO_0;
    }
}
