#[win32]
mod Windows {
    mod Win32 {
        type NTPROP = *mut void;
        #[library("ole32.dll")]
        extern fn StgPropertyLengthAsVariant(#[buffer(bytes(cbProp))] #[in] pProp: *const SERIALIZEDPROPERTYVALUE, #[in] cbProp: ULONG, #[in] CodePage: USHORT, #[reserved] bReserved: BYTE) -> ULONG;
    }
}
