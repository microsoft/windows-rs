#[win32]
mod Windows {
    mod Win32 {
        type CRYPT_DIGEST_DATA = _CRYPTOAPI_BLOB;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPAddProvider(psNewProv: *mut SIP_ADD_NEWPROVIDER) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPCreateIndirectData(pSubjectInfo: *mut SIP_SUBJECTINFO, pcbIndirectData: *mut DWORD, pIndirectData: *mut SIP_INDIRECT_DATA) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPGetCaps(#[in] pSubjInfo: *mut SIP_SUBJECTINFO, #[in] #[out] pCaps: *mut SIP_CAP_SET) -> BOOL;
        #[success(return != 0)]
        #[library("CRYPT32.dll")]
        extern fn CryptSIPGetSealedDigest(#[in] pSubjectInfo: *mut SIP_SUBJECTINFO, #[Windows::Win32::Metadata::NativeSal("1.1", "_In_opt_count_", "dwSig", "dwSig")] pSig: *const BYTE, #[in] dwSig: DWORD, #[out] #[opt] #[writable(entry, *pcbDigest)] pbDigest: *mut BYTE, #[in] #[out] pcbDigest: *mut DWORD) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPGetSignedDataMsg(pSubjectInfo: *mut SIP_SUBJECTINFO, pdwEncodingType: *mut DWORD, dwIndex: DWORD, pcbSignedDataMsg: *mut DWORD, pbSignedDataMsg: *mut BYTE) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPLoad(pgSubject: *const GUID, dwFlags: DWORD, pSipDispatch: *mut SIP_DISPATCH_INFO) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPPutSignedDataMsg(pSubjectInfo: *mut SIP_SUBJECTINFO, dwEncodingType: DWORD, pdwIndex: *mut DWORD, cbSignedDataMsg: DWORD, pbSignedDataMsg: *mut BYTE) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPRemoveProvider(pgProv: *mut GUID) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPRemoveSignedDataMsg(pSubjectInfo: *mut SIP_SUBJECTINFO, dwIndex: DWORD) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPRetrieveSubjectGuid(FileName: LPCWSTR, hFileIn: HANDLE, pgSubject: *mut GUID) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPRetrieveSubjectGuidForCatalogFile(FileName: LPCWSTR, hFileIn: HANDLE, pgSubject: *mut GUID) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptSIPVerifyIndirectData(pSubjectInfo: *mut SIP_SUBJECTINFO, pIndirectData: *mut SIP_INDIRECT_DATA) -> BOOL;
        type LPSIP_DISPATCH_INFO = *mut SIP_DISPATCH_INFO;
        type LPSIP_SUBJECTINFO = *mut SIP_SUBJECTINFO;
        const MSSIP_ADDINFO_BLOB: i32 = 3;
        const MSSIP_ADDINFO_CATMEMBER: i32 = 2;
        const MSSIP_ADDINFO_DETACHEDSIG: i32 = 4;
        const MSSIP_ADDINFO_FLAT: i32 = 1;
        const MSSIP_ADDINFO_NONE: i32 = 0;
        const MSSIP_ADDINFO_NONMSSIP: i32 = 500;
        const MSSIP_FLAGS_MULTI_HASH: i32 = 262144;
        const MSSIP_FLAGS_PROHIBIT_RESIZE_ON_CREATE: i32 = 65536;
        const MSSIP_FLAGS_USE_CATALOG: i32 = 131072;
        #[packed(8)]
        struct MS_ADDINFO_BLOB {
            cbStruct: DWORD,
            cbMemObject: DWORD,
            pbMemObject: *mut BYTE,
            cbMemSignedMsg: DWORD,
            pbMemSignedMsg: *mut BYTE,
        }
        #[packed(8)]
        struct MS_ADDINFO_CATALOGMEMBER {
            cbStruct: DWORD,
            pStore: *mut CRYPTCATSTORE,
            pMember: *mut CRYPTCATMEMBER,
        }
        #[packed(8)]
        struct MS_ADDINFO_DETACHEDSIG {
            cbStruct: DWORD,
            hSignatureFile: HANDLE,
            cbSignatureObject: DWORD,
            pbSignatureObject: *mut BYTE,
        }
        #[packed(8)]
        struct MS_ADDINFO_FLAT {
            cbStruct: DWORD,
            pIndirectData: *mut SIP_INDIRECT_DATA,
        }
        type PMS_ADDINFO_BLOB = *mut MS_ADDINFO_BLOB;
        type PMS_ADDINFO_CATALOGMEMBER = *mut MS_ADDINFO_CATALOGMEMBER;
        type PMS_ADDINFO_DETACHEDSIG = *mut MS_ADDINFO_DETACHEDSIG;
        type PMS_ADDINFO_FLAT = *mut MS_ADDINFO_FLAT;
        type PSIP_ADD_NEWPROVIDER = *mut SIP_ADD_NEWPROVIDER;
        type PSIP_CAP_SET = *mut SIP_CAP_SET_V3;
        type PSIP_CAP_SET_V2 = *mut SIP_CAP_SET_V2;
        type PSIP_CAP_SET_V3 = *mut SIP_CAP_SET_V3;
        type PSIP_INDIRECT_DATA = *mut SIP_INDIRECT_DATA;
        #[packed(8)]
        struct SIP_ADD_NEWPROVIDER {
            cbStruct: DWORD,
            pgSubject: *mut GUID,
            pwszDLLFileName: *mut WCHAR,
            pwszMagicNumber: *mut WCHAR,
            pwszIsFunctionName: *mut WCHAR,
            pwszGetFuncName: *mut WCHAR,
            pwszPutFuncName: *mut WCHAR,
            pwszCreateFuncName: *mut WCHAR,
            pwszVerifyFuncName: *mut WCHAR,
            pwszRemoveFuncName: *mut WCHAR,
            pwszIsFunctionNameFmt2: *mut WCHAR,
            pwszGetCapFuncName: PWSTR,
        }
        const SIP_CAP_FLAG_SEALING: i32 = 1;
        type SIP_CAP_SET = SIP_CAP_SET_V3;
        const SIP_CAP_SET_CUR_VER: i32 = 3;
        #[packed(8)]
        struct SIP_CAP_SET_V2 {
            cbSize: DWORD,
            dwVersion: DWORD,
            isMultiSign: BOOL,
            dwReserved: DWORD,
        }
        #[packed(8)]
        struct SIP_CAP_SET_V3 {
            cbSize: DWORD,
            dwVersion: DWORD,
            isMultiSign: BOOL,
            Anonymous: #[packed(8)] union {
                dwFlags: DWORD,
                dwReserved: DWORD,
            },
        }
        const SIP_CAP_SET_VERSION_2: i32 = 2;
        const SIP_CAP_SET_VERSION_3: i32 = 3;
        #[packed(8)]
        struct SIP_DISPATCH_INFO {
            cbSize: DWORD,
            hSIP: HANDLE,
            pfGet: pCryptSIPGetSignedDataMsg,
            pfPut: pCryptSIPPutSignedDataMsg,
            pfCreate: pCryptSIPCreateIndirectData,
            pfVerify: pCryptSIPVerifyIndirectData,
            pfRemove: pCryptSIPRemoveSignedDataMsg,
        }
        #[packed(8)]
        struct SIP_INDIRECT_DATA {
            Data: CRYPT_ATTRIBUTE_TYPE_VALUE,
            DigestAlgorithm: CRYPT_ALGORITHM_IDENTIFIER,
            Digest: CRYPT_HASH_BLOB,
        }
        const SIP_MAX_MAGIC_NUMBER: i32 = 4;
        #[packed(8)]
        struct SIP_SUBJECTINFO {
            cbSize: DWORD,
            pgSubjectType: *mut GUID,
            hFile: HANDLE,
            pwsFileName: LPCWSTR,
            pwsDisplayName: LPCWSTR,
            dwReserved1: DWORD,
            dwIntVersion: DWORD,
            hProv: HCRYPTPROV,
            DigestAlgorithm: CRYPT_ALGORITHM_IDENTIFIER,
            dwFlags: DWORD,
            dwEncodingType: DWORD,
            dwReserved2: DWORD,
            fdwCAPISettings: DWORD,
            fdwSecuritySettings: DWORD,
            dwIndex: DWORD,
            dwUnionChoice: DWORD,
            Anonymous: #[packed(8)] union {
                psFlat: *mut MS_ADDINFO_FLAT,
                psCatMember: *mut MS_ADDINFO_CATALOGMEMBER,
                psBlob: *mut MS_ADDINFO_BLOB,
                psDetachedSig: *mut MS_ADDINFO_DETACHEDSIG,
            },
            pClientData: LPVOID,
        }
        const SPC_DIGEST_GENERATE_FLAG: i32 = 512;
        const SPC_DIGEST_SIGN_EX_FLAG: i32 = 16384;
        const SPC_DIGEST_SIGN_FLAG: i32 = 1024;
        const SPC_EXC_PE_PAGE_HASHES_FLAG: i32 = 16;
        const SPC_INC_PE_DEBUG_INFO_FLAG: i32 = 64;
        const SPC_INC_PE_IMPORT_ADDR_TABLE_FLAG: i32 = 32;
        const SPC_INC_PE_PAGE_HASHES_FLAG: i32 = 256;
        const SPC_INC_PE_RESOURCES_FLAG: i32 = 128;
        const SPC_MARKER_CHECK_CURRENTLY_SUPPORTED_FLAGS: i32 = 1;
        const SPC_MARKER_CHECK_SKIP_SIP_INDIRECT_DATA_FLAG: i32 = 1;
        const SPC_RELAXED_PE_MARKER_CHECK: i32 = 2048;
        extern fn pCryptSIPCreateIndirectData(pSubjectInfo: *mut SIP_SUBJECTINFO, pcbIndirectData: *mut DWORD, pIndirectData: *mut SIP_INDIRECT_DATA) -> BOOL;
        extern fn pCryptSIPGetCaps(#[in] pSubjInfo: *mut SIP_SUBJECTINFO, #[in] #[out] pCaps: *mut SIP_CAP_SET) -> BOOL;
        #[success(return != 0)]
        extern fn pCryptSIPGetSealedDigest(#[in] pSubjectInfo: *mut SIP_SUBJECTINFO, #[Windows::Win32::Metadata::NativeSal("1.1", "_In_opt_count_", "dwSig", "dwSig")] pSig: *const BYTE, #[in] dwSig: DWORD, #[out] #[opt] #[writable(entry, *pcbDigest)] pbDigest: *mut BYTE, #[in] #[out] pcbDigest: *mut DWORD) -> BOOL;
        extern fn pCryptSIPGetSignedDataMsg(pSubjectInfo: *mut SIP_SUBJECTINFO, pdwEncodingType: *mut DWORD, dwIndex: DWORD, pcbSignedDataMsg: *mut DWORD, pbSignedDataMsg: *mut BYTE) -> BOOL;
        extern fn pCryptSIPPutSignedDataMsg(pSubjectInfo: *mut SIP_SUBJECTINFO, dwEncodingType: DWORD, pdwIndex: *mut DWORD, cbSignedDataMsg: DWORD, pbSignedDataMsg: *mut BYTE) -> BOOL;
        extern fn pCryptSIPRemoveSignedDataMsg(pSubjectInfo: *mut SIP_SUBJECTINFO, dwIndex: DWORD) -> BOOL;
        extern fn pCryptSIPVerifyIndirectData(pSubjectInfo: *mut SIP_SUBJECTINFO, pIndirectData: *mut SIP_INDIRECT_DATA) -> BOOL;
        extern fn pfnIsFileSupported(hFile: HANDLE, pgSubject: *mut GUID) -> BOOL;
        extern fn pfnIsFileSupportedName(pwszFileName: *mut WCHAR, pgSubject: *mut GUID) -> BOOL;
    }
}
