#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn AddConsoleAliasA(#[in] Source: LPSTR, #[in] Target: LPSTR, #[in] ExeName: LPSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn AddConsoleAliasW(#[in] Source: LPWSTR, #[in] Target: LPWSTR, #[in] ExeName: LPWSTR) -> BOOL;
        struct CONSOLE_FONT_INFOEX {
            cbSize: ULONG,
            nFont: DWORD,
            dwFontSize: COORD,
            FontFamily: UINT,
            FontWeight: UINT,
            FaceName: [WCHAR; 32],
        }
        const CONSOLE_FULLSCREEN: i32 = 1;
        const CONSOLE_FULLSCREEN_HARDWARE: i32 = 2;
        const CONSOLE_FULLSCREEN_MODE: i32 = 1;
        struct CONSOLE_HISTORY_INFO {
            cbSize: UINT,
            HistoryBufferSize: UINT,
            NumberOfHistoryBuffers: UINT,
            dwFlags: DWORD,
        }
        const CONSOLE_MOUSE_DOWN: i32 = 8;
        const CONSOLE_MOUSE_SELECTION: i32 = 4;
        const CONSOLE_NO_SELECTION: i32 = 0;
        struct CONSOLE_SELECTION_INFO {
            dwFlags: DWORD,
            dwSelectionAnchor: COORD,
            srSelection: SMALL_RECT,
        }
        const CONSOLE_SELECTION_IN_PROGRESS: i32 = 1;
        const CONSOLE_SELECTION_NOT_EMPTY: i32 = 2;
        const CONSOLE_WINDOWED_MODE: i32 = 2;
        #[library("KERNEL32.dll")]
        extern fn ExpungeConsoleCommandHistoryA(#[in] ExeName: LPSTR);
        #[library("KERNEL32.dll")]
        extern fn ExpungeConsoleCommandHistoryW(#[in] ExeName: LPWSTR);
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasA(#[in] Source: LPSTR, #[out] #[writable(entry, TargetBufferLength)] TargetBuffer: LPSTR, #[in] TargetBufferLength: DWORD, #[in] ExeName: LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasExesA(#[out] #[writable(entry, ExeNameBufferLength)] ExeNameBuffer: LPSTR, #[in] ExeNameBufferLength: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasExesLengthA() -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasExesLengthW() -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasExesW(#[out] #[writable(entry, ExeNameBufferLength)] ExeNameBuffer: LPWSTR, #[in] ExeNameBufferLength: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasW(#[in] Source: LPWSTR, #[out] #[writable(entry, TargetBufferLength)] TargetBuffer: LPWSTR, #[in] TargetBufferLength: DWORD, #[in] ExeName: LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasesA(#[out] #[writable(entry, AliasBufferLength)] AliasBuffer: LPSTR, #[in] AliasBufferLength: DWORD, #[in] ExeName: LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasesLengthA(#[in] ExeName: LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasesLengthW(#[in] ExeName: LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleAliasesW(#[out] #[writable(entry, AliasBufferLength)] AliasBuffer: LPWSTR, #[in] AliasBufferLength: DWORD, #[in] ExeName: LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleCommandHistoryA(#[out] #[writable(entry, bytes(CommandBufferLength))] Commands: LPSTR, #[in] CommandBufferLength: DWORD, #[in] ExeName: LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleCommandHistoryLengthA(#[in] ExeName: LPSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleCommandHistoryLengthW(#[in] ExeName: LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleCommandHistoryW(#[out] #[writable(entry, bytes(CommandBufferLength))] Commands: LPWSTR, #[in] CommandBufferLength: DWORD, #[in] ExeName: LPWSTR) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleDisplayMode(#[out] lpModeFlags: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleFontSize(#[in] hConsoleOutput: HANDLE, #[in] nFont: DWORD) -> COORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleHistoryInfo(#[out] lpConsoleHistoryInfo: PCONSOLE_HISTORY_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleProcessList(#[out] #[writable(entry, dwProcessCount)] lpdwProcessList: LPDWORD, #[in] dwProcessCount: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleSelectionInfo(#[out] lpConsoleSelectionInfo: PCONSOLE_SELECTION_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleWindow() -> HWND;
        #[library("KERNEL32.dll")]
        extern fn GetCurrentConsoleFont(#[in] hConsoleOutput: HANDLE, #[in] bMaximumWindow: BOOL, #[out] lpConsoleCurrentFont: PCONSOLE_FONT_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetCurrentConsoleFontEx(#[in] hConsoleOutput: HANDLE, #[in] bMaximumWindow: BOOL, #[out] lpConsoleCurrentFontEx: PCONSOLE_FONT_INFOEX) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNumberOfConsoleMouseButtons(#[out] lpNumberOfMouseButtons: LPDWORD) -> BOOL;
        const HISTORY_NO_DUP_FLAG: i32 = 1;
        type PCONSOLE_FONT_INFOEX = *mut CONSOLE_FONT_INFOEX;
        type PCONSOLE_HISTORY_INFO = *mut CONSOLE_HISTORY_INFO;
        type PCONSOLE_SELECTION_INFO = *mut CONSOLE_SELECTION_INFO;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleDisplayMode(#[in] hConsoleOutput: HANDLE, #[in] dwFlags: DWORD, #[out] #[opt] lpNewScreenBufferDimensions: PCOORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleHistoryInfo(#[in] lpConsoleHistoryInfo: PCONSOLE_HISTORY_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleNumberOfCommandsA(#[in] Number: DWORD, #[in] ExeName: LPSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleNumberOfCommandsW(#[in] Number: DWORD, #[in] ExeName: LPWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetCurrentConsoleFontEx(#[in] hConsoleOutput: HANDLE, #[in] bMaximumWindow: BOOL, #[in] lpConsoleCurrentFontEx: PCONSOLE_FONT_INFOEX) -> BOOL;
    }
}
