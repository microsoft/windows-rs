#[win32]
mod Windows {
    mod Win32 {
        #[library("MSWSOCK.dll")]
        extern fn AcceptEx(#[in] sListenSocket: SOCKET, #[in] sAcceptSocket: SOCKET, #[out] #[writable(entry, bytes(dwReceiveDataLength + dwLocalAddressLength + dwRemoteAddressLength))] lpOutputBuffer: PVOID, #[in] dwReceiveDataLength: DWORD, #[in] dwLocalAddressLength: DWORD, #[in] dwRemoteAddressLength: DWORD, #[out] lpdwBytesReceived: LPDWORD, #[in] #[out] lpOverlapped: LPOVERLAPPED) -> BOOL;
        const DE_REUSE_SOCKET: i32 = 2;
        #[library("MSWSOCK.dll")]
        extern fn GetAcceptExSockaddrs(#[in] #[readable(entry, bytes(dwReceiveDataLength + dwLocalAddressLength + dwRemoteAddressLength))] lpOutputBuffer: PVOID, #[in] dwReceiveDataLength: DWORD, #[in] dwLocalAddressLength: DWORD, #[in] dwRemoteAddressLength: DWORD, #[out] #[writable(success, bytes(*LocalSockaddrLength), indirect)] LocalSockaddr: *mut *mut SOCKADDR, #[out] LocalSockaddrLength: LPINT, #[out] #[writable(success, bytes(*RemoteSockaddrLength), indirect)] RemoteSockaddr: *mut *mut SOCKADDR, #[out] RemoteSockaddrLength: LPINT);
        extern fn LPFN_ACCEPTEX(#[in] sListenSocket: SOCKET, #[in] sAcceptSocket: SOCKET, #[out] #[writable(entry, bytes(dwReceiveDataLength + dwLocalAddressLength + dwRemoteAddressLength))] lpOutputBuffer: PVOID, #[in] dwReceiveDataLength: DWORD, #[in] dwLocalAddressLength: DWORD, #[in] dwRemoteAddressLength: DWORD, #[out] lpdwBytesReceived: LPDWORD, #[in] #[out] lpOverlapped: LPOVERLAPPED) -> BOOL;
        extern fn LPFN_CONNECTEX(#[in] s: SOCKET, #[in] #[readable(entry, bytes(namelen))] name: *const SOCKADDR, #[in] namelen: i32, #[in] #[opt] #[readable(entry, bytes(dwSendDataLength))] lpSendBuffer: PVOID, #[in] dwSendDataLength: DWORD, #[out] lpdwBytesSent: LPDWORD, #[in] #[out] lpOverlapped: LPOVERLAPPED) -> BOOL;
        extern fn LPFN_DISCONNECTEX(#[in] s: SOCKET, #[in] #[opt] #[out] lpOverlapped: LPOVERLAPPED, #[in] dwFlags: DWORD, #[in] dwReserved: DWORD) -> BOOL;
        extern fn LPFN_GETACCEPTEXSOCKADDRS(#[in] #[readable(entry, bytes(dwReceiveDataLength + dwLocalAddressLength + dwRemoteAddressLength))] lpOutputBuffer: PVOID, #[in] dwReceiveDataLength: DWORD, #[in] dwLocalAddressLength: DWORD, #[in] dwRemoteAddressLength: DWORD, #[out] #[writable(success, bytes(*LocalSockaddrLength), indirect)] LocalSockaddr: *mut *mut SOCKADDR, #[out] LocalSockaddrLength: LPINT, #[out] #[writable(success, bytes(*RemoteSockaddrLength), indirect)] RemoteSockaddr: *mut *mut SOCKADDR, #[out] RemoteSockaddrLength: LPINT);
        extern fn LPFN_RIOCLOSECOMPLETIONQUEUE(#[in] CQ: RIO_CQ);
        extern fn LPFN_RIOCREATECOMPLETIONQUEUE(#[in] QueueSize: DWORD, #[in] #[opt] NotificationCompletion: PRIO_NOTIFICATION_COMPLETION) -> RIO_CQ;
        extern fn LPFN_RIOCREATEREQUESTQUEUE(#[in] Socket: SOCKET, #[in] MaxOutstandingReceive: ULONG, #[in] MaxReceiveDataBuffers: ULONG, #[in] MaxOutstandingSend: ULONG, #[in] MaxSendDataBuffers: ULONG, #[in] ReceiveCQ: RIO_CQ, #[in] SendCQ: RIO_CQ, #[in] #[opt] SocketContext: PVOID) -> RIO_RQ;
        extern fn LPFN_RIODEQUEUECOMPLETION(#[in] CQ: RIO_CQ, #[incomplete] #[out] #[writable(entry, ArraySize)] Array: PRIORESULT, #[in] ArraySize: ULONG) -> ULONG;
        extern fn LPFN_RIODEREGISTERBUFFER(#[in] BufferId: RIO_BUFFERID);
        extern fn LPFN_RIONOTIFY(#[in] CQ: RIO_CQ) -> INT;
        extern fn LPFN_RIORECEIVE(#[in] SocketQueue: RIO_RQ, #[in] #[readable(entry, DataBufferCount)] pData: PRIO_BUF, #[in] DataBufferCount: ULONG, #[in] Flags: DWORD, #[in] #[opt] RequestContext: PVOID) -> BOOL;
        extern fn LPFN_RIORECEIVEEX(#[in] SocketQueue: RIO_RQ, #[in] #[readable(entry, DataBufferCount)] pData: PRIO_BUF, #[in] DataBufferCount: ULONG, #[in] #[opt] pLocalAddress: PRIO_BUF, #[in] #[opt] pRemoteAddress: PRIO_BUF, #[in] #[opt] pControlContext: PRIO_BUF, #[in] #[opt] pFlags: PRIO_BUF, #[in] Flags: DWORD, #[in] #[opt] RequestContext: PVOID) -> i32;
        extern fn LPFN_RIOREGISTERBUFFER(#[in] DataBuffer: PCHAR, #[in] DataLength: DWORD) -> RIO_BUFFERID;
        extern fn LPFN_RIORESIZECOMPLETIONQUEUE(#[in] CQ: RIO_CQ, #[in] QueueSize: DWORD) -> BOOL;
        extern fn LPFN_RIORESIZEREQUESTQUEUE(#[in] RQ: RIO_RQ, #[in] MaxOutstandingReceive: DWORD, #[in] MaxOutstandingSend: DWORD) -> BOOL;
        extern fn LPFN_RIOSEND(#[in] SocketQueue: RIO_RQ, #[in] #[readable(entry, DataBufferCount)] pData: PRIO_BUF, #[in] DataBufferCount: ULONG, #[in] Flags: DWORD, #[in] #[opt] RequestContext: PVOID) -> BOOL;
        extern fn LPFN_RIOSENDEX(#[in] SocketQueue: RIO_RQ, #[in] #[readable(entry, DataBufferCount)] pData: PRIO_BUF, #[in] DataBufferCount: ULONG, #[in] #[opt] pLocalAddress: PRIO_BUF, #[in] #[opt] pRemoteAddress: PRIO_BUF, #[in] #[opt] pControlContext: PRIO_BUF, #[in] #[opt] pFlags: PRIO_BUF, #[in] Flags: DWORD, #[in] #[opt] RequestContext: PVOID) -> BOOL;
        extern fn LPFN_TRANSMITFILE(#[in] hSocket: SOCKET, #[in] hFile: HANDLE, #[in] nNumberOfBytesToWrite: DWORD, #[in] nNumberOfBytesPerSend: DWORD, #[in] #[opt] #[out] lpOverlapped: LPOVERLAPPED, #[in] #[opt] lpTransmitBuffers: LPTRANSMIT_FILE_BUFFERS, #[in] dwReserved: DWORD) -> BOOL;
        extern fn LPFN_TRANSMITPACKETS(#[in] hSocket: SOCKET, #[in] #[opt] lpPacketArray: LPTRANSMIT_PACKETS_ELEMENT, #[in] nElementCount: DWORD, #[in] nSendSize: DWORD, #[in] #[opt] #[out] lpOverlapped: LPOVERLAPPED, #[in] dwFlags: DWORD) -> BOOL;
        extern fn LPFN_WSAPOLL(#[in] #[out] fdarray: LPWSAPOLLFD, #[in] nfds: ULONG, #[in] timeout: INT) -> INT;
        extern fn LPFN_WSARECVMSG(#[in] s: SOCKET, #[in] #[out] lpMsg: LPWSAMSG, #[opt] #[out] lpdwNumberOfBytesRecvd: LPDWORD, #[in] #[opt] #[out] lpOverlapped: LPWSAOVERLAPPED, #[in] #[opt] lpCompletionRoutine: LPWSAOVERLAPPED_COMPLETION_ROUTINE) -> INT;
        extern fn LPFN_WSASENDMSG(#[in] s: SOCKET, #[in] lpMsg: LPWSAMSG, #[in] dwFlags: DWORD, #[opt] #[out] lpNumberOfBytesSent: LPDWORD, #[in] #[opt] #[out] lpOverlapped: LPWSAOVERLAPPED, #[in] #[opt] lpCompletionRoutine: LPWSAOVERLAPPED_COMPLETION_ROUTINE) -> INT;
        type LPNLA_BLOB = *mut NLA_BLOB;
        type LPTRANSMIT_FILE_BUFFERS = *mut TRANSMIT_FILE_BUFFERS;
        type LPTRANSMIT_PACKETS_ELEMENT = *mut TRANSMIT_PACKETS_ELEMENT;
        type LPWSAPOLLDATA = *mut WSAPOLLDATA;
        type LPWSASENDMSG = *mut WSASENDMSG;
        const NLA_ALLUSERS_NETWORK: i32 = 1;
        struct NLA_BLOB {
            header: struct {
                r#type: NLA_BLOB_DATA_TYPE,
                dwSize: DWORD,
                nextOffset: DWORD,
            },
            data: union {
                rawData: [CHAR; 1],
                interfaceData: struct {
                    dwType: DWORD,
                    dwSpeed: DWORD,
                    adapterName: [CHAR; 1],
                },
                locationData: struct {
                    information: [CHAR; 1],
                },
                connectivity: struct {
                    r#type: NLA_CONNECTIVITY_TYPE,
                    internet: NLA_INTERNET,
                },
                ICS: struct {
                    remote: struct {
                        speed: DWORD,
                        r#type: DWORD,
                        state: DWORD,
                        machineName: [WCHAR; 256],
                        sharedAdapterName: [WCHAR; 256],
                    },
                },
            },
        }
        #[repr(i32)]
        enum NLA_BLOB_DATA_TYPE {
            NLA_RAW_DATA = 0,
            NLA_INTERFACE = 1,
            NLA_802_1X_LOCATION = 2,
            NLA_CONNECTIVITY = 3,
            NLA_ICS = 4,
        }
        #[repr(i32)]
        enum NLA_CONNECTIVITY_TYPE {
            NLA_NETWORK_AD_HOC = 0,
            NLA_NETWORK_MANAGED = 1,
            NLA_NETWORK_UNMANAGED = 2,
            NLA_NETWORK_UNKNOWN = 3,
        }
        const NLA_FRIENDLY_NAME: i32 = 2;
        #[repr(i32)]
        enum NLA_INTERNET {
            NLA_INTERNET_UNKNOWN = 0,
            NLA_INTERNET_NO = 1,
            NLA_INTERNET_YES = 2,
        }
        type PNLA_BLOB = *mut NLA_BLOB;
        type PNLA_BLOB_DATA_TYPE = *mut NLA_BLOB_DATA_TYPE;
        type PNLA_CONNECTIVITY_TYPE = *mut NLA_CONNECTIVITY_TYPE;
        type PNLA_INTERNET = *mut NLA_INTERNET;
        type PRIO_EXTENSION_FUNCTION_TABLE = *mut RIO_EXTENSION_FUNCTION_TABLE;
        type PRIO_NOTIFICATION_COMPLETION = *mut RIO_NOTIFICATION_COMPLETION;
        type PRIO_NOTIFICATION_COMPLETION_TYPE = *mut RIO_NOTIFICATION_COMPLETION_TYPE;
        type PTRANSMIT_FILE_BUFFERS = *mut TRANSMIT_FILE_BUFFERS;
        type PTRANSMIT_PACKETS_ELEMENT = *mut TRANSMIT_PACKETS_ELEMENT;
        struct RIO_EXTENSION_FUNCTION_TABLE {
            cbSize: DWORD,
            RIOReceive: LPFN_RIORECEIVE,
            RIOReceiveEx: LPFN_RIORECEIVEEX,
            RIOSend: LPFN_RIOSEND,
            RIOSendEx: LPFN_RIOSENDEX,
            RIOCloseCompletionQueue: LPFN_RIOCLOSECOMPLETIONQUEUE,
            RIOCreateCompletionQueue: LPFN_RIOCREATECOMPLETIONQUEUE,
            RIOCreateRequestQueue: LPFN_RIOCREATEREQUESTQUEUE,
            RIODequeueCompletion: LPFN_RIODEQUEUECOMPLETION,
            RIODeregisterBuffer: LPFN_RIODEREGISTERBUFFER,
            RIONotify: LPFN_RIONOTIFY,
            RIORegisterBuffer: LPFN_RIOREGISTERBUFFER,
            RIOResizeCompletionQueue: LPFN_RIORESIZECOMPLETIONQUEUE,
            RIOResizeRequestQueue: LPFN_RIORESIZEREQUESTQUEUE,
        }
        struct RIO_NOTIFICATION_COMPLETION {
            Type: RIO_NOTIFICATION_COMPLETION_TYPE,
            Anonymous: union {
                Event: struct {
                    EventHandle: HANDLE,
                    NotifyReset: BOOL,
                },
                Iocp: struct {
                    IocpHandle: HANDLE,
                    CompletionKey: PVOID,
                    Overlapped: PVOID,
                },
            },
        }
        #[repr(i32)]
        enum RIO_NOTIFICATION_COMPLETION_TYPE {
            RIO_EVENT_COMPLETION = 1,
            RIO_IOCP_COMPLETION = 2,
        }
        const SIO_BASE_HANDLE: i32 = 1207959586;
        const SIO_BSP_HANDLE: i32 = 1207959579;
        const SIO_BSP_HANDLE_POLL: i32 = 1207959581;
        const SIO_BSP_HANDLE_SELECT: i32 = 1207959580;
        const SIO_EXT_POLL: u32 = 3355443231;
        const SIO_EXT_SELECT: u32 = 3355443230;
        const SIO_EXT_SENDMSG: u32 = 3355443232;
        const SIO_UDP_CONNRESET: u32 = 2550136844;
        const SIO_UDP_NETRESET: u32 = 2550136847;
        const SO_CONNDATA: i32 = 28672;
        const SO_CONNDATALEN: i32 = 28676;
        const SO_CONNECT_TIME: i32 = 28684;
        const SO_CONNOPT: i32 = 28673;
        const SO_CONNOPTLEN: i32 = 28677;
        const SO_DISCDATA: i32 = 28674;
        const SO_DISCDATALEN: i32 = 28678;
        const SO_DISCOPT: i32 = 28675;
        const SO_DISCOPTLEN: i32 = 28679;
        const SO_MAXDG: i32 = 28681;
        const SO_MAXPATHDG: i32 = 28682;
        const SO_OPENTYPE: i32 = 28680;
        const SO_SYNCHRONOUS_ALERT: i32 = 16;
        const SO_SYNCHRONOUS_NONALERT: i32 = 32;
        const SO_UPDATE_ACCEPT_CONTEXT: i32 = 28683;
        const SO_UPDATE_CONNECT_CONTEXT: i32 = 28688;
        const TCP_BSDURGENT: i32 = 28672;
        const TF_DISCONNECT: i32 = 1;
        const TF_REUSE_SOCKET: i32 = 2;
        const TF_USE_DEFAULT_WORKER: i32 = 0;
        const TF_USE_KERNEL_APC: i32 = 32;
        const TF_USE_SYSTEM_THREAD: i32 = 16;
        const TF_WRITE_BEHIND: i32 = 4;
        const TP_DISCONNECT: i32 = 1;
        const TP_ELEMENT_EOP: i32 = 4;
        const TP_ELEMENT_FILE: i32 = 2;
        const TP_ELEMENT_MEMORY: i32 = 1;
        const TP_REUSE_SOCKET: i32 = 2;
        const TP_USE_DEFAULT_WORKER: i32 = 0;
        const TP_USE_KERNEL_APC: i32 = 32;
        const TP_USE_SYSTEM_THREAD: i32 = 16;
        struct TRANSMIT_FILE_BUFFERS {
            Head: LPVOID,
            HeadLength: DWORD,
            Tail: LPVOID,
            TailLength: DWORD,
        }
        struct TRANSMIT_PACKETS_ELEMENT {
            dwElFlags: ULONG,
            cLength: ULONG,
            Anonymous: union {
                Anonymous: struct {
                    nFileOffset: LARGE_INTEGER,
                    hFile: HANDLE,
                },
                pBuffer: PVOID,
            },
        }
        #[library("MSWSOCK.dll")]
        extern fn TransmitFile(#[in] hSocket: SOCKET, #[in] hFile: HANDLE, #[in] nNumberOfBytesToWrite: DWORD, #[in] nNumberOfBytesPerSend: DWORD, #[in] #[opt] #[out] lpOverlapped: LPOVERLAPPED, #[in] #[opt] lpTransmitBuffers: LPTRANSMIT_FILE_BUFFERS, #[in] dwReserved: DWORD) -> BOOL;
        struct WSAPOLLDATA {
            result: i32,
            fds: ULONG,
            timeout: INT,
            fdArray: [WSAPOLLFD; 0],
        }
        #[deprecated("Use WSARecv() instead or define _WINSOCK_DEPRECATED_NO_WARNINGS to disable deprecated API warnings")]
        #[library("MSWSOCK.dll")]
        extern fn WSARecvEx(#[in] s: SOCKET, #[incomplete] #[out] #[writable(entry, bytes(len))] buf: *mut CHAR, #[in] len: INT, #[in] #[out] flags: *mut INT) -> INT;
        struct WSASENDMSG {
            lpMsg: LPWSAMSG,
            dwFlags: DWORD,
            lpNumberOfBytesSent: LPDWORD,
            lpOverlapped: LPWSAOVERLAPPED,
            lpCompletionRoutine: LPWSAOVERLAPPED_COMPLETION_ROUTINE,
        }
    }
}
