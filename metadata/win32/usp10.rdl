            _bitfield2: u32 {
                fInvalidLogAttr: DWORD: 1,
                fCDM: DWORD: 1,
                fAmbiguousCharSet: DWORD: 1,
                fClusterSizeVaries: DWORD: 1,
                fRejectInvalid: DWORD: 1,
            },
        }
        struct SCRIPT_STATE {
            _bitfield: u16 {
                uBidiLevel: WORD: 5,
                fOverrideDirection: WORD: 1,
                fInhibitSymSwap: WORD: 1,
                fCharShape: WORD: 1,
                fDigitSubstitute: WORD: 1,
                fInhibitLigate: WORD: 1,
