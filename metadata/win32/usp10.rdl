                fNumericOverride: DWORD: 1,
                fLegacyBidiClass: DWORD: 1,
                fMergeNeutralItems: DWORD: 1,
                fUseStandardBidi: DWORD: 1,
                fReserved: DWORD: 6,
            },
        }
        struct SCRIPT_DIGITSUBSTITUTE {
