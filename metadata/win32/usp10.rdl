        #[library("USP10.dll")]
        #[must_use]
        extern fn ScriptXtoCP(iX: i32, cChars: i32, cGlyphs: i32, #[in] #[readable(entry, cChars)] pwLogClust: *const WORD, #[in] #[readable(entry, cGlyphs)] psva: *const SCRIPT_VISATTR, #[in] #[readable(entry, cGlyphs)] piAdvance: *const i32, #[in] #[readable(entry, 1)] psa: *const SCRIPT_ANALYSIS, #[out] #[writable(entry, 1)] piCP: *mut i32, #[out] #[writable(entry, 1)] piTrailing: *mut i32) -> HRESULT;
        struct TEXTRANGE_PROPERTIES {
            potfRecords: *mut OPENTYPE_FEATURE_RECORD,
            cotfRecords: i32,
        }
        const UNISCRIBE_OPENTYPE: i32 = 256;
        const USP_E_SCRIPT_NOT_IN_FONT: HRESULT = -2147220992;
    }
}
