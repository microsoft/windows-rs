        struct SCRIPT_PROPERTIES {
            _bitfield1: u32 {
                langid: DWORD: 16,
                fNumeric: DWORD: 1,
                fComplex: DWORD: 1,
                fNeedsWordBreaking: DWORD: 1,
                fNeedsCaretInfo: DWORD: 1,
