                fNoGlyphIndex: WORD: 1,
            },
            s: SCRIPT_STATE,
        }
        type SCRIPT_CACHE = *mut void;
        struct SCRIPT_CHARPROP {
            _bitfield: u16 {
                fCanGlyphAlone: WORD: 1,
                reserved: WORD: 15,
            },
        }
        struct SCRIPT_CONTROL {
            _bitfield: u32 {
