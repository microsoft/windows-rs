            ve_valuename: LPWSTR,
            ve_valuelen: DWORD,
            ve_valueptr: DWORD_PTR,
            ve_type: DWORD,
        }
        const WIN31_CLASS: i32 = 0;
        struct val_context {
            valuelen: i32,
            value_context: LPVOID,
            val_buff_ptr: LPVOID,
        }
    }
}
