#[win32]
mod Windows {
    mod Win32 {
        extern fn LPTIMECALLBACK(uTimerID: UINT, uMsg: UINT, dwUser: DWORD_PTR, dw1: DWORD_PTR, dw2: DWORD_PTR);
        extern fn TIMECALLBACK(uTimerID: UINT, uMsg: UINT, dwUser: DWORD_PTR, dw1: DWORD_PTR, dw2: DWORD_PTR);
        const TIME_CALLBACK_EVENT_PULSE: i32 = 32;
        const TIME_CALLBACK_EVENT_SET: i32 = 16;
        const TIME_CALLBACK_FUNCTION: i32 = 0;
        const TIME_KILL_SYNCHRONOUS: i32 = 256;
        const TIME_ONESHOT: i32 = 0;
        const TIME_PERIODIC: i32 = 1;
        #[library("WINMM.dll")]
        extern fn timeKillEvent(#[in] uTimerID: UINT) -> MMRESULT;
        #[library("WINMM.dll")]
        extern fn timeSetEvent(#[in] uDelay: UINT, #[in] uResolution: UINT, #[in] fptc: LPTIMECALLBACK, #[in] dwUser: DWORD_PTR, #[in] fuEvent: UINT) -> MMRESULT;
    }
}
