#[win32]
mod Windows {
    mod Win32 {
        #[guid(0x917fe891_3d13_4138_9809_934c8abeb12c)]
        interface IWSDDeviceHost: IUnknown {
            fn Init(&self, #[in] pszLocalId: LPCWSTR, #[in] #[opt] pContext: IWSDXMLContext, #[in] #[opt] #[readable(entry, dwHostAddressCount)] ppHostAddresses: *mut IWSDAddress, #[in] #[opt] dwHostAddressCount: DWORD) -> HRESULT;
            fn Start(&self, #[in] ullInstanceId: ULONGLONG, #[in] pScopeList: *const WSD_URI_LIST, #[in] #[opt] pNotificationSink: IWSDDeviceHostNotify) -> HRESULT;
            fn Stop(&self) -> HRESULT;
            fn Terminate(&self) -> HRESULT;
            fn RegisterPortType(&self, #[in] pPortType: *const WSD_PORT_TYPE) -> HRESULT;
            fn SetMetadata(&self, #[in] pThisModelMetadata: *const WSD_THIS_MODEL_METADATA, #[in] pThisDeviceMetadata: *const WSD_THIS_DEVICE_METADATA, #[in] #[opt] pHostMetadata: *const WSD_HOST_METADATA, #[in] #[opt] pCustomMetadata: *const WSD_METADATA_SECTION_LIST) -> HRESULT;
            fn RegisterService(&self, #[in] pszServiceId: LPCWSTR, #[in] pService: IUnknown) -> HRESULT;
            fn RetireService(&self, #[in] pszServiceId: LPCWSTR) -> HRESULT;
            fn AddDynamicService(&self, #[in] pszServiceId: LPCWSTR, #[in] #[opt] pszEndpointAddress: LPCWSTR, #[in] #[opt] pPortType: *const WSD_PORT_TYPE, #[in] #[opt] pPortName: *const WSDXML_NAME, #[in] #[opt] pAny: *const WSDXML_ELEMENT, #[in] #[opt] pService: IUnknown) -> HRESULT;
            fn RemoveDynamicService(&self, #[in] pszServiceId: LPCWSTR) -> HRESULT;
            fn SetServiceDiscoverable(&self, #[in] pszServiceId: LPCWSTR, #[in] fDiscoverable: BOOL) -> HRESULT;
            fn SignalEvent(&self, #[in] pszServiceId: LPCWSTR, #[in] #[opt] pBody: *const void, #[in] pOperation: *const WSD_OPERATION) -> HRESULT;
        }
        #[guid(0xb5bee9f9_eeda_41fe_96f7_f45e14990fb0)]
        interface IWSDDeviceHostNotify: IUnknown {
            fn GetService(&self, #[in] pszServiceId: LPCWSTR, #[out] #[out_ptr] ppService: *mut IUnknown) -> HRESULT;
        }
        #[guid(0x94974cf4_0cab_460d_a3f6_7a0ad623c0e6)]
        interface IWSDServiceMessaging: IUnknown {
            fn SendResponse(&self, #[in] #[opt] pBody: *mut void, #[in] pOperation: *mut WSD_OPERATION, #[in] pMessageParameters: IWSDMessageParameters) -> HRESULT;
            fn FaultRequest(&self, #[in] pRequestHeader: *mut WSD_SOAP_HEADER, #[in] pMessageParameters: IWSDMessageParameters, #[in] #[opt] pFault: *mut WSD_SOAP_FAULT) -> HRESULT;
        }
        #[library("wsdapi.dll")]
        extern fn WSDCreateDeviceHost(#[in] pszLocalId: LPCWSTR, pContext: IWSDXMLContext, #[out] #[out_ptr] ppDeviceHost: *mut IWSDDeviceHost) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDCreateDeviceHost2(#[in] pszLocalId: LPCWSTR, pContext: IWSDXMLContext, #[in] #[opt] #[readable(entry, dwConfigParamCount)] pConfigParams: *mut WSD_CONFIG_PARAM, dwConfigParamCount: DWORD, #[out] #[out_ptr] ppDeviceHost: *mut IWSDDeviceHost) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDCreateDeviceHostAdvanced(#[in] pszLocalId: LPCWSTR, pContext: IWSDXMLContext, #[in] #[opt] #[readable(entry, dwHostAddressCount)] ppHostAddresses: *mut IWSDAddress, dwHostAddressCount: DWORD, #[out] #[out_ptr] ppDeviceHost: *mut IWSDDeviceHost) -> HRESULT;
    }
}
