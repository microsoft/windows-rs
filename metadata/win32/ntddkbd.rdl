#[win32]
mod Windows {
    mod Win32 {
        #[encoding("ansi")]
        const DD_KEYBOARD_DEVICE_NAME: String = "\\Device\\KeyboardClass";
        #[encoding("utf-16")]
        const DD_KEYBOARD_DEVICE_NAME_U: String = "\\Device\\KeyboardClass";
        const GUID_DEVINTERFACE_KEYBOARD: GUID = 0x884b96c3_56ef_11d1_bc8c_00a0c91405dd;
        struct INDICATOR_LIST {
            MakeCode: USHORT,
            IndicatorFlags: USHORT,
        }
        const IOCTL_KEYBOARD_INSERT_DATA: i32 = 721152;
        const IOCTL_KEYBOARD_QUERY_ATTRIBUTES: i32 = 720896;
        const IOCTL_KEYBOARD_QUERY_EXTENDED_ATTRIBUTES: i32 = 721408;
        const IOCTL_KEYBOARD_QUERY_IME_STATUS: i32 = 724992;
        const IOCTL_KEYBOARD_QUERY_INDICATORS: i32 = 720960;
        const IOCTL_KEYBOARD_QUERY_INDICATOR_TRANSLATION: i32 = 721024;
        const IOCTL_KEYBOARD_QUERY_TYPEMATIC: i32 = 720928;
        const IOCTL_KEYBOARD_SET_IME_STATUS: i32 = 724996;
        const IOCTL_KEYBOARD_SET_INDICATORS: i32 = 720904;
        const IOCTL_KEYBOARD_SET_TYPEMATIC: i32 = 720900;
        struct KEYBOARD_ATTRIBUTES {
            KeyboardIdentifier: KEYBOARD_ID,
            KeyboardMode: USHORT,
            NumberOfFunctionKeys: USHORT,
            NumberOfIndicators: USHORT,
            NumberOfKeysTotal: USHORT,
            InputDataQueueLength: ULONG,
            KeyRepeatMinimum: KEYBOARD_TYPEMATIC_PARAMETERS,
            KeyRepeatMaximum: KEYBOARD_TYPEMATIC_PARAMETERS,
        }
        const KEYBOARD_CAPS_LOCK_ON: i32 = 4;
        const KEYBOARD_ERROR_VALUE_BASE: i32 = 10000;
        struct KEYBOARD_EXTENDED_ATTRIBUTES {
            Version: UCHAR,
            FormFactor: UCHAR,
            KeyType: UCHAR,
            PhysicalLayout: UCHAR,
            VendorSpecificPhysicalLayout: UCHAR,
            IETFLanguageTagIndex: UCHAR,
            ImplementedInputAssistControls: UCHAR,
        }
        const KEYBOARD_EXTENDED_ATTRIBUTES_STRUCT_VERSION_1: i32 = 1;
        struct KEYBOARD_ID {
            Type: UCHAR,
            Subtype: UCHAR,
        }
        struct KEYBOARD_IME_STATUS {
            UnitId: USHORT,
            ImeOpen: ULONG,
            ImeConvMode: ULONG,
        }
        struct KEYBOARD_INDICATOR_PARAMETERS {
            UnitId: USHORT,
            LedFlags: USHORT,
        }
        struct KEYBOARD_INDICATOR_TRANSLATION {
            NumberOfIndicatorKeys: USHORT,
            IndicatorList: [INDICATOR_LIST; 1],
        }
        struct KEYBOARD_INPUT_DATA {
            UnitId: USHORT,
            MakeCode: USHORT,
            Flags: USHORT,
            Reserved: USHORT,
            ExtraInformation: ULONG,
        }
        const KEYBOARD_KANA_LOCK_ON: i32 = 8;
        const KEYBOARD_LED_INJECTED: i32 = 32768;
        const KEYBOARD_NUM_LOCK_ON: i32 = 2;
        const KEYBOARD_SCROLL_LOCK_ON: i32 = 1;
        const KEYBOARD_SHADOW: i32 = 16384;
        struct KEYBOARD_TYPEMATIC_PARAMETERS {
            UnitId: USHORT,
            Rate: USHORT,
            Delay: USHORT,
        }
        struct KEYBOARD_UNIT_ID_PARAMETER {
            UnitId: USHORT,
        }
        const KEY_BREAK: i32 = 1;
        const KEY_E0: i32 = 2;
        const KEY_E1: i32 = 4;
        const KEY_FROM_KEYBOARD_OVERRIDER: i32 = 128;
        const KEY_MAKE: i32 = 0;
        const KEY_RIM_VKEY: i32 = 64;
        const KEY_TERMSRV_SET_LED: i32 = 8;
        const KEY_TERMSRV_SHADOW: i32 = 16;
        const KEY_TERMSRV_VKPACKET: i32 = 32;
        const KEY_UNICODE_SEQUENCE_END: i32 = 512;
        const KEY_UNICODE_SEQUENCE_ITEM: i32 = 256;
        type PINDICATOR_LIST = *mut INDICATOR_LIST;
        type PKEYBOARD_ATTRIBUTES = *mut KEYBOARD_ATTRIBUTES;
        type PKEYBOARD_EXTENDED_ATTRIBUTES = *mut KEYBOARD_EXTENDED_ATTRIBUTES;
        type PKEYBOARD_ID = *mut KEYBOARD_ID;
        type PKEYBOARD_IME_STATUS = *mut KEYBOARD_IME_STATUS;
        type PKEYBOARD_INDICATOR_PARAMETERS = *mut KEYBOARD_INDICATOR_PARAMETERS;
        type PKEYBOARD_INDICATOR_TRANSLATION = *mut KEYBOARD_INDICATOR_TRANSLATION;
        type PKEYBOARD_INPUT_DATA = *mut KEYBOARD_INPUT_DATA;
        type PKEYBOARD_TYPEMATIC_PARAMETERS = *mut KEYBOARD_TYPEMATIC_PARAMETERS;
        type PKEYBOARD_UNIT_ID_PARAMETER = *mut KEYBOARD_UNIT_ID_PARAMETER;
    }
}
