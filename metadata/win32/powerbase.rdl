#[win32]
mod Windows {
    mod Win32 {
        #[library("POWRPROF.dll")]
        extern fn CallNtPowerInformation(InformationLevel: POWER_INFORMATION_LEVEL, #[size_param(2)] #[in] #[opt] InputBuffer: *mut void, InputBufferLength: u32, #[size_param(4)] #[opt] OutputBuffer: *mut void, OutputBufferLength: u32) -> i32;
        #[library("POWRPROF.dll")]
        extern fn GetPwrCapabilities(#[out] lpspc: PSYSTEM_POWER_CAPABILITIES) -> BOOLEAN;
        #[library("POWRPROF.dll")]
        extern fn PowerDeterminePlatformRoleEx(Version: u32) -> POWER_PLATFORM_ROLE;
        #[library("POWRPROF.dll")]
        extern fn PowerRegisterSuspendResumeNotification(Flags: u32, Recipient: HANDLE, #[out] RegistrationHandle: PHPOWERNOTIFY) -> u32;
        #[library("POWRPROF.dll")]
        extern fn PowerUnregisterSuspendResumeNotification(#[in] #[out] RegistrationHandle: HPOWERNOTIFY) -> u32;
    }
}
