#[win32]
mod Windows {
    mod Win32 {
        #[library("POWRPROF.dll")]
        extern fn CallNtPowerInformation(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] InformationLevel: POWER_INFORMATION_LEVEL, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(2)] InputBuffer: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] InputBufferLength: ULONG, #[out] #[opt] #[size_param(4)] OutputBuffer: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] OutputBufferLength: ULONG) -> LONG;
        #[library("POWRPROF.dll")]
        extern fn GetPwrCapabilities(#[out] lpspc: PSYSTEM_POWER_CAPABILITIES) -> BOOLEAN;
