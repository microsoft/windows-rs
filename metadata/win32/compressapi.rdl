#[win32]
mod Windows {
    mod Win32 {
        type COMPRESSOR_HANDLE = *mut COMPRESSOR_HANDLE__;
        struct COMPRESSOR_HANDLE__ {
            unused: i32,
        }
        const COMPRESS_ALGORITHM_INVALID: i32 = 0;
        const COMPRESS_ALGORITHM_LZMS: i32 = 5;
        const COMPRESS_ALGORITHM_MAX: i32 = 6;
        const COMPRESS_ALGORITHM_MSZIP: i32 = 2;
        const COMPRESS_ALGORITHM_NULL: i32 = 1;
        const COMPRESS_ALGORITHM_XPRESS: i32 = 3;
        const COMPRESS_ALGORITHM_XPRESS_HUFF: i32 = 4;
        struct COMPRESS_ALLOCATION_ROUTINES {
            Allocate: PFN_COMPRESS_ALLOCATE,
            Free: PFN_COMPRESS_FREE,
            UserContext: PVOID,
        }
        #[repr(i32)]
        enum COMPRESS_INFORMATION_CLASS {
            COMPRESS_INFORMATION_CLASS_INVALID = 0,
            COMPRESS_INFORMATION_CLASS_BLOCK_SIZE = 1,
            COMPRESS_INFORMATION_CLASS_LEVEL = 2,
        }
        const COMPRESS_RAW: i32 = 536870912;
        #[library("Cabinet.dll")]
        extern fn CloseCompressor(#[in] CompressorHandle: COMPRESSOR_HANDLE) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn CloseDecompressor(#[in] DecompressorHandle: DECOMPRESSOR_HANDLE) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn Compress(#[in] CompressorHandle: COMPRESSOR_HANDLE, #[in] #[opt] #[readable(entry, bytes(UncompressedDataSize))] UncompressedData: LPCVOID, #[in] UncompressedDataSize: SIZE_T, #[out] #[opt] #[writable(entry, bytes(CompressedBufferSize))] CompressedBuffer: PVOID, #[in] CompressedBufferSize: SIZE_T, #[out] CompressedDataSize: PSIZE_T) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn CreateCompressor(#[in] Algorithm: DWORD, #[in] #[opt] AllocationRoutines: PCOMPRESS_ALLOCATION_ROUTINES, #[out] CompressorHandle: PCOMPRESSOR_HANDLE) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn CreateDecompressor(#[in] Algorithm: DWORD, #[in] #[opt] AllocationRoutines: PCOMPRESS_ALLOCATION_ROUTINES, #[out] DecompressorHandle: PDECOMPRESSOR_HANDLE) -> BOOL;
        type DECOMPRESSOR_HANDLE = *mut COMPRESSOR_HANDLE__;
        #[library("Cabinet.dll")]
        extern fn Decompress(#[in] DecompressorHandle: DECOMPRESSOR_HANDLE, #[in] #[opt] #[readable(entry, bytes(CompressedDataSize))] CompressedData: LPCVOID, #[in] CompressedDataSize: SIZE_T, #[out] #[opt] #[writable(entry, bytes(UncompressedBufferSize))] UncompressedBuffer: PVOID, #[in] UncompressedBufferSize: SIZE_T, #[out] #[opt] UncompressedDataSize: PSIZE_T) -> BOOL;
        type PCOMPRESSOR_HANDLE = *mut *mut COMPRESSOR_HANDLE__;
        type PCOMPRESS_ALLOCATION_ROUTINES = *mut COMPRESS_ALLOCATION_ROUTINES;
        type PDECOMPRESSOR_HANDLE = *mut *mut COMPRESSOR_HANDLE__;
        extern "C" fn PFN_COMPRESS_ALLOCATE(#[in] UserContext: PVOID, #[in] Size: SIZE_T) -> PVOID;
        extern "C" fn PFN_COMPRESS_FREE(#[in] UserContext: PVOID, #[in] Memory: PVOID);
        #[library("Cabinet.dll")]
        extern fn QueryCompressorInformation(#[in] CompressorHandle: COMPRESSOR_HANDLE, #[in] CompressInformationClass: COMPRESS_INFORMATION_CLASS, #[out] #[writable(entry, bytes(CompressInformationSize))] CompressInformation: PVOID, #[in] CompressInformationSize: SIZE_T) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn QueryDecompressorInformation(#[in] DecompressorHandle: DECOMPRESSOR_HANDLE, #[in] CompressInformationClass: COMPRESS_INFORMATION_CLASS, #[out] #[writable(entry, bytes(CompressInformationSize))] CompressInformation: PVOID, #[in] CompressInformationSize: SIZE_T) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn ResetCompressor(#[in] CompressorHandle: COMPRESSOR_HANDLE) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn ResetDecompressor(#[in] DecompressorHandle: DECOMPRESSOR_HANDLE) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn SetCompressorInformation(#[in] CompressorHandle: COMPRESSOR_HANDLE, #[in] CompressInformationClass: COMPRESS_INFORMATION_CLASS, #[in] #[readable(entry, bytes(CompressInformationSize))] CompressInformation: LPCVOID, #[in] CompressInformationSize: SIZE_T) -> BOOL;
        #[library("Cabinet.dll")]
        extern fn SetDecompressorInformation(#[in] DecompressorHandle: DECOMPRESSOR_HANDLE, #[in] CompressInformationClass: COMPRESS_INFORMATION_CLASS, #[in] #[readable(entry, bytes(CompressInformationSize))] CompressInformation: LPCVOID, #[in] CompressInformationSize: SIZE_T) -> BOOL;
    }
}
