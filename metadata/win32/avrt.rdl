#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum AVRT_PRIORITY {
            AVRT_PRIORITY_VERYLOW = -2,
            AVRT_PRIORITY_LOW = -1,
            AVRT_PRIORITY_NORMAL = 0,
            AVRT_PRIORITY_HIGH = 1,
            AVRT_PRIORITY_CRITICAL = 2,
        }
        #[library("AVRT.dll")]
        extern fn AvQuerySystemResponsiveness(AvrtHandle: HANDLE, #[out] SystemResponsivenessValue: PULONG) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRevertMmThreadCharacteristics(AvrtHandle: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtCreateThreadOrderingGroup(#[out] Context: PHANDLE, Period: PLARGE_INTEGER, #[in] #[out] ThreadOrderingGuid: *mut GUID, #[opt] Timeout: PLARGE_INTEGER) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtCreateThreadOrderingGroupExA(#[out] Context: PHANDLE, Period: PLARGE_INTEGER, #[in] #[out] ThreadOrderingGuid: *mut GUID, #[opt] Timeout: PLARGE_INTEGER, TaskName: PCSTR) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtCreateThreadOrderingGroupExW(#[out] Context: PHANDLE, Period: PLARGE_INTEGER, #[in] #[out] ThreadOrderingGuid: *mut GUID, #[opt] Timeout: PLARGE_INTEGER, TaskName: PCWSTR) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtDeleteThreadOrderingGroup(Context: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtJoinThreadOrderingGroup(#[out] Context: PHANDLE, #[in] ThreadOrderingGuid: *mut GUID, Before: BOOL) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtLeaveThreadOrderingGroup(Context: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtWaitOnThreadOrderingGroup(Context: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvSetMmMaxThreadCharacteristicsA(FirstTask: PCSTR, SecondTask: PCSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmMaxThreadCharacteristicsW(FirstTask: PCWSTR, SecondTask: PCWSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmThreadCharacteristicsA(TaskName: PCSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmThreadCharacteristicsW(TaskName: PCWSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmThreadPriority(AvrtHandle: HANDLE, Priority: AVRT_PRIORITY) -> BOOL;
        type PAVRT_PRIORITY = *mut AVRT_PRIORITY;
        const THREAD_ORDER_GROUP_INFINITE_TIMEOUT: i64 = -1;
    }
}
