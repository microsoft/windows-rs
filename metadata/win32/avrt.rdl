#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum AVRT_PRIORITY {
            AVRT_PRIORITY_VERYLOW = -2,
            AVRT_PRIORITY_LOW = -1,
            AVRT_PRIORITY_NORMAL = 0,
            AVRT_PRIORITY_HIGH = 1,
            AVRT_PRIORITY_CRITICAL = 2,
        }
        #[library("AVRT.dll")]
        extern fn AvQuerySystemResponsiveness(#[in] AvrtHandle: HANDLE, #[out] SystemResponsivenessValue: PULONG) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRevertMmThreadCharacteristics(#[in] AvrtHandle: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtCreateThreadOrderingGroup(#[out] Context: PHANDLE, #[in] Period: PLARGE_INTEGER, #[in] #[out] ThreadOrderingGuid: *mut GUID, #[in] #[opt] Timeout: PLARGE_INTEGER) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtCreateThreadOrderingGroupExA(#[out] Context: PHANDLE, #[in] Period: PLARGE_INTEGER, #[in] #[out] ThreadOrderingGuid: *mut GUID, #[in] #[opt] Timeout: PLARGE_INTEGER, #[in] TaskName: LPCSTR) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtCreateThreadOrderingGroupExW(#[out] Context: PHANDLE, #[in] Period: PLARGE_INTEGER, #[in] #[out] ThreadOrderingGuid: *mut GUID, #[in] #[opt] Timeout: PLARGE_INTEGER, #[in] TaskName: LPCWSTR) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtDeleteThreadOrderingGroup(#[in] Context: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtJoinThreadOrderingGroup(#[out] Context: PHANDLE, #[in] ThreadOrderingGuid: *mut GUID, #[in] Before: BOOL) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtLeaveThreadOrderingGroup(#[in] Context: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvRtWaitOnThreadOrderingGroup(#[in] Context: HANDLE) -> BOOL;
        #[library("AVRT.dll")]
        extern fn AvSetMmMaxThreadCharacteristicsA(#[in] FirstTask: LPCSTR, #[in] SecondTask: LPCSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmMaxThreadCharacteristicsW(#[in] FirstTask: LPCWSTR, #[in] SecondTask: LPCWSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmThreadCharacteristicsA(#[in] TaskName: LPCSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmThreadCharacteristicsW(#[in] TaskName: LPCWSTR, #[in] #[out] TaskIndex: LPDWORD) -> HANDLE;
        #[library("AVRT.dll")]
        extern fn AvSetMmThreadPriority(#[in] AvrtHandle: HANDLE, #[in] Priority: AVRT_PRIORITY) -> BOOL;
        type PAVRT_PRIORITY = *mut AVRT_PRIORITY;
        const THREAD_ORDER_GROUP_INFINITE_TIMEOUT: i64 = -1;
    }
}
