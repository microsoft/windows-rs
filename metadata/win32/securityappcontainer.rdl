#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn GetAppContainerNamedObjectPath(#[in] #[opt] Token: HANDLE, #[in] #[opt] AppContainerSid: PSID, #[in] ObjectPathLength: ULONG, #[opt] #[out] #[writable(entry, ObjectPathLength)] ObjectPath: LPWSTR, #[out] ReturnLength: PULONG) -> BOOL;
    }
}
