        extern "C" fn PFNSTATUSMESSAGECALLBACK(#[in] bVerbose: BOOL, #[in] lpMessage: LPWSTR) -> DWORD;
        type PGPO_LINK = *mut GPO_LINK;
        type PGROUP_POLICY_OBJECT = *mut GROUP_POLICY_OBJECTA;
        type PGROUP_POLICY_OBJECTA = *mut GROUP_POLICY_OBJECTA;
        type PGROUP_POLICY_OBJECTW = *mut GROUP_POLICY_OBJECTW;
        const PI_APPLYPOLICY: i32 = 2;
        const PI_NOUI: i32 = 1;
        struct POLICYSETTINGSTATUSINFO {
            szKey: LPWSTR,
            szEventSource: LPWSTR,
            szEventLogName: LPWSTR,
            dwEventID: DWORD,
            dwErrorCode: DWORD,
            status: SETTINGSTATUS,
            timeLogged: SYSTEMTIME,
        }
        type PRSOPTOKEN = *mut void;
        type PRSOP_TARGET = *mut RSOP_TARGET;
        const PT_MANDATORY: i32 = 4;
        const PT_ROAMING: i32 = 2;
        const PT_ROAMING_PREEXISTING: i32 = 8;
        const PT_TEMPORARY: i32 = 1;
