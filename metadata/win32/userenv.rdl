        #[library("USERENV.dll")]
        extern fn RsopAccessCheckByType(#[in] pSecurityDescriptor: PSECURITY_DESCRIPTOR, #[in] #[opt] pPrincipalSelfSid: PSID, #[in] pRsopToken: PRSOPTOKEN, #[in] dwDesiredAccessMask: DWORD, #[in] #[opt] #[readable(entry, ObjectTypeListLength)] pObjectTypeList: POBJECT_TYPE_LIST, #[in] ObjectTypeListLength: DWORD, #[in] pGenericMapping: PGENERIC_MAPPING, #[in] #[opt] #[readable(entry, bytes(if_present(*pdwPrivilegeSetLength)))] pPrivilegeSet: PPRIVILEGE_SET, #[in] #[opt] pdwPrivilegeSetLength: LPDWORD, #[out] pdwGrantedAccessMask: LPDWORD, #[out] pbAccessStatus: LPBOOL) -> HRESULT;
        #[library("USERENV.dll")]
        extern fn RsopFileAccessCheck(#[in] pszFileName: LPWSTR, #[in] pRsopToken: PRSOPTOKEN, #[in] dwDesiredAccessMask: DWORD, #[out] pdwGrantedAccessMask: LPDWORD, #[out] pbAccessStatus: LPBOOL) -> HRESULT;
        #[library("USERENV.dll")]
        extern fn RsopResetPolicySettingStatus(#[in] dwFlags: DWORD, #[in] pServices: IWbemServices, #[in] pSettingInstance: IWbemClassObject) -> HRESULT;
        #[library("USERENV.dll")]
        extern fn RsopSetPolicySettingStatus(#[in] dwFlags: DWORD, #[in] pServices: IWbemServices, #[in] pSettingInstance: IWbemClassObject, #[in] nInfo: DWORD, #[in] #[readable(entry, nInfo)] pStatus: *mut POLICYSETTINGSTATUSINFO) -> HRESULT;
