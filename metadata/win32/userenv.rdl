        extern fn CreateAppContainerProfile(#[in] pszAppContainerName: PCWSTR, #[in] pszDisplayName: PCWSTR, #[in] pszDescription: PCWSTR, #[in] #[opt] #[readable(entry, dwCapabilityCount)] pCapabilities: PSID_AND_ATTRIBUTES, #[in] dwCapabilityCount: DWORD, #[out] #[out_ptr] ppSidAppContainerSid: *mut PSID) -> HRESULT;
        #[library("USERENV.dll")]
