        extern fn ProcessGroupPolicyCompleted(#[in] extensionId: REFGPEXTENSIONID, #[in] pAsyncHandle: ASYNCCOMPLETIONHANDLE, #[in] dwStatus: DWORD) -> DWORD;
        #[library("USERENV.dll")]
