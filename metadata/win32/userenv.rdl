        const GPC_BLOCK_POLICY: i32 = 1;
        const GPO_FLAG_DISABLE: i32 = 1;
        const GPO_FLAG_FORCE: i32 = 2;
        const GPO_INFO_FLAG_ASYNC_FOREGROUND: i32 = 4096;
        const GPO_INFO_FLAG_BACKGROUND: i32 = 16;
