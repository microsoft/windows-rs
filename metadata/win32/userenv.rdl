        const GPO_INFO_FLAG_LINKTRANSITION: i32 = 256;
        const GPO_INFO_FLAG_LOGRSOP_TRANSITION: i32 = 512;
        const GPO_INFO_FLAG_MACHINE: i32 = 1;
        const GPO_INFO_FLAG_NOCHANGES: i32 = 128;
