        #[encoding("ansi")]
        const GP_MAXNOGPOLISTCHANGESINTERVAL: String = "MaxNoGPOListChangesInterval";
        #[encoding("ansi")]
        const GP_NOBACKGROUNDPOLICY: String = "NoBackgroundPolicy";
        #[encoding("ansi")]
        const GP_NOGPOLISTCHANGES: String = "NoGPOListChanges";
