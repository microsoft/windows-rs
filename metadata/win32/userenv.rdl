        type GROUP_POLICY_OBJECT = GROUP_POLICY_OBJECTA;
        struct GROUP_POLICY_OBJECTA {
            dwOptions: DWORD,
            dwVersion: DWORD,
            lpDSPath: LPSTR,
            lpFileSysPath: LPSTR,
            lpDisplayName: LPSTR,
            szGPOName: [CHAR; 50],
            GPOLink: GPO_LINK,
            lParam: LPARAM,
            pNext: *mut GROUP_POLICY_OBJECTA,
            pPrev: *mut GROUP_POLICY_OBJECTA,
            lpExtensions: LPSTR,
            lParam2: LPARAM,
            lpLink: LPSTR,
        }
        struct GROUP_POLICY_OBJECTW {
            dwOptions: DWORD,
            dwVersion: DWORD,
            lpDSPath: LPWSTR,
            lpFileSysPath: LPWSTR,
            lpDisplayName: LPWSTR,
            szGPOName: [WCHAR; 50],
            GPOLink: GPO_LINK,
            lParam: LPARAM,
            pNext: *mut GROUP_POLICY_OBJECTW,
            pPrev: *mut GROUP_POLICY_OBJECTW,
            lpExtensions: LPWSTR,
            lParam2: LPARAM,
            lpLink: LPWSTR,
        }
