#[win32]
mod Windows {
    mod Win32 {
        struct DDEACK {
            _bitfield: u16 {
                bAppReturnCode: u16: 8,
                reserved: u16: 6,
                fBusy: u16: 1,
                fAck: u16: 1,
            },
        }
        struct DDEADVISE {
            _bitfield: u16 {
                reserved: u16: 14,
                fDeferUpd: u16: 1,
                fAckReq: u16: 1,
            },
            cfFormat: i16,
        }
        struct DDEDATA {
            _bitfield: u16 {
                unused: u16: 12,
                fResponse: u16: 1,
                fRelease: u16: 1,
                reserved: u16: 1,
                fAckReq: u16: 1,
            },
            cfFormat: i16,
            Value: [BYTE; 1],
        }
        struct DDELN {
            _bitfield: u16 {
                unused: u16: 13,
                fRelease: u16: 1,
                fDeferUpd: u16: 1,
                fAckReq: u16: 1,
            },
            cfFormat: i16,
        }
        struct DDEPOKE {
            _bitfield: u16 {
                unused: u16: 13,
                fRelease: u16: 1,
                fReserved: u16: 2,
            },
            cfFormat: i16,
            Value: [BYTE; 1],
        }
        struct DDEUP {
            _bitfield: u16 {
                unused: u16: 12,
                fAck: u16: 1,
                fRelease: u16: 1,
                fReserved: u16: 1,
                fAckReq: u16: 1,
            },
            cfFormat: i16,
            rgb: [BYTE; 1],
        }
        #[library("USER32.dll")]
        extern fn DdeSetQualityOfService(hwndClient: HWND, pqosNew: *const SECURITY_QUALITY_OF_SERVICE, pqosPrev: PSECURITY_QUALITY_OF_SERVICE) -> BOOL;
        #[library("USER32.dll")]
        extern fn FreeDDElParam(#[in] msg: UINT, #[in] lParam: LPARAM) -> BOOL;
        #[library("USER32.dll")]
        extern fn ImpersonateDdeClientWindow(hWndClient: HWND, hWndServer: HWND) -> BOOL;
        #[library("USER32.dll")]
        extern fn PackDDElParam(#[in] msg: UINT, #[in] uiLo: UINT_PTR, #[in] uiHi: UINT_PTR) -> LPARAM;
        #[library("USER32.dll")]
        extern fn ReuseDDElParam(lParam: LPARAM, msgIn: UINT, msgOut: UINT, uiLo: UINT_PTR, uiHi: UINT_PTR) -> LPARAM;
        #[library("USER32.dll")]
        extern fn UnpackDDElParam(#[in] msg: UINT, #[in] lParam: LPARAM, #[out] puiLo: PUINT_PTR, #[out] puiHi: PUINT_PTR) -> BOOL;
        const WM_DDE_ACK: i32 = 996;
        const WM_DDE_ADVISE: i32 = 994;
        const WM_DDE_DATA: i32 = 997;
        const WM_DDE_EXECUTE: i32 = 1000;
        const WM_DDE_FIRST: i32 = 992;
        const WM_DDE_INITIATE: i32 = 992;
        const WM_DDE_LAST: i32 = 1000;
        const WM_DDE_POKE: i32 = 999;
        const WM_DDE_REQUEST: i32 = 998;
        const WM_DDE_TERMINATE: i32 = 993;
        const WM_DDE_UNADVISE: i32 = 995;
    }
}
