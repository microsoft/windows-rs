        extern fn CreateTransaction(lpTransactionAttributes: LPSECURITY_ATTRIBUTES, UOW: LPGUID, CreateOptions: DWORD, IsolationLevel: DWORD, IsolationFlags: DWORD, Timeout: DWORD, #[in] #[opt] Description: LPWSTR) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn CreateTransactionManager(lpTransactionAttributes: LPSECURITY_ATTRIBUTES, #[in] LogFileName: LPWSTR, CreateOptions: ULONG, CommitStrength: ULONG) -> HANDLE;
