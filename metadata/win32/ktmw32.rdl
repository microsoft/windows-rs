#[win32]
mod Windows {
    mod Win32 {
        #[library("ktmw32.dll")]
        extern fn CommitComplete(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn CommitEnlistment(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn CommitTransaction(TransactionHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn CommitTransactionAsync(TransactionHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn CreateEnlistment(#[opt] lpEnlistmentAttributes: LPSECURITY_ATTRIBUTES, ResourceManagerHandle: HANDLE, TransactionHandle: HANDLE, NotificationMask: NOTIFICATION_MASK, #[opt] CreateOptions: u32, #[in] #[opt] EnlistmentKey: *mut void) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn CreateResourceManager(#[opt] lpResourceManagerAttributes: LPSECURITY_ATTRIBUTES, ResourceManagerId: LPGUID, #[opt] CreateOptions: u32, TmHandle: HANDLE, #[opt] Description: PCWSTR) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn CreateTransaction(#[opt] lpTransactionAttributes: LPSECURITY_ATTRIBUTES, #[opt] UOW: LPGUID, #[opt] CreateOptions: u32, #[opt] IsolationLevel: u32, #[opt] IsolationFlags: u32, #[opt] Timeout: u32, #[opt] Description: PCWSTR) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn CreateTransactionManager(#[opt] lpTransactionAttributes: LPSECURITY_ATTRIBUTES, LogFileName: PCWSTR, #[opt] CreateOptions: u32, #[opt] CommitStrength: u32) -> HANDLE;
        #[library("ktmw32.dll")]
        extern "C" fn GetCurrentClockTransactionManager(TransactionManagerHandle: HANDLE, #[out] TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetEnlistmentId(EnlistmentHandle: HANDLE, #[out] EnlistmentId: LPGUID) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetEnlistmentRecoveryInformation(EnlistmentHandle: HANDLE, BufferSize: u32, Buffer: *mut void, #[out] #[opt] BufferUsed: PULONG) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetNotificationResourceManager(ResourceManagerHandle: HANDLE, #[out] TransactionNotification: PTRANSACTION_NOTIFICATION, NotificationLength: u32, #[opt] dwMilliseconds: u32, #[out] #[opt] ReturnLength: PULONG) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetNotificationResourceManagerAsync(ResourceManagerHandle: HANDLE, #[out] TransactionNotification: PTRANSACTION_NOTIFICATION, TransactionNotificationLength: u32, #[out] ReturnLength: PULONG, lpOverlapped: LPOVERLAPPED) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetTransactionId(TransactionHandle: HANDLE, #[out] TransactionId: LPGUID) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetTransactionInformation(TransactionHandle: HANDLE, #[out] #[opt] Outcome: PDWORD, #[out] #[opt] IsolationLevel: PDWORD, #[out] #[opt] IsolationFlags: PDWORD, #[out] #[opt] Timeout: PDWORD, BufferLength: u32, #[len_param(5)] #[out] #[opt] Description: PWSTR) -> BOOL;
        #[library("ktmw32.dll")]
        extern "C" fn GetTransactionManagerId(TransactionManagerHandle: HANDLE, #[out] TransactionManagerId: LPGUID) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn OpenEnlistment(dwDesiredAccess: u32, ResourceManagerHandle: HANDLE, EnlistmentId: LPGUID) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn OpenResourceManager(dwDesiredAccess: u32, TmHandle: HANDLE, ResourceManagerId: LPGUID) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn OpenTransaction(dwDesiredAccess: u32, TransactionId: LPGUID) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn OpenTransactionManager(LogFileName: PCWSTR, DesiredAccess: ACCESS_MASK, #[opt] OpenOptions: u32) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn OpenTransactionManagerById(TransactionManagerId: LPGUID, DesiredAccess: ACCESS_MASK, #[opt] OpenOptions: u32) -> HANDLE;
        #[library("ktmw32.dll")]
        extern fn PrePrepareComplete(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn PrePrepareEnlistment(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn PrepareComplete(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn PrepareEnlistment(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn ReadOnlyEnlistment(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RecoverEnlistment(EnlistmentHandle: HANDLE, #[in] #[opt] EnlistmentKey: *mut void) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RecoverResourceManager(ResourceManagerHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RecoverTransactionManager(TransactionManagerHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RenameTransactionManager(LogFileName: PCWSTR, ExistingTransactionManagerGuid: LPGUID) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RollbackComplete(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RollbackEnlistment(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RollbackTransaction(TransactionHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RollbackTransactionAsync(TransactionHandle: HANDLE) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn RollforwardTransactionManager(TransactionManagerHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn SetEnlistmentRecoveryInformation(EnlistmentHandle: HANDLE, BufferSize: u32, #[in] Buffer: *mut void) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn SetResourceManagerCompletionPort(ResourceManagerHandle: HANDLE, IoCompletionPortHandle: HANDLE, CompletionKey: usize) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn SetTransactionInformation(TransactionHandle: HANDLE, #[opt] IsolationLevel: u32, #[opt] IsolationFlags: u32, #[opt] Timeout: u32, #[opt] Description: PCWSTR) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn SinglePhaseReject(EnlistmentHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
    }
}
