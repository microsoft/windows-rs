        extern fn CreateResourceManager(lpResourceManagerAttributes: LPSECURITY_ATTRIBUTES, ResourceManagerId: LPGUID, CreateOptions: DWORD, TmHandle: HANDLE, #[in] #[opt] Description: LPWSTR) -> HANDLE;
