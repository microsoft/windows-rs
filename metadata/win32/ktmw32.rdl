        extern fn GetCurrentClockTransactionManager(TransactionManagerHandle: HANDLE, TmVirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetEnlistmentId(EnlistmentHandle: HANDLE, EnlistmentId: LPGUID) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetEnlistmentRecoveryInformation(EnlistmentHandle: HANDLE, BufferSize: ULONG, Buffer: PVOID, BufferUsed: PULONG) -> BOOL;
        #[library("ktmw32.dll")]
        extern fn GetNotificationResourceManager(ResourceManagerHandle: HANDLE, TransactionNotification: PTRANSACTION_NOTIFICATION, NotificationLength: ULONG, dwMilliseconds: DWORD, ReturnLength: PULONG) -> BOOL;
