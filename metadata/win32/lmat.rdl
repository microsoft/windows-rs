#[win32]
mod Windows {
    mod Win32 {
        struct AT_ENUM {
            JobId: DWORD,
            JobTime: DWORD_PTR,
            DaysOfMonth: DWORD,
            DaysOfWeek: UCHAR,
            Flags: UCHAR,
            Command: LPWSTR,
        }
        struct AT_INFO {
            JobTime: DWORD_PTR,
            DaysOfMonth: DWORD,
            DaysOfWeek: UCHAR,
            Flags: UCHAR,
            Command: LPWSTR,
        }
        const JOB_ADD_CURRENT_DATE: i32 = 8;
        const JOB_EXEC_ERROR: i32 = 2;
        const JOB_INPUT_FLAGS: i32 = 25;
        const JOB_NONINTERACTIVE: i32 = 16;
        const JOB_OUTPUT_FLAGS: i32 = 23;
        const JOB_RUNS_TODAY: i32 = 4;
        const JOB_RUN_PERIODICALLY: i32 = 1;
        type LPAT_ENUM = *mut AT_ENUM;
        type LPAT_INFO = *mut AT_INFO;
        #[library("NETAPI32.dll")]
        extern fn NetScheduleJobAdd(Servername: LPCWSTR, Buffer: LPBYTE, JobId: LPDWORD) -> DWORD;
        #[library("NETAPI32.dll")]
        extern fn NetScheduleJobDel(Servername: LPCWSTR, MinJobId: DWORD, MaxJobId: DWORD) -> DWORD;
        #[library("NETAPI32.dll")]
        extern fn NetScheduleJobEnum(Servername: LPCWSTR, PointerToBuffer: *mut LPBYTE, PrefferedMaximumLength: DWORD, EntriesRead: LPDWORD, TotalEntries: LPDWORD, ResumeHandle: LPDWORD) -> DWORD;
        #[library("NETAPI32.dll")]
        extern fn NetScheduleJobGetInfo(Servername: LPCWSTR, JobId: DWORD, PointerToBuffer: *mut LPBYTE) -> DWORD;
        type PAT_ENUM = *mut AT_ENUM;
        type PAT_INFO = *mut AT_INFO;
    }
}
