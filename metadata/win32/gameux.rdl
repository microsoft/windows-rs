        const ID_GDF_XML_STR: String = "__GDF_XML";
        #[guid(0xe7b2fb72_d728_49b3_a5f2_18ebf5f1349e)]
        interface IGameExplorer: IUnknown {
            fn AddGame(&self, #[in] bstrGDFBinaryPath: BSTR, #[in] bstrGameInstallDirectory: BSTR, #[in] installScope: GAME_INSTALL_SCOPE, #[in] #[out] pguidInstanceID: *mut GUID) -> HRESULT;
            fn RemoveGame(&self, #[in] guidInstanceID: GUID) -> HRESULT;
