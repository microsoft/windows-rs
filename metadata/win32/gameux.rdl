            fn GetCategoryTitle(&self, #[in] categoryIndex: WORD, #[null_terminated(entry, success, indirect)] #[out] #[out_ptr(nullable)] #[readable(entry, 1, indirect, nullable)] #[retval] pTitle: *mut LPWSTR) -> HRESULT;
            fn GetStatistic(&self, #[in] categoryIndex: WORD, #[in] statIndex: WORD, #[Windows::Win32::Metadata::NativeSal("1.2", "__RPC__deref_opt_inout_opt_string", "", "")] #[in] #[out] pName: *mut LPWSTR, #[Windows::Win32::Metadata::NativeSal("1.2", "__RPC__deref_opt_inout_opt_string", "", "")] #[in] #[out] pValue: *mut LPWSTR) -> HRESULT;
            fn SetStatistic(&self, #[in] categoryIndex: WORD, #[in] statIndex: WORD, #[in] #[null_terminated(entry)] name: LPCWSTR, #[in] #[null_terminated(entry)] value: LPCWSTR) -> HRESULT;
            fn Save(&self, #[in] trackChanges: BOOL) -> HRESULT;
            fn SetLastPlayedCategory(&self, #[in] categoryIndex: UINT) -> HRESULT;
            fn GetLastPlayedCategory(&self, #[out] #[retval] pCategoryIndex: *mut UINT) -> HRESULT;
        }
        #[guid(0xaff3ea11_e70e_407d_95dd_35e612c41ce2)]
        interface IGameStatisticsMgr: IUnknown {
            fn GetGameStatistics(&self, #[in] #[null_terminated(entry)] GDFBinaryPath: LPCWSTR, #[in] openType: GAMESTATS_OPEN_TYPE, #[out] pOpenResult: *mut GAMESTATS_OPEN_RESULT, #[out] #[out_ptr] #[retval] ppiStats: *mut IGameStatistics) -> HRESULT;
            fn RemoveGameStatistics(&self, #[in] #[null_terminated(entry)] GDFBinaryPath: LPCWSTR) -> HRESULT;
