            fn VerifyAccess(&self, #[in] bstrGDFBinaryPath: BSTR, #[out] pfHasAccess: *mut BOOL) -> HRESULT;
        }
        #[guid(0x86874aa7_a1ed_450d_a7eb_b89e20b2fff3)]
        interface IGameExplorer2: IUnknown {
            fn InstallGame(&self, #[in] #[null_terminated(entry)] binaryGDFPath: LPCWSTR, #[in] #[opt] installDirectory: LPCWSTR, #[in] installScope: GAME_INSTALL_SCOPE) -> HRESULT;
            fn UninstallGame(&self, #[in] #[null_terminated(entry)] binaryGDFPath: LPCWSTR) -> HRESULT;
            fn CheckAccess(&self, #[in] #[null_terminated(entry)] binaryGDFPath: LPCWSTR, #[out] #[retval] pHasAccess: *mut BOOL) -> HRESULT;
        }
        #[guid(0x3887c9ca_04a0_42ae_bc4c_5fa6c7721145)]
        interface IGameStatistics: IUnknown {
            fn GetMaxCategoryLength(&self, #[out] #[retval] cch: *mut UINT) -> HRESULT;
            fn GetMaxNameLength(&self, #[out] #[retval] cch: *mut UINT) -> HRESULT;
            fn GetMaxValueLength(&self, #[out] #[retval] cch: *mut UINT) -> HRESULT;
