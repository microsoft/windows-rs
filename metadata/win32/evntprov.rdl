#[win32]
mod Windows {
    mod Win32 {
        const EVENT_ACTIVITY_CTRL_CREATE_ID: i32 = 3;
        const EVENT_ACTIVITY_CTRL_CREATE_SET_ID: i32 = 5;
        const EVENT_ACTIVITY_CTRL_GET_ID: i32 = 1;
        const EVENT_ACTIVITY_CTRL_GET_SET_ID: i32 = 4;
        const EVENT_ACTIVITY_CTRL_SET_ID: i32 = 2;
        struct EVENT_DATA_DESCRIPTOR {
            Ptr: ULONGLONG,
            Size: ULONG,
            Anonymous: union {
                Reserved: ULONG,
                Anonymous: struct {
                    Type: UCHAR,
                    Reserved1: UCHAR,
                    Reserved2: USHORT,
                },
            },
        }
        const EVENT_DATA_DESCRIPTOR_TYPE_EVENT_METADATA: i32 = 1;
        const EVENT_DATA_DESCRIPTOR_TYPE_NONE: i32 = 0;
        const EVENT_DATA_DESCRIPTOR_TYPE_PROVIDER_METADATA: i32 = 2;
        const EVENT_DATA_DESCRIPTOR_TYPE_RESERVED1: i32 = 4;
        const EVENT_DATA_DESCRIPTOR_TYPE_TIMESTAMP_OVERRIDE: i32 = 3;
        struct EVENT_DESCRIPTOR {
            Id: USHORT,
            Version: UCHAR,
            Channel: UCHAR,
            Level: UCHAR,
            Opcode: UCHAR,
            Task: USHORT,
            Keyword: ULONGLONG,
        }
        struct EVENT_FILTER_DESCRIPTOR {
            Ptr: ULONGLONG,
            Size: ULONG,
            Type: ULONG,
        }
        struct EVENT_FILTER_EVENT_ID {
            FilterIn: BOOLEAN,
            Reserved: UCHAR,
            Count: USHORT,
            Events: [USHORT; 1],
        }
        struct EVENT_FILTER_EVENT_NAME {
            MatchAnyKeyword: ULONGLONG,
            MatchAllKeyword: ULONGLONG,
            Level: UCHAR,
            FilterIn: BOOLEAN,
            NameCount: USHORT,
            Names: [UCHAR; 1],
        }
        struct EVENT_FILTER_HEADER {
            Id: USHORT,
            Version: UCHAR,
            Reserved: [UCHAR; 5],
            InstanceId: ULONGLONG,
            Size: ULONG,
            NextOffset: ULONG,
        }
        struct EVENT_FILTER_LEVEL_KW {
            MatchAnyKeyword: ULONGLONG,
            MatchAllKeyword: ULONGLONG,
            Level: UCHAR,
            FilterIn: BOOLEAN,
        }
        const EVENT_FILTER_TYPE_CONTAINER: u32 = 2147516416;
        const EVENT_FILTER_TYPE_EVENT_ID: u32 = 2147484160;
        const EVENT_FILTER_TYPE_EVENT_NAME: u32 = 2147484672;
        const EVENT_FILTER_TYPE_EXECUTABLE_NAME: u32 = 2147483656;
        const EVENT_FILTER_TYPE_NONE: i32 = 0;
        const EVENT_FILTER_TYPE_PACKAGE_APP_ID: u32 = 2147483680;
        const EVENT_FILTER_TYPE_PACKAGE_ID: u32 = 2147483664;
        const EVENT_FILTER_TYPE_PAYLOAD: u32 = 2147483904;
        const EVENT_FILTER_TYPE_PID: u32 = 2147483652;
        const EVENT_FILTER_TYPE_SCHEMATIZED: u32 = 2147483648;
        const EVENT_FILTER_TYPE_STACKWALK: u32 = 2147487744;
        const EVENT_FILTER_TYPE_STACKWALK_LEVEL_KW: u32 = 2147500032;
        const EVENT_FILTER_TYPE_STACKWALK_NAME: u32 = 2147491840;
        const EVENT_FILTER_TYPE_SYSTEM_FLAGS: u32 = 2147483649;
        const EVENT_FILTER_TYPE_TRACEHANDLE: u32 = 2147483650;
        #[repr(i32)]
        enum EVENT_INFO_CLASS {
            EventProviderBinaryTrackInfo = 0,
            EventProviderSetReserved1 = 1,
            EventProviderSetTraits = 2,
            EventProviderUseDescriptorType = 3,
            EventProviderSetReserved2 = 4,
            MaxEventInfo = 5,
        }
        const EVENT_MAX_LEVEL: i32 = 255;
        const EVENT_MIN_LEVEL: i32 = 0;
        const EVENT_WRITE_FLAG_INPRIVATE: i32 = 2;
        const EVENT_WRITE_FLAG_NO_FAULTING: i32 = 1;
        #[library("ADVAPI32.dll")]
        extern fn EventActivityIdControl(#[in] ControlCode: ULONG, #[in] #[out] ActivityId: LPGUID) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventEnabled(#[in] RegHandle: REGHANDLE, #[in] EventDescriptor: PCEVENT_DESCRIPTOR) -> BOOLEAN;
        #[library("ADVAPI32.dll")]
        extern fn EventProviderEnabled(#[in] RegHandle: REGHANDLE, #[in] Level: UCHAR, #[in] Keyword: ULONGLONG) -> BOOLEAN;
        #[library("ADVAPI32.dll")]
        extern fn EventRegister(#[in] ProviderId: LPCGUID, #[in] #[opt] EnableCallback: PENABLECALLBACK, #[in] #[opt] CallbackContext: PVOID, #[out] RegHandle: PREGHANDLE) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventSetInformation(#[in] RegHandle: REGHANDLE, #[in] InformationClass: EVENT_INFO_CLASS, #[in] #[readable(entry, bytes(InformationLength))] EventInformation: PVOID, #[in] InformationLength: ULONG) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventUnregister(#[in] RegHandle: REGHANDLE) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventWrite(#[in] RegHandle: REGHANDLE, #[in] EventDescriptor: PCEVENT_DESCRIPTOR, UserDataCount: ULONG, #[in] #[opt] #[readable(entry, UserDataCount)] UserData: PEVENT_DATA_DESCRIPTOR) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventWriteEx(#[in] RegHandle: REGHANDLE, #[in] EventDescriptor: PCEVENT_DESCRIPTOR, #[in] Filter: ULONG64, #[in] Flags: ULONG, #[in] #[opt] ActivityId: LPCGUID, #[in] #[opt] RelatedActivityId: LPCGUID, UserDataCount: ULONG, #[in] #[opt] #[readable(entry, UserDataCount)] UserData: PEVENT_DATA_DESCRIPTOR) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventWriteString(#[in] RegHandle: REGHANDLE, #[in] Level: UCHAR, #[in] Keyword: ULONGLONG, #[in] String: PCWSTR) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventWriteTransfer(#[in] RegHandle: REGHANDLE, #[in] EventDescriptor: PCEVENT_DESCRIPTOR, #[in] #[opt] ActivityId: LPCGUID, #[in] #[opt] RelatedActivityId: LPCGUID, UserDataCount: ULONG, #[in] #[opt] #[readable(entry, UserDataCount)] UserData: PEVENT_DATA_DESCRIPTOR) -> ULONG;
        const MAX_EVENT_DATA_DESCRIPTORS: i32 = 128;
        const MAX_EVENT_FILTERS_COUNT: i32 = 13;
        const MAX_EVENT_FILTER_DATA_SIZE: i32 = 1024;
        const MAX_EVENT_FILTER_EVENT_ID_COUNT: i32 = 64;
        const MAX_EVENT_FILTER_EVENT_NAME_SIZE: i32 = 4096;
        const MAX_EVENT_FILTER_PAYLOAD_SIZE: i32 = 4096;
        const MAX_EVENT_FILTER_PID_COUNT: i32 = 8;
        type PCEVENT_DESCRIPTOR = *const EVENT_DESCRIPTOR;
        extern fn PENABLECALLBACK(#[in] SourceId: LPCGUID, #[in] IsEnabled: ULONG, #[in] Level: UCHAR, #[in] MatchAnyKeyword: ULONGLONG, #[in] MatchAllKeyword: ULONGLONG, #[in] #[opt] FilterData: PEVENT_FILTER_DESCRIPTOR, #[in] #[opt] #[out] CallbackContext: PVOID);
        type PEVENT_DATA_DESCRIPTOR = *mut EVENT_DATA_DESCRIPTOR;
        type PEVENT_DESCRIPTOR = *mut EVENT_DESCRIPTOR;
        type PEVENT_FILTER_DESCRIPTOR = *mut EVENT_FILTER_DESCRIPTOR;
        type PEVENT_FILTER_EVENT_ID = *mut EVENT_FILTER_EVENT_ID;
        type PEVENT_FILTER_EVENT_NAME = *mut EVENT_FILTER_EVENT_NAME;
        type PEVENT_FILTER_HEADER = *mut EVENT_FILTER_HEADER;
        type PEVENT_FILTER_LEVEL_KW = *mut EVENT_FILTER_LEVEL_KW;
        type PREGHANDLE = *mut u64;
        type REGHANDLE = u64;
    }
}
