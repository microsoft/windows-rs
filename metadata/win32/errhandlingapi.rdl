#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn AddVectoredContinueHandler(#[in] First: ULONG, #[in] Handler: PVECTORED_EXCEPTION_HANDLER) -> #[nullable] PVOID;
        #[library("KERNEL32.dll")]
        extern fn AddVectoredExceptionHandler(#[in] First: ULONG, #[in] Handler: PVECTORED_EXCEPTION_HANDLER) -> #[nullable] PVOID;
        #[library("KERNEL32.dll")]
        extern fn FatalAppExitA(#[in] uAction: UINT, #[in] lpMessageText: LPCSTR);
        #[library("KERNEL32.dll")]
        extern fn FatalAppExitW(#[in] uAction: UINT, #[in] lpMessageText: LPCWSTR);
        #[library("KERNEL32.dll")]
        extern fn GetErrorMode() -> UINT;
        #[library("KERNEL32.dll")]
        #[must_use]
        extern fn GetLastError() -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetThreadErrorMode() -> DWORD;
        extern fn LPTOP_LEVEL_EXCEPTION_FILTER(#[in] ExceptionInfo: *mut EXCEPTION_POINTERS) -> LONG;
        extern fn PTOP_LEVEL_EXCEPTION_FILTER(#[in] ExceptionInfo: *mut EXCEPTION_POINTERS) -> LONG;
        #[library("KERNEL32.dll")]
        extern fn RaiseException(#[in] dwExceptionCode: DWORD, #[in] dwExceptionFlags: DWORD, #[in] nNumberOfArguments: DWORD, #[in] #[opt] #[readable(entry, nNumberOfArguments)] lpArguments: *const ULONG_PTR);
        #[library("KERNEL32.dll")]
        extern fn RaiseFailFastException(#[in] #[opt] pExceptionRecord: PEXCEPTION_RECORD, #[in] #[opt] pContextRecord: PCONTEXT, #[in] dwFlags: DWORD);
        #[library("KERNEL32.dll")]
        extern fn RemoveVectoredContinueHandler(#[in] Handle: PVOID) -> ULONG;
        #[library("KERNEL32.dll")]
        extern fn RemoveVectoredExceptionHandler(#[in] Handle: PVOID) -> ULONG;
        #[library("KERNEL32.dll")]
        extern fn SetErrorMode(#[in] uMode: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn SetLastError(#[in] dwErrCode: DWORD);
        #[library("KERNEL32.dll")]
        extern fn SetThreadErrorMode(#[in] dwNewMode: DWORD, #[in] #[opt] lpOldMode: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetUnhandledExceptionFilter(#[in] #[opt] lpTopLevelExceptionFilter: LPTOP_LEVEL_EXCEPTION_FILTER) -> LPTOP_LEVEL_EXCEPTION_FILTER;
        #[library("api-ms-win-core-errorhandling-l1-1-3.dll")]
        extern fn TerminateProcessOnMemoryExhaustion(#[in] FailedAllocationSize: SIZE_T);
        #[library("KERNEL32.dll")]
        extern fn UnhandledExceptionFilter(#[in] ExceptionInfo: *mut EXCEPTION_POINTERS) -> LONG;
    }
}
