#[win32]
mod Windows {
    mod Win32 {
        #[packed(8)]
        struct CATALOG_INFO {
            cbStruct: DWORD,
            wszCatalogFile: [WCHAR; 260],
        }
        #[packed(8)]
        struct CRYPTCATATTRIBUTE {
            cbStruct: DWORD,
            pwszReferenceTag: LPWSTR,
            dwAttrTypeAndAction: DWORD,
            cbValue: DWORD,
            pbValue: *mut BYTE,
            dwReserved: DWORD,
        }
        #[packed(8)]
        struct CRYPTCATCDF {
            cbStruct: DWORD,
            hFile: HANDLE,
            dwCurFilePos: DWORD,
            dwLastMemberOffset: DWORD,
            fEOF: BOOL,
            pwszResultDir: LPWSTR,
            hCATStore: HANDLE,
        }
        #[packed(8)]
        struct CRYPTCATMEMBER {
            cbStruct: DWORD,
            pwszReferenceTag: LPWSTR,
            pwszFileName: LPWSTR,
            gSubjectType: GUID,
            fdwMemberFlags: DWORD,
            pIndirectData: *mut SIP_INDIRECT_DATA,
            dwCertVersion: DWORD,
            dwReserved: DWORD,
            hReserved: HANDLE,
            sEncodedIndirectData: CRYPT_ATTR_BLOB,
            sEncodedMemberInfo: CRYPT_ATTR_BLOB,
        }
        #[packed(8)]
        struct CRYPTCATSTORE {
            cbStruct: DWORD,
            dwPublicVersion: DWORD,
            pwszP7File: LPWSTR,
            hProv: HCRYPTPROV,
            dwEncodingType: DWORD,
            fdwStoreFlags: DWORD,
            hReserved: HANDLE,
            hAttrs: HANDLE,
            hCryptMsg: HCRYPTMSG,
            hSorted: HANDLE,
        }
        const CRYPTCAT_ADDCATALOG_HARDLINK: i32 = 1;
        const CRYPTCAT_ADDCATALOG_NONE: i32 = 0;
        const CRYPTCAT_ATTR_AUTHENTICATED: i32 = 268435456;
        const CRYPTCAT_ATTR_DATAASCII: i32 = 65536;
        const CRYPTCAT_ATTR_DATABASE64: i32 = 131072;
        const CRYPTCAT_ATTR_DATAREPLACE: i32 = 262144;
        const CRYPTCAT_ATTR_NAMEASCII: i32 = 1;
        const CRYPTCAT_ATTR_NAMEOBJID: i32 = 2;
        const CRYPTCAT_ATTR_NO_AUTO_COMPAT_ENTRY: i32 = 16777216;
        const CRYPTCAT_ATTR_UNAUTHENTICATED: i32 = 536870912;
        const CRYPTCAT_E_AREA_ATTRIBUTE: i32 = 131072;
        const CRYPTCAT_E_AREA_HEADER: i32 = 0;
        const CRYPTCAT_E_AREA_MEMBER: i32 = 65536;
        const CRYPTCAT_E_CDF_ATTR_TOOFEWVALUES: i32 = 131074;
        const CRYPTCAT_E_CDF_ATTR_TYPECOMBO: i32 = 131076;
        const CRYPTCAT_E_CDF_BAD_GUID_CONV: i32 = 131073;
        const CRYPTCAT_E_CDF_DUPLICATE: i32 = 2;
        const CRYPTCAT_E_CDF_MEMBER_FILENOTFOUND: i32 = 65540;
        const CRYPTCAT_E_CDF_MEMBER_FILE_PATH: i32 = 65537;
        const CRYPTCAT_E_CDF_MEMBER_INDIRECTDATA: i32 = 65538;
        const CRYPTCAT_E_CDF_TAGNOTFOUND: i32 = 4;
        const CRYPTCAT_E_CDF_UNSUPPORTED: i32 = 1;
        #[encoding("utf-16")]
        const CRYPTCAT_FILEEXT: String = "CAT";
        const CRYPTCAT_MAX_MEMBERTAG: i32 = 128;
        const CRYPTCAT_MEMBER_SORTED: i32 = 1073741824;
        const CRYPTCAT_OPEN_ALWAYS: i32 = 2;
        const CRYPTCAT_OPEN_CREATENEW: i32 = 1;
        const CRYPTCAT_OPEN_EXCLUDE_PAGE_HASHES: i32 = 65536;
        const CRYPTCAT_OPEN_EXISTING: i32 = 4;
        const CRYPTCAT_OPEN_FLAGS_MASK: u32 = 4294901760;
        const CRYPTCAT_OPEN_INCLUDE_PAGE_HASHES: i32 = 131072;
        const CRYPTCAT_OPEN_NO_CONTENT_HCRYPTMSG: i32 = 536870912;
        const CRYPTCAT_OPEN_SORTED: i32 = 1073741824;
        const CRYPTCAT_OPEN_VERIFYSIGHASH: i32 = 268435456;
        const CRYPTCAT_VERSION_1: i32 = 256;
        const CRYPTCAT_VERSION_2: i32 = 512;
        #[library("WINTRUST.dll")]
        #[success(return != 0)]
        extern fn CryptCATAdminAcquireContext(#[out] phCatAdmin: *mut HCATADMIN, #[in] #[opt] pgSubsystem: *const GUID, #[reserved] dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        #[success(return != 0)]
        extern fn CryptCATAdminAcquireContext2(#[out] phCatAdmin: *mut HCATADMIN, #[in] #[opt] pgSubsystem: *const GUID, #[in] #[opt] pwszHashAlgorithm: PCWSTR, #[in] #[opt] pStrongHashPolicy: PCCERT_STRONG_SIGN_PARA, #[reserved] dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAdminAddCatalog(#[in] hCatAdmin: HCATADMIN, #[in] pwszCatalogFile: PWSTR, #[in] #[opt] pwszSelectBaseName: PWSTR, #[in] dwFlags: DWORD) -> HCATINFO;
        #[library("WINTRUST.dll")]
        #[success(return != 0)]
        extern fn CryptCATAdminCalcHashFromFileHandle(#[in] hFile: HANDLE, #[in] #[out] pcbHash: *mut DWORD, #[opt] #[out] #[readable(success, bytes(*pcbHash))] #[writable(entry, bytes(*pcbHash))] pbHash: *mut BYTE, #[reserved] dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        #[success(return != 0)]
        extern fn CryptCATAdminCalcHashFromFileHandle2(#[in] hCatAdmin: HCATADMIN, #[in] hFile: HANDLE, #[in] #[out] pcbHash: *mut DWORD, #[opt] #[out] #[readable(success, bytes(*pcbHash))] #[writable(entry, bytes(*pcbHash))] pbHash: *mut BYTE, #[reserved] dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAdminEnumCatalogFromHash(#[in] hCatAdmin: HCATADMIN, #[in] #[readable(entry, bytes(cbHash))] pbHash: *mut BYTE, #[in] cbHash: DWORD, #[reserved] dwFlags: DWORD, #[in] #[opt] #[out] phPrevCatInfo: *mut HCATINFO) -> HCATINFO;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAdminPauseServiceForBackup(dwFlags: DWORD, fResume: BOOL) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAdminReleaseCatalogContext(hCatAdmin: HCATADMIN, hCatInfo: HCATINFO, dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAdminReleaseContext(hCatAdmin: HCATADMIN, dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAdminRemoveCatalog(hCatAdmin: HCATADMIN, pwszCatalogFile: LPCWSTR, dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        #[success(return != 0)]
        extern fn CryptCATAdminResolveCatalogPath(#[in] hCatAdmin: HCATADMIN, #[in] #[null_terminated(entry)] pwszCatalogFile: *mut WCHAR, #[in] #[out] psCatInfo: *mut CATALOG_INFO, #[in] dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATAllocSortedMemberInfo(hCatalog: HANDLE, #[in] pwszReferenceTag: LPWSTR) -> *mut CRYPTCATMEMBER;
        #[library("WINTRUST.dll")]
        extern fn CryptCATCDFClose(pCDF: *mut CRYPTCATCDF) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATCDFEnumAttributes(pCDF: *mut CRYPTCATCDF, pMember: *mut CRYPTCATMEMBER, pPrevAttr: *mut CRYPTCATATTRIBUTE, pfnParseError: PFN_CDF_PARSE_ERROR_CALLBACK) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATCDFEnumCatAttributes(pCDF: *mut CRYPTCATCDF, pPrevAttr: *mut CRYPTCATATTRIBUTE, pfnParseError: PFN_CDF_PARSE_ERROR_CALLBACK) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATCDFEnumMembers(pCDF: *mut CRYPTCATCDF, pPrevMember: *mut CRYPTCATMEMBER, pfnParseError: PFN_CDF_PARSE_ERROR_CALLBACK) -> *mut CRYPTCATMEMBER;
        #[library("WINTRUST.dll")]
        extern fn CryptCATCDFOpen(#[in] pwszFilePath: LPWSTR, #[in] #[opt] pfnParseError: PFN_CDF_PARSE_ERROR_CALLBACK) -> *mut CRYPTCATCDF;
        #[library("WINTRUST.dll")]
        #[success(return != 0)]
        extern fn CryptCATCatalogInfoFromContext(#[in] hCatInfo: HCATINFO, #[in] #[out] psCatInfo: *mut CATALOG_INFO, #[in] dwFlags: DWORD) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATClose(hCatalog: HANDLE) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATEnumerateAttr(hCatalog: HANDLE, pCatMember: *mut CRYPTCATMEMBER, pPrevAttr: *mut CRYPTCATATTRIBUTE) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATEnumerateCatAttr(hCatalog: HANDLE, pPrevAttr: *mut CRYPTCATATTRIBUTE) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATEnumerateMember(hCatalog: HANDLE, pPrevMember: *mut CRYPTCATMEMBER) -> *mut CRYPTCATMEMBER;
        #[library("WINTRUST.dll")]
        extern fn CryptCATFreeSortedMemberInfo(hCatalog: HANDLE, pCatMember: *mut CRYPTCATMEMBER);
        #[library("WINTRUST.dll")]
        extern fn CryptCATGetAttrInfo(hCatalog: HANDLE, pCatMember: *mut CRYPTCATMEMBER, #[in] pwszReferenceTag: LPWSTR) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATGetCatAttrInfo(hCatalog: HANDLE, #[in] pwszReferenceTag: LPWSTR) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATGetMemberInfo(hCatalog: HANDLE, #[in] pwszReferenceTag: LPWSTR) -> *mut CRYPTCATMEMBER;
        #[library("WINTRUST.dll")]
        extern fn CryptCATHandleFromStore(pCatStore: *mut CRYPTCATSTORE) -> HANDLE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATOpen(#[in] pwszFileName: LPWSTR, fdwOpenFlags: DWORD, hProv: HCRYPTPROV, dwPublicVersion: DWORD, dwEncodingType: DWORD) -> HANDLE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATPersistStore(hCatalog: HANDLE) -> BOOL;
        #[library("WINTRUST.dll")]
        extern fn CryptCATPutAttrInfo(hCatalog: HANDLE, pCatMember: *mut CRYPTCATMEMBER, #[in] pwszReferenceTag: LPWSTR, dwAttrTypeAndAction: DWORD, cbData: DWORD, pbData: *mut BYTE) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATPutCatAttrInfo(hCatalog: HANDLE, #[in] pwszReferenceTag: LPWSTR, dwAttrTypeAndAction: DWORD, cbData: DWORD, pbData: *mut BYTE) -> *mut CRYPTCATATTRIBUTE;
        #[library("WINTRUST.dll")]
        extern fn CryptCATPutMemberInfo(hCatalog: HANDLE, #[in] #[opt] pwszFileName: LPWSTR, #[in] pwszReferenceTag: LPWSTR, pgSubjectType: *mut GUID, dwCertVersion: DWORD, cbSIPIndirectData: DWORD, pbSIPIndirectData: *mut BYTE) -> *mut CRYPTCATMEMBER;
        #[library("WINTRUST.dll")]
        extern fn CryptCATStoreFromHandle(hCatalog: HANDLE) -> *mut CRYPTCATSTORE;
        type HCATINFO = *mut void;
        #[library("WINTRUST.dll")]
        extern fn IsCatalogFile(hFile: HANDLE, #[in] #[null_terminated(entry)] #[opt] pwszFileName: *mut WCHAR) -> BOOL;
        extern fn PFN_CDF_PARSE_ERROR_CALLBACK(dwErrorArea: DWORD, dwLocalError: DWORD, pwszLine: *mut WCHAR);
        #[encoding("ansi")]
        const szOID_CATALOG_LIST: String = "1.3.6.1.4.1.311.12.1.1";
        #[encoding("ansi")]
        const szOID_CATALOG_LIST_MEMBER: String = "1.3.6.1.4.1.311.12.1.2";
        #[encoding("ansi")]
        const szOID_CATALOG_LIST_MEMBER2: String = "1.3.6.1.4.1.311.12.1.3";
    }
}
