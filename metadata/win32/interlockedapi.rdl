#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn InitializeSListHead(#[out] ListHead: PSLIST_HEADER);
        #[library("KERNEL32.dll")]
        extern fn InterlockedFlushSList(#[in] #[out] ListHead: PSLIST_HEADER) -> PSLIST_ENTRY;
        #[library("KERNEL32.dll")]
        extern fn InterlockedPopEntrySList(#[in] #[out] ListHead: PSLIST_HEADER) -> PSLIST_ENTRY;
        #[library("KERNEL32.dll")]
        extern fn InterlockedPushEntrySList(#[in] #[out] ListHead: PSLIST_HEADER, #[Windows::Win32::Metadata::NativeSal("L", "__drv_aliasesMem", "", "")] #[in] #[out] ListEntry: PSLIST_ENTRY) -> PSLIST_ENTRY;
        #[library("KERNEL32.dll")]
        extern fn InterlockedPushListSListEx(#[in] #[out] ListHead: PSLIST_HEADER, #[in] #[out] List: PSLIST_ENTRY, #[in] #[out] ListEnd: PSLIST_ENTRY, #[in] Count: ULONG) -> PSLIST_ENTRY;
        #[library("KERNEL32.dll")]
        extern fn QueryDepthSList(#[in] ListHead: PSLIST_HEADER) -> USHORT;
    }
