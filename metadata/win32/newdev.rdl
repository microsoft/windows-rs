#[win32]
mod Windows {
    mod Win32 {
        const DIIDFLAG_BITS: i32 = 15;
        const DIIDFLAG_INSTALLCOPYINFDRIVERS: i32 = 8;
        const DIIDFLAG_INSTALLNULLDRIVER: i32 = 4;
        const DIIDFLAG_NOFINISHINSTALLUI: i32 = 2;
        const DIIDFLAG_SHOWSEARCHUI: i32 = 1;
        const DIIRFLAG_BITS: i32 = 106;
        const DIIRFLAG_FORCE_INF: i32 = 2;
        const DIIRFLAG_HOTPATCH: i32 = 8;
        const DIIRFLAG_HW_USING_THE_INF: i32 = 4;
        const DIIRFLAG_INF_ALREADY_COPIED: i32 = 1;
        const DIIRFLAG_INSTALL_AS_SET: i32 = 64;
        const DIIRFLAG_NOBACKUP: i32 = 16;
        const DIIRFLAG_PRE_CONFIGURE_INF: i32 = 32;
        const DIIRFLAG_SYSTEM_BITS: i32 = 127;
        const DIURFLAG_NO_REMOVE_INF: i32 = 1;
        const DIURFLAG_RESERVED: i32 = 2;
        const DIURFLAG_VALID: i32 = 3;
        #[library("newdev.dll")]
        extern fn DiInstallDevice(#[in] #[opt] hwndParent: HWND, #[in] DeviceInfoSet: HDEVINFO, #[in] DeviceInfoData: PSP_DEVINFO_DATA, #[in] #[opt] DriverInfoData: PSP_DRVINFO_DATA, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiInstallDriverA(#[in] #[opt] hwndParent: HWND, #[in] InfPath: LPCSTR, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiInstallDriverW(#[in] #[opt] hwndParent: HWND, #[in] InfPath: LPCWSTR, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiRollbackDriver(#[in] DeviceInfoSet: HDEVINFO, #[in] DeviceInfoData: PSP_DEVINFO_DATA, #[in] #[opt] hwndParent: HWND, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiShowUpdateDevice(#[in] #[opt] hwndParent: HWND, #[in] DeviceInfoSet: HDEVINFO, #[in] DeviceInfoData: PSP_DEVINFO_DATA, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiShowUpdateDriver(#[in] #[opt] hwndParent: HWND, #[in] #[opt] FilePath: PCWSTR, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiUninstallDevice(#[in] hwndParent: HWND, #[in] DeviceInfoSet: HDEVINFO, #[in] DeviceInfoData: PSP_DEVINFO_DATA, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiUninstallDriverA(#[in] #[opt] hwndParent: HWND, #[in] InfPath: LPCSTR, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn DiUninstallDriverW(#[in] #[opt] hwndParent: HWND, #[in] InfPath: LPCWSTR, #[in] Flags: DWORD, #[opt] #[out] NeedReboot: PBOOL) -> BOOL;
        const INSTALLFLAG_BITS: i32 = 7;
        const INSTALLFLAG_FORCE: i32 = 1;
        const INSTALLFLAG_NONINTERACTIVE: i32 = 4;
        const INSTALLFLAG_READONLY: i32 = 2;
        const ROLLBACK_BITS: i32 = 1;
        const ROLLBACK_FLAG_NO_UI: i32 = 1;
        #[library("newdev.dll")]
        extern fn UpdateDriverForPlugAndPlayDevicesA(#[in] #[opt] hwndParent: HWND, #[in] HardwareId: LPCSTR, #[in] FullInfPath: LPCSTR, #[in] InstallFlags: DWORD, #[opt] #[out] bRebootRequired: PBOOL) -> BOOL;
        #[library("newdev.dll")]
        extern fn UpdateDriverForPlugAndPlayDevicesW(#[in] #[opt] hwndParent: HWND, #[in] HardwareId: LPCWSTR, #[in] FullInfPath: LPCWSTR, #[in] InstallFlags: DWORD, #[opt] #[out] bRebootRequired: PBOOL) -> BOOL;
    }
}
