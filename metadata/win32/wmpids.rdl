        const WMPCOREEVENT_PLAYLIST_BASE: i32 = 5800;
        const WMPCOREEVENT_SEEK_BASE: i32 = 5200;
        const WMPCOREEVENT_WARNING_BASE: i32 = 5600;
        const WMPOCXEVENT_BASE: i32 = 6500;
    }
}
