#[win32]
mod Windows {
    mod Win32 {
        const BACKGROUND_BLUE: i32 = 16;
        const BACKGROUND_GREEN: i32 = 32;
        const BACKGROUND_INTENSITY: i32 = 128;
        const BACKGROUND_RED: i32 = 64;
        const COMMON_LVB_GRID_HORIZONTAL: i32 = 1024;
        const COMMON_LVB_GRID_LVERTICAL: i32 = 2048;
        const COMMON_LVB_GRID_RVERTICAL: i32 = 4096;
        const COMMON_LVB_LEADING_BYTE: i32 = 256;
        const COMMON_LVB_REVERSE_VIDEO: i32 = 16384;
        const COMMON_LVB_SBCSDBCS: i32 = 768;
        const COMMON_LVB_TRAILING_BYTE: i32 = 512;
        const COMMON_LVB_UNDERSCORE: i32 = 32768;
        struct CONSOLE_CURSOR_INFO {
            dwSize: DWORD,
            bVisible: BOOL,
        }
        struct CONSOLE_SCREEN_BUFFER_INFO {
            dwSize: COORD,
            dwCursorPosition: COORD,
            wAttributes: WORD,
            srWindow: SMALL_RECT,
            dwMaximumWindowSize: COORD,
        }
        struct CONSOLE_SCREEN_BUFFER_INFOEX {
            cbSize: ULONG,
            dwSize: COORD,
            dwCursorPosition: COORD,
            wAttributes: WORD,
            srWindow: SMALL_RECT,
            dwMaximumWindowSize: COORD,
            wPopupAttributes: WORD,
            bFullscreenSupported: BOOL,
            ColorTable: [COLORREF; 16],
        }
        #[library("KERNEL32.dll")]
        extern fn CreateConsoleScreenBuffer(#[in] dwDesiredAccess: DWORD, #[in] dwShareMode: DWORD, #[in] #[opt] lpSecurityAttributes: *const SECURITY_ATTRIBUTES, #[in] dwFlags: DWORD, #[reserved] lpScreenBufferData: LPVOID) -> HANDLE;
        const FOREGROUND_BLUE: i32 = 1;
        const FOREGROUND_GREEN: i32 = 2;
        const FOREGROUND_INTENSITY: i32 = 8;
        const FOREGROUND_RED: i32 = 4;
        #[library("KERNEL32.dll")]
        extern fn FillConsoleOutputAttribute(#[in] hConsoleOutput: HANDLE, #[in] wAttribute: WORD, #[in] nLength: DWORD, #[in] dwWriteCoord: COORD, #[out] lpNumberOfAttrsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn FillConsoleOutputCharacterA(#[in] hConsoleOutput: HANDLE, #[in] cCharacter: CHAR, #[in] nLength: DWORD, #[in] dwWriteCoord: COORD, #[out] lpNumberOfCharsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn FillConsoleOutputCharacterW(#[in] hConsoleOutput: HANDLE, #[in] cCharacter: WCHAR, #[in] nLength: DWORD, #[in] dwWriteCoord: COORD, #[out] lpNumberOfCharsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn FlushConsoleInputBuffer(#[in] hConsoleInput: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GenerateConsoleCtrlEvent(#[in] dwCtrlEvent: DWORD, #[in] dwProcessGroupId: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleCursorInfo(#[in] hConsoleOutput: HANDLE, #[out] lpConsoleCursorInfo: PCONSOLE_CURSOR_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleOriginalTitleA(#[out] #[writable(entry, nSize)] lpConsoleTitle: LPSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleOriginalTitleW(#[out] #[writable(entry, nSize)] lpConsoleTitle: LPWSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleScreenBufferInfo(#[in] hConsoleOutput: HANDLE, #[out] lpConsoleScreenBufferInfo: PCONSOLE_SCREEN_BUFFER_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleScreenBufferInfoEx(#[in] hConsoleOutput: HANDLE, #[in] #[out] lpConsoleScreenBufferInfoEx: PCONSOLE_SCREEN_BUFFER_INFOEX) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleTitleA(#[out] #[writable(entry, nSize)] lpConsoleTitle: LPSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleTitleW(#[out] #[writable(entry, nSize)] lpConsoleTitle: LPWSTR, #[in] nSize: DWORD) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetLargestConsoleWindowSize(#[in] hConsoleOutput: HANDLE) -> COORD;
        type PCONSOLE_CURSOR_INFO = *mut CONSOLE_CURSOR_INFO;
        type PCONSOLE_SCREEN_BUFFER_INFO = *mut CONSOLE_SCREEN_BUFFER_INFO;
        type PCONSOLE_SCREEN_BUFFER_INFOEX = *mut CONSOLE_SCREEN_BUFFER_INFOEX;
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleOutputA(#[in] hConsoleOutput: HANDLE, #[incomplete] #[out] lpBuffer: PCHAR_INFO, #[in] dwBufferSize: COORD, #[in] dwBufferCoord: COORD, #[in] #[out] lpReadRegion: PSMALL_RECT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleOutputAttribute(#[in] hConsoleOutput: HANDLE, #[out] #[writable(entry, nLength)] lpAttribute: LPWORD, #[in] nLength: DWORD, #[in] dwReadCoord: COORD, #[out] lpNumberOfAttrsRead: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleOutputCharacterA(#[in] hConsoleOutput: HANDLE, #[out] #[writable(entry, nLength)] lpCharacter: LPSTR, #[in] nLength: DWORD, #[in] dwReadCoord: COORD, #[out] lpNumberOfCharsRead: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleOutputCharacterW(#[in] hConsoleOutput: HANDLE, #[out] #[writable(entry, nLength)] lpCharacter: LPWSTR, #[in] nLength: DWORD, #[in] dwReadCoord: COORD, #[out] lpNumberOfCharsRead: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleOutputW(#[in] hConsoleOutput: HANDLE, #[incomplete] #[out] lpBuffer: PCHAR_INFO, #[in] dwBufferSize: COORD, #[in] dwBufferCoord: COORD, #[in] #[out] lpReadRegion: PSMALL_RECT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ScrollConsoleScreenBufferA(#[in] hConsoleOutput: HANDLE, #[in] lpScrollRectangle: *const SMALL_RECT, #[in] #[opt] lpClipRectangle: *const SMALL_RECT, #[in] dwDestinationOrigin: COORD, #[in] lpFill: *const CHAR_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ScrollConsoleScreenBufferW(#[in] hConsoleOutput: HANDLE, #[in] lpScrollRectangle: *const SMALL_RECT, #[in] #[opt] lpClipRectangle: *const SMALL_RECT, #[in] dwDestinationOrigin: COORD, #[in] lpFill: *const CHAR_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleActiveScreenBuffer(#[in] hConsoleOutput: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleCP(#[in] wCodePageID: UINT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleCursorInfo(#[in] hConsoleOutput: HANDLE, #[in] lpConsoleCursorInfo: *const CONSOLE_CURSOR_INFO) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleCursorPosition(#[in] hConsoleOutput: HANDLE, #[in] dwCursorPosition: COORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleOutputCP(#[in] wCodePageID: UINT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleScreenBufferInfoEx(#[in] hConsoleOutput: HANDLE, #[in] lpConsoleScreenBufferInfoEx: PCONSOLE_SCREEN_BUFFER_INFOEX) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleScreenBufferSize(#[in] hConsoleOutput: HANDLE, #[in] dwSize: COORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleTextAttribute(#[in] hConsoleOutput: HANDLE, #[in] wAttributes: WORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleTitleA(#[in] lpConsoleTitle: LPCSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleTitleW(#[in] lpConsoleTitle: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleWindowInfo(#[in] hConsoleOutput: HANDLE, #[in] bAbsolute: BOOL, #[in] lpConsoleWindow: *const SMALL_RECT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleInputA(#[in] hConsoleInput: HANDLE, #[in] #[readable(entry, nLength)] lpBuffer: *const INPUT_RECORD, #[in] nLength: DWORD, #[out] lpNumberOfEventsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleInputW(#[in] hConsoleInput: HANDLE, #[in] #[readable(entry, nLength)] lpBuffer: *const INPUT_RECORD, #[in] nLength: DWORD, #[out] lpNumberOfEventsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleOutputA(#[in] hConsoleOutput: HANDLE, #[in] #[incomplete] lpBuffer: *const CHAR_INFO, #[in] dwBufferSize: COORD, #[in] dwBufferCoord: COORD, #[in] #[out] lpWriteRegion: PSMALL_RECT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleOutputAttribute(#[in] hConsoleOutput: HANDLE, #[in] #[readable(entry, nLength)] lpAttribute: *const WORD, #[in] nLength: DWORD, #[in] dwWriteCoord: COORD, #[out] lpNumberOfAttrsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleOutputCharacterA(#[in] hConsoleOutput: HANDLE, #[in] #[readable(entry, nLength)] lpCharacter: LPCSTR, #[in] nLength: DWORD, #[in] dwWriteCoord: COORD, #[out] lpNumberOfCharsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleOutputCharacterW(#[in] hConsoleOutput: HANDLE, #[in] #[readable(entry, nLength)] lpCharacter: LPCWSTR, #[in] nLength: DWORD, #[in] dwWriteCoord: COORD, #[out] lpNumberOfCharsWritten: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleOutputW(#[in] hConsoleOutput: HANDLE, #[in] #[incomplete] lpBuffer: *const CHAR_INFO, #[in] dwBufferSize: COORD, #[in] dwBufferCoord: COORD, #[in] #[out] lpWriteRegion: PSMALL_RECT) -> BOOL;
    }
}
