#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum ETW_PROVIDER_TRAIT_TYPE {
            EtwProviderTraitTypeGroup = 1,
            EtwProviderTraitDecodeGuid = 2,
            EtwProviderTraitTypeMax = 3,
        }
        #[repr(i32)]
        enum EVENTSECURITYOPERATION {
            EventSecuritySetDACL = 0,
            EventSecuritySetSACL = 1,
            EventSecurityAddDACL = 2,
            EventSecurityAddSACL = 3,
            EventSecurityMax = 4,
        }
        const EVENT_ENABLE_PROPERTY_ENABLE_KEYWORD_0: i32 = 64;
        const EVENT_ENABLE_PROPERTY_ENABLE_SILOS: i32 = 1024;
        const EVENT_ENABLE_PROPERTY_EVENT_KEY: i32 = 256;
        const EVENT_ENABLE_PROPERTY_EXCLUDE_INPRIVATE: i32 = 512;
        const EVENT_ENABLE_PROPERTY_IGNORE_KEYWORD_0: i32 = 16;
        const EVENT_ENABLE_PROPERTY_PROCESS_START_KEY: i32 = 128;
        const EVENT_ENABLE_PROPERTY_PROVIDER_GROUP: i32 = 32;
        const EVENT_ENABLE_PROPERTY_PSM_KEY: i32 = 8;
        const EVENT_ENABLE_PROPERTY_SID: i32 = 1;
        const EVENT_ENABLE_PROPERTY_SOURCE_CONTAINER_TRACKING: i32 = 2048;
        const EVENT_ENABLE_PROPERTY_STACK_TRACE: i32 = 4;
        const EVENT_ENABLE_PROPERTY_TS_ID: i32 = 2;
        struct EVENT_EXTENDED_ITEM_EVENT_KEY {
            Key: ULONG64,
        }
        struct EVENT_EXTENDED_ITEM_INSTANCE {
            InstanceId: ULONG,
            ParentInstanceId: ULONG,
            ParentGuid: GUID,
        }
        struct EVENT_EXTENDED_ITEM_PEBS_INDEX {
            PebsIndex: ULONG64,
        }
        struct EVENT_EXTENDED_ITEM_PMC_COUNTERS {
            Counter: [ULONG64; 1],
        }
        struct EVENT_EXTENDED_ITEM_PROCESS_START_KEY {
            ProcessStartKey: ULONG64,
        }
        struct EVENT_EXTENDED_ITEM_RELATED_ACTIVITYID {
            RelatedActivityId: GUID,
        }
        struct EVENT_EXTENDED_ITEM_STACK_KEY32 {
            MatchId: ULONG64,
            StackKey: ULONG,
            Padding: ULONG,
        }
        struct EVENT_EXTENDED_ITEM_STACK_KEY64 {
            MatchId: ULONG64,
            StackKey: ULONG64,
        }
        struct EVENT_EXTENDED_ITEM_STACK_TRACE32 {
            MatchId: ULONG64,
            Address: [ULONG; 1],
        }
        struct EVENT_EXTENDED_ITEM_STACK_TRACE64 {
            MatchId: ULONG64,
            Address: [ULONG64; 1],
        }
        struct EVENT_EXTENDED_ITEM_TS_ID {
            SessionId: ULONG,
        }
        struct EVENT_HEADER {
            Size: USHORT,
            HeaderType: USHORT,
            Flags: USHORT,
            EventProperty: USHORT,
            ThreadId: ULONG,
            ProcessId: ULONG,
            TimeStamp: LARGE_INTEGER,
            ProviderId: GUID,
            EventDescriptor: EVENT_DESCRIPTOR,
            Anonymous: union {
                Anonymous: struct {
                    KernelTime: ULONG,
                    UserTime: ULONG,
                },
                ProcessorTime: ULONG64,
            },
            ActivityId: GUID,
        }
        struct EVENT_HEADER_EXTENDED_DATA_ITEM {
            Reserved1: USHORT,
            ExtType: USHORT,
            Anonymous: struct {
                _bitfield: u16 {
                    Linkage: USHORT: 1,
                    Reserved2: USHORT: 15,
                },
            },
            DataSize: USHORT,
            DataPtr: ULONGLONG,
        }
        const EVENT_HEADER_EXT_TYPE_CONTAINER_ID: i32 = 16;
        const EVENT_HEADER_EXT_TYPE_CONTROL_GUID: i32 = 14;
        const EVENT_HEADER_EXT_TYPE_EVENT_KEY: i32 = 10;
        const EVENT_HEADER_EXT_TYPE_EVENT_SCHEMA_TL: i32 = 11;
        const EVENT_HEADER_EXT_TYPE_INSTANCE_INFO: i32 = 4;
        const EVENT_HEADER_EXT_TYPE_MAX: i32 = 19;
        const EVENT_HEADER_EXT_TYPE_PEBS_INDEX: i32 = 7;
        const EVENT_HEADER_EXT_TYPE_PMC_COUNTERS: i32 = 8;
        const EVENT_HEADER_EXT_TYPE_PROCESS_START_KEY: i32 = 13;
        const EVENT_HEADER_EXT_TYPE_PROV_TRAITS: i32 = 12;
        const EVENT_HEADER_EXT_TYPE_PSM_KEY: i32 = 9;
        const EVENT_HEADER_EXT_TYPE_QPC_DELTA: i32 = 15;
        const EVENT_HEADER_EXT_TYPE_RELATED_ACTIVITYID: i32 = 1;
        const EVENT_HEADER_EXT_TYPE_SID: i32 = 2;
        const EVENT_HEADER_EXT_TYPE_STACK_KEY32: i32 = 17;
        const EVENT_HEADER_EXT_TYPE_STACK_KEY64: i32 = 18;
        const EVENT_HEADER_EXT_TYPE_STACK_TRACE32: i32 = 5;
        const EVENT_HEADER_EXT_TYPE_STACK_TRACE64: i32 = 6;
        const EVENT_HEADER_EXT_TYPE_TS_ID: i32 = 3;
        const EVENT_HEADER_FLAG_32_BIT_HEADER: i32 = 32;
        const EVENT_HEADER_FLAG_64_BIT_HEADER: i32 = 64;
        const EVENT_HEADER_FLAG_CLASSIC_HEADER: i32 = 256;
        const EVENT_HEADER_FLAG_DECODE_GUID: i32 = 128;
        const EVENT_HEADER_FLAG_EXTENDED_INFO: i32 = 1;
        const EVENT_HEADER_FLAG_NO_CPUTIME: i32 = 16;
        const EVENT_HEADER_FLAG_PRIVATE_SESSION: i32 = 2;
        const EVENT_HEADER_FLAG_PROCESSOR_INDEX: i32 = 512;
        const EVENT_HEADER_FLAG_RESERVED1: i32 = 1024;
        const EVENT_HEADER_FLAG_STRING_ONLY: i32 = 4;
        const EVENT_HEADER_FLAG_TRACE_MESSAGE: i32 = 8;
        const EVENT_HEADER_PROPERTY_FORWARDED_XML: i32 = 2;
        const EVENT_HEADER_PROPERTY_LEGACY_EVENTLOG: i32 = 4;
        const EVENT_HEADER_PROPERTY_RELOGGABLE: i32 = 8;
        const EVENT_HEADER_PROPERTY_XML: i32 = 1;
        struct EVENT_RECORD {
            EventHeader: EVENT_HEADER,
            BufferContext: ETW_BUFFER_CONTEXT,
            ExtendedDataCount: USHORT,
            UserDataLength: USHORT,
            ExtendedData: PEVENT_HEADER_EXTENDED_DATA_ITEM,
            UserData: PVOID,
            UserContext: PVOID,
        }
        #[library("ADVAPI32.dll")]
        extern fn EventAccessControl(#[in] Guid: LPGUID, #[in] Operation: ULONG, #[in] Sid: PSID, #[in] Rights: ULONG, #[in] AllowOrDeny: BOOLEAN) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventAccessQuery(#[in] Guid: LPGUID, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PSECURITY_DESCRIPTOR, #[in] #[out] BufferSize: PULONG) -> ULONG;
        #[library("ADVAPI32.dll")]
        extern fn EventAccessRemove(#[in] Guid: LPGUID) -> ULONG;
        type PCEVENT_RECORD = *const EVENT_RECORD;
        type PEVENT_EXTENDED_ITEM_EVENT_KEY = *mut EVENT_EXTENDED_ITEM_EVENT_KEY;
        type PEVENT_EXTENDED_ITEM_INSTANCE = *mut EVENT_EXTENDED_ITEM_INSTANCE;
        type PEVENT_EXTENDED_ITEM_PEBS_INDEX = *mut EVENT_EXTENDED_ITEM_PEBS_INDEX;
        type PEVENT_EXTENDED_ITEM_PMC_COUNTERS = *mut EVENT_EXTENDED_ITEM_PMC_COUNTERS;
        type PEVENT_EXTENDED_ITEM_PROCESS_START_KEY = *mut EVENT_EXTENDED_ITEM_PROCESS_START_KEY;
        type PEVENT_EXTENDED_ITEM_RELATED_ACTIVITYID = *mut EVENT_EXTENDED_ITEM_RELATED_ACTIVITYID;
        type PEVENT_EXTENDED_ITEM_STACK_KEY32 = *mut EVENT_EXTENDED_ITEM_STACK_KEY32;
        type PEVENT_EXTENDED_ITEM_STACK_KEY64 = *mut EVENT_EXTENDED_ITEM_STACK_KEY64;
        type PEVENT_EXTENDED_ITEM_STACK_TRACE32 = *mut EVENT_EXTENDED_ITEM_STACK_TRACE32;
        type PEVENT_EXTENDED_ITEM_STACK_TRACE64 = *mut EVENT_EXTENDED_ITEM_STACK_TRACE64;
        type PEVENT_EXTENDED_ITEM_TS_ID = *mut EVENT_EXTENDED_ITEM_TS_ID;
        type PEVENT_HEADER = *mut EVENT_HEADER;
        type PEVENT_HEADER_EXTENDED_DATA_ITEM = *mut EVENT_HEADER_EXTENDED_DATA_ITEM;
        type PEVENT_RECORD = *mut EVENT_RECORD;
        const PROCESS_TRACE_MODE_EVENT_RECORD: i32 = 268435456;
        const PROCESS_TRACE_MODE_RAW_TIMESTAMP: i32 = 4096;
        const PROCESS_TRACE_MODE_REAL_TIME: i32 = 256;
    }
}
