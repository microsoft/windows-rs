        const PKCS12_OBJECT_LOCATOR_ALL_IMPORT_FLAGS: i32 = 33360;
        const PKCS12_ONLY_CERTIFICATES: i32 = 1024;
        #[encoding("utf-16")]
        const PKCS12_ONLY_CERTIFICATES_CONTAINER_NAME: String = "PfxContainer";
