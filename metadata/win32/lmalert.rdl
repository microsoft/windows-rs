#[win32]
mod Windows {
    mod Win32 {
        struct ADMIN_OTHER_INFO {
            alrtad_errcode: DWORD,
            alrtad_numstrings: DWORD,
        }
        #[encoding("utf-16")]
        const ALERTER_MAILSLOT: String = "\\\\.\\MAILSLOT\\Alerter";
        #[encoding("utf-16")]
        const ALERT_ADMIN_EVENT: String = "ADMIN";
        #[encoding("utf-16")]
        const ALERT_ERRORLOG_EVENT: String = "ERRORLOG";
        #[encoding("utf-16")]
        const ALERT_MESSAGE_EVENT: String = "MESSAGE";
        #[encoding("utf-16")]
        const ALERT_PRINT_EVENT: String = "PRINTING";
        #[encoding("utf-16")]
        const ALERT_USER_EVENT: String = "USER";
        struct ERRLOG_OTHER_INFO {
            alrter_errcode: DWORD,
            alrter_offset: DWORD,
        }
        type LPADMIN_OTHER_INFO = *mut ADMIN_OTHER_INFO;
        type LPERRLOG_OTHER_INFO = *mut ERRLOG_OTHER_INFO;
        type LPPRINT_OTHER_INFO = *mut PRINT_OTHER_INFO;
        type LPSTD_ALERT = *mut STD_ALERT;
        type LPUSER_OTHER_INFO = *mut USER_OTHER_INFO;
        #[library("NETAPI32.dll")]
        extern fn NetAlertRaise(#[in] AlertType: LPCWSTR, #[in] Buffer: LPVOID, #[in] BufferSize: DWORD) -> DWORD;
        #[library("NETAPI32.dll")]
        extern fn NetAlertRaiseEx(#[in] AlertType: LPCWSTR, #[in] VariableInfo: LPVOID, #[in] VariableInfoSize: DWORD, #[in] ServiceName: LPCWSTR) -> DWORD;
        type PADMIN_OTHER_INFO = *mut ADMIN_OTHER_INFO;
        type PERRLOG_OTHER_INFO = *mut ERRLOG_OTHER_INFO;
        type PPRINT_OTHER_INFO = *mut PRINT_OTHER_INFO;
        struct PRINT_OTHER_INFO {
            alrtpr_jobid: DWORD,
            alrtpr_status: DWORD,
            alrtpr_submitted: DWORD,
            alrtpr_size: DWORD,
        }
        const PRJOB_COMPLETE: i32 = 4;
        const PRJOB_DELETED: i32 = 32768;
        const PRJOB_DESTNOPAPER: i32 = 256;
        const PRJOB_DESTOFFLINE: i32 = 32;
        const PRJOB_DESTPAUSED: i32 = 64;
        const PRJOB_DEVSTATUS: i32 = 508;
        const PRJOB_ERROR: i32 = 16;
        const PRJOB_INTERV: i32 = 8;
        const PRJOB_NOTIFY: i32 = 128;
        const PRJOB_QSTATUS: i32 = 3;
        const PRJOB_QS_PAUSED: i32 = 1;
        const PRJOB_QS_PRINTING: i32 = 3;
        const PRJOB_QS_QUEUED: i32 = 0;
        const PRJOB_QS_SPOOLING: i32 = 2;
        type PSTD_ALERT = *mut STD_ALERT;
        type PUSER_OTHER_INFO = *mut USER_OTHER_INFO;
        struct STD_ALERT {
            alrt_timestamp: DWORD,
            alrt_eventname: [WCHAR; 17],
            alrt_servicename: [WCHAR; 81],
        }
        struct USER_OTHER_INFO {
            alrtus_errcode: DWORD,
            alrtus_numstrings: DWORD,
        }
    }
}
