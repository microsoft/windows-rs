#[win32]
mod Windows {
    mod Win32 {
        const CCH_MAX_PROPSTG_NAME: i32 = 31;
        const CWCSTORAGENAME: i32 = 32;
        #[library("ole32.dll")]
        #[must_use]
        extern fn CreateILockBytesOnHGlobal(#[in] #[opt] hGlobal: HGLOBAL, #[in] fDeleteOnRelease: BOOL, #[out] #[out_ptr] pplkbyt: *mut LPLOCKBYTES) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn FmtIdToPropStgName(#[in] pfmtid: *const FMTID, #[out] #[writable(entry, 32)] oszName: LPOLESTR) -> HRESULT;
        #[library("ole32.dll")]
        extern fn GetConvertStg(#[in] pStg: LPSTORAGE) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn GetHGlobalFromILockBytes(#[in] plkbyt: LPLOCKBYTES, #[out] phglobal: *mut HGLOBAL) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn PropStgNameToFmtId(#[in] oszName: LPOLESTR, #[out] pfmtid: *mut FMTID) -> HRESULT;
        #[library("ole32.dll")]
        extern fn ReadClassStg(#[in] pStg: LPSTORAGE, #[out] pclsid: *mut CLSID) -> HRESULT;
        #[library("ole32.dll")]
        extern fn ReadClassStm(#[in] pStm: LPSTREAM, #[out] pclsid: *mut CLSID) -> HRESULT;
        type STGFMT = u32;
        const STGFMT_ANY: i32 = 4;
        const STGFMT_DOCFILE: i32 = 5;
        const STGFMT_DOCUMENT: i32 = 0;
        const STGFMT_FILE: i32 = 3;
        const STGFMT_NATIVE: i32 = 1;
        const STGFMT_STORAGE: i32 = 0;
        const STGM_CONVERT: i32 = 131072;
        const STGM_CREATE: i32 = 4096;
        const STGM_DELETEONRELEASE: i32 = 67108864;
        const STGM_DIRECT: i32 = 0;
        const STGM_DIRECT_SWMR: i32 = 4194304;
        const STGM_FAILIFTHERE: i32 = 0;
        const STGM_NOSCRATCH: i32 = 1048576;
        const STGM_NOSNAPSHOT: i32 = 2097152;
        const STGM_PRIORITY: i32 = 262144;
        const STGM_READ: i32 = 0;
        const STGM_READWRITE: i32 = 2;
        const STGM_SHARE_DENY_NONE: i32 = 64;
        const STGM_SHARE_DENY_READ: i32 = 48;
        const STGM_SHARE_DENY_WRITE: i32 = 32;
        const STGM_SHARE_EXCLUSIVE: i32 = 16;
        const STGM_SIMPLE: i32 = 134217728;
        const STGM_TRANSACTED: i32 = 65536;
        const STGM_WRITE: i32 = 1;
        #[packed(8)]
        struct STGOPTIONS {
            usVersion: USHORT,
            reserved: USHORT,
            ulSectorSize: ULONG,
            pwcsTemplateFile: *const WCHAR,
        }
        const STGOPTIONS_VERSION: i32 = 2;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgCreateDocfile(#[Windows::Win32::Metadata::NativeSal("2", "_Null_terminated_", "", "")] #[in] #[opt] pwcsName: *const WCHAR, #[in] grfMode: DWORD, #[reserved] reserved: DWORD, #[out] #[out_ptr] ppstgOpen: *mut IStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgCreateDocfileOnILockBytes(#[in] plkbyt: ILockBytes, #[in] grfMode: DWORD, #[in] reserved: DWORD, #[out] #[out_ptr] ppstgOpen: *mut IStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgCreatePropSetStg(#[in] pStorage: IStorage, #[reserved] dwReserved: DWORD, #[out] #[out_ptr] ppPropSetStg: *mut IPropertySetStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgCreatePropStg(#[in] pUnk: IUnknown, #[in] fmtid: &IID, #[in] pclsid: *const CLSID, #[in] grfFlags: DWORD, #[reserved] dwReserved: DWORD, #[out] #[out_ptr] ppPropStg: *mut IPropertyStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgCreateStorageEx(#[Windows::Win32::Metadata::NativeSal("2", "_Null_terminated_", "", "")] #[in] #[opt] pwcsName: *const WCHAR, #[in] grfMode: DWORD, #[in] stgfmt: DWORD, #[in] grfAttrs: DWORD, #[in] #[opt] #[out] pStgOptions: *mut STGOPTIONS, #[in] #[opt] pSecurityDescriptor: PSECURITY_DESCRIPTOR, #[in] riid: &IID, #[out] #[out_ptr] ppObjectOpen: *mut *mut void) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgIsStorageFile(#[Windows::Win32::Metadata::NativeSal("2", "_Null_terminated_", "", "")] #[in] pwcsName: *const WCHAR) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgIsStorageILockBytes(#[in] plkbyt: ILockBytes) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgOpenPropStg(#[in] pUnk: IUnknown, #[in] fmtid: &IID, #[in] grfFlags: DWORD, #[reserved] dwReserved: DWORD, #[out] #[out_ptr] ppPropStg: *mut IPropertyStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgOpenStorage(#[Windows::Win32::Metadata::NativeSal("2", "_Null_terminated_", "", "")] #[in] #[opt] pwcsName: *const WCHAR, #[in] #[opt] pstgPriority: IStorage, #[in] grfMode: DWORD, #[in] #[null_terminated(entry)] #[opt] snbExclude: SNB, #[in] reserved: DWORD, #[out] #[out_ptr] ppstgOpen: *mut IStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgOpenStorageEx(#[Windows::Win32::Metadata::NativeSal("2", "_Null_terminated_", "", "")] #[in] pwcsName: *const WCHAR, #[in] grfMode: DWORD, #[in] stgfmt: DWORD, #[in] grfAttrs: DWORD, #[in] #[opt] #[out] pStgOptions: *mut STGOPTIONS, #[in] #[opt] pSecurityDescriptor: PSECURITY_DESCRIPTOR, #[in] riid: &IID, #[out] #[out_ptr] ppObjectOpen: *mut *mut void) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgOpenStorageOnILockBytes(#[in] plkbyt: ILockBytes, #[in] #[opt] pstgPriority: IStorage, #[in] grfMode: DWORD, #[in] #[null_terminated(entry)] #[opt] snbExclude: SNB, #[reserved] reserved: DWORD, #[out] #[out_ptr] ppstgOpen: *mut IStorage) -> HRESULT;
        #[library("ole32.dll")]
        #[must_use]
        extern fn StgSetTimes(#[Windows::Win32::Metadata::NativeSal("2", "_Null_terminated_", "", "")] #[in] lpszName: *const WCHAR, #[in] #[opt] pctime: *const FILETIME, #[in] #[opt] patime: *const FILETIME, #[in] #[opt] pmtime: *const FILETIME) -> HRESULT;
        #[library("ole32.dll")]
        extern fn WriteClassStg(#[in] pStg: LPSTORAGE, #[in] rclsid: &IID) -> HRESULT;
        #[library("ole32.dll")]
        extern fn WriteClassStm(#[in] pStm: LPSTREAM, #[in] rclsid: &IID) -> HRESULT;
    }
}
