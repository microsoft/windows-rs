#[win32]
mod Windows {
    mod Win32 {
        #[guid(0x5d55a616_9df8_4b09_b156_9ba351a48b76)]
        interface IWSDAttachment: IUnknown {}
        #[guid(0x5bd6ca65_233c_4fb8_9f7a_2641619655c9)]
        interface IWSDInboundAttachment: IWSDAttachment {
            fn Read(&self, #[out] #[readable(success, *pdwNumberOfBytesRead)] #[writable(entry, dwBytesToRead)] pBuffer: *mut BYTE, #[in] dwBytesToRead: DWORD, #[out] pdwNumberOfBytesRead: LPDWORD) -> HRESULT;
            fn Close(&self) -> HRESULT;
        }
        #[guid(0xaa302f8d_5a22_4ba5_b392_aa8486f4c15d)]
        interface IWSDOutboundAttachment: IWSDAttachment {
            fn Write(&self, #[in] #[readable(entry, dwBytesToWrite)] pBuffer: *const BYTE, #[in] dwBytesToWrite: DWORD, #[out] pdwNumberOfBytesWritten: LPDWORD) -> HRESULT;
            fn Close(&self) -> HRESULT;
            fn Abort(&self) -> HRESULT;
        }
        #[library("wsdapi.dll")]
        extern fn WSDCreateOutboundAttachment(#[out] #[out_ptr] ppAttachment: *mut IWSDOutboundAttachment) -> HRESULT;
    }
}
