#[win32]
mod Windows {
    mod Win32 {
        #[encoding("utf-16")]
        const MS_KEY_PROTECTION_PROVIDER: String = "Microsoft Key Protection Provider";
        type NCRYPT_DESCRIPTOR_HANDLE = *mut NCRYPT_DESCRIPTOR_HANDLE__;
        struct NCRYPT_DESCRIPTOR_HANDLE__ {
            unused: i32,
        }
        #[encoding("utf-16")]
        const NCRYPT_DESCR_DELIMITER_AND: String = "AND";
        #[encoding("utf-16")]
        const NCRYPT_DESCR_DELIMITER_OR: String = "OR";
        #[encoding("utf-16")]
        const NCRYPT_DESCR_EQUAL: String = "=";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_ALGORITHM_CERTIFICATE: String = "CERTIFICATE";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_ALGORITHM_LOCAL: String = "LOCAL";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_ALGORITHM_LOCKEDCREDENTIALS: String = "LOCKEDCREDENTIALS";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_ALGORITHM_SDDL: String = "SDDL";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_ALGORITHM_SID: String = "SID";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_ALGORITHM_WEBCREDENTIALS: String = "WEBCREDENTIALS";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_CERT_CERTBLOB: String = "CertBlob";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_CERT_HASHID: String = "HashId";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_LOCAL_LOGON: String = "logon";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_LOCAL_MACHINE: String = "machine";
        #[encoding("utf-16")]
        const NCRYPT_KEY_PROTECTION_LOCAL_USER: String = "user";
        const NCRYPT_NAMED_DESCRIPTOR_FLAG: i32 = 1;
        const NCRYPT_PROTECTION_INFO_TYPE_DESCRIPTOR_STRING: i32 = 1;
        struct NCRYPT_PROTECT_STREAM_INFO {
            pfnStreamOutput: PFNCryptStreamOutputCallback,
            pvCallbackCtxt: *mut void,
        }
        struct NCRYPT_PROTECT_STREAM_INFO_EX {
            pfnStreamOutput: PFNCryptStreamOutputCallbackEx,
            pvCallbackCtxt: *mut void,
        }
        type NCRYPT_STREAM_HANDLE = *mut NCRYPT_STREAM_HANDLE__;
        struct NCRYPT_STREAM_HANDLE__ {
            unused: i32,
        }
        const NCRYPT_UNPROTECT_NO_DECRYPT: i32 = 1;
        #[library("ncrypt.dll")]
        extern fn NCryptCloseProtectionDescriptor(#[in] hDescriptor: NCRYPT_DESCRIPTOR_HANDLE) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptCreateProtectionDescriptor(#[in] pwszDescriptorString: LPCWSTR, dwFlags: DWORD, #[out] phDescriptor: *mut NCRYPT_DESCRIPTOR_HANDLE) -> SECURITY_STATUS;
        #[Windows::Win32::Metadata::NativeSal("2", "_When_", "dwInfoType == NCRYPT_PROTECTION_INFO_TYPE_DESCRIPTOR_STRING,_At_((LPWSTR*)ppvInfo, _Outptr_result_nullonfailure_)", "dwInfoType == 0x00000001, _At_((LPWSTR*)ppvInfo, _Outptr_result_nullonfailure_)")]
        #[library("ncrypt.dll")]
        #[success(return == 0)]
        extern fn NCryptGetProtectionDescriptorInfo(#[in] hDescriptor: NCRYPT_DESCRIPTOR_HANDLE, #[in] #[opt] pMemPara: *const NCRYPT_ALLOC_PARA, dwInfoType: DWORD, #[out] #[out_ptr] ppvInfo: *mut *mut void) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptProtectSecret(#[in] hDescriptor: NCRYPT_DESCRIPTOR_HANDLE, dwFlags: DWORD, #[in] #[readable(entry, bytes(cbData))] pbData: *const BYTE, cbData: ULONG, #[in] #[opt] pMemPara: *const NCRYPT_ALLOC_PARA, #[in] #[opt] hWnd: HWND, #[out] #[writable(success, bytes(*pcbProtectedBlob), indirect)] ppbProtectedBlob: *mut *mut BYTE, #[out] pcbProtectedBlob: *mut ULONG) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptQueryProtectionDescriptorName(#[in] pwszName: LPCWSTR, #[opt] #[out] #[readable(success, *pcDescriptorString)] #[writable(entry, *pcDescriptorString)] pwszDescriptorString: LPWSTR, #[in] #[out] pcDescriptorString: *mut SIZE_T, dwFlags: DWORD) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptRegisterProtectionDescriptorName(#[in] pwszName: LPCWSTR, #[in] #[opt] pwszDescriptorString: LPCWSTR, dwFlags: DWORD) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptStreamClose(#[in] hStream: NCRYPT_STREAM_HANDLE) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptStreamOpenToProtect(#[in] hDescriptor: NCRYPT_DESCRIPTOR_HANDLE, dwFlags: DWORD, #[in] #[opt] hWnd: HWND, #[in] pStreamInfo: *mut NCRYPT_PROTECT_STREAM_INFO, #[out] phStream: *mut NCRYPT_STREAM_HANDLE) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptStreamOpenToUnprotect(#[in] pStreamInfo: *mut NCRYPT_PROTECT_STREAM_INFO, dwFlags: DWORD, #[in] #[opt] hWnd: HWND, #[out] phStream: *mut NCRYPT_STREAM_HANDLE) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptStreamOpenToUnprotectEx(#[in] pStreamInfo: *mut NCRYPT_PROTECT_STREAM_INFO_EX, dwFlags: DWORD, #[in] #[opt] hWnd: HWND, #[out] phStream: *mut NCRYPT_STREAM_HANDLE) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptStreamUpdate(#[in] hStream: NCRYPT_STREAM_HANDLE, #[in] #[readable(entry, bytes(cbData))] pbData: *const BYTE, cbData: SIZE_T, fFinal: BOOL) -> SECURITY_STATUS;
        #[library("ncrypt.dll")]
        extern fn NCryptUnprotectSecret(#[opt] #[out] phDescriptor: *mut NCRYPT_DESCRIPTOR_HANDLE, #[in] dwFlags: DWORD, #[in] #[readable(entry, bytes(cbProtectedBlob))] pbProtectedBlob: *const BYTE, cbProtectedBlob: ULONG, #[in] #[opt] pMemPara: *const NCRYPT_ALLOC_PARA, #[in] #[opt] hWnd: HWND, #[out] #[writable(success, bytes(*pcbData), indirect)] ppbData: *mut *mut BYTE, #[out] pcbData: *mut ULONG) -> SECURITY_STATUS;
        extern fn PFNCryptStreamOutputCallback(#[in] pvCallbackCtxt: *mut void, #[in] #[readable(entry, bytes(cbData))] pbData: *const BYTE, cbData: SIZE_T, fFinal: BOOL) -> SECURITY_STATUS;
        extern fn PFNCryptStreamOutputCallbackEx(#[in] pvCallbackCtxt: *mut void, #[in] #[opt] #[readable(entry, bytes(cbData))] pbData: *const BYTE, cbData: SIZE_T, #[in] hDescriptor: NCRYPT_DESCRIPTOR_HANDLE, fFinal: BOOL) -> SECURITY_STATUS;
    }
}
