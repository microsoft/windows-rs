#[win32]
mod Windows {
    mod Win32 {
        type BTHNS_INQUIRYBLOB = BTH_QUERY_DEVICE;
        type BTHNS_RESTRICTIONBLOB = BTH_QUERY_SERVICE;
        const BTHNS_RESULT_DEVICE_AUTHENTICATED: i32 = 262144;
        const BTHNS_RESULT_DEVICE_CONNECTED: i32 = 65536;
        const BTHNS_RESULT_DEVICE_REMEMBERED: i32 = 131072;
        type BTHNS_SETBLOB = BTH_SET_SERVICE;
        const BTHPROTO_L2CAP: i32 = 256;
        const BTHPROTO_RFCOMM: i32 = 3;
        const BTH_ADDR_STRING_SIZE: i32 = 12;
        #[packed(1)]
        struct BTH_INFO_REQ {
            btAddr: BTH_ADDR,
            infoType: u16,
        }
        #[packed(1)]
        struct BTH_INFO_RSP {
            result: u16,
            dataLen: u8,
            Anonymous: #[packed(1)] union {
                connectionlessMTU: u16,
                data: [u8; 44],
            },
        }
        #[packed(1)]
        struct BTH_PING_REQ {
            btAddr: BTH_ADDR,
            dataLen: u8,
            data: [u8; 44],
        }
        struct BTH_PING_RSP {
            dataLen: u8,
            data: [u8; 44],
        }
        #[packed(1)]
        struct BTH_QUERY_DEVICE {
            LAP: u32,
            length: u8,
        }
        #[packed(1)]
        struct BTH_QUERY_SERVICE {
            r#type: u32,
            serviceHandle: u32,
            uuids: [SdpQueryUuid; 12],
            numRange: u32,
            pRange: [SdpAttributeRange; 1],
        }
        const BTH_SDP_VERSION: i32 = 1;
        #[packed(1)]
        struct BTH_SET_SERVICE {
            pSdpVersion: PULONG,
            pRecordHandle: *mut HANDLE,
            fCodService: u32,
            Reserved: [u32; 5],
            ulRecordLength: u32,
            pRecord: [u8; 1],
        }
        const BT_PORT_ANY: u32 = 4294967295;
        const BT_PORT_DYN_FIRST: i32 = 4097;
        const BT_PORT_MAX: i32 = 65535;
        const BT_PORT_MIN: i32 = 1;
        const MSC_BREAK_BIT: i32 = 2;
        const MSC_DV_BIT: i32 = 128;
        const MSC_FC_BIT: i32 = 2;
        const MSC_IC_BIT: i32 = 64;
        const MSC_RESERVED: i32 = 48;
        const MSC_RTC_BIT: i32 = 4;
        const MSC_RTR_BIT: i32 = 8;
        type PBTHNS_INQUIRYBLOB = *mut BTH_QUERY_DEVICE;
        type PBTHNS_RESTRICTIONBLOB = *mut BTH_QUERY_SERVICE;
        type PBTHNS_SETBLOB = *mut BTH_SET_SERVICE;
        type PBTH_INFO_REQ = *mut BTH_INFO_REQ;
        type PBTH_INFO_RSP = *mut BTH_INFO_RSP;
        type PBTH_PING_REQ = *mut BTH_PING_REQ;
        type PBTH_PING_RSP = *mut BTH_PING_RSP;
        type PBTH_QUERY_DEVICE = *mut BTH_QUERY_DEVICE;
        type PBTH_QUERY_SERVICE = *mut BTH_QUERY_SERVICE;
        type PBTH_SET_SERVICE = *mut BTH_SET_SERVICE;
        type PRFCOMM_COMMAND = *mut RFCOMM_COMMAND;
        type PRFCOMM_MSC_DATA = *mut RFCOMM_MSC_DATA;
        type PRFCOMM_RLS_DATA = *mut RFCOMM_RLS_DATA;
        type PRFCOMM_RPN_DATA = *mut RFCOMM_RPN_DATA;
        type PSOCKADDR_BTH = *mut SOCKADDR_BTH;
        const RFCOMM_CMD_MSC: i32 = 1;
        const RFCOMM_CMD_NONE: i32 = 0;
        const RFCOMM_CMD_RLS: i32 = 2;
        const RFCOMM_CMD_RPN: i32 = 3;
        const RFCOMM_CMD_RPN_REQUEST: i32 = 4;
        const RFCOMM_CMD_RPN_RESPONSE: i32 = 5;
        #[packed(1)]
        struct RFCOMM_COMMAND {
            CmdType: u32,
            Data: union {
                MSC: RFCOMM_MSC_DATA,
                RLS: RFCOMM_RLS_DATA,
                RPN: RFCOMM_RPN_DATA,
            },
        }
        const RFCOMM_MAX_MTU: i32 = 1011;
        const RFCOMM_MIN_MTU: i32 = 23;
        struct RFCOMM_MSC_DATA {
            Signals: u8,
            Break: u8,
        }
        struct RFCOMM_RLS_DATA {
            LineStatus: u8,
        }
        struct RFCOMM_RPN_DATA {
            Baud: u8,
            Data: u8,
            FlowControl: u8,
            XonChar: u8,
            XoffChar: u8,
            ParameterMask1: u8,
            ParameterMask2: u8,
        }
        const RLS_ERROR: i32 = 1;
        const RLS_FRAMING: i32 = 8;
        const RLS_OVERRUN: i32 = 2;
        const RLS_PARITY: i32 = 4;
        const RPN_BAUD_115200: i32 = 7;
        const RPN_BAUD_19200: i32 = 4;
        const RPN_BAUD_230400: i32 = 8;
        const RPN_BAUD_2400: i32 = 0;
        const RPN_BAUD_38400: i32 = 5;
        const RPN_BAUD_4800: i32 = 1;
        const RPN_BAUD_57600: i32 = 6;
        const RPN_BAUD_7200: i32 = 2;
        const RPN_BAUD_9600: i32 = 3;
        const RPN_DATA_5: i32 = 0;
        const RPN_DATA_6: i32 = 1;
        const RPN_DATA_7: i32 = 2;
        const RPN_DATA_8: i32 = 3;
        const RPN_FLOW_RTC_IN: i32 = 16;
        const RPN_FLOW_RTC_OUT: i32 = 32;
        const RPN_FLOW_RTR_IN: i32 = 4;
        const RPN_FLOW_RTR_OUT: i32 = 8;
        const RPN_FLOW_X_IN: i32 = 1;
        const RPN_FLOW_X_OUT: i32 = 2;
        const RPN_PARAM_BAUD: i32 = 1;
        const RPN_PARAM_DATA: i32 = 2;
        const RPN_PARAM_PARITY: i32 = 8;
        const RPN_PARAM_P_TYPE: i32 = 16;
        const RPN_PARAM_RTC_IN: i32 = 16;
        const RPN_PARAM_RTC_OUT: i32 = 32;
        const RPN_PARAM_RTR_IN: i32 = 4;
        const RPN_PARAM_RTR_OUT: i32 = 8;
        const RPN_PARAM_STOP: i32 = 4;
        const RPN_PARAM_XOFF: i32 = 64;
        const RPN_PARAM_XON: i32 = 32;
        const RPN_PARAM_X_IN: i32 = 1;
        const RPN_PARAM_X_OUT: i32 = 2;
        const RPN_PARITY_EVEN: i32 = 24;
        const RPN_PARITY_MARK: i32 = 40;
        const RPN_PARITY_NONE: i32 = 0;
        const RPN_PARITY_ODD: i32 = 8;
        const RPN_PARITY_SPACE: i32 = 56;
        const RPN_STOP_1: i32 = 0;
        const RPN_STOP_1_5: i32 = 4;
        const SDP_DEFAULT_INQUIRY_MAX_RESPONSES: i32 = 255;
        const SDP_DEFAULT_INQUIRY_SECONDS: i32 = 6;
        const SDP_MAX_INQUIRY_SECONDS: i32 = 60;
        const SDP_SERVICE_ATTRIBUTE_REQUEST: i32 = 2;
        const SDP_SERVICE_SEARCH_ATTRIBUTE_REQUEST: i32 = 3;
        const SDP_SERVICE_SEARCH_REQUEST: i32 = 1;
        const SIO_BTH_INFO: u32 = 3623878665;
        const SIO_BTH_PING: u32 = 3623878664;
        const SIO_RFCOMM_SEND_COMMAND: u32 = 3623878757;
        const SIO_RFCOMM_SESSION_FLOW_OFF: u32 = 3623878759;
        const SIO_RFCOMM_TEST: u32 = 3623878760;
        const SIO_RFCOMM_USECFC: u32 = 3623878761;
        const SIO_RFCOMM_WAIT_COMMAND: u32 = 3623878758;
        #[packed(1)]
        struct SOCKADDR_BTH {
            addressFamily: u16,
            btAddr: BTH_ADDR,
            serviceClassId: GUID,
            port: u32,
        }
        const SOL_L2CAP: i32 = 256;
        const SOL_RFCOMM: i32 = 3;
        const SOL_SDP: i32 = 257;
        const SO_BTH_AUTHENTICATE: u32 = 2147483649;
        const SO_BTH_ENCRYPT: i32 = 2;
        const SO_BTH_MTU: u32 = 2147483655;
        const SO_BTH_MTU_MAX: u32 = 2147483656;
        const SO_BTH_MTU_MIN: u32 = 2147483658;
        const SVCID_BTH_PROVIDER: GUID = 0x06aa63e0_7d60_41ff_afb2_3ee6d2d9392d;
    }
}
