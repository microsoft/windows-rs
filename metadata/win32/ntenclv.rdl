#[win32]
mod Windows {
    mod Win32 {
        const ENCLAVE_FLAG_DYNAMIC_DEBUG_ACTIVE: i32 = 4;
        const ENCLAVE_FLAG_DYNAMIC_DEBUG_ENABLED: i32 = 2;
        const ENCLAVE_FLAG_FULL_DEBUG_ENABLED: i32 = 1;
        #[packed(1)]
        struct ENCLAVE_IDENTITY {
            OwnerId: [UINT8; 32],
            UniqueId: [UINT8; 32],
            AuthorId: [UINT8; 32],
            FamilyId: [UINT8; 16],
            ImageId: [UINT8; 16],
            EnclaveSvn: UINT32,
            SecureKernelSvn: UINT32,
            PlatformSvn: UINT32,
            Flags: UINT32,
            SigningLevel: UINT32,
            EnclaveType: UINT32,
        }
        struct ENCLAVE_INFORMATION {
            EnclaveType: ULONG,
            Reserved: ULONG,
            BaseAddress: PVOID,
            Size: SIZE_T,
            Identity: ENCLAVE_IDENTITY,
        }
        #[packed(1)]
        struct ENCLAVE_PACKAGE_IDENTITY {
            PackageId: [UINT8; 32],
            PackageSvn: UINT64,
        }
        const ENCLAVE_REPORT_DATA_LENGTH: i32 = 64;
        const ENCLAVE_RUNTIME_POLICY_ALLOW_DYNAMIC_DEBUG: i32 = 2;
        const ENCLAVE_RUNTIME_POLICY_ALLOW_FULL_DEBUG: i32 = 1;
        #[repr(i32)]
        enum ENCLAVE_SEALING_IDENTITY_POLICY {
            ENCLAVE_IDENTITY_POLICY_SEAL_INVALID = 0,
            ENCLAVE_IDENTITY_POLICY_SEAL_EXACT_CODE = 1,
            ENCLAVE_IDENTITY_POLICY_SEAL_SAME_PRIMARY_CODE = 2,
            ENCLAVE_IDENTITY_POLICY_SEAL_SAME_IMAGE = 3,
            ENCLAVE_IDENTITY_POLICY_SEAL_SAME_FAMILY = 4,
            ENCLAVE_IDENTITY_POLICY_SEAL_SAME_AUTHOR = 5,
        }
        const ENCLAVE_UNSEAL_FLAG_STALE_KEY: i32 = 1;
        const ENCLAVE_VBS_BASIC_KEY_FLAG_DEBUG_KEY: i32 = 8;
        const ENCLAVE_VBS_BASIC_KEY_FLAG_FAMILY_ID: i32 = 2;
        const ENCLAVE_VBS_BASIC_KEY_FLAG_IMAGE_ID: i32 = 4;
        const ENCLAVE_VBS_BASIC_KEY_FLAG_MEASUREMENT: i32 = 1;
        struct ENCLAVE_VBS_BASIC_KEY_REQUEST {
            RequestSize: ULONG,
            Flags: ULONG,
            EnclaveSVN: ULONG,
            SystemKeyID: ULONG,
            CurrentSystemKeyID: ULONG,
        }
        type PENCLAVE_VBS_BASIC_KEY_REQUEST = *mut ENCLAVE_VBS_BASIC_KEY_REQUEST;
        #[arch(X64)]
        type PVBS_BASIC_ENCLAVE_EXCEPTION = *mut VBS_BASIC_ENCLAVE_EXCEPTION_AMD64;
        #[arch(X86 | Arm64)]
        type PVBS_BASIC_ENCLAVE_EXCEPTION = *mut void;
        type PVBS_BASIC_ENCLAVE_EXCEPTION_AMD64 = *mut VBS_BASIC_ENCLAVE_EXCEPTION_AMD64;
        type PVBS_BASIC_ENCLAVE_SYSCALL_PAGE = *mut VBS_BASIC_ENCLAVE_SYSCALL_PAGE;
        #[arch(X64 | Arm64)]
        type PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR = *mut VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR64;
        #[arch(X86)]
        type PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR = *mut VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR32;
        type PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR32 = *mut VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR32;
        type PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR64 = *mut VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR64;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_COMMIT_PAGES(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EnclaveAddress: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] NumberOfBytes: SIZE_T, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] SourceAddress: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] PageProtection: ULONG) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_CREATE_THREAD(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ThreadDescriptor: PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_DECOMMIT_PAGES(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EnclaveAddress: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] NumberOfBytes: SIZE_T) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_GENERATE_KEY(#[in] #[out] KeyRequest: PENCLAVE_VBS_BASIC_KEY_REQUEST, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] RequestedKeySize: ULONG, #[out] #[len_param(1)] ReturnedKey: PUCHAR) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_GENERATE_RANDOM_DATA(#[out] #[size_param(1)] Buffer: PUCHAR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] NumberOfBytes: ULONG, #[out] Generation: PULONGLONG) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_GENERATE_REPORT(#[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EnclaveData: *const UINT8, #[out] #[opt] #[size_param(2)] #[Windows::Win32::Metadata::NativeInitializedLength(CountParamIndex = 3, IsByteCount = true, Dereference = true)] Report: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufferSize: UINT32, #[out] OutputSize: *mut UINT32) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_GET_ENCLAVE_INFORMATION(#[out] EnclaveInfo: *mut ENCLAVE_INFORMATION) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_INTERRUPT_THREAD(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ThreadDescriptor: PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_PROTECT_PAGES(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EnclaveAddress: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] NumberOfytes: SIZE_T, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] PageProtection: ULONG) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_RETURN_FROM_ENCLAVE(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ReturnValue: ULONG_PTR);
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_RETURN_FROM_EXCEPTION(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ExceptionRecord: PVBS_BASIC_ENCLAVE_EXCEPTION) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_TERMINATE_THREAD(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ThreadDescriptor: PVBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR) -> LONG;
        extern "C" fn VBS_BASIC_ENCLAVE_BASIC_CALL_VERIFY_REPORT(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(1)] Report: *const void, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ReportSize: UINT32) -> LONG;
        struct VBS_BASIC_ENCLAVE_EXCEPTION_AMD64 {
            ExceptionCode: ULONG,
            NumberParameters: ULONG,
            ExceptionInformation: [ULONG_PTR; 3],
            ExceptionRAX: ULONG_PTR,
            ExceptionRCX: ULONG_PTR,
            ExceptionRIP: ULONG_PTR,
            ExceptionRFLAGS: ULONG_PTR,
            ExceptionRSP: ULONG_PTR,
        }
        struct VBS_BASIC_ENCLAVE_SYSCALL_PAGE {
            ReturnFromEnclave: VBS_BASIC_ENCLAVE_BASIC_CALL_RETURN_FROM_ENCLAVE,
            ReturnFromException: VBS_BASIC_ENCLAVE_BASIC_CALL_RETURN_FROM_EXCEPTION,
            TerminateThread: VBS_BASIC_ENCLAVE_BASIC_CALL_TERMINATE_THREAD,
            InterruptThread: VBS_BASIC_ENCLAVE_BASIC_CALL_INTERRUPT_THREAD,
            CommitPages: VBS_BASIC_ENCLAVE_BASIC_CALL_COMMIT_PAGES,
            DecommitPages: VBS_BASIC_ENCLAVE_BASIC_CALL_DECOMMIT_PAGES,
            ProtectPages: VBS_BASIC_ENCLAVE_BASIC_CALL_PROTECT_PAGES,
            CreateThread: VBS_BASIC_ENCLAVE_BASIC_CALL_CREATE_THREAD,
            GetEnclaveInformation: VBS_BASIC_ENCLAVE_BASIC_CALL_GET_ENCLAVE_INFORMATION,
            GenerateKey: VBS_BASIC_ENCLAVE_BASIC_CALL_GENERATE_KEY,
            GenerateReport: VBS_BASIC_ENCLAVE_BASIC_CALL_GENERATE_REPORT,
            VerifyReport: VBS_BASIC_ENCLAVE_BASIC_CALL_VERIFY_REPORT,
            GenerateRandomData: VBS_BASIC_ENCLAVE_BASIC_CALL_GENERATE_RANDOM_DATA,
        }
        #[arch(X64 | Arm64)]
        type VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR = VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR64;
        #[arch(X86)]
        type VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR = VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR32;
        struct VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR32 {
            ThreadContext: [ULONG; 4],
            EntryPoint: ULONG,
            StackPointer: ULONG,
            ExceptionEntryPoint: ULONG,
            ExceptionStack: ULONG,
            ExceptionActive: ULONG,
        }
        struct VBS_BASIC_ENCLAVE_THREAD_DESCRIPTOR64 {
            ThreadContext: [ULONGLONG; 4],
            EntryPoint: ULONGLONG,
            StackPointer: ULONGLONG,
            ExceptionEntryPoint: ULONGLONG,
            ExceptionStack: ULONGLONG,
            ExceptionActive: ULONG,
        }
        #[packed(1)]
        struct VBS_ENCLAVE_REPORT {
            ReportSize: UINT32,
            ReportVersion: UINT32,
            EnclaveData: [UINT8; 64],
            EnclaveIdentity: ENCLAVE_IDENTITY,
        }
        #[packed(1)]
        struct VBS_ENCLAVE_REPORT_MODULE {
            Header: VBS_ENCLAVE_REPORT_VARDATA_HEADER,
            UniqueId: [UINT8; 32],
            AuthorId: [UINT8; 32],
            FamilyId: [UINT8; 16],
            ImageId: [UINT8; 16],
            Svn: UINT32,
            ModuleName: [WCHAR; 1],
        }
        struct VBS_ENCLAVE_REPORT_PACKAGE_ID {
            Header: VBS_ENCLAVE_REPORT_VARDATA_HEADER,
            PackageIdentity: ENCLAVE_PACKAGE_IDENTITY,
        }
        #[packed(1)]
        struct VBS_ENCLAVE_REPORT_PKG_HEADER {
            PackageSize: UINT32,
            Version: UINT32,
            SignatureScheme: UINT32,
            SignedStatementSize: UINT32,
            SignatureSize: UINT32,
            Reserved: UINT32,
        }
        const VBS_ENCLAVE_REPORT_PKG_HEADER_VERSION_CURRENT: i32 = 1;
        const VBS_ENCLAVE_REPORT_SIGNATURE_SCHEME_SHA256_RSA_PSS_SHA256: i32 = 1;
        #[packed(1)]
        struct VBS_ENCLAVE_REPORT_VARDATA_HEADER {
            DataType: UINT32,
            Size: UINT32,
        }
        const VBS_ENCLAVE_REPORT_VERSION_CURRENT: i32 = 1;
        const VBS_ENCLAVE_VARDATA_INVALID: i32 = 0;
        const VBS_ENCLAVE_VARDATA_MODULE: i32 = 1;
        const VBS_ENCLAVE_VARDATA_PACKAGE: i32 = 2;
    }
}
