#[win32]
mod Windows {
    mod Win32 {
        #[library("api-ms-win-core-wow64-l1-1-1.dll")]
        #[must_use]
        extern fn GetSystemWow64Directory2A(#[incomplete] #[opt] #[out] #[writable(entry, uSize)] lpBuffer: LPSTR, #[in] uSize: UINT, #[in] ImageFileMachineType: WORD) -> UINT;
        #[library("api-ms-win-core-wow64-l1-1-1.dll")]
        #[must_use]
        extern fn GetSystemWow64Directory2W(#[incomplete] #[opt] #[out] #[writable(entry, uSize)] lpBuffer: LPWSTR, #[in] uSize: UINT, #[in] ImageFileMachineType: WORD) -> UINT;
        #[library("KERNEL32.dll")]
        #[must_use]
        extern fn GetSystemWow64DirectoryA(#[incomplete] #[opt] #[out] #[writable(entry, uSize)] lpBuffer: LPSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        #[must_use]
        extern fn GetSystemWow64DirectoryW(#[incomplete] #[opt] #[out] #[writable(entry, uSize)] lpBuffer: LPWSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        #[must_use]
        extern fn IsWow64GuestMachineSupported(#[in] WowGuestMachine: USHORT, #[out] MachineIsSupported: *mut BOOL) -> HRESULT;
        #[library("KERNEL32.dll")]
        extern fn IsWow64Process(#[in] hProcess: HANDLE, #[out] Wow64Process: PBOOL) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn IsWow64Process2(#[in] hProcess: HANDLE, #[out] pProcessMachine: *mut USHORT, #[opt] #[out] pNativeMachine: *mut USHORT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Wow64DisableWow64FsRedirection(#[out] OldValue: *mut PVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Wow64EnableWow64FsRedirection(#[in] Wow64FsEnableRedirection: BOOLEAN) -> BOOLEAN;
        #[library("KERNEL32.dll")]
        extern fn Wow64GetThreadContext(#[in] hThread: HANDLE, #[in] #[out] lpContext: PWOW64_CONTEXT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Wow64RevertWow64FsRedirection(#[in] OlValue: PVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn Wow64SetThreadContext(#[in] hThread: HANDLE, #[in] lpContext: *const WOW64_CONTEXT) -> BOOL;
        #[library("api-ms-win-core-wow64-l1-1-1.dll")]
        extern fn Wow64SetThreadDefaultGuestMachine(#[in] Machine: USHORT) -> USHORT;
        #[library("KERNEL32.dll")]
        extern fn Wow64SuspendThread(#[in] hThread: HANDLE) -> DWORD;
    }
}
