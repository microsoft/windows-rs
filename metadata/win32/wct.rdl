#[win32]
mod Windows {
    mod Win32 {
        #[library("ADVAPI32.dll")]
        extern fn CloseThreadWaitChainSession(#[in] WctHandle: HWCT);
        #[must_use]
        #[library("ADVAPI32.dll")]
        extern fn GetThreadWaitChain(#[in] WctHandle: HWCT, #[in] #[opt] Context: DWORD_PTR, #[in] Flags: DWORD, #[in] ThreadId: DWORD, #[in] #[out] NodeCount: LPDWORD, #[out] #[writable(entry, *NodeCount)] NodeInfoArray: PWAITCHAIN_NODE_INFO, #[out] IsCycle: LPBOOL) -> BOOL;
        type HWCT = *mut void;
        #[must_use]
        #[library("ADVAPI32.dll")]
        extern fn OpenThreadWaitChainSession(#[in] Flags: DWORD, #[in] #[opt] callback: PWAITCHAINCALLBACK) -> HWCT;
        extern "C" fn PCOGETACTIVATIONSTATE(param0: GUID, param1: DWORD, param2: *mut DWORD) -> HRESULT;
        extern "C" fn PCOGETCALLSTATE(param0: i32, param1: PULONG) -> HRESULT;
        extern fn PWAITCHAINCALLBACK(WctHandle: HWCT, Context: DWORD_PTR, CallbackStatus: DWORD, NodeCount: LPDWORD, NodeInfoArray: PWAITCHAIN_NODE_INFO, IsCycle: LPBOOL);
        type PWAITCHAIN_NODE_INFO = *mut WAITCHAIN_NODE_INFO;
        #[library("ADVAPI32.dll")]
        extern fn RegisterWaitChainCOMCallback(#[in] CallStateCallback: PCOGETCALLSTATE, #[in] ActivationStateCallback: PCOGETACTIVATIONSTATE);
        struct WAITCHAIN_NODE_INFO {
            ObjectType: WCT_OBJECT_TYPE,
            ObjectStatus: WCT_OBJECT_STATUS,
            Anonymous: union {
                LockObject: struct {
                    ObjectName: [WCHAR; 128],
                    Timeout: LARGE_INTEGER,
                    Alertable: BOOL,
                },
                ThreadObject: struct {
                    ProcessId: DWORD,
                    ThreadId: DWORD,
                    WaitTime: DWORD,
                    ContextSwitches: DWORD,
                },
            },
        }
        const WCTP_GETINFO_ALL_FLAGS: i32 = 7;
        const WCTP_OPEN_ALL_FLAGS: i32 = 1;
        const WCT_ASYNC_OPEN_FLAG: i32 = 1;
        const WCT_MAX_NODE_COUNT: i32 = 16;
        const WCT_NETWORK_IO_FLAG: i32 = 8;
        #[repr(i32)]
        enum WCT_OBJECT_STATUS {
            WctStatusNoAccess = 1,
            WctStatusRunning = 2,
            WctStatusBlocked = 3,
            WctStatusPidOnly = 4,
            WctStatusPidOnlyRpcss = 5,
            WctStatusOwned = 6,
            WctStatusNotOwned = 7,
            WctStatusAbandoned = 8,
            WctStatusUnknown = 9,
            WctStatusError = 10,
            WctStatusMax = 11,
        }
        #[repr(i32)]
        enum WCT_OBJECT_TYPE {
            WctCriticalSectionType = 1,
            WctSendMessageType = 2,
            WctMutexType = 3,
            WctAlpcType = 4,
            WctComType = 5,
            WctThreadWaitType = 6,
            WctProcessWaitType = 7,
            WctThreadType = 8,
            WctComActivationType = 9,
            WctUnknownType = 10,
            WctSocketIoType = 11,
            WctSmbIoType = 12,
            WctMaxType = 13,
        }
        const WCT_OBJNAME_LENGTH: i32 = 128;
        const WCT_OUT_OF_PROC_COM_FLAG: i32 = 2;
        const WCT_OUT_OF_PROC_CS_FLAG: i32 = 4;
        const WCT_OUT_OF_PROC_FLAG: i32 = 1;
    }
}
