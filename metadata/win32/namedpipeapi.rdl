#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CallNamedPipeW(#[in] lpNamedPipeName: LPCWSTR, #[in] #[opt] #[readable(entry, bytes(nInBufferSize))] lpInBuffer: LPVOID, #[in] nInBufferSize: DWORD, #[out] #[opt] #[writable(entry, bytes(nOutBufferSize))] #[readable(success, bytes(*lpBytesRead))] lpOutBuffer: LPVOID, #[in] nOutBufferSize: DWORD, #[out] lpBytesRead: LPDWORD, #[in] nTimeOut: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ConnectNamedPipe(#[in] hNamedPipe: HANDLE, #[in] #[out] #[opt] lpOverlapped: LPOVERLAPPED) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn CreateNamedPipeW(#[in] lpName: LPCWSTR, #[in] dwOpenMode: DWORD, #[in] dwPipeMode: DWORD, #[in] nMaxInstances: DWORD, #[in] nOutBufferSize: DWORD, #[in] nInBufferSize: DWORD, #[in] nDefaultTimeOut: DWORD, #[in] #[opt] lpSecurityAttributes: LPSECURITY_ATTRIBUTES) -> HANDLE;
        #[library("KERNEL32.dll")]
        extern fn CreatePipe(#[out] hReadPipe: PHANDLE, #[out] hWritePipe: PHANDLE, #[in] #[opt] lpPipeAttributes: LPSECURITY_ATTRIBUTES, #[in] nSize: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn DisconnectNamedPipe(#[in] hNamedPipe: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNamedPipeClientComputerNameW(#[in] Pipe: HANDLE, #[out] #[writable(entry, bytes(ClientComputerNameLength))] ClientComputerName: LPWSTR, #[in] ClientComputerNameLength: ULONG) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNamedPipeHandleStateW(#[in] hNamedPipe: HANDLE, #[out] #[opt] lpState: LPDWORD, #[out] #[opt] lpCurInstances: LPDWORD, #[out] #[opt] lpMaxCollectionCount: LPDWORD, #[out] #[opt] lpCollectDataTimeout: LPDWORD, #[out] #[opt] #[writable(entry, nMaxUserNameSize)] lpUserName: LPWSTR, #[in] nMaxUserNameSize: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNamedPipeInfo(#[in] hNamedPipe: HANDLE, #[out] #[opt] lpFlags: LPDWORD, #[out] #[opt] lpOutBufferSize: LPDWORD, #[out] #[opt] lpInBufferSize: LPDWORD, #[out] #[opt] lpMaxInstances: LPDWORD) -> BOOL;
        #[must_use]
        #[library("ADVAPI32.dll")]
        extern fn ImpersonateNamedPipeClient(#[in] hNamedPipe: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn PeekNamedPipe(#[in] hNamedPipe: HANDLE, #[out] #[opt] #[writable(entry, bytes(nBufferSize))] #[readable(success, bytes(if_present(*lpBytesRead)))] lpBuffer: LPVOID, #[in] nBufferSize: DWORD, #[out] #[opt] lpBytesRead: LPDWORD, #[out] #[opt] lpTotalBytesAvail: LPDWORD, #[out] #[opt] lpBytesLeftThisMessage: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetNamedPipeHandleState(#[in] hNamedPipe: HANDLE, #[in] #[opt] lpMode: LPDWORD, #[in] #[opt] lpMaxCollectionCount: LPDWORD, #[in] #[opt] lpCollectDataTimeout: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn TransactNamedPipe(#[in] hNamedPipe: HANDLE, #[in] #[opt] #[readable(entry, bytes(nInBufferSize))] lpInBuffer: LPVOID, #[in] nInBufferSize: DWORD, #[out] #[opt] #[writable(entry, bytes(nOutBufferSize))] #[readable(success, bytes(*lpBytesRead))] lpOutBuffer: LPVOID, #[in] nOutBufferSize: DWORD, #[out] lpBytesRead: LPDWORD, #[in] #[out] #[opt] lpOverlapped: LPOVERLAPPED) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WaitNamedPipeW(#[in] lpNamedPipeName: LPCWSTR, #[in] nTimeOut: DWORD) -> BOOL;
    }
}
