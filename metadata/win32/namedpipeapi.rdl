#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CallNamedPipeW(lpNamedPipeName: PCWSTR, #[size_param(2)] #[in] #[opt] lpInBuffer: *mut void, nInBufferSize: u32, #[size_param(4)] #[opt] lpOutBuffer: *mut void, nOutBufferSize: u32, #[out] lpBytesRead: LPDWORD, nTimeOut: u32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ConnectNamedPipe(hNamedPipe: HANDLE, #[in] #[out] #[opt] lpOverlapped: LPOVERLAPPED) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn CreateNamedPipeW(lpName: PCWSTR, dwOpenMode: u32, dwPipeMode: u32, nMaxInstances: u32, nOutBufferSize: u32, nInBufferSize: u32, nDefaultTimeOut: u32, #[opt] lpSecurityAttributes: LPSECURITY_ATTRIBUTES) -> HANDLE;
        #[library("KERNEL32.dll")]
        extern fn CreatePipe(#[out] hReadPipe: PHANDLE, #[out] hWritePipe: PHANDLE, #[opt] lpPipeAttributes: LPSECURITY_ATTRIBUTES, nSize: u32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn DisconnectNamedPipe(hNamedPipe: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNamedPipeClientComputerNameW(Pipe: HANDLE, #[size_param(2)] #[out] ClientComputerName: PWSTR, ClientComputerNameLength: u32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNamedPipeHandleStateW(hNamedPipe: HANDLE, #[out] #[opt] lpState: LPDWORD, #[out] #[opt] lpCurInstances: LPDWORD, #[out] #[opt] lpMaxCollectionCount: LPDWORD, #[out] #[opt] lpCollectDataTimeout: LPDWORD, #[len_param(6)] #[out] #[opt] lpUserName: PWSTR, nMaxUserNameSize: u32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNamedPipeInfo(hNamedPipe: HANDLE, #[out] #[opt] lpFlags: LPDWORD, #[out] #[opt] lpOutBufferSize: LPDWORD, #[out] #[opt] lpInBufferSize: LPDWORD, #[out] #[opt] lpMaxInstances: LPDWORD) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn ImpersonateNamedPipeClient(hNamedPipe: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn PeekNamedPipe(hNamedPipe: HANDLE, #[size_param(2)] #[opt] lpBuffer: *mut void, nBufferSize: u32, #[out] #[opt] lpBytesRead: LPDWORD, #[out] #[opt] lpTotalBytesAvail: LPDWORD, #[out] #[opt] lpBytesLeftThisMessage: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetNamedPipeHandleState(hNamedPipe: HANDLE, #[opt] lpMode: LPDWORD, #[opt] lpMaxCollectionCount: LPDWORD, #[opt] lpCollectDataTimeout: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn TransactNamedPipe(hNamedPipe: HANDLE, #[size_param(2)] #[in] #[opt] lpInBuffer: *mut void, nInBufferSize: u32, #[size_param(4)] #[opt] lpOutBuffer: *mut void, nOutBufferSize: u32, #[out] lpBytesRead: LPDWORD, #[in] #[out] #[opt] lpOverlapped: LPOVERLAPPED) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WaitNamedPipeW(lpNamedPipeName: PCWSTR, nTimeOut: u32) -> BOOL;
    }
}
