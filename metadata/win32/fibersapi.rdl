#[win32]
mod Windows {
    mod Win32 {
        const FLS_OUT_OF_INDEXES: DWORD = 4294967295;
        #[library("KERNEL32.dll")]
        extern fn FlsAlloc(#[in] #[opt] lpCallback: PFLS_CALLBACK_FUNCTION) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn FlsFree(#[in] dwFlsIndex: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn FlsGetValue(#[in] dwFlsIndex: DWORD) -> PVOID;
        #[library("KERNEL32.dll")]
        extern fn FlsGetValue2(#[in] dwTlsIndex: DWORD) -> PVOID;
        #[library("KERNEL32.dll")]
        extern fn FlsSetValue(#[in] dwFlsIndex: DWORD, #[in] #[opt] lpFlsData: PVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn IsThreadAFiber() -> BOOL;
    }
}
