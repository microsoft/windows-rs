#[win32]
mod Windows {
    mod Win32 {
        const FLS_OUT_OF_INDEXES: DWORD = 4294967295;
        #[library("KERNEL32.dll")]
        extern fn FlsAlloc(#[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpCallback: PFLS_CALLBACK_FUNCTION) -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn FlsFree(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwFlsIndex: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn FlsGetValue(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwFlsIndex: DWORD) -> PVOID;
        #[library("KERNEL32.dll")]
        extern fn FlsGetValue2(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwTlsIndex: DWORD) -> PVOID;
        #[library("KERNEL32.dll")]
        extern fn FlsSetValue(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwFlsIndex: DWORD, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpFlsData: PVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn IsThreadAFiber() -> BOOL;
    }
}
