#[win32]
mod Windows {
    mod Win32 {
        extern fn AMGETERRORTEXTPROC(param0: HRESULT, param1: *mut i8, param2: DWORD) -> BOOL;
        extern fn AMGETERRORTEXTPROCA(param0: HRESULT, param1: *mut i8, param2: DWORD) -> BOOL;
        extern fn AMGETERRORTEXTPROCW(param0: HRESULT, param1: *mut WCHAR, param2: DWORD) -> BOOL;
        #[library("QUARTZ.dll", import = "AMGetErrorTextA")]
        extern fn AMGetErrorText(hr: HRESULT, #[out] #[len_param(2)] pbuffer: LPSTR, MaxLen: DWORD) -> DWORD;
        #[library("QUARTZ.dll")]
        extern fn AMGetErrorTextA(hr: HRESULT, #[out] #[len_param(2)] pbuffer: LPSTR, MaxLen: DWORD) -> DWORD;
        #[library("QUARTZ.dll")]
        extern fn AMGetErrorTextW(hr: HRESULT, #[out] #[len_param(2)] pbuffer: LPWSTR, MaxLen: DWORD) -> DWORD;
        const MAX_ERROR_TEXT_LEN: i32 = 160;
        const VFW_FIRST_CODE: i32 = 512;
    }
}
