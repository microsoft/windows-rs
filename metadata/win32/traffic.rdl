        extern fn TcSetInterface(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] IfcHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufferSize: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(2)] Buffer: PVOID) -> ULONG;
