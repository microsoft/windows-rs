#[win32]
mod Windows {
    mod Win32 {
        struct ADDRESS_LIST_DESCRIPTOR {
            MediaType: ULONG,
            AddressList: NETWORK_ADDRESS_LIST,
        }
        const CURRENT_TCI_VERSION: i32 = 2;
        struct ENUMERATION_BUFFER {
            Length: ULONG,
            OwnerProcessId: ULONG,
            FlowNameLength: USHORT,
            FlowName: [WCHAR; 256],
            pFlow: PTC_GEN_FLOW,
            NumberOfFilters: ULONG,
            GenericFilter: [TC_GEN_FILTER; 1],
        }
        struct IPX_PATTERN {
            struct IPX_PATTERN_0 {
                NetworkAddress: ULONG,
                NodeAddress: [UCHAR; 6],
                Socket: USHORT,
            }
            Src: IPX_PATTERN::IPX_PATTERN_0,
            Dest: IPX_PATTERN::IPX_PATTERN_0,
        }
        struct IP_PATTERN {
            Reserved1: ULONG,
            Reserved2: ULONG,
            SrcAddr: ULONG,
            DstAddr: ULONG,
            S_un: union {
                S_un_ports: struct {
                    s_srcport: USHORT,
                    s_dstport: USHORT,
                },
                S_un_icmp: struct {
                    s_type: UCHAR,
                    s_code: UCHAR,
                    filler: USHORT,
                },
                S_Spi: ULONG,
            },
            ProtocolId: UCHAR,
            Reserved3: [UCHAR; 3],
        }
        const MAX_STRING_LENGTH: i32 = 256;
        type PADDRESS_LIST_DESCRIPTOR = *mut ADDRESS_LIST_DESCRIPTOR;
        type PENUMERATION_BUFFER = *mut ENUMERATION_BUFFER;
        type PIPX_PATTERN = *mut IPX_PATTERN;
        type PIP_PATTERN = *mut IP_PATTERN;
        type PTCI_CLIENT_FUNC_LIST = *mut TCI_CLIENT_FUNC_LIST;
        type PTC_GEN_FILTER = *mut TC_GEN_FILTER;
        type PTC_GEN_FLOW = *mut TC_GEN_FLOW;
        type PTC_IFC_DESCRIPTOR = *mut TC_IFC_DESCRIPTOR;
        type PTC_SUPPORTED_INFO_BUFFER = *mut TC_SUPPORTED_INFO_BUFFER;
        extern fn TCI_ADD_FLOW_COMPLETE_HANDLER(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClFlowCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Status: ULONG);
        struct TCI_CLIENT_FUNC_LIST {
            ClNotifyHandler: TCI_NOTIFY_HANDLER,
            ClAddFlowCompleteHandler: TCI_ADD_FLOW_COMPLETE_HANDLER,
            ClModifyFlowCompleteHandler: TCI_MOD_FLOW_COMPLETE_HANDLER,
            ClDeleteFlowCompleteHandler: TCI_DEL_FLOW_COMPLETE_HANDLER,
        }
        extern fn TCI_DEL_FLOW_COMPLETE_HANDLER(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClFlowCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Status: ULONG);
        extern fn TCI_MOD_FLOW_COMPLETE_HANDLER(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClFlowCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Status: ULONG);
        extern fn TCI_NOTIFY_HANDLER(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClRegCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClIfcCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Event: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] SubCode: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufSize: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(4)] Buffer: PVOID);
        struct TC_GEN_FILTER {
            AddressType: USHORT,
            PatternSize: ULONG,
            #[Windows::Win32::Metadata::NativeFieldBuffer(CapacityFieldName = "PatternSize", IsByteCount = true, MayBeNull = false)]
            Pattern: PVOID,
            #[Windows::Win32::Metadata::NativeFieldBuffer(CapacityFieldName = "PatternSize", IsByteCount = true, MayBeNull = false)]
            Mask: PVOID,
        }
        struct TC_GEN_FLOW {
            SendingFlowspec: FLOWSPEC,
            ReceivingFlowspec: FLOWSPEC,
            TcObjectsLength: ULONG,
            TcObjects: [QOS_OBJECT_HDR; 1],
        }
        struct TC_IFC_DESCRIPTOR {
            Length: ULONG,
            pInterfaceName: LPWSTR,
            pInterfaceID: LPWSTR,
            AddressListDesc: ADDRESS_LIST_DESCRIPTOR,
        }
        const TC_INVALID_HANDLE: HANDLE = 0;
        const TC_NOTIFY_FLOW_CLOSE: i32 = 5;
        const TC_NOTIFY_IFC_CHANGE: i32 = 3;
        const TC_NOTIFY_IFC_CLOSE: i32 = 2;
        const TC_NOTIFY_IFC_UP: i32 = 1;
        const TC_NOTIFY_PARAM_CHANGED: i32 = 4;
        struct TC_SUPPORTED_INFO_BUFFER {
            InstanceIDLength: USHORT,
            InstanceID: [WCHAR; 256],
            InterfaceLuid: ULONG64,
            AddrListDesc: ADDRESS_LIST_DESCRIPTOR,
        }
        #[library("TRAFFIC.dll")]
        extern fn TcAddFilter(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FlowHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGenericFilter: PTC_GEN_FILTER, #[out] pFilterHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcAddFlow(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] IfcHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClFlowCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Flags: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGenericFlow: PTC_GEN_FLOW, #[out] pFlowHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcCloseInterface(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] IfcHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcDeleteFilter(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FilterHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcDeleteFlow(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FlowHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcDeregisterClient(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClientHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcEnumerateFlows(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] IfcHandle: HANDLE, #[in] #[out] pEnumHandle: PHANDLE, #[in] #[out] pFlowCount: PULONG, #[in] #[out] pBufSize: PULONG, #[out] Buffer: PENUMERATION_BUFFER) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcEnumerateInterfaces(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClientHandle: HANDLE, #[in] #[out] pBufferSize: PULONG, #[out] InterfaceBuffer: PTC_IFC_DESCRIPTOR) -> ULONG;
        #[library("TRAFFIC.dll", import = "TcGetFlowNameA")]
        extern fn TcGetFlowName(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FlowHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] StrSize: ULONG, #[out] #[len_param(1)] pFlowName: LPSTR) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcGetFlowNameA(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FlowHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] StrSize: ULONG, #[out] #[len_param(1)] pFlowName: LPSTR) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcGetFlowNameW(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FlowHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] StrSize: ULONG, #[out] #[len_param(1)] pFlowName: LPWSTR) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcModifyFlow(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FlowHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGenericFlow: PTC_GEN_FLOW) -> ULONG;
        #[library("TRAFFIC.dll", import = "TcOpenInterfaceA")]
        extern fn TcOpenInterface(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pInterfaceName: LPSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClientHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClIfcCtx: HANDLE, #[out] pIfcHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcOpenInterfaceA(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pInterfaceName: LPSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClientHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClIfcCtx: HANDLE, #[out] pIfcHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcOpenInterfaceW(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pInterfaceName: LPWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClientHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClIfcCtx: HANDLE, #[out] pIfcHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll", import = "TcQueryFlowA")]
        extern fn TcQueryFlow(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pFlowName: LPSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[out] pBufferSize: PULONG, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_", "*pBufferSize", "*pBufferSize")] #[out] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcQueryFlowA(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pFlowName: LPSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[out] pBufferSize: PULONG, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_", "*pBufferSize", "*pBufferSize")] #[out] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcQueryFlowW(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pFlowName: LPWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[out] pBufferSize: PULONG, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_", "*pBufferSize", "*pBufferSize")] #[out] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcQueryInterface(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] IfcHandle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] NotifyChange: BOOLEAN, #[in] #[out] pBufferSize: PULONG, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_", "*pBufferSize", "*pBufferSize")] #[out] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcRegisterClient(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] TciVersion: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClRegCtx: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] ClientHandlerList: PTCI_CLIENT_FUNC_LIST, #[out] pClientHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll", import = "TcSetFlowA")]
        extern fn TcSetFlow(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pFlowName: LPSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufferSize: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(2)] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcSetFlowA(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pFlowName: LPSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufferSize: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(2)] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcSetFlowW(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pFlowName: LPWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pGuidParam: LPGUID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufferSize: ULONG, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(2)] Buffer: PVOID) -> ULONG;
