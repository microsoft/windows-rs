#[win32]
mod Windows {
    mod Win32 {
        struct ADDRESS_LIST_DESCRIPTOR {
            MediaType: ULONG,
            AddressList: NETWORK_ADDRESS_LIST,
        }
        const CURRENT_TCI_VERSION: i32 = 2;
        struct ENUMERATION_BUFFER {
            Length: ULONG,
            OwnerProcessId: ULONG,
            FlowNameLength: USHORT,
            FlowName: [WCHAR; 256],
            pFlow: PTC_GEN_FLOW,
            NumberOfFilters: ULONG,
            GenericFilter: [TC_GEN_FILTER; 1],
        }
        struct IPX_PATTERN {
            struct IPX_PATTERN_0 {
                NetworkAddress: ULONG,
                NodeAddress: [UCHAR; 6],
                Socket: USHORT,
            }
            Src: IPX_PATTERN::IPX_PATTERN_0,
            Dest: IPX_PATTERN::IPX_PATTERN_0,
        }
        struct IP_PATTERN {
            Reserved1: ULONG,
            Reserved2: ULONG,
            SrcAddr: ULONG,
            DstAddr: ULONG,
            S_un: union {
                S_un_ports: struct {
                    s_srcport: USHORT,
                    s_dstport: USHORT,
                },
                S_un_icmp: struct {
                    s_type: UCHAR,
                    s_code: UCHAR,
                    filler: USHORT,
                },
                S_Spi: ULONG,
            },
            ProtocolId: UCHAR,
            Reserved3: [UCHAR; 3],
        }
        const MAX_STRING_LENGTH: i32 = 256;
        type PADDRESS_LIST_DESCRIPTOR = *mut ADDRESS_LIST_DESCRIPTOR;
        type PENUMERATION_BUFFER = *mut ENUMERATION_BUFFER;
        type PIPX_PATTERN = *mut IPX_PATTERN;
        type PIP_PATTERN = *mut IP_PATTERN;
        type PTCI_CLIENT_FUNC_LIST = *mut TCI_CLIENT_FUNC_LIST;
        type PTC_GEN_FILTER = *mut TC_GEN_FILTER;
        type PTC_GEN_FLOW = *mut TC_GEN_FLOW;
        type PTC_IFC_DESCRIPTOR = *mut TC_IFC_DESCRIPTOR;
        type PTC_SUPPORTED_INFO_BUFFER = *mut TC_SUPPORTED_INFO_BUFFER;
        extern fn TCI_ADD_FLOW_COMPLETE_HANDLER(#[in] ClFlowCtx: HANDLE, #[in] Status: ULONG);
        struct TCI_CLIENT_FUNC_LIST {
            ClNotifyHandler: TCI_NOTIFY_HANDLER,
            ClAddFlowCompleteHandler: TCI_ADD_FLOW_COMPLETE_HANDLER,
            ClModifyFlowCompleteHandler: TCI_MOD_FLOW_COMPLETE_HANDLER,
            ClDeleteFlowCompleteHandler: TCI_DEL_FLOW_COMPLETE_HANDLER,
        }
        extern fn TCI_DEL_FLOW_COMPLETE_HANDLER(#[in] ClFlowCtx: HANDLE, #[in] Status: ULONG);
        extern fn TCI_MOD_FLOW_COMPLETE_HANDLER(#[in] ClFlowCtx: HANDLE, #[in] Status: ULONG);
        extern fn TCI_NOTIFY_HANDLER(#[in] ClRegCtx: HANDLE, #[in] ClIfcCtx: HANDLE, #[in] Event: ULONG, #[in] SubCode: HANDLE, #[in] BufSize: ULONG, #[in] #[readable(entry, bytes(BufSize))] Buffer: PVOID);
        struct TC_GEN_FILTER {
            AddressType: USHORT,
            PatternSize: ULONG,
            #[writable(bytes(PatternSize))]
            Pattern: PVOID,
            #[writable(bytes(PatternSize))]
            Mask: PVOID,
        }
        struct TC_GEN_FLOW {
            SendingFlowspec: FLOWSPEC,
            ReceivingFlowspec: FLOWSPEC,
            TcObjectsLength: ULONG,
            TcObjects: [QOS_OBJECT_HDR; 1],
        }
        struct TC_IFC_DESCRIPTOR {
            Length: ULONG,
            pInterfaceName: LPWSTR,
            pInterfaceID: LPWSTR,
            AddressListDesc: ADDRESS_LIST_DESCRIPTOR,
        }
        const TC_INVALID_HANDLE: HANDLE = 0;
        const TC_NOTIFY_FLOW_CLOSE: i32 = 5;
        const TC_NOTIFY_IFC_CHANGE: i32 = 3;
        const TC_NOTIFY_IFC_CLOSE: i32 = 2;
        const TC_NOTIFY_IFC_UP: i32 = 1;
        const TC_NOTIFY_PARAM_CHANGED: i32 = 4;
        struct TC_SUPPORTED_INFO_BUFFER {
            InstanceIDLength: USHORT,
            InstanceID: [WCHAR; 256],
            InterfaceLuid: ULONG64,
            AddrListDesc: ADDRESS_LIST_DESCRIPTOR,
        }
        #[library("TRAFFIC.dll")]
        extern fn TcAddFilter(#[in] FlowHandle: HANDLE, #[in] pGenericFilter: PTC_GEN_FILTER, #[out] pFilterHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcAddFlow(#[in] IfcHandle: HANDLE, #[in] ClFlowCtx: HANDLE, #[in] Flags: ULONG, #[in] pGenericFlow: PTC_GEN_FLOW, #[out] pFlowHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcCloseInterface(#[in] IfcHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcDeleteFilter(#[in] FilterHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcDeleteFlow(#[in] FlowHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcDeregisterClient(#[in] ClientHandle: HANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcEnumerateFlows(#[in] IfcHandle: HANDLE, #[in] #[out] pEnumHandle: PHANDLE, #[in] #[out] pFlowCount: PULONG, #[in] #[out] pBufSize: PULONG, #[out] Buffer: PENUMERATION_BUFFER) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcEnumerateInterfaces(#[in] ClientHandle: HANDLE, #[in] #[out] pBufferSize: PULONG, #[out] InterfaceBuffer: PTC_IFC_DESCRIPTOR) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcGetFlowNameA(#[in] FlowHandle: HANDLE, #[in] StrSize: ULONG, #[out] #[writable(entry, StrSize)] pFlowName: LPSTR) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcGetFlowNameW(#[in] FlowHandle: HANDLE, #[in] StrSize: ULONG, #[out] #[writable(entry, StrSize)] pFlowName: LPWSTR) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcModifyFlow(#[in] FlowHandle: HANDLE, #[in] pGenericFlow: PTC_GEN_FLOW) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcOpenInterfaceA(#[in] pInterfaceName: LPSTR, #[in] ClientHandle: HANDLE, #[in] ClIfcCtx: HANDLE, #[out] pIfcHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcOpenInterfaceW(#[in] pInterfaceName: LPWSTR, #[in] ClientHandle: HANDLE, #[in] ClIfcCtx: HANDLE, #[out] pIfcHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcQueryFlowA(#[in] pFlowName: LPSTR, #[in] pGuidParam: LPGUID, #[in] #[out] pBufferSize: PULONG, #[out] #[writable(entry, bytes(*pBufferSize))] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcQueryFlowW(#[in] pFlowName: LPWSTR, #[in] pGuidParam: LPGUID, #[in] #[out] pBufferSize: PULONG, #[out] #[writable(entry, bytes(*pBufferSize))] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcQueryInterface(#[in] IfcHandle: HANDLE, #[in] pGuidParam: LPGUID, #[in] NotifyChange: BOOLEAN, #[in] #[out] pBufferSize: PULONG, #[out] #[writable(entry, bytes(*pBufferSize))] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcRegisterClient(#[in] TciVersion: ULONG, #[in] ClRegCtx: HANDLE, #[in] ClientHandlerList: PTCI_CLIENT_FUNC_LIST, #[out] pClientHandle: PHANDLE) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcSetFlowA(#[in] pFlowName: LPSTR, #[in] pGuidParam: LPGUID, #[in] BufferSize: ULONG, #[in] #[readable(entry, bytes(BufferSize))] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcSetFlowW(#[in] pFlowName: LPWSTR, #[in] pGuidParam: LPGUID, #[in] BufferSize: ULONG, #[in] #[readable(entry, bytes(BufferSize))] Buffer: PVOID) -> ULONG;
        #[library("TRAFFIC.dll")]
        extern fn TcSetInterface(#[in] IfcHandle: HANDLE, #[in] pGuidParam: LPGUID, #[in] BufferSize: ULONG, #[in] #[readable(entry, bytes(BufferSize))] Buffer: PVOID) -> ULONG;
    }
}
