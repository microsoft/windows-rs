            fn GetChannelVolumeLevel(&self, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] nChannel: UINT, #[out] pfLevelDB: *mut f32) -> HRESULT;
            fn GetChannelVolumeLevelScalar(&self, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] nChannel: UINT, #[out] pfLevel: *mut f32) -> HRESULT;
            fn SetMute(&self, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] bMute: BOOL, pguidEventContext: LPCGUID) -> HRESULT;
            fn GetMute(&self, #[out] pbMute: *mut BOOL) -> HRESULT;
