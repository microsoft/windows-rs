        enum TA_PROPERTY {
            TAP_FLAGS = 0,
            TAP_TRANSFORMCOUNT = 1,
            TAP_STAGGERDELAY = 2,
            TAP_STAGGERDELAYCAP = 3,
            TAP_STAGGERDELAYFACTOR = 4,
            TAP_ZORDER = 5,
        }
        #[repr(i32)]
        enum TA_PROPERTY_FLAG {
            TAPF_NONE = 0,
            TAPF_HASSTAGGER = 1,
            TAPF_ISRTLAWARE = 2,
            TAPF_ALLOWCOLLECTION = 4,
            TAPF_HASBACKGROUND = 8,
            TAPF_HASPERSPECTIVE = 16,
        }
        #[packed(8)]
        struct TA_TIMINGFUNCTION {
            eTimingFunctionType: TA_TIMINGFUNCTION_TYPE,
        }
        #[repr(i32)]
        enum TA_TIMINGFUNCTION_TYPE {
            TTFT_UNDEFINED = 0,
            TTFT_CUBIC_BEZIER = 1,
        }
        #[packed(8)]
        struct TA_TRANSFORM {
            eTransformType: TA_TRANSFORM_TYPE,
            dwTimingFunctionId: DWORD,
            dwStartTime: DWORD,
            dwDurationTime: DWORD,
            eFlags: TA_TRANSFORM_FLAG,
        }
        #[packed(8)]
        struct TA_TRANSFORM_2D {
            header: TA_TRANSFORM,
            rX: f32,
            rY: f32,
            rInitialX: f32,
            rInitialY: f32,
            rOriginX: f32,
            rOriginY: f32,
        }
        #[packed(8)]
        struct TA_TRANSFORM_CLIP {
            header: TA_TRANSFORM,
            rLeft: f32,
            rTop: f32,
            rRight: f32,
            rBottom: f32,
            rInitialLeft: f32,
            rInitialTop: f32,
            rInitialRight: f32,
            rInitialBottom: f32,
        }
        #[repr(i32)]
        enum TA_TRANSFORM_FLAG {
            TATF_NONE = 0,
            TATF_TARGETVALUES_USER = 1,
            TATF_HASINITIALVALUES = 2,
            TATF_HASORIGINVALUES = 4,
        }
        #[packed(8)]
        struct TA_TRANSFORM_OPACITY {
            header: TA_TRANSFORM,
            rOpacity: f32,
            rInitialOpacity: f32,
        }
        #[repr(i32)]
        enum TA_TRANSFORM_TYPE {
            TATT_TRANSLATE_2D = 0,
            TATT_SCALE_2D = 1,
            TATT_OPACITY = 2,
            TATT_CLIP = 3,
        }
        #[repr(i32)]
        enum THEMESIZE {
            TS_MIN = 0,
            TS_TRUE = 1,
            TS_DRAW = 2,
        }
        #[library("UxTheme.dll")]
        extern fn UpdatePanningFeedback(#[in] hwnd: HWND, #[in] lTotalOverpanOffsetX: LONG, #[in] lTotalOverpanOffsetY: LONG, #[in] fInInertia: BOOL) -> BOOL;
        #[repr(i32)]
        enum WINDOWTHEMEATTRIBUTETYPE {
            WTA_NONCLIENT = 1,
        }
        struct WTA_OPTIONS {
            dwFlags: DWORD,
            dwMask: DWORD,
        }
        const WTNCA_NODRAWCAPTION: i32 = 1;
        const WTNCA_NODRAWICON: i32 = 2;
        const WTNCA_NOMIRRORHELP: i32 = 8;
        const WTNCA_NOSYSMENU: i32 = 4;
        const WTNCA_VALIDBITS: i32 = 15;
    }
}
