#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum DECODING_SOURCE {
            DecodingSourceXMLFile = 0,
            DecodingSourceWbem = 1,
            DecodingSourceWPP = 2,
            DecodingSourceTlg = 3,
            DecodingSourceMax = 4,
        }
        #[repr(i32)]
        enum EVENT_FIELD_TYPE {
            EventKeywordInformation = 0,
            EventLevelInformation = 1,
            EventChannelInformation = 2,
            EventTaskInformation = 3,
            EventOpcodeInformation = 4,
            EventInformationMax = 5,
        }
        struct EVENT_MAP_ENTRY {
            OutputOffset: ULONG,
            Anonymous: union {
                Value: ULONG,
                InputOffset: ULONG,
            },
        }
        struct EVENT_MAP_INFO {
            NameOffset: ULONG,
            Flag: MAP_FLAGS,
            EntryCount: ULONG,
            Anonymous: union {
                MapEntryValueType: MAP_VALUETYPE,
                FormatStringOffset: ULONG,
            },
            #[writable(EntryCount)]
            MapEntryArray: [EVENT_MAP_ENTRY; 1],
        }
        struct EVENT_PROPERTY_INFO {
            Flags: PROPERTY_FLAGS,
            NameOffset: ULONG,
            Anonymous: union {
                struct _customSchemaType {
                    InType: USHORT,
                    OutType: USHORT,
                    CustomSchemaOffset: ULONG,
                }
                struct _nonStructType {
                    InType: USHORT,
                    OutType: USHORT,
                    MapNameOffset: ULONG,
                }
                struct _structType {
                    StructStartIndex: USHORT,
                    NumOfStructMembers: USHORT,
                    padding: ULONG,
                }
                nonStructType: EVENT_PROPERTY_INFO::EVENT_PROPERTY_INFO_2::_nonStructType,
                structType: EVENT_PROPERTY_INFO::EVENT_PROPERTY_INFO_2::_structType,
                customSchemaType: EVENT_PROPERTY_INFO::EVENT_PROPERTY_INFO_2::_customSchemaType,
            },
            Anonymous2: union {
                count: USHORT,
                countPropertyIndex: USHORT,
            },
            Anonymous3: union {
                length: USHORT,
                lengthPropertyIndex: USHORT,
            },
            Anonymous4: union {
                Reserved: ULONG,
                Anonymous: struct {
                    _bitfield: u32 {
                        Tags: ULONG: 28,
                    },
                },
            },
        }
        #[repr(i32)]
        enum MAP_FLAGS {
            EVENTMAP_INFO_FLAG_MANIFEST_VALUEMAP = 1,
            EVENTMAP_INFO_FLAG_MANIFEST_BITMAP = 2,
            EVENTMAP_INFO_FLAG_MANIFEST_PATTERNMAP = 4,
            EVENTMAP_INFO_FLAG_WBEM_VALUEMAP = 8,
            EVENTMAP_INFO_FLAG_WBEM_BITMAP = 16,
            EVENTMAP_INFO_FLAG_WBEM_FLAG = 32,
            EVENTMAP_INFO_FLAG_WBEM_NO_MAP = 64,
        }
        #[repr(i32)]
        enum MAP_VALUETYPE {
            EVENTMAP_ENTRY_VALUETYPE_ULONG = 0,
            EVENTMAP_ENTRY_VALUETYPE_STRING = 1,
        }
        const MAX_PAYLOAD_PREDICATES: i32 = 8;
        struct PAYLOAD_FILTER_PREDICATE {
            FieldName: LPWSTR,
            CompareOp: USHORT,
            Value: LPWSTR,
        }
        #[repr(i32)]
        enum PAYLOAD_OPERATOR {
            PAYLOADFIELD_EQ = 0,
            PAYLOADFIELD_NE = 1,
            PAYLOADFIELD_LE = 2,
            PAYLOADFIELD_GT = 3,
            PAYLOADFIELD_LT = 4,
            PAYLOADFIELD_GE = 5,
            PAYLOADFIELD_BETWEEN = 6,
            PAYLOADFIELD_NOTBETWEEN = 7,
            PAYLOADFIELD_MODULO = 8,
            PAYLOADFIELD_CONTAINS = 20,
            PAYLOADFIELD_DOESNTCONTAIN = 21,
            PAYLOADFIELD_IS = 30,
            PAYLOADFIELD_ISNOT = 31,
            PAYLOADFIELD_INVALID = 32,
        }
        type PEVENT_MAP_ENTRY = *mut EVENT_MAP_ENTRY;
        type PEVENT_MAP_INFO = *mut EVENT_MAP_INFO;
        type PEVENT_PROPERTY_INFO = *mut EVENT_PROPERTY_INFO;
        type PPAYLOAD_FILTER_PREDICATE = *mut PAYLOAD_FILTER_PREDICATE;
        type PPROPERTY_DATA_DESCRIPTOR = *mut PROPERTY_DATA_DESCRIPTOR;
        type PPROVIDER_ENUMERATION_INFO = *mut PROVIDER_ENUMERATION_INFO;
        type PPROVIDER_EVENT_INFO = *mut PROVIDER_EVENT_INFO;
        type PPROVIDER_FIELD_INFO = *mut PROVIDER_FIELD_INFO;
        type PPROVIDER_FIELD_INFOARRAY = *mut PROVIDER_FIELD_INFOARRAY;
        type PPROVIDER_FILTER_INFO = *mut PROVIDER_FILTER_INFO;
        struct PROPERTY_DATA_DESCRIPTOR {
            PropertyName: ULONGLONG,
            ArrayIndex: ULONG,
            Reserved: ULONG,
        }
        #[repr(i32)]
        enum PROPERTY_FLAGS {
            PropertyStruct = 1,
            PropertyParamLength = 2,
            PropertyParamCount = 4,
            PropertyWBEMXmlFragment = 8,
            PropertyParamFixedLength = 16,
            PropertyParamFixedCount = 32,
            PropertyHasTags = 64,
            PropertyHasCustomSchema = 128,
        }
        struct PROVIDER_ENUMERATION_INFO {
            NumberOfProviders: ULONG,
            Reserved: ULONG,
            #[writable(NumberOfProviders)]
            TraceProviderInfoArray: [TRACE_PROVIDER_INFO; 1],
        }
        struct PROVIDER_EVENT_INFO {
            NumberOfEvents: ULONG,
            Reserved: ULONG,
            #[writable(NumberOfEvents)]
            EventDescriptorsArray: [EVENT_DESCRIPTOR; 1],
        }
        struct PROVIDER_FIELD_INFO {
            NameOffset: ULONG,
            DescriptionOffset: ULONG,
            Value: ULONGLONG,
        }
        struct PROVIDER_FIELD_INFOARRAY {
            NumberOfElements: ULONG,
            FieldType: EVENT_FIELD_TYPE,
            FieldInfoArray: [PROVIDER_FIELD_INFO; 1],
        }
        struct PROVIDER_FILTER_INFO {
            Id: UCHAR,
            Version: UCHAR,
            MessageOffset: ULONG,
            Reserved: ULONG,
            PropertyCount: ULONG,
            #[writable(PropertyCount)]
            EventPropertyInfoArray: [EVENT_PROPERTY_INFO; 1],
        }
        type PTDH_CONTEXT = *mut TDH_CONTEXT;
        type PTDH_HANDLE = *mut *mut void;
        type PTRACE_EVENT_INFO = *mut TRACE_EVENT_INFO;
        type PTRACE_PROVIDER_INFO = *mut TRACE_PROVIDER_INFO;
        #[success(return == 0)]
        type TDHSTATUS = u32;
        struct TDH_CONTEXT {
            ParameterValue: ULONGLONG,
            ParameterType: TDH_CONTEXT_TYPE,
            ParameterSize: ULONG,
        }
        #[repr(i32)]
        enum TDH_CONTEXT_TYPE {
            TDH_CONTEXT_WPP_TMFFILE = 0,
            TDH_CONTEXT_WPP_TMFSEARCHPATH = 1,
            TDH_CONTEXT_WPP_GMT = 2,
            TDH_CONTEXT_POINTERSIZE = 3,
            TDH_CONTEXT_PDB_PATH = 4,
            TDH_CONTEXT_MAXIMUM = 5,
        }
        type TDH_HANDLE = *mut void;
        const TDH_OUTYTPE_ERRORCODE: _TDH_OUT_TYPE = 29;
        #[repr(i32)]
        enum TEMPLATE_FLAGS {
            TEMPLATE_EVENT_DATA = 1,
            TEMPLATE_USER_DATA = 2,
            TEMPLATE_CONTROL_GUID = 4,
        }
        struct TRACE_EVENT_INFO {
            ProviderGuid: GUID,
            EventGuid: GUID,
            EventDescriptor: EVENT_DESCRIPTOR,
            DecodingSource: DECODING_SOURCE,
            ProviderNameOffset: ULONG,
            LevelNameOffset: ULONG,
            ChannelNameOffset: ULONG,
            KeywordsNameOffset: ULONG,
            TaskNameOffset: ULONG,
            OpcodeNameOffset: ULONG,
            EventMessageOffset: ULONG,
            ProviderMessageOffset: ULONG,
            BinaryXMLOffset: ULONG,
            BinaryXMLSize: ULONG,
            Anonymous: union {
                EventNameOffset: ULONG,
                ActivityIDNameOffset: ULONG,
            },
            Anonymous2: union {
                EventAttributesOffset: ULONG,
                RelatedActivityIDNameOffset: ULONG,
            },
            PropertyCount: ULONG,
            #[range(0..=PropertyCount)]
            TopLevelPropertyCount: ULONG,
            Anonymous3: union {
                Flags: TEMPLATE_FLAGS,
                Anonymous: struct {
                    _bitfield: u32 {
                        Reserved: ULONG: 4,
                        Tags: ULONG: 28,
                    },
                },
            },
            #[writable(PropertyCount)]
            EventPropertyInfoArray: [EVENT_PROPERTY_INFO; 1],
        }
        struct TRACE_PROVIDER_INFO {
            ProviderGuid: GUID,
            SchemaSource: ULONG,
            ProviderNameOffset: ULONG,
        }
        #[library("tdh.dll")]
        extern fn TdhAggregatePayloadFilters(#[in] PayloadFilterCount: ULONG, #[in] #[readable(entry, PayloadFilterCount)] PayloadFilterPtrs: *mut PVOID, #[in] #[opt] #[readable(entry, PayloadFilterCount)] EventMatchALLFlags: PBOOLEAN, #[out] EventFilterDescriptor: PEVENT_FILTER_DESCRIPTOR) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhCleanupPayloadEventFilterDescriptor(#[in] #[out] EventFilterDescriptor: PEVENT_FILTER_DESCRIPTOR) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhCloseDecodingHandle(#[in] Handle: TDH_HANDLE) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhCreatePayloadFilter(#[in] ProviderGuid: LPCGUID, #[in] EventDescriptor: PCEVENT_DESCRIPTOR, #[in] EventMatchANY: BOOLEAN, #[in] PayloadPredicateCount: ULONG, #[in] #[readable(entry, PayloadPredicateCount)] PayloadPredicates: PPAYLOAD_FILTER_PREDICATE, #[nullable] #[out] #[out_ptr] PayloadFilter: *mut PVOID) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhDeletePayloadFilter(#[in] #[out] PayloadFilter: *mut PVOID) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhEnumerateManifestProviderEvents(#[in] ProviderGuid: LPGUID, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PPROVIDER_EVENT_INFO, #[in] #[out] BufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhEnumerateProviderFieldInformation(#[in] pGuid: LPGUID, #[in] EventFieldType: EVENT_FIELD_TYPE, #[opt] #[out] #[writable(entry, bytes(*pBufferSize))] pBuffer: PPROVIDER_FIELD_INFOARRAY, #[in] #[out] pBufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhEnumerateProviderFilters(#[in] Guid: LPGUID, #[in] TdhContextCount: ULONG, #[in] #[opt] #[readable(entry, TdhContextCount)] TdhContext: PTDH_CONTEXT, #[out] FilterCount: *mut ULONG, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: *mut PPROVIDER_FILTER_INFO, #[in] #[out] BufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhEnumerateProviders(#[opt] #[out] #[writable(entry, bytes(*pBufferSize))] pBuffer: PPROVIDER_ENUMERATION_INFO, #[in] #[out] pBufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhEnumerateProvidersForDecodingSource(filter: DECODING_SOURCE, #[opt] #[out] #[readable(success, bytes(*bufferRequired))] #[writable(entry, bytes(bufferSize))] buffer: *mut PROVIDER_ENUMERATION_INFO, bufferSize: ULONG, #[out] bufferRequired: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhFormatProperty(#[in] EventInfo: PTRACE_EVENT_INFO, #[in] #[opt] MapInfo: PEVENT_MAP_INFO, #[in] PointerSize: ULONG, #[in] PropertyInType: USHORT, #[in] PropertyOutType: USHORT, #[in] PropertyLength: USHORT, #[in] UserDataLength: USHORT, #[in] #[readable(entry, bytes(UserDataLength))] UserData: PBYTE, #[in] #[out] BufferSize: PULONG, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PWCHAR, #[out] UserDataConsumed: PUSHORT) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetDecodingParameter(#[in] Handle: TDH_HANDLE, #[in] #[out] TdhContext: PTDH_CONTEXT) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetEventInformation(#[in] Event: PEVENT_RECORD, #[in] TdhContextCount: ULONG, #[in] #[opt] #[readable(entry, TdhContextCount)] TdhContext: PTDH_CONTEXT, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PTRACE_EVENT_INFO, #[in] #[out] BufferSize: PULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetEventMapInformation(#[in] pEvent: PEVENT_RECORD, #[in] pMapName: PWSTR, #[opt] #[out] #[writable(entry, bytes(*pBufferSize))] pBuffer: PEVENT_MAP_INFO, #[in] #[out] pBufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetManifestEventInformation(#[in] ProviderGuid: LPGUID, #[in] EventDescriptor: PEVENT_DESCRIPTOR, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PTRACE_EVENT_INFO, #[in] #[out] BufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetProperty(#[in] pEvent: PEVENT_RECORD, #[in] TdhContextCount: ULONG, #[in] #[opt] #[readable(entry, TdhContextCount)] pTdhContext: PTDH_CONTEXT, #[in] PropertyDataCount: ULONG, #[in] #[readable(entry, PropertyDataCount)] pPropertyData: PPROPERTY_DATA_DESCRIPTOR, #[in] BufferSize: ULONG, #[out] #[writable(entry, bytes(BufferSize))] pBuffer: PBYTE) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetPropertySize(#[in] pEvent: PEVENT_RECORD, #[in] TdhContextCount: ULONG, #[in] #[opt] #[readable(entry, TdhContextCount)] pTdhContext: PTDH_CONTEXT, #[in] PropertyDataCount: ULONG, #[in] #[readable(entry, PropertyDataCount)] pPropertyData: PPROPERTY_DATA_DESCRIPTOR, #[out] pPropertySize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetWppMessage(#[in] Handle: TDH_HANDLE, #[in] EventRecord: PEVENT_RECORD, #[in] #[out] BufferSize: PULONG, #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PBYTE) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhGetWppProperty(#[in] Handle: TDH_HANDLE, #[in] EventRecord: PEVENT_RECORD, #[in] PropertyName: PWSTR, #[in] #[out] BufferSize: PULONG, #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PBYTE) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhLoadManifest(#[in] Manifest: PWSTR) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhLoadManifestFromBinary(#[in] BinaryPath: PWSTR) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhLoadManifestFromMemory(#[in] #[readable(entry, bytes(cbData))] pData: LPCVOID, #[in] cbData: ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhOpenDecodingHandle(#[out] Handle: PTDH_HANDLE) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhQueryProviderFieldInformation(#[in] pGuid: LPGUID, #[in] EventFieldValue: ULONGLONG, #[in] EventFieldType: EVENT_FIELD_TYPE, #[opt] #[out] #[writable(entry, bytes(*pBufferSize))] pBuffer: PPROVIDER_FIELD_INFOARRAY, #[in] #[out] pBufferSize: *mut ULONG) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhSetDecodingParameter(#[in] Handle: TDH_HANDLE, #[in] TdhContext: PTDH_CONTEXT) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhUnloadManifest(#[in] Manifest: PWSTR) -> TDHSTATUS;
        #[library("tdh.dll")]
        extern fn TdhUnloadManifestFromMemory(#[in] #[readable(entry, bytes(cbData))] pData: LPCVOID, #[in] cbData: ULONG) -> TDHSTATUS;
        #[repr(i32)]
        enum _TDH_IN_TYPE {
            TDH_INTYPE_NULL = 0,
            TDH_INTYPE_UNICODESTRING = 1,
            TDH_INTYPE_ANSISTRING = 2,
            TDH_INTYPE_INT8 = 3,
            TDH_INTYPE_UINT8 = 4,
            TDH_INTYPE_INT16 = 5,
            TDH_INTYPE_UINT16 = 6,
            TDH_INTYPE_INT32 = 7,
            TDH_INTYPE_UINT32 = 8,
            TDH_INTYPE_INT64 = 9,
            TDH_INTYPE_UINT64 = 10,
            TDH_INTYPE_FLOAT = 11,
            TDH_INTYPE_DOUBLE = 12,
            TDH_INTYPE_BOOLEAN = 13,
            TDH_INTYPE_BINARY = 14,
            TDH_INTYPE_GUID = 15,
            TDH_INTYPE_POINTER = 16,
            TDH_INTYPE_FILETIME = 17,
            TDH_INTYPE_SYSTEMTIME = 18,
            TDH_INTYPE_SID = 19,
            TDH_INTYPE_HEXINT32 = 20,
            TDH_INTYPE_HEXINT64 = 21,
            TDH_INTYPE_MANIFEST_COUNTEDSTRING = 22,
            TDH_INTYPE_MANIFEST_COUNTEDANSISTRING = 23,
            TDH_INTYPE_RESERVED24 = 24,
            TDH_INTYPE_MANIFEST_COUNTEDBINARY = 25,
            TDH_INTYPE_COUNTEDSTRING = 300,
            TDH_INTYPE_COUNTEDANSISTRING = 301,
            TDH_INTYPE_REVERSEDCOUNTEDSTRING = 302,
            TDH_INTYPE_REVERSEDCOUNTEDANSISTRING = 303,
            TDH_INTYPE_NONNULLTERMINATEDSTRING = 304,
            TDH_INTYPE_NONNULLTERMINATEDANSISTRING = 305,
            TDH_INTYPE_UNICODECHAR = 306,
            TDH_INTYPE_ANSICHAR = 307,
            TDH_INTYPE_SIZET = 308,
            TDH_INTYPE_HEXDUMP = 309,
            TDH_INTYPE_WBEMSID = 310,
