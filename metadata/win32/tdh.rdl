        #[repr(i32)]
        enum _TDH_OUT_TYPE {
            TDH_OUTTYPE_NULL = 0,
            TDH_OUTTYPE_STRING = 1,
            TDH_OUTTYPE_DATETIME = 2,
            TDH_OUTTYPE_BYTE = 3,
            TDH_OUTTYPE_UNSIGNEDBYTE = 4,
            TDH_OUTTYPE_SHORT = 5,
            TDH_OUTTYPE_UNSIGNEDSHORT = 6,
            TDH_OUTTYPE_INT = 7,
            TDH_OUTTYPE_UNSIGNEDINT = 8,
            TDH_OUTTYPE_LONG = 9,
            TDH_OUTTYPE_UNSIGNEDLONG = 10,
            TDH_OUTTYPE_FLOAT = 11,
