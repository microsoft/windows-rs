#[win32]
mod Windows {
    mod Win32 {
        const DA_ERR: i32 = -1;
        const DA_LAST: i32 = 2147483647;
        const DPAMM_DELETE: i32 = 2;
        const DPAMM_INSERT: i32 = 3;
        const DPAMM_MERGE: i32 = 1;
        const DPAM_INTERSECT: i32 = 8;
        const DPAM_NORMAL: i32 = 2;
        const DPAM_SORTED: i32 = 1;
        const DPAM_UNION: i32 = 4;
        struct DPASTREAMINFO {
            iPos: i32,
            pvItem: *mut void,
        }
        const DPAS_INSERTAFTER: i32 = 4;
        const DPAS_INSERTBEFORE: i32 = 2;
        const DPAS_SORTED: i32 = 1;
        const DPA_APPEND: i32 = 2147483647;
        #[library("COMCTL32.dll")]
        extern fn DPA_Clone(hdpa: HDPA, #[in] #[out] #[opt] hdpaNew: HDPA) -> HDPA;
        #[library("COMCTL32.dll")]
        extern fn DPA_Create(cItemGrow: i32) -> HDPA;
        #[library("COMCTL32.dll")]
        extern fn DPA_CreateEx(cpGrow: i32, #[opt] hheap: HANDLE) -> HDPA;
        #[library("COMCTL32.dll")]
        extern fn DPA_DeleteAllPtrs(#[in] #[out] hdpa: HDPA) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DPA_DeletePtr(#[in] #[out] hdpa: HDPA, i: i32) -> *mut void;
        #[library("COMCTL32.dll")]
        extern fn DPA_Destroy(#[in] #[out] #[opt] hdpa: HDPA) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DPA_DestroyCallback(#[in] #[out] #[opt] hdpa: HDPA, pfnCB: PFNDAENUMCALLBACK, #[in] #[opt] pData: *mut void);
        const DPA_ERR: i32 = -1;
        #[library("COMCTL32.dll")]
        extern fn DPA_EnumCallback(#[opt] hdpa: HDPA, #[opt] pfnCB: PFNDAENUMCALLBACK, #[in] #[opt] pData: *mut void);
        #[library("COMCTL32.dll")]
        extern fn DPA_GetPtr(hdpa: HDPA, i: isize) -> *mut void;
        #[library("COMCTL32.dll")]
        extern fn DPA_GetPtrIndex(hdpa: HDPA, #[opt] p: *const void) -> i32;
        #[library("COMCTL32.dll")]
        extern fn DPA_GetSize(#[opt] hdpa: HDPA) -> u64;
        #[library("COMCTL32.dll")]
        extern fn DPA_Grow(#[in] #[out] pdpa: HDPA, cp: i32) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DPA_InsertPtr(#[in] #[out] hdpa: HDPA, i: i32, #[in] #[opt] p: *mut void) -> i32;
        #[library("COMCTL32.dll")]
        extern fn DPA_LoadStream(phdpa: *mut HDPA, pfn: PFNDPASTREAM, pstream: IStream, #[in] #[opt] pvInstData: *mut void) -> HRESULT;
        #[library("COMCTL32.dll")]
        extern fn DPA_Merge(#[in] #[out] hdpaDest: HDPA, hdpaSrc: HDPA, dwFlags: u32, pfnCompare: PFNDACOMPARE, pfnMerge: PFNDPAMERGE, lParam: LPARAM) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DPA_SaveStream(hdpa: HDPA, pfn: PFNDPASTREAM, pstream: IStream, #[in] #[opt] pvInstData: *mut void) -> HRESULT;
        #[library("COMCTL32.dll")]
        extern fn DPA_Search(hdpa: HDPA, #[in] #[opt] pFind: *mut void, iStart: i32, pfnCompare: PFNDACOMPARE, lParam: LPARAM, options: u32) -> i32;
        #[library("COMCTL32.dll")]
        extern fn DPA_SetPtr(#[in] #[out] hdpa: HDPA, i: i32, #[in] #[opt] p: *mut void) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DPA_Sort(#[in] #[out] hdpa: HDPA, pfnCompare: PFNDACOMPARE, lParam: LPARAM) -> BOOL;
        const DSA_APPEND: i32 = 2147483647;
        #[library("COMCTL32.dll")]
        extern fn DSA_Clone(hdsa: HDSA) -> HDSA;
        #[library("COMCTL32.dll")]
        extern fn DSA_Create(cbItem: i32, cItemGrow: i32) -> HDSA;
        #[library("COMCTL32.dll")]
        extern fn DSA_DeleteAllItems(#[in] #[out] hdsa: HDSA) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DSA_DeleteItem(#[in] #[out] hdsa: HDSA, i: i32) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DSA_Destroy(#[in] #[out] #[opt] hdsa: HDSA) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DSA_DestroyCallback(#[in] #[out] #[opt] hdsa: HDSA, pfnCB: PFNDAENUMCALLBACK, #[in] #[opt] pData: *mut void);
        const DSA_ERR: i32 = -1;
        #[library("COMCTL32.dll")]
        extern fn DSA_EnumCallback(hdsa: HDSA, pfnCB: PFNDAENUMCALLBACK, #[in] #[opt] pData: *mut void);
        #[library("COMCTL32.dll")]
        extern fn DSA_GetItem(hdsa: HDSA, i: i32, pitem: *mut void) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DSA_GetItemPtr(hdsa: HDSA, i: i32) -> *mut void;
        #[library("COMCTL32.dll")]
        extern fn DSA_GetSize(#[opt] hdsa: HDSA) -> u64;
        #[library("COMCTL32.dll")]
        extern fn DSA_InsertItem(#[in] #[out] hdsa: HDSA, i: i32, pitem: *const void) -> i32;
        #[library("COMCTL32.dll")]
        extern fn DSA_SetItem(#[in] #[out] hdsa: HDSA, i: i32, pitem: *const void) -> BOOL;
        #[library("COMCTL32.dll")]
        extern fn DSA_Sort(#[in] #[out] pdsa: HDSA, pfnCompare: PFNDACOMPARE, lParam: LPARAM) -> BOOL;
        type HDPA = *mut _DPA;
        type HDSA = *mut _DSA;
        extern fn PFNDACOMPARE(#[in] #[opt] p1: *mut void, #[in] #[opt] p2: *mut void, lParam: LPARAM) -> i32;
        extern fn PFNDACOMPARECONST(#[opt] p1: *const void, #[opt] p2: *const void, lParam: LPARAM) -> i32;
        extern fn PFNDAENUMCALLBACK(#[in] #[opt] p: *mut void, #[in] #[opt] pData: *mut void) -> i32;
        extern fn PFNDAENUMCALLBACKCONST(#[opt] p: *const void, #[in] #[opt] pData: *mut void) -> i32;
        extern fn PFNDPAMERGE(uMsg: u32, #[in] pvDest: *mut void, #[in] pvSrc: *mut void, lParam: LPARAM) -> *mut void;
        extern fn PFNDPAMERGECONST(uMsg: u32, pvDest: *const void, pvSrc: *const void, lParam: LPARAM) -> *const void;
        extern fn PFNDPASTREAM(#[in] pinfo: *mut DPASTREAMINFO, pstream: IStream, #[in] #[opt] pvInstData: *mut void) -> HRESULT;
        #[library("COMCTL32.dll")]
        extern fn Str_SetPtrW(#[in] #[out] ppsz: *mut PWSTR, #[opt] psz: PCWSTR) -> BOOL;
        struct _DPA {}
        struct _DSA {}
    }
}
