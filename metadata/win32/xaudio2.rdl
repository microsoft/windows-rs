            SendCount: UINT32,
            pSends: *mut XAUDIO2_SEND_DESCRIPTOR,
        }
        #[packed(1)]
        struct XAUDIO2_VOICE_STATE {
            pCurrentBufferContext: *mut void,
            BuffersQueued: UINT32,
            SamplesPlayed: UINT64,
        }
        const XAUDIO2_VOICE_USEFILTER: i32 = 8;
        #[library("XAudio2_9.dll")]
        extern fn XAudio2CreateWithVersionInfo(#[out] #[out_ptr] ppXAudio2: *mut IXAudio2, Flags: UINT32, XAudio2Processor: XAUDIO2_PROCESSOR, ntddiVersion: DWORD) -> HRESULT;
    }
}
