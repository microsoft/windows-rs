#[win32]
mod Windows {
    mod Win32 {
        const CCH_RM_MAX_APP_NAME: i32 = 255;
        const CCH_RM_MAX_SVC_NAME: i32 = 63;
        #[arch(X64 | Arm64)]
        const CCH_RM_SESSION_KEY: u64 = 32;
        #[arch(X86)]
        const CCH_RM_SESSION_KEY: u32 = 32;
        type PRM_FILTER_INFO = *mut RM_FILTER_INFO;
        type PRM_PROCESS_INFO = *mut RM_PROCESS_INFO;
        type PRM_UNIQUE_PROCESS = *mut RM_UNIQUE_PROCESS;
        #[repr(i32)]
        enum RM_APP_STATUS {
            RmStatusUnknown = 0,
            RmStatusRunning = 1,
            RmStatusStopped = 2,
            RmStatusStoppedOther = 4,
            RmStatusRestarted = 8,
            RmStatusErrorOnStop = 16,
            RmStatusErrorOnRestart = 32,
            RmStatusShutdownMasked = 64,
            RmStatusRestartMasked = 128,
        }
        #[repr(i32)]
        enum RM_APP_TYPE {
            RmUnknownApp = 0,
            RmMainWindow = 1,
            RmOtherWindow = 2,
            RmService = 3,
            RmExplorer = 4,
            RmConsole = 5,
            RmCritical = 1000,
        }
        #[repr(i32)]
        enum RM_FILTER_ACTION {
            RmInvalidFilterAction = 0,
            RmNoRestart = 1,
            RmNoShutdown = 2,
        }
        struct RM_FILTER_INFO {
            FilterAction: RM_FILTER_ACTION,
            FilterTrigger: RM_FILTER_TRIGGER,
            cbNextOffset: DWORD,
            Anonymous: union {
                strFilename: LPWSTR,
                Process: RM_UNIQUE_PROCESS,
                strServiceShortName: LPWSTR,
            },
        }
        #[repr(i32)]
        enum RM_FILTER_TRIGGER {
            RmFilterTriggerInvalid = 0,
            RmFilterTriggerFile = 1,
            RmFilterTriggerProcess = 2,
            RmFilterTriggerService = 3,
        }
        const RM_INVALID_PROCESS: i32 = -1;
        const RM_INVALID_TS_SESSION: i32 = -1;
        struct RM_PROCESS_INFO {
            Process: RM_UNIQUE_PROCESS,
            strAppName: [WCHAR; 256],
            strServiceShortName: [WCHAR; 64],
            ApplicationType: RM_APP_TYPE,
            AppStatus: ULONG,
            TSSessionId: DWORD,
            bRestartable: BOOL,
        }
        #[repr(i32)]
        enum RM_REBOOT_REASON {
            RmRebootReasonNone = 0,
            RmRebootReasonPermissionDenied = 1,
            RmRebootReasonSessionMismatch = 2,
            RmRebootReasonCriticalProcess = 4,
            RmRebootReasonCriticalService = 8,
            RmRebootReasonDetectedSelf = 16,
        }
        #[arch(X64 | Arm64)]
        const RM_SESSION_KEY_LEN: u64 = 16;
        #[arch(X86)]
        const RM_SESSION_KEY_LEN: u32 = 16;
        #[repr(i32)]
        enum RM_SHUTDOWN_TYPE {
            RmForceShutdown = 1,
            RmShutdownOnlyRegistered = 16,
        }
        struct RM_UNIQUE_PROCESS {
            dwProcessId: DWORD,
            ProcessStartTime: FILETIME,
        }
        extern "C" fn RM_WRITE_STATUS_CALLBACK(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] nPercentComplete: UINT);
        #[library("RstrtMgr.DLL")]
        extern fn RmAddFilter(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] strModuleName: LPCWSTR, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pProcess: *mut RM_UNIQUE_PROCESS, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] strServiceShortName: LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FilterAction: RM_FILTER_ACTION) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmCancelCurrentTask(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmEndSession(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmGetFilterList(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[out] #[opt] #[size_param(2)] pbFilterBuf: PBYTE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cbFilterBuf: DWORD, #[out] cbFilterBufNeeded: LPDWORD) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmGetList(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[out] pnProcInfoNeeded: *mut UINT, #[in] #[out] pnProcInfo: *mut UINT, #[Windows::Win32::Metadata::NativeSal("2", "_Inout_updates_opt_", "*pnProcInfo", "*pnProcInfo")] #[in] #[out] #[opt] rgAffectedApps: *mut RM_PROCESS_INFO, #[out] lpdwRebootReasons: LPDWORD) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmJoinSession(#[out] pSessionHandle: *mut DWORD, #[Windows::Win32::Metadata::NativeSal("2", "_In_reads_", "sizeof(GUID)*2+1", "sizeof(GUID)*2+1")] #[in] strSessionKey: *const WCHAR) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmRegisterResources(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] nFiles: UINT, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[len_param(1)] rgsFileNames: *mut LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] nApplications: UINT, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[len_param(3)] rgApplications: *mut RM_UNIQUE_PROCESS, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] nServices: UINT, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[len_param(5)] rgsServiceNames: *mut LPCWSTR) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmRemoveFilter(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] strModuleName: LPCWSTR, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pProcess: *mut RM_UNIQUE_PROCESS, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] strServiceShortName: LPCWSTR) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmRestart(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[reserved] dwRestartFlags: DWORD, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] fnStatus: RM_WRITE_STATUS_CALLBACK) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmShutdown(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwSessionHandle: DWORD, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lActionFlags: ULONG, #[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] fnStatus: RM_WRITE_STATUS_CALLBACK) -> DWORD;
        #[library("RstrtMgr.DLL")]
        extern fn RmStartSession(#[out] pSessionHandle: *mut DWORD, #[reserved] dwSessionFlags: DWORD, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_", "sizeof(GUID)*2+1", "sizeof(GUID)*2+1")] #[out] strSessionKey: *mut WCHAR) -> DWORD;
    }
}
