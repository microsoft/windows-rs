#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum EFFECTIVE_POWER_MODE {
            EffectivePowerModeBatterySaver = 0,
            EffectivePowerModeEnergySaverHighSavings = 0,
            EffectivePowerModeBetterBattery = 1,
            EffectivePowerModeEnergySaverStandard = 1,
            EffectivePowerModeBalanced = 2,
            EffectivePowerModeHighPerformance = 3,
            EffectivePowerModeMaxPerformance = 4,
            EffectivePowerModeGameMode = 5,
            EffectivePowerModeMixedReality = 6,
        }
        #[Windows::Win32::Metadata::NativeSal("2", "_Function_class_", "EFFECTIVE_POWER_MODE_CALLBACK", "EFFECTIVE_POWER_MODE_CALLBACK")]
        extern fn EFFECTIVE_POWER_MODE_CALLBACK(#[in] Mode: EFFECTIVE_POWER_MODE, #[in] #[opt] Context: *mut void);
        const EFFECTIVE_POWER_MODE_V1: i32 = 1;
        const EFFECTIVE_POWER_MODE_V2: i32 = 2;
        #[library("POWRPROF.dll")]
        extern fn PowerGetActiveScheme(#[in] #[opt] UserRootPowerKey: HKEY, #[out] #[out_ptr] ActivePolicyGuid: *mut *mut GUID) -> DWORD;
        #[library("POWRPROF.dll")]
        extern fn PowerReadACValue(#[in] #[opt] RootPowerKey: HKEY, #[in] #[opt] SchemeGuid: *const GUID, #[in] #[opt] SubGroupOfPowerSettingsGuid: *const GUID, #[in] #[opt] PowerSettingGuid: *const GUID, #[opt] #[out] Type: PULONG, #[opt] #[out] #[writable(entry, bytes(if_present(*BufferSize)))] Buffer: LPBYTE, #[in] #[opt] #[out] BufferSize: LPDWORD) -> DWORD;
        #[library("POWRPROF.dll")]
        extern fn PowerReadDCValue(#[in] #[opt] RootPowerKey: HKEY, #[in] #[opt] SchemeGuid: *const GUID, #[in] #[opt] SubGroupOfPowerSettingsGuid: *const GUID, #[in] #[opt] PowerSettingGuid: *const GUID, #[opt] #[out] Type: PULONG, #[opt] #[out] #[writable(entry, bytes(*BufferSize))] Buffer: PUCHAR, #[in] #[out] BufferSize: LPDWORD) -> DWORD;
        #[library("POWRPROF.dll")]
        #[must_use]
        extern fn PowerRegisterForEffectivePowerModeNotifications(#[in] Version: ULONG, #[in] Callback: EFFECTIVE_POWER_MODE_CALLBACK, #[in] #[opt] Context: PVOID, #[out] #[out_ptr] RegistrationHandle: *mut PVOID) -> HRESULT;
        #[library("POWRPROF.dll")]
        extern fn PowerSetActiveScheme(#[in] #[opt] UserRootPowerKey: HKEY, #[in] #[opt] SchemeGuid: *const GUID) -> DWORD;
        #[library("POWRPROF.dll")]
        extern fn PowerSettingRegisterNotification(#[in] SettingGuid: LPCGUID, #[in] Flags: DWORD, #[in] Recipient: HANDLE, #[out] RegistrationHandle: PHPOWERNOTIFY) -> DWORD;
        #[library("POWRPROF.dll")]
        extern fn PowerSettingUnregisterNotification(#[in] #[out] RegistrationHandle: HPOWERNOTIFY) -> DWORD;
        #[library("POWRPROF.dll")]
        extern fn PowerUnregisterFromEffectivePowerModeNotifications(#[in] RegistrationHandle: PVOID) -> HRESULT;
        #[library("POWRPROF.dll")]
        extern fn PowerWriteACValueIndex(#[in] #[opt] RootPowerKey: HKEY, #[in] SchemeGuid: *const GUID, #[in] #[opt] SubGroupOfPowerSettingsGuid: *const GUID, #[in] #[opt] PowerSettingGuid: *const GUID, #[in] AcValueIndex: DWORD) -> DWORD;
        #[library("POWRPROF.dll")]
        extern fn PowerWriteDCValueIndex(#[in] #[opt] RootPowerKey: HKEY, #[in] SchemeGuid: *const GUID, #[in] #[opt] SubGroupOfPowerSettingsGuid: *const GUID, #[in] #[opt] PowerSettingGuid: *const GUID, #[in] DcValueIndex: DWORD) -> DWORD;
    }
}
