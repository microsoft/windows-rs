            Reserved: [ULONG; 2],
            VideoTimeoutAc: ULONG,
            VideoTimeoutDc: ULONG,
            SpindownTimeoutAc: ULONG,
            SpindownTimeoutDc: ULONG,
            OptimizeForPowerAc: BOOLEAN,
            OptimizeForPowerDc: BOOLEAN,
            FanThrottleToleranceAc: UCHAR,
            FanThrottleToleranceDc: UCHAR,
            ForcedThrottleAc: UCHAR,
            ForcedThrottleDc: UCHAR,
        }
        #[library("POWRPROF.dll")]
        extern fn ValidatePowerPolicies(#[in] #[out] #[opt] pGlobalPowerPolicy: PGLOBAL_POWER_POLICY, #[in] #[out] #[opt] pPowerPolicy: PPOWER_POLICY) -> BOOLEAN;
        #[library("POWRPROF.dll")]
        extern fn WriteGlobalPwrPolicy(#[in] pGlobalPowerPolicy: PGLOBAL_POWER_POLICY) -> BOOLEAN;
        #[library("POWRPROF.dll")]
        extern fn WriteProcessorPwrScheme(#[in] uiID: UINT, #[in] pMachineProcessorPowerPolicy: PMACHINE_PROCESSOR_POWER_POLICY) -> BOOLEAN;
        #[library("POWRPROF.dll")]
        extern fn WritePwrScheme(#[in] puiID: PUINT, #[in] lpszSchemeName: LPCWSTR, #[in] #[opt] lpszDescription: LPCWSTR, #[in] lpScheme: PPOWER_POLICY) -> BOOLEAN;
    }
}
