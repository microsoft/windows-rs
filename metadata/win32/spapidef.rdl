#[win32]
mod Windows {
    mod Win32 {
        const LOGTOKEN_NO_LOG: i32 = 1;
        const LOGTOKEN_SETUPAPI_APPLOG: i32 = 2;
        const LOGTOKEN_SETUPAPI_DEVLOG: i32 = 3;
        const LOGTOKEN_TYPE_MASK: i32 = 3;
        const LOGTOKEN_UNSPECIFIED: i32 = 0;
        type PSP_LOG_TOKEN = *mut DWORDLONG;
        type SP_LOG_TOKEN = DWORDLONG;
        const TXTLOG_BACKUP: i32 = 128;
        const TXTLOG_CMI: i32 = 268435456;
        const TXTLOG_COPYFILES: i32 = 8;
        const TXTLOG_DEPTH_DECR: i32 = 262144;
        const TXTLOG_DEPTH_INCR: i32 = 131072;
        const TXTLOG_DETAILS: i32 = 5;
        const TXTLOG_DEVINST: i32 = 1;
        const TXTLOG_DEVMGR: i32 = 536870912;
        const TXTLOG_DRIVER_STORE: i32 = 67108864;
        const TXTLOG_DRVSETUP: i32 = 4194304;
        const TXTLOG_ERROR: i32 = 1;
        const TXTLOG_FILEQ: i32 = 4;
        const TXTLOG_FLUSH_FILE: i32 = 1048576;
        const TXTLOG_INF: i32 = 2;
        const TXTLOG_INFDB: i32 = 1024;
        const TXTLOG_INSTALLER: i32 = 1073741824;
        const TXTLOG_NEWDEV: i32 = 16777216;
        const TXTLOG_POLICY: i32 = 8388608;
        const TXTLOG_RESERVED_FLAGS: i32 = 65520;
        const TXTLOG_SETUP: i32 = 134217728;
        const TXTLOG_SETUPAPI_BITS: i32 = 3;
        const TXTLOG_SETUPAPI_CMDLINE: i32 = 2;
        const TXTLOG_SETUPAPI_DEVLOG: i32 = 1;
        const TXTLOG_SIGVERIF: i32 = 32;
        const TXTLOG_SUMMARY: i32 = 4;
        const TXTLOG_SYSTEM_STATE_CHANGE: i32 = 3;
        const TXTLOG_TAB_1: i32 = 524288;
        const TXTLOG_TIMESTAMP: i32 = 65536;
        const TXTLOG_UI: i32 = 256;
        const TXTLOG_UMPNPMGR: i32 = 33554432;
        const TXTLOG_UTIL: i32 = 512;
        const TXTLOG_VENDOR: u32 = 2147483648;
        const TXTLOG_VERBOSE: i32 = 6;
        const TXTLOG_VERY_VERBOSE: i32 = 7;
        const TXTLOG_WARNING: i32 = 2;
    }
}
