#[win32]
mod Windows {
    mod Win32 {
        type ATOM = u16;
        type BOOL = i32;
        const FALSE: i32 = 0;
        #[arch(X64 | Arm64)]
        extern fn FARPROC() -> INT_PTR;
        #[arch(X86)]
        extern fn FARPROC() -> i32;
        struct FILETIME {
            dwLowDateTime: DWORD,
            dwHighDateTime: DWORD,
        }
        type FLOAT = f32;
        type GLOBALHANDLE = *mut void;
        type HFILE = i32;
        type HGLOBAL = *mut void;
        type HINSTANCE = *mut HINSTANCE__;
        struct HINSTANCE__ {
            unused: i32,
        }
        type HKEY = *mut HKEY__;
        struct HKEY__ {
            unused: i32,
        }
        type HKL = *mut HKL__;
        struct HKL__ {
            unused: i32,
        }
        type HLOCAL = *mut void;
        type HLSURF = *mut HLSURF__;
        struct HLSURF__ {
            unused: i32,
        }
        type HMETAFILE = *mut HMETAFILE__;
        struct HMETAFILE__ {
            unused: i32,
        }
        type HMODULE = *mut HINSTANCE__;
        type HRGN = *mut HRGN__;
        struct HRGN__ {
            unused: i32,
        }
        type HRSRC = *mut HRSRC__;
        struct HRSRC__ {
            unused: i32,
        }
        type HSPRITE = *mut HSPRITE__;
        struct HSPRITE__ {
            unused: i32,
        }
        type HSTR = *mut HSTR__;
        struct HSTR__ {
            unused: i32,
        }
        type HTASK = *mut HTASK__;
        struct HTASK__ {
            unused: i32,
        }
        type HWINSTA = *mut HWINSTA__;
        struct HWINSTA__ {
            unused: i32,
        }
        type LOCALHANDLE = *mut void;
        type LPARAM = isize;
        type LPBOOL = *mut i32;
        type LPDWORD = *mut u32;
        type LPFILETIME = *mut FILETIME;
        type LPHANDLE = *mut *mut void;
        type LPINT = *mut i32;
        type LPLONG = *mut i32;
        type LPVOID = *mut void;
        type LPWORD = *mut u16;
        type LRESULT = isize;
        const MAX_PATH: i32 = 260;
        #[arch(X64 | Arm64)]
        extern fn NEARPROC() -> INT_PTR;
        #[arch(X86)]
        extern fn NEARPROC() -> i32;
        type PBOOL = *mut i32;
        type PDWORD = *mut u32;
        type PFILETIME = *mut FILETIME;
        type PFLOAT = *mut f32;
        type PHKEY = *mut *mut HKEY__;
        type PINT = *mut i32;
        #[arch(X64 | Arm64)]
        extern fn PROC() -> INT_PTR;
        #[arch(X86)]
        extern fn PROC() -> i32;
        type PSZ = *mut i8;
        type PUCHAR = *mut u8;
        type PUINT = *mut u32;
        type PULONG = *mut u32;
        type PUSHORT = *mut u16;
        type PWORD = *mut u16;
        type SPHANDLE = *mut *mut void;
        const STRICT: i32 = 1;
        const TRUE: i32 = 1;
        type WPARAM = usize;
    }
}
