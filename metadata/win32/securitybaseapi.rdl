        extern fn SetSecurityDescriptorSacl(#[in] #[out] pSecurityDescriptor: PSECURITY_DESCRIPTOR, bSaclPresent: BOOL, #[opt] pSacl: PACL, bSaclDefaulted: BOOL) -> BOOL;
        #[library("ADVAPI32.dll")]
        extern fn SetTokenInformation(TokenHandle: HANDLE, TokenInformationClass: TOKEN_INFORMATION_CLASS, #[size_param(3)] #[in] TokenInformation: *mut void, TokenInformationLength: u32) -> BOOL;
    }
}
