#[win32]
mod Windows {
    mod Win32 {
        const CSBACKUP_DISABLE_INCREMENTAL: u32 = 4294967295;
        const CSBACKUP_TYPE_FULL: i32 = 1;
        const CSBACKUP_TYPE_LOGS_ONLY: i32 = 2;
        const CSBACKUP_TYPE_MASK: i32 = 3;
        type CSBFT = u16;
        const CSBFT_CERTSERVER_DATABASE: CSBFT = 68;
        const CSBFT_CHECKPOINT_DIR: CSBFT = 131;
        const CSBFT_DATABASE_DIRECTORY: i32 = 64;
        const CSBFT_DIRECTORY: i32 = 128;
        const CSBFT_LOG: CSBFT = 33;
        const CSBFT_LOG_DIR: CSBFT = 130;
        const CSBFT_LOG_DIRECTORY: i32 = 32;
        const CSBFT_PATCH_FILE: CSBFT = 37;
        const CSBFT_UNKNOWN: CSBFT = 15;
        const CSCONTROL_RESTART: i32 = 3;
        const CSCONTROL_SHUTDOWN: i32 = 1;
        const CSCONTROL_SUSPEND: i32 = 2;
        struct CSEDB_RSTMAPW {
            pwszDatabaseName: *mut WCHAR,
            pwszNewDatabaseName: *mut WCHAR,
        }
        const CSRESTORE_TYPE_CATCHUP: i32 = 4;
        const CSRESTORE_TYPE_FULL: i32 = 1;
        const CSRESTORE_TYPE_MASK: i32 = 5;
        const CSRESTORE_TYPE_ONLINE: i32 = 2;
        #[library("certadm.dll")]
        extern fn CertSrvBackupClose(hbc: HCSBC) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupEnd(hbc: HCSBC) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupFree(pv: *mut void);
        #[library("certadm.dll")]
        extern fn CertSrvBackupGetBackupLogsW(#[in] hbc: HCSBC, #[out] #[out_ptr] ppwszzBackupLogFiles: *mut PWSTR, #[out] pcbSize: *mut DWORD) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupGetDatabaseNamesW(#[in] hbc: HCSBC, #[out] #[out_ptr] ppwszzAttachmentInformation: *mut PWSTR, #[out] pcbSize: *mut DWORD) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupGetDynamicFileListW(#[in] hbc: HCSBC, #[out] #[out_ptr] ppwszzFileList: *mut PWSTR, #[out] pcbSize: *mut DWORD) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupOpenFileW(hbc: HCSBC, pwszAttachmentName: *const WCHAR, cbReadHintSize: DWORD, pliFileSize: *mut LARGE_INTEGER) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupPrepareW(pwszServerName: *const WCHAR, grbitJet: ULONG, dwBackupFlags: ULONG, phbc: *mut HCSBC) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupRead(hbc: HCSBC, pvBuffer: *mut void, cbBuffer: DWORD, pcbRead: *mut DWORD) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvBackupTruncateLogs(hbc: HCSBC) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvIsServerOnlineW(pwszServerName: *const WCHAR, pfServerOnline: *mut BOOL) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvRestoreEnd(hbc: HCSBC) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvRestoreGetDatabaseLocationsW(#[in] hbc: HCSBC, #[out] #[out_ptr] ppwszzDatabaseLocationList: *mut PWSTR, #[out] pcbSize: *mut DWORD) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvRestorePrepareW(pwszServerName: *const WCHAR, dwRestoreFlags: ULONG, phbc: *mut HCSBC) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvRestoreRegisterComplete(hbc: HCSBC, hrRestoreState: HRESULT) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvRestoreRegisterThroughFile(hbc: HCSBC, pwszCheckPointFilePath: *const WCHAR, pwszLogPath: *const WCHAR, rgrstmap: *mut CSEDB_RSTMAPW, crstmap: LONG, pwszBackupLogPath: *const WCHAR, genLow: ULONG, genHigh: ULONG) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvRestoreRegisterW(hbc: HCSBC, pwszCheckPointFilePath: *const WCHAR, pwszLogPath: *const WCHAR, rgrstmap: *mut CSEDB_RSTMAPW, crstmap: LONG, pwszBackupLogPath: *const WCHAR, genLow: ULONG, genHigh: ULONG) -> HRESULT;
        #[library("certadm.dll")]
        extern fn CertSrvServerControlW(pwszServerName: *const WCHAR, dwControlFlags: DWORD, pcbOut: *mut DWORD, ppbOut: *mut *mut BYTE) -> HRESULT;
        extern fn FNCERTSRVBACKUPCLOSE(hbc: HCSBC) -> HRESULT;
        extern fn FNCERTSRVBACKUPEND(hbc: HCSBC) -> HRESULT;
        extern fn FNCERTSRVBACKUPFREE(pv: *mut void);
        extern fn FNCERTSRVBACKUPGETBACKUPLOGSW(hbc: HCSBC, ppwszzBackupLogFiles: *mut *mut WCHAR, pcbSize: *mut DWORD) -> HRESULT;
        extern fn FNCERTSRVBACKUPGETDATABASENAMESW(hbc: HCSBC, ppwszzAttachmentInformation: *mut *mut WCHAR, pcbSize: *mut DWORD) -> HRESULT;
        extern fn FNCERTSRVBACKUPGETDYNAMICFILELISTW(hbc: HCSBC, ppwszzFileList: *mut *mut WCHAR, pcbSize: *mut DWORD) -> HRESULT;
        extern fn FNCERTSRVBACKUPOPENFILEW(hbc: HCSBC, pwszAttachmentName: *const WCHAR, cbReadHintSize: DWORD, pliFileSize: *mut LARGE_INTEGER) -> HRESULT;
        extern fn FNCERTSRVBACKUPPREPAREW(pwszServerName: *const WCHAR, grbitJet: ULONG, dwBackupFlags: ULONG, phbc: *mut HCSBC) -> HRESULT;
        extern fn FNCERTSRVBACKUPREAD(hbc: HCSBC, pvBuffer: *mut void, cbBuffer: DWORD, pcbRead: *mut DWORD) -> HRESULT;
        extern fn FNCERTSRVBACKUPTRUNCATELOGS(hbc: HCSBC) -> HRESULT;
        extern fn FNCERTSRVISSERVERONLINEW(pwszServerName: *const WCHAR, pfServerOnline: *mut BOOL) -> HRESULT;
        extern fn FNCERTSRVRESTOREEND(hbc: HCSBC) -> HRESULT;
        extern fn FNCERTSRVRESTOREGETDATABASELOCATIONSW(hbc: HCSBC, ppwszzDatabaseLocationList: *mut *mut WCHAR, pcbSize: *mut DWORD) -> HRESULT;
        extern fn FNCERTSRVRESTOREPREPAREW(pwszServerName: *const WCHAR, dwRestoreFlags: ULONG, phbc: *mut HCSBC) -> HRESULT;
        extern fn FNCERTSRVRESTOREREGISTERCOMPLETE(hbc: HCSBC, hrRestoreState: HRESULT) -> HRESULT;
        extern fn FNCERTSRVRESTOREREGISTERW(hbc: HCSBC, pwszCheckPointFilePath: *const WCHAR, pwszLogPath: *const WCHAR, rgrstmap: *mut CSEDB_RSTMAPW, crstmap: LONG, pwszBackupLogPath: *const WCHAR, genLow: ULONG, genHigh: ULONG) -> HRESULT;
        extern fn FNCERTSRVSERVERCONTROLW(pwszServerName: *const WCHAR, dwControlFlags: DWORD, pcbOut: *mut DWORD, ppbOut: *mut *mut BYTE) -> HRESULT;
        type HCSBC = *mut void;
        #[encoding("ansi")]
        const szBACKUPANNOTATION: String = "Cert Server Backup Interface";
        #[encoding("ansi")]
        const szRESTOREANNOTATION: String = "Cert Server Restore Interface";
        #[encoding("ansi")]
        const wszBACKUPANNOTATION: String = "Cert Server Backup Interface";
        #[encoding("ansi")]
        const wszRESTOREANNOTATION: String = "Cert Server Restore Interface";
    }
}
