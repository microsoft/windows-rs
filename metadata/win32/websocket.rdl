#[win32]
mod Windows {
    mod Win32 {
        type PWEB_SOCKET_ACTION = *mut WEB_SOCKET_ACTION;
        type PWEB_SOCKET_BUFFER = *mut WEB_SOCKET_BUFFER;
        type PWEB_SOCKET_HTTP_HEADER = *mut WEB_SOCKET_HTTP_HEADER;
        type PWEB_SOCKET_PROPERTY = *mut WEB_SOCKET_PROPERTY;
        #[repr(i32)]
        enum WEB_SOCKET_ACTION {
            WEB_SOCKET_NO_ACTION = 0,
            WEB_SOCKET_SEND_TO_NETWORK_ACTION = 1,
            WEB_SOCKET_INDICATE_SEND_COMPLETE_ACTION = 2,
            WEB_SOCKET_RECEIVE_FROM_NETWORK_ACTION = 3,
            WEB_SOCKET_INDICATE_RECEIVE_COMPLETE_ACTION = 4,
        }
        #[repr(i32)]
        enum WEB_SOCKET_ACTION_QUEUE {
            WEB_SOCKET_SEND_ACTION_QUEUE = 1,
            WEB_SOCKET_RECEIVE_ACTION_QUEUE = 2,
            WEB_SOCKET_ALL_ACTION_QUEUE = 3,
        }
        union WEB_SOCKET_BUFFER {
            Data: struct {
                #[writable(bytes(ulBufferLength))]
                pbBuffer: PBYTE,
                ulBufferLength: ULONG,
            },
            CloseStatus: struct {
                #[writable(bytes(ulReasonLength))]
                pbReason: PBYTE,
                ulReasonLength: ULONG,
                usStatus: USHORT,
            },
        }
        #[repr(i32)]
        enum WEB_SOCKET_BUFFER_TYPE {
            WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE = -2147483648,
            WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE = -2147483647,
            WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE = -2147483646,
            WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE = -2147483645,
            WEB_SOCKET_CLOSE_BUFFER_TYPE = -2147483644,
            WEB_SOCKET_PING_PONG_BUFFER_TYPE = -2147483643,
            WEB_SOCKET_UNSOLICITED_PONG_BUFFER_TYPE = -2147483642,
        }
        #[repr(i32)]
        enum WEB_SOCKET_CLOSE_STATUS {
            WEB_SOCKET_SUCCESS_CLOSE_STATUS = 1000,
            WEB_SOCKET_ENDPOINT_UNAVAILABLE_CLOSE_STATUS = 1001,
            WEB_SOCKET_PROTOCOL_ERROR_CLOSE_STATUS = 1002,
            WEB_SOCKET_INVALID_DATA_TYPE_CLOSE_STATUS = 1003,
            WEB_SOCKET_EMPTY_CLOSE_STATUS = 1005,
            WEB_SOCKET_ABORTED_CLOSE_STATUS = 1006,
            WEB_SOCKET_INVALID_PAYLOAD_CLOSE_STATUS = 1007,
            WEB_SOCKET_POLICY_VIOLATION_CLOSE_STATUS = 1008,
            WEB_SOCKET_MESSAGE_TOO_BIG_CLOSE_STATUS = 1009,
            WEB_SOCKET_UNSUPPORTED_EXTENSIONS_CLOSE_STATUS = 1010,
            WEB_SOCKET_SERVER_ERROR_CLOSE_STATUS = 1011,
            WEB_SOCKET_SECURE_HANDSHAKE_ERROR_CLOSE_STATUS = 1015,
        }
        type WEB_SOCKET_HANDLE = *mut WEB_SOCKET_HANDLE__;
        struct WEB_SOCKET_HANDLE__ {
            unused: i32,
        }
        struct WEB_SOCKET_HTTP_HEADER {
            pcName: PCHAR,
            ulNameLength: ULONG,
            pcValue: PCHAR,
            ulValueLength: ULONG,
        }
        const WEB_SOCKET_MAX_CLOSE_REASON_LENGTH: i32 = 123;
        struct WEB_SOCKET_PROPERTY {
            Type: WEB_SOCKET_PROPERTY_TYPE,
            pvValue: PVOID,
            ulValueSize: ULONG,
        }
        #[repr(i32)]
        enum WEB_SOCKET_PROPERTY_TYPE {
            WEB_SOCKET_RECEIVE_BUFFER_SIZE_PROPERTY_TYPE = 0,
            WEB_SOCKET_SEND_BUFFER_SIZE_PROPERTY_TYPE = 1,
            WEB_SOCKET_DISABLE_MASKING_PROPERTY_TYPE = 2,
            WEB_SOCKET_ALLOCATED_BUFFER_PROPERTY_TYPE = 3,
            WEB_SOCKET_DISABLE_UTF8_VERIFICATION_PROPERTY_TYPE = 4,
            WEB_SOCKET_KEEPALIVE_INTERVAL_PROPERTY_TYPE = 5,
            WEB_SOCKET_SUPPORTED_VERSIONS_PROPERTY_TYPE = 6,
        }
        #[library("websocket.dll")]
        extern fn WebSocketAbortHandle(#[in] hWebSocket: WEB_SOCKET_HANDLE);
        #[library("websocket.dll")]
        extern fn WebSocketBeginClientHandshake(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] #[opt] #[readable(entry, ulSubprotocolCount)] pszSubprotocols: *mut PCSTR, #[in] ulSubprotocolCount: ULONG, #[in] #[opt] #[readable(entry, ulExtensionCount)] pszExtensions: *mut PCSTR, #[in] ulExtensionCount: ULONG, #[in] #[opt] #[readable(entry, ulInitialHeaderCount)] pInitialHeaders: PWEB_SOCKET_HTTP_HEADER, #[in] ulInitialHeaderCount: ULONG, #[out] #[writable(entry, *pulAdditionalHeaderCount)] pAdditionalHeaders: *mut PWEB_SOCKET_HTTP_HEADER, #[out] pulAdditionalHeaderCount: *mut ULONG) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketBeginServerHandshake(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] #[opt] pszSubprotocolSelected: PCSTR, #[in] #[opt] #[readable(entry, ulExtensionSelectedCount)] pszExtensionSelected: *mut PCSTR, #[in] ulExtensionSelectedCount: ULONG, #[in] #[readable(entry, ulRequestHeaderCount)] pRequestHeaders: PWEB_SOCKET_HTTP_HEADER, #[in] ulRequestHeaderCount: ULONG, #[out] #[writable(entry, *pulResponseHeaderCount)] pResponseHeaders: *mut PWEB_SOCKET_HTTP_HEADER, #[out] pulResponseHeaderCount: *mut ULONG) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketCompleteAction(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] pvActionContext: PVOID, #[in] ulBytesTransferred: ULONG);
        #[library("websocket.dll")]
        extern fn WebSocketCreateClientHandle(#[in] #[readable(entry, ulPropertyCount)] pProperties: PWEB_SOCKET_PROPERTY, #[in] ulPropertyCount: ULONG, #[out] phWebSocket: *mut WEB_SOCKET_HANDLE) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketCreateServerHandle(#[in] #[readable(entry, ulPropertyCount)] pProperties: PWEB_SOCKET_PROPERTY, #[in] ulPropertyCount: ULONG, #[out] phWebSocket: *mut WEB_SOCKET_HANDLE) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketDeleteHandle(#[in] hWebSocket: WEB_SOCKET_HANDLE);
        #[library("websocket.dll")]
        extern fn WebSocketEndClientHandshake(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] #[readable(entry, ulReponseHeaderCount)] pResponseHeaders: PWEB_SOCKET_HTTP_HEADER, #[in] ulReponseHeaderCount: ULONG, #[in] #[opt] #[out] #[readable(entry, if_present(*pulSelectedExtensionCount))] #[readable(success, if_present(*pulSelectedExtensionCount))] #[writable(entry, if_present(*pulSelectedExtensionCount))] pulSelectedExtensions: *mut ULONG, #[in] #[opt] #[out] pulSelectedExtensionCount: *mut ULONG, #[in] #[opt] #[out] pulSelectedSubprotocol: *mut ULONG) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketEndServerHandshake(#[in] hWebSocket: WEB_SOCKET_HANDLE) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketGetAction(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] eActionQueue: WEB_SOCKET_ACTION_QUEUE, #[in] #[out] #[readable(entry, *pulDataBufferCount)] #[readable(success, *pulDataBufferCount)] #[writable(entry, *pulDataBufferCount)] pDataBuffers: *mut WEB_SOCKET_BUFFER, #[in] #[out] pulDataBufferCount: *mut ULONG, #[out] pAction: *mut WEB_SOCKET_ACTION, #[out] pBufferType: *mut WEB_SOCKET_BUFFER_TYPE, #[opt] #[out] pvApplicationContext: *mut PVOID, #[out] pvActionContext: *mut PVOID) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketGetGlobalProperty(#[in] eType: WEB_SOCKET_PROPERTY_TYPE, #[in] #[out] #[readable(entry, *ulSize)] #[readable(success, *ulSize)] #[writable(entry, *ulSize)] pvValue: PVOID, #[in] #[out] ulSize: *mut ULONG) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketReceive(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] #[opt] pBuffer: *mut WEB_SOCKET_BUFFER, #[in] #[opt] pvContext: PVOID) -> HRESULT;
        #[library("websocket.dll")]
        extern fn WebSocketSend(#[in] hWebSocket: WEB_SOCKET_HANDLE, #[in] BufferType: WEB_SOCKET_BUFFER_TYPE, #[in] #[opt] pBuffer: *mut WEB_SOCKET_BUFFER, #[in] #[opt] Context: PVOID) -> HRESULT;
    }
}
