        extern fn WinBioEnumEnrollments(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] UnitId: WINBIO_UNIT_ID, #[in] Identity: *mut WINBIO_IDENTITY, #[out] #[writable(success, if_present(*SubFactorCount), indirect, nullable)] SubFactorArray: *mut *mut WINBIO_BIOMETRIC_SUBTYPE, #[out] #[opt] SubFactorCount: *mut SIZE_T) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnumServiceProviders(#[in] Factor: WINBIO_BIOMETRIC_TYPE, #[out] #[writable(success, *BspCount, indirect)] BspSchemaArray: *mut *mut WINBIO_BSP_SCHEMA, #[out] BspCount: *mut SIZE_T) -> HRESULT;
