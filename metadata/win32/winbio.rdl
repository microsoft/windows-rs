#[win32]
mod Windows {
    mod Win32 {
        extern fn PWINBIO_ASYNC_COMPLETION_CALLBACK(#[in] AsyncResult: PWINBIO_ASYNC_RESULT);
        type PWINBIO_ASYNC_NOTIFICATION_METHOD = *mut WINBIO_ASYNC_NOTIFICATION_METHOD;
        type PWINBIO_ASYNC_RESULT = *mut WINBIO_ASYNC_RESULT;
        extern fn PWINBIO_CAPTURE_CALLBACK(#[in] #[opt] CaptureCallbackContext: PVOID, #[in] OperationStatus: HRESULT, #[in] UnitId: WINBIO_UNIT_ID, #[in] #[readable(entry, bytes(SampleSize))] Sample: PWINBIO_BIR, #[in] SampleSize: SIZE_T, #[in] RejectDetail: WINBIO_REJECT_DETAIL);
        extern fn PWINBIO_ENROLL_CAPTURE_CALLBACK(#[in] #[opt] EnrollCallbackContext: PVOID, #[in] OperationStatus: HRESULT, #[in] RejectDetail: WINBIO_REJECT_DETAIL);
        extern fn PWINBIO_EVENT_CALLBACK(#[in] #[opt] EventCallbackContext: PVOID, #[in] OperationStatus: HRESULT, #[in] Event: PWINBIO_EVENT);
        extern fn PWINBIO_IDENTIFY_CALLBACK(#[in] #[opt] IdentifyCallbackContext: PVOID, #[in] OperationStatus: HRESULT, #[in] UnitId: WINBIO_UNIT_ID, #[in] Identity: *mut WINBIO_IDENTITY, #[in] SubFactor: WINBIO_BIOMETRIC_SUBTYPE, #[in] RejectDetail: WINBIO_REJECT_DETAIL);
        extern fn PWINBIO_LOCATE_SENSOR_CALLBACK(#[in] #[opt] LocateCallbackContext: PVOID, #[in] OperationStatus: HRESULT, #[in] UnitId: WINBIO_UNIT_ID);
        extern fn PWINBIO_VERIFY_CALLBACK(#[in] #[opt] VerifyCallbackContext: PVOID, #[in] OperationStatus: HRESULT, #[in] UnitId: WINBIO_UNIT_ID, #[in] Match: BOOLEAN, #[in] RejectDetail: WINBIO_REJECT_DETAIL);
        #[repr(i32)]
        enum WINBIO_ASYNC_NOTIFICATION_METHOD {
            WINBIO_ASYNC_NOTIFY_NONE = 0,
            WINBIO_ASYNC_NOTIFY_CALLBACK = 1,
            WINBIO_ASYNC_NOTIFY_MESSAGE = 2,
            WINBIO_ASYNC_NOTIFY_MAXIMUM_VALUE = 3,
        }
        struct WINBIO_ASYNC_RESULT {
            SessionHandle: WINBIO_SESSION_HANDLE,
            Operation: WINBIO_OPERATION_TYPE,
            SequenceNumber: ULONGLONG,
            TimeStamp: LONGLONG,
            ApiStatus: HRESULT,
            UnitId: WINBIO_UNIT_ID,
            UserData: PVOID,
            Parameters: union {
                Verify: struct {
                    Match: BOOLEAN,
                    RejectDetail: WINBIO_REJECT_DETAIL,
                },
                Identify: struct {
                    Identity: WINBIO_IDENTITY,
                    SubFactor: WINBIO_BIOMETRIC_SUBTYPE,
                    RejectDetail: WINBIO_REJECT_DETAIL,
                },
                EnrollBegin: struct {
                    SubFactor: WINBIO_BIOMETRIC_SUBTYPE,
                },
                EnrollCapture: struct {
                    RejectDetail: WINBIO_REJECT_DETAIL,
                },
                EnrollCommit: struct {
                    Identity: WINBIO_IDENTITY,
                    IsNewTemplate: BOOLEAN,
                },
                EnumEnrollments: struct {
                    Identity: WINBIO_IDENTITY,
                    SubFactorCount: SIZE_T,
                    SubFactorArray: *mut WINBIO_BIOMETRIC_SUBTYPE,
                },
                CaptureSample: struct {
                    Sample: PWINBIO_BIR,
                    SampleSize: SIZE_T,
                    RejectDetail: WINBIO_REJECT_DETAIL,
                },
                DeleteTemplate: struct {
                    Identity: WINBIO_IDENTITY,
                    SubFactor: WINBIO_BIOMETRIC_SUBTYPE,
                },
                GetProperty: struct {
                    PropertyType: WINBIO_PROPERTY_TYPE,
                    PropertyId: WINBIO_PROPERTY_ID,
                    Identity: WINBIO_IDENTITY,
                    SubFactor: WINBIO_BIOMETRIC_SUBTYPE,
                    PropertyBufferSize: SIZE_T,
                    PropertyBuffer: PVOID,
                },
                SetProperty: struct {
                    PropertyType: WINBIO_PROPERTY_TYPE,
                    PropertyId: WINBIO_PROPERTY_ID,
                    Identity: WINBIO_IDENTITY,
                    SubFactor: WINBIO_BIOMETRIC_SUBTYPE,
                    PropertyBufferSize: SIZE_T,
                    PropertyBuffer: PVOID,
                },
                GetEvent: struct {
                    Event: WINBIO_EVENT,
                },
                ControlUnit: struct {
                    Component: WINBIO_COMPONENT,
                    ControlCode: ULONG,
                    OperationStatus: ULONG,
                    SendBuffer: PUCHAR,
                    SendBufferSize: SIZE_T,
                    ReceiveBuffer: PUCHAR,
                    ReceiveBufferSize: SIZE_T,
                    ReceiveDataSize: SIZE_T,
                },
                EnumServiceProviders: struct {
                    BspCount: SIZE_T,
                    BspSchemaArray: *mut WINBIO_BSP_SCHEMA,
                },
                EnumBiometricUnits: struct {
                    UnitCount: SIZE_T,
                    UnitSchemaArray: *mut WINBIO_UNIT_SCHEMA,
                },
                EnumDatabases: struct {
                    StorageCount: SIZE_T,
                    StorageSchemaArray: *mut WINBIO_STORAGE_SCHEMA,
                },
                VerifyAndReleaseTicket: struct {
                    Match: BOOLEAN,
                    RejectDetail: WINBIO_REJECT_DETAIL,
                    Ticket: WINBIO_PROTECTION_TICKET,
                },
                IdentifyAndReleaseTicket: struct {
                    Identity: WINBIO_IDENTITY,
                    SubFactor: WINBIO_BIOMETRIC_SUBTYPE,
                    RejectDetail: WINBIO_REJECT_DETAIL,
                    Ticket: WINBIO_PROTECTION_TICKET,
                },
                EnrollSelect: struct {
                    SelectorValue: ULONGLONG,
                },
                MonitorPresence: struct {
                    ChangeType: WINBIO_PRESENCE_CHANGE,
                    PresenceCount: SIZE_T,
                    PresenceArray: *mut WINBIO_PRESENCE,
                },
                GetProtectionPolicy: struct {
                    Identity: WINBIO_IDENTITY,
                    Policy: WINBIO_PROTECTION_POLICY,
                },
                NotifyUnitStatusChange: struct {
                    ExtendedStatus: WINBIO_EXTENDED_UNIT_STATUS,
                },
            },
        }
