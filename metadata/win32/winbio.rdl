        extern fn WinBioEnrollBegin(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] SubFactor: WINBIO_BIOMETRIC_SUBTYPE, #[in] UnitId: WINBIO_UNIT_ID) -> HRESULT;
