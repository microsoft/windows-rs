        #[library("winbio.dll")]
        extern fn WinBioAsyncOpenFramework(#[in] NotificationMethod: WINBIO_ASYNC_NOTIFICATION_METHOD, #[in] #[opt] TargetWindow: HWND, #[in] #[opt] MessageCode: UINT, #[in] #[opt] CallbackRoutine: PWINBIO_ASYNC_COMPLETION_CALLBACK, #[in] #[opt] UserData: PVOID, #[in] AsynchronousOpen: BOOL, #[out] #[opt] FrameworkHandle: *mut WINBIO_FRAMEWORK_HANDLE) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioAsyncOpenSession(#[in] Factor: WINBIO_BIOMETRIC_TYPE, #[in] PoolType: WINBIO_POOL_TYPE, #[in] Flags: WINBIO_SESSION_FLAGS, #[in] #[opt] #[readable(entry, UnitCount)] UnitArray: *mut WINBIO_UNIT_ID, #[in] #[opt] UnitCount: SIZE_T, #[in] #[opt] DatabaseId: *mut GUID, #[in] NotificationMethod: WINBIO_ASYNC_NOTIFICATION_METHOD, #[in] #[opt] TargetWindow: HWND, #[in] #[opt] MessageCode: UINT, #[in] #[opt] CallbackRoutine: PWINBIO_ASYNC_COMPLETION_CALLBACK, #[in] #[opt] UserData: PVOID, #[in] AsynchronousOpen: BOOL, #[out] #[opt] SessionHandle: *mut WINBIO_SESSION_HANDLE) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioCancel(#[in] SessionHandle: WINBIO_SESSION_HANDLE) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioCaptureSample(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] Purpose: WINBIO_BIR_PURPOSE, #[in] Flags: WINBIO_BIR_DATA_FLAGS, #[out] #[opt] UnitId: *mut WINBIO_UNIT_ID, #[out] #[writable(success, bytes(if_present(*SampleSize)), indirect, nullable)] Sample: *mut PWINBIO_BIR, #[out] #[opt] SampleSize: *mut SIZE_T, #[out] #[opt] RejectDetail: *mut WINBIO_REJECT_DETAIL) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioCaptureSampleWithCallback(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] Purpose: WINBIO_BIR_PURPOSE, #[in] Flags: WINBIO_BIR_DATA_FLAGS, #[in] CaptureCallback: PWINBIO_CAPTURE_CALLBACK, #[in] #[opt] CaptureCallbackContext: PVOID) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioCloseFramework(#[in] FrameworkHandle: WINBIO_FRAMEWORK_HANDLE) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioCloseSession(#[in] SessionHandle: WINBIO_SESSION_HANDLE) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioControlUnit(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] UnitId: WINBIO_UNIT_ID, #[in] Component: WINBIO_COMPONENT, #[in] ControlCode: ULONG, #[in] #[readable(entry, bytes(SendBufferSize))] SendBuffer: PUCHAR, #[in] SendBufferSize: SIZE_T, #[out] #[writable(entry, bytes(ReceiveBufferSize))] #[readable(success, bytes(*ReceiveDataSize))] ReceiveBuffer: PUCHAR, #[in] ReceiveBufferSize: SIZE_T, #[Windows::Win32::Metadata::NativeSal("2", "_Out_range_", "<=,ReceiveBufferSize", "<=,ReceiveBufferSize")] ReceiveDataSize: *mut SIZE_T, #[out] #[opt] OperationStatus: *mut ULONG) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioControlUnitPrivileged(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] UnitId: WINBIO_UNIT_ID, #[in] Component: WINBIO_COMPONENT, #[in] ControlCode: ULONG, #[in] #[readable(entry, bytes(SendBufferSize))] SendBuffer: PUCHAR, #[in] SendBufferSize: SIZE_T, #[out] #[writable(entry, bytes(ReceiveBufferSize))] #[readable(success, bytes(*ReceiveDataSize))] ReceiveBuffer: PUCHAR, #[in] ReceiveBufferSize: SIZE_T, #[Windows::Win32::Metadata::NativeSal("2", "_Out_range_", "<=,ReceiveBufferSize", "<=,ReceiveBufferSize")] ReceiveDataSize: *mut SIZE_T, #[out] #[opt] OperationStatus: *mut ULONG) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioDeleteTemplate(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] UnitId: WINBIO_UNIT_ID, #[in] Identity: *mut WINBIO_IDENTITY, #[in] SubFactor: WINBIO_BIOMETRIC_SUBTYPE) -> HRESULT;
