        extern fn WinBioEnrollCapture(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[out] #[opt] RejectDetail: *mut WINBIO_REJECT_DETAIL) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnrollCaptureWithCallback(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] EnrollCallback: PWINBIO_ENROLL_CAPTURE_CALLBACK, #[in] #[opt] EnrollCallbackContext: PVOID) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnrollCommit(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[out] #[opt] Identity: *mut WINBIO_IDENTITY, #[out] #[opt] IsNewTemplate: *mut BOOLEAN) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnrollDiscard(#[in] SessionHandle: WINBIO_SESSION_HANDLE) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnrollSelect(#[in] SessionHandle: WINBIO_SESSION_HANDLE, #[in] SelectorValue: ULONGLONG) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnumBiometricUnits(#[in] Factor: WINBIO_BIOMETRIC_TYPE, #[out] #[writable(success, *UnitCount, indirect)] UnitSchemaArray: *mut *mut WINBIO_UNIT_SCHEMA, #[out] UnitCount: *mut SIZE_T) -> HRESULT;
        #[library("winbio.dll")]
        extern fn WinBioEnumDatabases(#[in] Factor: WINBIO_BIOMETRIC_TYPE, #[out] #[writable(success, *StorageCount, indirect)] StorageSchemaArray: *mut *mut WINBIO_STORAGE_SCHEMA, #[out] StorageCount: *mut SIZE_T) -> HRESULT;
