#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum ALLOC_CONSOLE_MODE {
            ALLOC_CONSOLE_MODE_DEFAULT = 0,
            ALLOC_CONSOLE_MODE_NEW_WINDOW = 1,
            ALLOC_CONSOLE_MODE_NO_WINDOW = 2,
        }
        struct ALLOC_CONSOLE_OPTIONS {
            mode: ALLOC_CONSOLE_MODE,
            useShowWindow: BOOL,
            showWindow: WORD,
        }
        #[repr(i32)]
        enum ALLOC_CONSOLE_RESULT {
            ALLOC_CONSOLE_RESULT_NO_CONSOLE = 0,
            ALLOC_CONSOLE_RESULT_NEW_CONSOLE = 1,
            ALLOC_CONSOLE_RESULT_EXISTING_CONSOLE = 2,
        }
        const ATTACH_PARENT_PROCESS: DWORD = 4294967295;
        #[library("KERNEL32.dll")]
        extern fn AllocConsole() -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn AllocConsoleWithOptions(#[in] #[opt] options: PALLOC_CONSOLE_OPTIONS, #[out] #[opt] result: PALLOC_CONSOLE_RESULT) -> HRESULT;
        #[library("KERNEL32.dll")]
        extern fn AttachConsole(#[in] dwProcessId: DWORD) -> BOOL;
        struct CONSOLE_READCONSOLE_CONTROL {
            nLength: ULONG,
            nInitialChars: ULONG,
            dwCtrlWakeupMask: ULONG,
            dwControlKeyState: ULONG,
        }
        const CTRL_BREAK_EVENT: i32 = 1;
        const CTRL_CLOSE_EVENT: i32 = 2;
        const CTRL_C_EVENT: i32 = 0;
        const CTRL_LOGOFF_EVENT: i32 = 5;
        const CTRL_SHUTDOWN_EVENT: i32 = 6;
        #[library("KERNEL32.dll")]
        extern fn ClosePseudoConsole(#[in] hPC: HPCON);
        #[library("KERNEL32.dll")]
        extern fn CreatePseudoConsole(#[in] size: COORD, #[in] hInput: HANDLE, #[in] hOutput: HANDLE, #[in] dwFlags: DWORD, #[out] phPC: *mut HPCON) -> HRESULT;
        const DISABLE_NEWLINE_AUTO_RETURN: i32 = 8;
        const ENABLE_AUTO_POSITION: i32 = 256;
        const ENABLE_ECHO_INPUT: i32 = 4;
        const ENABLE_EXTENDED_FLAGS: i32 = 128;
        const ENABLE_INSERT_MODE: i32 = 32;
        const ENABLE_LINE_INPUT: i32 = 2;
        const ENABLE_LVB_GRID_WORLDWIDE: i32 = 16;
        const ENABLE_MOUSE_INPUT: i32 = 16;
        const ENABLE_PROCESSED_INPUT: i32 = 1;
        const ENABLE_PROCESSED_OUTPUT: i32 = 1;
        const ENABLE_QUICK_EDIT_MODE: i32 = 64;
        const ENABLE_VIRTUAL_TERMINAL_INPUT: i32 = 512;
        const ENABLE_VIRTUAL_TERMINAL_PROCESSING: i32 = 4;
        const ENABLE_WINDOW_INPUT: i32 = 8;
        const ENABLE_WRAP_AT_EOL_OUTPUT: i32 = 2;
        #[library("KERNEL32.dll")]
        extern fn FreeConsole() -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleCP() -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleMode(#[in] hConsoleHandle: HANDLE, #[out] lpMode: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetConsoleOutputCP() -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetNumberOfConsoleInputEvents(#[in] hConsoleInput: HANDLE, #[out] lpNumberOfEvents: LPDWORD) -> BOOL;
        type PALLOC_CONSOLE_OPTIONS = *mut ALLOC_CONSOLE_OPTIONS;
        type PALLOC_CONSOLE_RESULT = *mut ALLOC_CONSOLE_RESULT;
        type PCONSOLE_READCONSOLE_CONTROL = *mut CONSOLE_READCONSOLE_CONTROL;
        extern fn PHANDLER_ROUTINE(#[in] CtrlType: DWORD) -> BOOL;
        const PSEUDOCONSOLE_INHERIT_CURSOR: i32 = 1;
        #[library("KERNEL32.dll")]
        extern fn PeekConsoleInputA(#[in] hConsoleInput: HANDLE, #[out] #[writable(entry, nLength)] lpBuffer: PINPUT_RECORD, #[in] nLength: DWORD, #[out] lpNumberOfEventsRead: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn PeekConsoleInputW(#[in] hConsoleInput: HANDLE, #[out] #[writable(entry, nLength)] lpBuffer: PINPUT_RECORD, #[in] nLength: DWORD, #[out] lpNumberOfEventsRead: LPDWORD) -> BOOL;
        #[success(return != 0)]
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleA(#[in] hConsoleInput: HANDLE, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_to_", "nNumberOfCharsToRead * sizeof(CHAR),*lpNumberOfCharsRead * sizeof(TCHAR%)", "nNumberOfCharsToRead * sizeof(CHAR),*lpNumberOfCharsRead * sizeof(TCHAR%)")] #[out] lpBuffer: LPVOID, #[in] nNumberOfCharsToRead: DWORD, #[out] #[range(success, <=nNumberOfCharsToRead, indirect)] lpNumberOfCharsRead: LPDWORD, #[in] #[opt] pInputControl: PCONSOLE_READCONSOLE_CONTROL) -> BOOL;
        #[success(return != 0)]
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleInputA(#[in] hConsoleInput: HANDLE, #[out] #[writable(entry, nLength)] #[readable(success, *lpNumberOfEventsRead)] lpBuffer: PINPUT_RECORD, #[in] nLength: DWORD, #[out] #[range(success, <=nLength, indirect)] lpNumberOfEventsRead: LPDWORD) -> BOOL;
        #[success(return != 0)]
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleInputW(#[in] hConsoleInput: HANDLE, #[out] #[writable(entry, nLength)] #[readable(success, *lpNumberOfEventsRead)] lpBuffer: PINPUT_RECORD, #[in] nLength: DWORD, #[out] #[range(success, <=nLength, indirect)] lpNumberOfEventsRead: LPDWORD) -> BOOL;
        #[success(return != 0)]
        #[library("KERNEL32.dll")]
        extern fn ReadConsoleW(#[in] hConsoleInput: HANDLE, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_to_", "nNumberOfCharsToRead * sizeof(WCHAR),*lpNumberOfCharsRead * sizeof(TCHAR%)", "nNumberOfCharsToRead * sizeof(WCHAR),*lpNumberOfCharsRead * sizeof(TCHAR%)")] #[out] lpBuffer: LPVOID, #[in] nNumberOfCharsToRead: DWORD, #[out] #[range(success, <=nNumberOfCharsToRead, indirect)] lpNumberOfCharsRead: LPDWORD, #[in] #[opt] pInputControl: PCONSOLE_READCONSOLE_CONTROL) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ReleasePseudoConsole(#[in] hPC: HPCON) -> HRESULT;
        #[library("KERNEL32.dll")]
        extern fn ResizePseudoConsole(#[in] hPC: HPCON, #[in] size: COORD) -> HRESULT;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleCtrlHandler(#[in] #[opt] HandlerRoutine: PHANDLER_ROUTINE, #[in] Add: BOOL) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetConsoleMode(#[in] hConsoleHandle: HANDLE, #[in] dwMode: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleA(#[in] hConsoleOutput: HANDLE, #[in] #[readable(entry, nNumberOfCharsToWrite)] lpBuffer: *const void, #[in] nNumberOfCharsToWrite: DWORD, #[out] #[opt] lpNumberOfCharsWritten: LPDWORD, #[reserved] lpReserved: LPVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WriteConsoleW(#[in] hConsoleOutput: HANDLE, #[in] #[readable(entry, nNumberOfCharsToWrite)] lpBuffer: *const void, #[in] nNumberOfCharsToWrite: DWORD, #[out] #[opt] lpNumberOfCharsWritten: LPDWORD, #[reserved] lpReserved: LPVOID) -> BOOL;
    }
}
