#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn QueryPerformanceCounter(#[out] lpPerformanceCount: *mut LARGE_INTEGER) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn QueryPerformanceFrequency(#[out] lpFrequency: *mut LARGE_INTEGER) -> BOOL;
    }
}
