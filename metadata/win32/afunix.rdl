#[win32]
mod Windows {
    mod Win32 {
        type PSOCKADDR_UN = *mut SOCKADDR_UN;
        const SIO_AF_UNIX_GETPEERPID: i32 = 1476395264;
        const SIO_AF_UNIX_SETBINDPARENTPATH: u32 = 2550137089;
        const SIO_AF_UNIX_SETCONNPARENTPATH: u32 = 2550137090;
        struct SOCKADDR_UN {
            sun_family: ADDRESS_FAMILY,
            sun_path: [i8; 108],
        }
        const UNIX_PATH_MAX: i32 = 108;
    }
}
