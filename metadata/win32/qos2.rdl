#[win32]
mod Windows {
    mod Win32 {
        type PQOS_FLOWID = *mut u32;
        type PQOS_FLOWRATE_OUTGOING = *mut QOS_FLOWRATE_OUTGOING;
        type PQOS_FLOWRATE_REASON = *mut QOS_FLOWRATE_REASON;
        type PQOS_FLOW_FUNDAMENTALS = *mut QOS_FLOW_FUNDAMENTALS;
        type PQOS_NOTIFY_FLOW = *mut QOS_NOTIFY_FLOW;
        type PQOS_PACKET_PRIORITY = *mut QOS_PACKET_PRIORITY;
        type PQOS_QUERY_FLOW = *mut QOS_QUERY_FLOW;
        type PQOS_SET_FLOW = *mut QOS_SET_FLOW;
        type PQOS_SHAPING = *mut QOS_SHAPING;
        type PQOS_TRAFFIC_TYPE = *mut QOS_TRAFFIC_TYPE;
        type PQOS_VERSION = *mut QOS_VERSION;
        #[library("qwave.dll")]
        extern fn QOSAddSocketToFlow(#[in] QOSHandle: HANDLE, #[in] Socket: SOCKET, #[in] #[opt] DestAddr: PSOCKADDR, #[in] TrafficType: QOS_TRAFFIC_TYPE, #[in] #[opt] Flags: DWORD, #[in] #[out] FlowId: PQOS_FLOWID) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSCancel(#[in] QOSHandle: HANDLE, #[in] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSCloseHandle(#[in] QOSHandle: HANDLE) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSCreateHandle(#[in] Version: PQOS_VERSION, #[out] QOSHandle: PHANDLE) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSEnumerateFlows(#[in] QOSHandle: HANDLE, #[in] #[out] Size: PULONG, #[out] #[writable(entry, bytes(*Size))] Buffer: PVOID) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSNotifyFlow(#[in] QOSHandle: HANDLE, #[in] FlowId: QOS_FLOWID, #[in] Operation: QOS_NOTIFY_FLOW, #[in] #[opt] #[out] Size: PULONG, #[in] #[opt] #[out] #[writable(entry, bytes(if_present(*Size)))] Buffer: PVOID, #[reserved] Flags: DWORD, #[opt] #[out] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSQueryFlow(#[in] QOSHandle: HANDLE, #[in] FlowId: QOS_FLOWID, #[in] Operation: QOS_QUERY_FLOW, #[in] #[out] Size: PULONG, #[out] #[writable(entry, bytes(*Size))] Buffer: PVOID, #[in] #[opt] Flags: DWORD, #[opt] #[out] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSRemoveSocketFromFlow(#[in] QOSHandle: HANDLE, #[in] #[opt] Socket: SOCKET, #[in] FlowId: QOS_FLOWID, #[reserved] Flags: DWORD) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSSetFlow(#[in] QOSHandle: HANDLE, #[in] FlowId: QOS_FLOWID, #[in] Operation: QOS_SET_FLOW, #[in] Size: ULONG, #[in] #[readable(entry, bytes(Size))] Buffer: PVOID, #[reserved] Flags: DWORD, #[opt] #[out] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSStartTrackingClient(#[in] QOSHandle: HANDLE, #[in] DestAddr: PSOCKADDR, #[reserved] Flags: DWORD) -> BOOL;
        #[library("qwave.dll")]
        extern fn QOSStopTrackingClient(#[in] QOSHandle: HANDLE, #[in] DestAddr: PSOCKADDR, #[reserved] Flags: DWORD) -> BOOL;
        type QOS_FLOWID = u32;
        struct QOS_FLOWRATE_OUTGOING {
            Bandwidth: UINT64,
            ShapingBehavior: QOS_SHAPING,
            Reason: QOS_FLOWRATE_REASON,
        }
        #[repr(i32)]
        enum QOS_FLOWRATE_REASON {
            QOSFlowRateNotApplicable = 0,
            QOSFlowRateContentChange = 1,
            QOSFlowRateCongestion = 2,
            QOSFlowRateHigherContentEncoding = 3,
            QOSFlowRateUserCaused = 4,
        }
        struct QOS_FLOW_FUNDAMENTALS {
            BottleneckBandwidthSet: BOOL,
            BottleneckBandwidth: UINT64,
            AvailableBandwidthSet: BOOL,
            AvailableBandwidth: UINT64,
            RTTSet: BOOL,
            RTT: UINT32,
        }
        const QOS_NON_ADAPTIVE_FLOW: i32 = 2;
        #[repr(i32)]
        enum QOS_NOTIFY_FLOW {
            QOSNotifyCongested = 0,
            QOSNotifyUncongested = 1,
            QOSNotifyAvailable = 2,
        }
        const QOS_OUTGOING_DEFAULT_MINIMUM_BANDWIDTH: u32 = 4294967295;
        struct QOS_PACKET_PRIORITY {
            ConformantDSCPValue: ULONG,
            NonConformantDSCPValue: ULONG,
            ConformantL2Value: ULONG,
            NonConformantL2Value: ULONG,
        }
        const QOS_QUERYFLOW_FRESH: i32 = 1;
        #[repr(i32)]
        enum QOS_QUERY_FLOW {
            QOSQueryFlowFundamentals = 0,
            QOSQueryPacketPriority = 1,
            QOSQueryOutgoingRate = 2,
        }
        #[repr(i32)]
        enum QOS_SET_FLOW {
            QOSSetTrafficType = 0,
            QOSSetOutgoingRate = 1,
            QOSSetOutgoingDSCPValue = 2,
        }
        #[repr(i32)]
        enum QOS_SHAPING {
            QOSShapeOnly = 0,
            QOSShapeAndMark = 1,
            QOSUseNonConformantMarkings = 2,
        }
        #[repr(i32)]
        enum QOS_TRAFFIC_TYPE {
            QOSTrafficTypeBestEffort = 0,
            QOSTrafficTypeBackground = 1,
            QOSTrafficTypeExcellentEffort = 2,
            QOSTrafficTypeAudioVideo = 3,
            QOSTrafficTypeVoice = 4,
            QOSTrafficTypeControl = 5,
        }
        struct QOS_VERSION {
            MajorVersion: USHORT,
            MinorVersion: USHORT,
        }
    }
}
