#[win32]
mod Windows {
    mod Win32 {
        struct FILE_EXTENT {
            VolumeOffset: ULONGLONG,
            ExtentLength: ULONGLONG,
        }
        const IOCTL_VOLUME_ALLOCATE_BC_STREAM: i32 = 5685312;
        const IOCTL_VOLUME_BC_VERSION: i32 = 1;
        const IOCTL_VOLUME_FREE_BC_STREAM: i32 = 5685316;
        const IOCTL_VOLUME_GET_BC_PROPERTIES: i32 = 5652540;
        const IOCTL_VOLUME_GET_CSVBLOCKCACHE_CALLBACK: i32 = 5685352;
        const IOCTL_VOLUME_IS_CSV: i32 = 5636192;
        const IOCTL_VOLUME_IS_DYNAMIC: i32 = 5636168;
        const IOCTL_VOLUME_IS_IO_CAPABLE: i32 = 5636116;
        const IOCTL_VOLUME_IS_OFFLINE: i32 = 5636112;
        const IOCTL_VOLUME_IS_PARTITION: i32 = 5636136;
        const IOCTL_VOLUME_LOGICAL_TO_PHYSICAL: i32 = 5636128;
        const IOCTL_VOLUME_PHYSICAL_TO_LOGICAL: i32 = 5636132;
        const IOCTL_VOLUME_POST_ONLINE: i32 = 5685348;
        const IOCTL_VOLUME_PREPARE_FOR_CRITICAL_IO: i32 = 5685324;
        const IOCTL_VOLUME_PREPARE_FOR_SHRINK: i32 = 5685340;
        const IOCTL_VOLUME_QUERY_ALLOCATION_HINT: i32 = 5652562;
        const IOCTL_VOLUME_QUERY_FAILOVER_SET: i32 = 5636120;
        const IOCTL_VOLUME_QUERY_MINIMUM_SHRINK_SIZE: i32 = 5652568;
        const IOCTL_VOLUME_QUERY_VOLUME_NUMBER: i32 = 5636124;
        const IOCTL_VOLUME_READ_PLEX: i32 = 5652526;
        const IOCTL_VOLUME_SET_GPT_ATTRIBUTES: i32 = 5636148;
        const IOCTL_VOLUME_SUPPORTS_ONLINE_OFFLINE: i32 = 5636100;
        const IOCTL_VOLUME_UPDATE_PROPERTIES: i32 = 5636180;
        type PFILE_EXTENT = *mut FILE_EXTENT;
        type PVOLUME_ALLOCATE_BC_STREAM_INPUT = *mut VOLUME_ALLOCATE_BC_STREAM_INPUT;
        type PVOLUME_ALLOCATE_BC_STREAM_OUTPUT = *mut VOLUME_ALLOCATE_BC_STREAM_OUTPUT;
        type PVOLUME_ALLOCATION_HINT_INPUT = *mut VOLUME_ALLOCATION_HINT_INPUT;
        type PVOLUME_ALLOCATION_HINT_OUTPUT = *mut VOLUME_ALLOCATION_HINT_OUTPUT;
        type PVOLUME_CRITICAL_IO = *mut VOLUME_CRITICAL_IO;
        type PVOLUME_FAILOVER_SET = *mut VOLUME_FAILOVER_SET;
        type PVOLUME_GET_BC_PROPERTIES_INPUT = *mut VOLUME_GET_BC_PROPERTIES_INPUT;
        type PVOLUME_GET_BC_PROPERTIES_OUTPUT = *mut VOLUME_GET_BC_PROPERTIES_OUTPUT;
        type PVOLUME_LOGICAL_OFFSET = *mut VOLUME_LOGICAL_OFFSET;
        type PVOLUME_NUMBER = *mut VOLUME_NUMBER;
        type PVOLUME_PHYSICAL_OFFSET = *mut VOLUME_PHYSICAL_OFFSET;
        type PVOLUME_PHYSICAL_OFFSETS = *mut VOLUME_PHYSICAL_OFFSETS;
        type PVOLUME_READ_PLEX_INPUT = *mut VOLUME_READ_PLEX_INPUT;
        type PVOLUME_SET_GPT_ATTRIBUTES_INFORMATION = *mut VOLUME_SET_GPT_ATTRIBUTES_INFORMATION;
        type PVOLUME_SHRINK_INFO = *mut VOLUME_SHRINK_INFO;
        struct VOLUME_ALLOCATE_BC_STREAM_INPUT {
            Version: ULONG,
            RequestsPerPeriod: ULONG,
            Period: ULONG,
            RetryFailures: BOOLEAN,
            Discardable: BOOLEAN,
            Reserved1: [BOOLEAN; 2],
            LowestByteOffset: ULONGLONG,
            HighestByteOffset: ULONGLONG,
            AccessType: ULONG,
            AccessMode: ULONG,
        }
        struct VOLUME_ALLOCATE_BC_STREAM_OUTPUT {
            RequestSize: ULONGLONG,
            NumOutStandingRequests: ULONG,
        }
        struct VOLUME_ALLOCATION_HINT_INPUT {
            ClusterSize: ULONG,
            NumberOfClusters: ULONG,
            StartingClusterNumber: LONGLONG,
        }
        struct VOLUME_ALLOCATION_HINT_OUTPUT {
            Bitmap: [ULONG; 1],
        }
        struct VOLUME_CRITICAL_IO {
            AccessType: ULONG,
            ExtentsCount: ULONG,
            Extents: [FILE_EXTENT; 1],
        }
        struct VOLUME_FAILOVER_SET {
            NumberOfDisks: ULONG,
            DiskNumbers: [ULONG; 1],
        }
        struct VOLUME_GET_BC_PROPERTIES_INPUT {
            Version: ULONG,
            Reserved1: ULONG,
            LowestByteOffset: ULONGLONG,
            HighestByteOffset: ULONGLONG,
            AccessType: ULONG,
            AccessMode: ULONG,
        }
        struct VOLUME_GET_BC_PROPERTIES_OUTPUT {
            MaximumRequestsPerPeriod: ULONG,
            MinimumPeriod: ULONG,
            MaximumRequestSize: ULONGLONG,
            EstimatedTimePerRequest: ULONG,
            NumOutStandingRequests: ULONG,
            RequestSize: ULONGLONG,
        }
        struct VOLUME_LOGICAL_OFFSET {
            LogicalOffset: LONGLONG,
        }
        struct VOLUME_NUMBER {
            VolumeNumber: ULONG,
            VolumeManagerName: [WCHAR; 8],
        }
        struct VOLUME_PHYSICAL_OFFSET {
            DiskNumber: ULONG,
            Offset: LONGLONG,
        }
        struct VOLUME_PHYSICAL_OFFSETS {
            NumberOfPhysicalOffsets: ULONG,
            PhysicalOffset: [VOLUME_PHYSICAL_OFFSET; 1],
        }
        struct VOLUME_READ_PLEX_INPUT {
            ByteOffset: LARGE_INTEGER,
            Length: ULONG,
            PlexNumber: ULONG,
        }
        struct VOLUME_SET_GPT_ATTRIBUTES_INFORMATION {
            GptAttributes: ULONGLONG,
            RevertOnClose: BOOLEAN,
            ApplyToAllConnectedVolumes: BOOLEAN,
            Reserved1: USHORT,
            Reserved2: ULONG,
        }
        struct VOLUME_SHRINK_INFO {
            VolumeSize: ULONGLONG,
        }
    }
}
