#[win32]
mod Windows {
    mod Win32 {
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn ChangeTimerQueueTimer(#[in] #[opt] TimerQueue: HANDLE, #[in] #[out] Timer: HANDLE, #[in] DueTime: ULONG, #[in] Period: ULONG) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn CreateTimerQueue() -> #[nullable] HANDLE;
        #[library("KERNEL32.dll")]
        extern fn CreateTimerQueueTimer(#[out] #[out_ptr] phNewTimer: PHANDLE, #[in] #[opt] TimerQueue: HANDLE, #[in] Callback: WAITORTIMERCALLBACK, #[in] #[opt] Parameter: PVOID, #[in] DueTime: DWORD, #[in] Period: DWORD, #[in] Flags: ULONG) -> BOOL;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn DeleteTimerQueue(#[in] TimerQueue: HANDLE) -> BOOL;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn DeleteTimerQueueEx(#[in] TimerQueue: HANDLE, #[in] #[opt] CompletionEvent: HANDLE) -> BOOL;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn DeleteTimerQueueTimer(#[in] #[opt] TimerQueue: HANDLE, #[in] Timer: HANDLE, #[in] #[opt] CompletionEvent: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn QueueUserWorkItem(#[in] Function: LPTHREAD_START_ROUTINE, #[in] #[opt] Context: PVOID, #[in] Flags: ULONG) -> BOOL;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn UnregisterWaitEx(#[in] WaitHandle: HANDLE, #[in] #[opt] CompletionEvent: HANDLE) -> BOOL;
    }
}
