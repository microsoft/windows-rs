            OLERENDER_NONE = 0,
            OLERENDER_DRAW = 1,
            OLERENDER_FORMAT = 2,
            OLERENDER_ASIS = 3,
        }
        #[repr(i32)]
        enum OLEUPDATE {
            OLEUPDATE_ALWAYS = 1,
            OLEUPDATE_ONCALL = 3,
        }
        #[packed(8)]
        struct OLEVERB {
            lVerb: LONG,
            lpszVerbName: LPOLESTR,
            fuFlags: DWORD,
            grfAttribs: DWORD,
        }
        #[repr(i32)]
        enum OLEVERBATTRIB {
            OLEVERBATTRIB_NEVERDIRTIES = 1,
            OLEVERBATTRIB_ONCONTAINERMENU = 2,
        }
        #[repr(i32)]
        enum OLEWHICHMK {
            OLEWHICHMK_CONTAINER = 1,
            OLEWHICHMK_OBJREL = 2,
            OLEWHICHMK_OBJFULL = 3,
        }
        type PLINKSRCDESCRIPTOR = *mut OBJECTDESCRIPTOR;
        type POBJECTDESCRIPTOR = *mut OBJECTDESCRIPTOR;
        type POLEUPDATE = *mut OLEUPDATE;
        const UPDFCACHE_ALL: DWORD = 2147483647;
        const UPDFCACHE_ALLBUTNODATACACHE: DWORD = 2147483646;
        const UPDFCACHE_IFBLANK: i32 = 16;
        const UPDFCACHE_IFBLANKORONSAVECACHE: i32 = 18;
        const UPDFCACHE_NODATACACHE: i32 = 1;
        const UPDFCACHE_NORMALCACHE: i32 = 8;
        const UPDFCACHE_ONLYIFBLANK: u32 = 2147483648;
        const UPDFCACHE_ONSAVECACHE: i32 = 2;
        const UPDFCACHE_ONSTOPCACHE: i32 = 4;
        #[repr(i32)]
        enum USERCLASSTYPE {
            USERCLASSTYPE_FULL = 1,
            USERCLASSTYPE_SHORT = 2,
            USERCLASSTYPE_APPNAME = 3,
        }
    }
}
