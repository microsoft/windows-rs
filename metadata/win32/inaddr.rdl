#[win32]
mod Windows {
    mod Win32 {
        struct IN_ADDR {
            S_un: union {
                S_un_b: struct {
                    s_b1: UCHAR,
                    s_b2: UCHAR,
                    s_b3: UCHAR,
                    s_b4: UCHAR,
                },
                S_un_w: struct {
                    s_w1: USHORT,
                    s_w2: USHORT,
                },
                S_addr: ULONG,
            },
        }
        type LPIN_ADDR = *mut IN_ADDR;
        type PIN_ADDR = *mut IN_ADDR;
    }
}
