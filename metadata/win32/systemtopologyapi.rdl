#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn GetNumaHighestNodeNumber(#[out] HighestNodeNumber: PULONG) -> BOOL;
        #[library("KERNEL32.dll")]
        #[success(return != 0)]
        extern fn GetNumaNodeProcessorMask2(#[in] NodeNumber: USHORT, #[opt] #[out] #[readable(success, *RequiredMaskCount)] #[writable(entry, ProcessorMaskCount)] ProcessorMasks: PGROUP_AFFINITY, #[in] ProcessorMaskCount: USHORT, #[out] RequiredMaskCount: PUSHORT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNumaNodeProcessorMaskEx(#[in] Node: USHORT, #[out] ProcessorMask: PGROUP_AFFINITY) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNumaProximityNodeEx(#[in] ProximityId: ULONG, #[out] NodeNumber: PUSHORT) -> BOOL;
    }
}
