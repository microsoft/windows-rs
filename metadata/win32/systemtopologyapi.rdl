#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn GetNumaHighestNodeNumber(#[out] HighestNodeNumber: PULONG) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNumaNodeProcessorMask2(NodeNumber: u16, #[len_param(2)] #[out] #[opt] ProcessorMasks: PGROUP_AFFINITY, ProcessorMaskCount: u16, #[out] RequiredMaskCount: PUSHORT) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNumaNodeProcessorMaskEx(Node: u16, #[out] ProcessorMask: PGROUP_AFFINITY) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNumaProximityNodeEx(ProximityId: u32, #[out] NodeNumber: PUSHORT) -> BOOL;
    }
}
