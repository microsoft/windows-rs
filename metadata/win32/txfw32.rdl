#[win32]
mod Windows {
    mod Win32 {
        type PGUID = *mut GUID;
        type PTXF_ID = *mut TXF_ID;
        type PTXF_LOG_RECORD_AFFECTED_FILE = *mut TXF_LOG_RECORD_AFFECTED_FILE;
        type PTXF_LOG_RECORD_BASE = *mut TXF_LOG_RECORD_BASE;
        type PTXF_LOG_RECORD_TRUNCATE = *mut TXF_LOG_RECORD_TRUNCATE;
        type PTXF_LOG_RECORD_WRITE = *mut TXF_LOG_RECORD_WRITE;
        const TXFS_MINIVERSION_COMMITTED_VIEW: i32 = 0;
        const TXFS_MINIVERSION_DEFAULT_VIEW: i32 = 65534;
        const TXFS_MINIVERSION_DIRTY_VIEW: i32 = 65535;
        struct TXF_ID {
            Anonymous: #[packed(4)] struct {
                LowPart: i64,
                HighPart: i64,
            },
        }
        struct TXF_LOG_RECORD_AFFECTED_FILE {
            Version: u16,
            RecordLength: u32,
            Flags: u32,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            FileNameLength: u32,
            FileNameByteOffsetInStructure: u32,
        }
        struct TXF_LOG_RECORD_BASE {
            Version: u16,
            RecordType: u16,
            RecordLength: u32,
        }
        const TXF_LOG_RECORD_GENERIC_TYPE_ABORT: i32 = 2;
        const TXF_LOG_RECORD_GENERIC_TYPE_COMMIT: i32 = 1;
        const TXF_LOG_RECORD_GENERIC_TYPE_DATA: i32 = 8;
        const TXF_LOG_RECORD_GENERIC_TYPE_PREPARE: i32 = 4;
        #[packed(4)]
        struct TXF_LOG_RECORD_TRUNCATE {
            Version: u16,
            RecordType: u16,
            RecordLength: u32,
            Flags: u32,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            NewFileSize: i64,
            FileNameLength: u32,
            FileNameByteOffsetInStructure: u32,
        }
        const TXF_LOG_RECORD_TYPE_AFFECTED_FILE: i32 = 4;
        const TXF_LOG_RECORD_TYPE_TRUNCATE: i32 = 2;
        const TXF_LOG_RECORD_TYPE_WRITE: i32 = 1;
        #[packed(4)]
        struct TXF_LOG_RECORD_WRITE {
            Version: u16,
            RecordType: u16,
            RecordLength: u32,
            Flags: u32,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            ByteOffsetInFile: i64,
            NumBytesWritten: u32,
            ByteOffsetInStructure: u32,
            FileNameLength: u32,
            FileNameByteOffsetInStructure: u32,
        }
        #[library("txfw32.dll")]
        extern fn TxfGetThreadMiniVersionForCreate(#[out] MiniVersion: PUSHORT);
        #[library("txfw32.dll")]
        extern fn TxfLogCreateFileReadContext(LogPath: PCWSTR, BeginningLsn: CLFS_LSN, EndingLsn: CLFS_LSN, TxfFileId: PTXF_ID, TxfLogContext: *mut *mut void) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogCreateRangeReadContext(LogPath: PCWSTR, BeginningLsn: CLFS_LSN, EndingLsn: CLFS_LSN, BeginningVirtualClock: PLARGE_INTEGER, EndingVirtualClock: PLARGE_INTEGER, RecordTypeMask: u32, TxfLogContext: *mut *mut void) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogDestroyReadContext(#[in] TxfLogContext: *mut void) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogReadRecords(#[in] TxfLogContext: *mut void, BufferLength: u32, #[size_param(1)] Buffer: *mut void, #[out] BytesUsed: PULONG, #[out] RecordCount: PULONG) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogRecordGetFileName(#[size_param(1)] #[in] RecordBuffer: *mut void, RecordBufferLengthInBytes: u32, #[size_param(3)] #[out] NameBuffer: PWSTR, #[in] #[out] NameBufferLengthInBytes: PULONG, #[out] #[opt] TxfId: PTXF_ID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogRecordGetGenericType(#[in] RecordBuffer: *mut void, RecordBufferLengthInBytes: u32, #[out] GenericType: PULONG, #[out] #[opt] VirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfReadMetadataInfo(FileHandle: HANDLE, #[out] TxfFileId: PTXF_ID, #[out] LastLsn: PCLFS_LSN, #[out] TransactionState: PULONG, #[out] LockingTransaction: PGUID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfSetThreadMiniVersionForCreate(MiniVersion: u16);
    }
}
