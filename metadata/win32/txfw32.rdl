#[win32]
mod Windows {
    mod Win32 {
        type PGUID = *mut GUID;
        type PTXF_ID = *mut TXF_ID;
        type PTXF_LOG_RECORD_AFFECTED_FILE = *mut TXF_LOG_RECORD_AFFECTED_FILE;
        type PTXF_LOG_RECORD_BASE = *mut TXF_LOG_RECORD_BASE;
        type PTXF_LOG_RECORD_TRUNCATE = *mut TXF_LOG_RECORD_TRUNCATE;
        type PTXF_LOG_RECORD_WRITE = *mut TXF_LOG_RECORD_WRITE;
        const TXFS_MINIVERSION_COMMITTED_VIEW: i32 = 0;
        const TXFS_MINIVERSION_DEFAULT_VIEW: i32 = 65534;
        const TXFS_MINIVERSION_DIRTY_VIEW: i32 = 65535;
        #[packed(4)]
        struct TXF_ID {
            Anonymous: #[packed(4)] struct {
                LowPart: LONGLONG,
                HighPart: LONGLONG,
            },
        }
        #[packed(4)]
        struct TXF_LOG_RECORD_AFFECTED_FILE {
            Version: USHORT,
            RecordLength: ULONG,
            Flags: ULONG,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            FileNameLength: ULONG,
            FileNameByteOffsetInStructure: ULONG,
        }
        #[packed(4)]
        struct TXF_LOG_RECORD_BASE {
            Version: USHORT,
            RecordType: USHORT,
            RecordLength: ULONG,
        }
        const TXF_LOG_RECORD_GENERIC_TYPE_ABORT: i32 = 2;
        const TXF_LOG_RECORD_GENERIC_TYPE_COMMIT: i32 = 1;
        const TXF_LOG_RECORD_GENERIC_TYPE_DATA: i32 = 8;
        const TXF_LOG_RECORD_GENERIC_TYPE_PREPARE: i32 = 4;
        #[packed(4)]
        struct TXF_LOG_RECORD_TRUNCATE {
            Version: USHORT,
            RecordType: USHORT,
            RecordLength: ULONG,
            Flags: ULONG,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            NewFileSize: LONGLONG,
            FileNameLength: ULONG,
            FileNameByteOffsetInStructure: ULONG,
        }
        const TXF_LOG_RECORD_TYPE_AFFECTED_FILE: i32 = 4;
        const TXF_LOG_RECORD_TYPE_TRUNCATE: i32 = 2;
        const TXF_LOG_RECORD_TYPE_WRITE: i32 = 1;
        #[packed(4)]
        struct TXF_LOG_RECORD_WRITE {
            Version: USHORT,
            RecordType: USHORT,
            RecordLength: ULONG,
            Flags: ULONG,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            ByteOffsetInFile: LONGLONG,
            NumBytesWritten: ULONG,
            ByteOffsetInStructure: ULONG,
            FileNameLength: ULONG,
            FileNameByteOffsetInStructure: ULONG,
        }
        #[library("txfw32.dll")]
        extern fn TxfGetThreadMiniVersionForCreate(#[out] MiniVersion: PUSHORT);
        #[library("txfw32.dll")]
        extern fn TxfLogCreateFileReadContext(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] LogPath: LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BeginningLsn: CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EndingLsn: CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] TxfFileId: PTXF_ID, #[out] #[Windows::Win32::Metadata::NativeReturnedPointer(MayBeNull = false, NullOnFailure = false)] TxfLogContext: *mut PVOID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogCreateRangeReadContext(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] LogPath: LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BeginningLsn: CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EndingLsn: CLFS_LSN, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BeginningVirtualClock: PLARGE_INTEGER, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] EndingVirtualClock: PLARGE_INTEGER, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] RecordTypeMask: ULONG, #[out] #[Windows::Win32::Metadata::NativeReturnedPointer(MayBeNull = false, NullOnFailure = false)] TxfLogContext: *mut PVOID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogDestroyReadContext(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] TxfLogContext: PVOID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogReadRecords(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] TxfLogContext: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] BufferLength: ULONG, #[out] #[size_param(1)] #[Windows::Win32::Metadata::NativeInitializedLength(CountParamIndex = 3, IsByteCount = true, Dereference = true)] Buffer: PVOID, #[out] BytesUsed: PULONG, #[out] RecordCount: PULONG) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogRecordGetFileName(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(1)] RecordBuffer: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] RecordBufferLengthInBytes: ULONG, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_bytes_", "*NameBufferLengthInBytes", "*NameBufferLengthInBytes")] #[out] NameBuffer: PWSTR, #[in] #[out] NameBufferLengthInBytes: PULONG, #[out] #[opt] TxfId: PTXF_ID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogRecordGetGenericType(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] RecordBuffer: PVOID, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] RecordBufferLengthInBytes: ULONG, #[out] GenericType: PULONG, #[out] #[opt] VirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfReadMetadataInfo(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] FileHandle: HANDLE, #[out] TxfFileId: PTXF_ID, #[out] LastLsn: PCLFS_LSN, #[out] TransactionState: PULONG, #[out] LockingTransaction: PGUID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfSetThreadMiniVersionForCreate(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] MiniVersion: USHORT);
    }
}
