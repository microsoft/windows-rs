#[win32]
mod Windows {
    mod Win32 {
        type PGUID = *mut GUID;
        type PTXF_ID = *mut TXF_ID;
        type PTXF_LOG_RECORD_AFFECTED_FILE = *mut TXF_LOG_RECORD_AFFECTED_FILE;
        type PTXF_LOG_RECORD_BASE = *mut TXF_LOG_RECORD_BASE;
        type PTXF_LOG_RECORD_TRUNCATE = *mut TXF_LOG_RECORD_TRUNCATE;
        type PTXF_LOG_RECORD_WRITE = *mut TXF_LOG_RECORD_WRITE;
        const TXFS_MINIVERSION_COMMITTED_VIEW: i32 = 0;
        const TXFS_MINIVERSION_DEFAULT_VIEW: i32 = 65534;
        const TXFS_MINIVERSION_DIRTY_VIEW: i32 = 65535;
        #[packed(4)]
        struct TXF_ID {
            Anonymous: #[packed(4)] struct {
                LowPart: LONGLONG,
                HighPart: LONGLONG,
            },
        }
        #[packed(4)]
        struct TXF_LOG_RECORD_AFFECTED_FILE {
            Version: USHORT,
            RecordLength: ULONG,
            Flags: ULONG,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            FileNameLength: ULONG,
            FileNameByteOffsetInStructure: ULONG,
        }
        #[packed(4)]
        struct TXF_LOG_RECORD_BASE {
            Version: USHORT,
            RecordType: USHORT,
            RecordLength: ULONG,
        }
        const TXF_LOG_RECORD_GENERIC_TYPE_ABORT: i32 = 2;
        const TXF_LOG_RECORD_GENERIC_TYPE_COMMIT: i32 = 1;
        const TXF_LOG_RECORD_GENERIC_TYPE_DATA: i32 = 8;
        const TXF_LOG_RECORD_GENERIC_TYPE_PREPARE: i32 = 4;
        #[packed(4)]
        struct TXF_LOG_RECORD_TRUNCATE {
            Version: USHORT,
            RecordType: USHORT,
            RecordLength: ULONG,
            Flags: ULONG,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            NewFileSize: LONGLONG,
            FileNameLength: ULONG,
            FileNameByteOffsetInStructure: ULONG,
        }
        const TXF_LOG_RECORD_TYPE_AFFECTED_FILE: i32 = 4;
        const TXF_LOG_RECORD_TYPE_TRUNCATE: i32 = 2;
        const TXF_LOG_RECORD_TYPE_WRITE: i32 = 1;
        #[packed(4)]
        struct TXF_LOG_RECORD_WRITE {
            Version: USHORT,
            RecordType: USHORT,
            RecordLength: ULONG,
            Flags: ULONG,
            TxfFileId: TXF_ID,
            KtmGuid: GUID,
            ByteOffsetInFile: LONGLONG,
            NumBytesWritten: ULONG,
            ByteOffsetInStructure: ULONG,
            FileNameLength: ULONG,
            FileNameByteOffsetInStructure: ULONG,
        }
        #[library("txfw32.dll")]
        extern fn TxfGetThreadMiniVersionForCreate(#[out] MiniVersion: PUSHORT);
        #[library("txfw32.dll")]
        extern fn TxfLogCreateFileReadContext(#[in] LogPath: LPCWSTR, #[in] BeginningLsn: CLFS_LSN, #[in] EndingLsn: CLFS_LSN, #[in] TxfFileId: PTXF_ID, #[out] #[out_ptr] TxfLogContext: *mut PVOID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogCreateRangeReadContext(#[in] LogPath: LPCWSTR, #[in] BeginningLsn: CLFS_LSN, #[in] EndingLsn: CLFS_LSN, #[in] BeginningVirtualClock: PLARGE_INTEGER, #[in] EndingVirtualClock: PLARGE_INTEGER, #[in] RecordTypeMask: ULONG, #[out] #[out_ptr] TxfLogContext: *mut PVOID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogDestroyReadContext(#[in] TxfLogContext: PVOID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogReadRecords(#[in] TxfLogContext: PVOID, #[in] BufferLength: ULONG, #[out] #[writable(entry, bytes(BufferLength))] #[readable(success, bytes(*BytesUsed))] Buffer: PVOID, #[out] BytesUsed: PULONG, #[out] RecordCount: PULONG) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogRecordGetFileName(#[in] #[readable(entry, bytes(RecordBufferLengthInBytes))] RecordBuffer: PVOID, #[in] RecordBufferLengthInBytes: ULONG, #[out] #[writable(entry, bytes(*NameBufferLengthInBytes))] NameBuffer: PWSTR, #[in] #[out] NameBufferLengthInBytes: PULONG, #[out] #[opt] TxfId: PTXF_ID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfLogRecordGetGenericType(#[in] RecordBuffer: PVOID, #[in] RecordBufferLengthInBytes: ULONG, #[out] GenericType: PULONG, #[out] #[opt] VirtualClock: PLARGE_INTEGER) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfReadMetadataInfo(#[in] FileHandle: HANDLE, #[out] TxfFileId: PTXF_ID, #[out] LastLsn: PCLFS_LSN, #[out] TransactionState: PULONG, #[out] LockingTransaction: PGUID) -> BOOL;
        #[library("txfw32.dll")]
        extern fn TxfSetThreadMiniVersionForCreate(#[in] MiniVersion: USHORT);
    }
}
