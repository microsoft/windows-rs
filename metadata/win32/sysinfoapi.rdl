#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum COMPUTER_NAME_FORMAT {
            ComputerNameNetBIOS = 0,
            ComputerNameDnsHostname = 1,
            ComputerNameDnsDomain = 2,
            ComputerNameDnsFullyQualified = 3,
            ComputerNamePhysicalNetBIOS = 4,
            ComputerNamePhysicalDnsHostname = 5,
            ComputerNamePhysicalDnsDomain = 6,
            ComputerNamePhysicalDnsFullyQualified = 7,
            ComputerNameMax = 8,
        }
        #[repr(i32)]
        enum DEVELOPER_DRIVE_ENABLEMENT_STATE {
            DeveloperDriveEnablementStateError = 0,
            DeveloperDriveEnabled = 1,
            DeveloperDriveDisabledBySystemPolicy = 2,
            DeveloperDriveDisabledByGroupPolicy = 3,
        }
        #[library("KERNEL32.dll")]
        extern fn DnsHostnameToComputerNameExW(#[in] Hostname: LPCWSTR, #[buffer(*nSize)] #[opt] #[out] ComputerName: LPWSTR, #[in] #[out] nSize: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn EnumSystemFirmwareTables(#[in] FirmwareTableProviderSignature: DWORD, #[buffer(bytes(BufferSize))] #[incomplete] #[opt] #[out] pFirmwareTableEnumBuffer: PVOID, #[in] BufferSize: DWORD) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetComputerNameExA(#[in] NameType: COMPUTER_NAME_FORMAT, #[buffer(*nSize)] #[opt] #[out] lpBuffer: LPSTR, #[in] #[out] nSize: LPDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetComputerNameExW(#[in] NameType: COMPUTER_NAME_FORMAT, #[buffer(*nSize)] #[opt] #[out] lpBuffer: LPWSTR, #[in] #[out] nSize: LPDWORD) -> BOOL;
        #[library("api-ms-win-core-sysinfo-l1-2-7.dll")]
        extern fn GetDeveloperDriveEnablementState() -> DEVELOPER_DRIVE_ENABLEMENT_STATE;
        #[library("api-ms-win-core-sysinfo-l1-2-3.dll")]
        extern fn GetIntegratedDisplaySize(#[out] sizeInInches: *mut f64) -> HRESULT;
        #[library("KERNEL32.dll")]
        extern fn GetLocalTime(#[out] lpSystemTime: LPSYSTEMTIME);
        #[library("KERNEL32.dll")]
        extern fn GetLogicalProcessorInformation(#[buffer(bytes(*ReturnedLength))] #[opt] #[out] Buffer: PSYSTEM_LOGICAL_PROCESSOR_INFORMATION, #[in] #[out] ReturnedLength: PDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetLogicalProcessorInformationEx(#[in] RelationshipType: LOGICAL_PROCESSOR_RELATIONSHIP, #[buffer(bytes(*ReturnedLength))] #[opt] #[out] Buffer: PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX, #[in] #[out] ReturnedLength: PDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetNativeSystemInfo(#[out] lpSystemInfo: LPSYSTEM_INFO);
        #[library("api-ms-win-core-sysinfo-l1-2-3.dll")]
        extern fn GetOsManufacturingMode(#[out] pbEnabled: PBOOL) -> BOOL;
        #[library("api-ms-win-core-sysinfo-l1-2-0.dll")]
        extern fn GetOsSafeBootMode(#[out] Flags: PDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetPhysicallyInstalledSystemMemory(#[out] TotalMemoryInKilobytes: PULONGLONG) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetProcessorSystemCycleTime(#[in] Group: USHORT, #[buffer(bytes(*ReturnedLength))] #[opt] #[out] Buffer: PSYSTEM_PROCESSOR_CYCLE_TIME_INFORMATION, #[in] #[out] ReturnedLength: PDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetProductInfo(#[in] dwOSMajorVersion: DWORD, #[in] dwOSMinorVersion: DWORD, #[in] dwSpMajorVersion: DWORD, #[in] dwSpMinorVersion: DWORD, #[out] pdwReturnedProductType: PDWORD) -> BOOL;
        #[library("api-ms-win-core-sysinfo-l1-2-8.dll")]
        extern fn GetRuntimeAttestationReport(#[buffer(bytes(32))] #[in] #[opt] Nonce: *mut UCHAR, #[in] PackageVersion: UINT16, #[in] ReportTypesBitmap: UINT64, #[buffer(bytes(*ReportBufferSize))] #[opt] #[out] ReportBuffer: PVOID, #[in] #[out] ReportBufferSize: PUINT32) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetSystemDirectoryA(#[buffer(uSize)] #[incomplete] #[opt] #[out] lpBuffer: LPSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetSystemDirectoryW(#[buffer(uSize)] #[incomplete] #[opt] #[out] lpBuffer: LPWSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetSystemFirmwareTable(#[in] FirmwareTableProviderSignature: DWORD, #[in] FirmwareTableID: DWORD, #[buffer(bytes(BufferSize))] #[incomplete] #[opt] #[out] pFirmwareTableBuffer: PVOID, #[in] BufferSize: DWORD) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetSystemInfo(#[out] lpSystemInfo: LPSYSTEM_INFO);
        #[library("KernelBase.dll")]
        extern fn GetSystemLeapSecondInformation(#[out] Enabled: PBOOL, #[out] Flags: PDWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetSystemTime(#[out] lpSystemTime: LPSYSTEMTIME);
        #[library("KERNEL32.dll")]
        extern fn GetSystemTimeAdjustment(#[out] lpTimeAdjustment: PDWORD, #[out] lpTimeIncrement: PDWORD, #[out] lpTimeAdjustmentDisabled: PBOOL) -> BOOL;
        #[library("api-ms-win-core-sysinfo-l1-2-4.dll")]
        extern fn GetSystemTimeAdjustmentPrecise(#[out] lpTimeAdjustment: PDWORD64, #[out] lpTimeIncrement: PDWORD64, #[out] lpTimeAdjustmentDisabled: PBOOL) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn GetSystemTimeAsFileTime(#[out] lpSystemTimeAsFileTime: LPFILETIME);
        #[library("KERNEL32.dll")]
        extern fn GetSystemTimePreciseAsFileTime(#[out] lpSystemTimeAsFileTime: LPFILETIME);
        #[library("KERNEL32.dll")]
        extern fn GetSystemWindowsDirectoryA(#[buffer(uSize)] #[incomplete] #[opt] #[out] lpBuffer: LPSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetSystemWindowsDirectoryW(#[buffer(uSize)] #[incomplete] #[opt] #[out] lpBuffer: LPWSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GetTickCount() -> DWORD;
        #[library("KERNEL32.dll")]
        extern fn GetTickCount64() -> ULONGLONG;
        #[deprecated]
        #[library("KERNEL32.dll")]
        extern fn GetVersion() -> DWORD;
        #[deprecated]
        #[library("KERNEL32.dll")]
        extern fn GetVersionExA(#[in] #[out] lpVersionInformation: LPOSVERSIONINFOA) -> BOOL;
        #[deprecated]
        #[library("KERNEL32.dll")]
        extern fn GetVersionExW(#[in] #[out] lpVersionInformation: LPOSVERSIONINFOW) -> BOOL;
        #[library("KERNEL32.dll")]
        #[must_use]
        extern fn GetWindowsDirectoryA(#[buffer(uSize)] #[incomplete] #[opt] #[out] lpBuffer: LPSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        #[must_use]
        extern fn GetWindowsDirectoryW(#[buffer(uSize)] #[incomplete] #[opt] #[out] lpBuffer: LPWSTR, #[in] uSize: UINT) -> UINT;
        #[library("KERNEL32.dll")]
        extern fn GlobalMemoryStatusEx(#[out] lpBuffer: LPMEMORYSTATUSEX) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn InstallELAMCertificateInfo(#[in] ELAMFile: HANDLE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn IsUserCetAvailableInEnvironment(#[in] UserCetEnvironment: DWORD) -> BOOL;
        type LPMEMORYSTATUSEX = *mut MEMORYSTATUSEX;
        type LPSYSTEM_INFO = *mut SYSTEM_INFO;
        struct MEMORYSTATUSEX {
            dwLength: DWORD,
            dwMemoryLoad: DWORD,
            ullTotalPhys: DWORDLONG,
            ullAvailPhys: DWORDLONG,
            ullTotalPageFile: DWORDLONG,
            ullAvailPageFile: DWORDLONG,
            ullTotalVirtual: DWORDLONG,
            ullAvailVirtual: DWORDLONG,
            ullAvailExtendedVirtual: DWORDLONG,
        }
        const SCEX2_ALT_NETBIOS_NAME: i32 = 1;
        struct SYSTEM_INFO {
            Anonymous: union {
                dwOemId: DWORD,
                Anonymous: struct {
                    wProcessorArchitecture: WORD,
                    wReserved: WORD,
                },
            },
            dwPageSize: DWORD,
            lpMinimumApplicationAddress: LPVOID,
            lpMaximumApplicationAddress: LPVOID,
            dwActiveProcessorMask: DWORD_PTR,
            dwNumberOfProcessors: DWORD,
            dwProcessorType: DWORD,
            dwAllocationGranularity: DWORD,
            wProcessorLevel: WORD,
            wProcessorRevision: WORD,
        }
        #[library("KERNEL32.dll")]
        extern fn SetComputerNameA(#[in] lpComputerName: LPCSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetComputerNameEx2W(#[in] NameType: COMPUTER_NAME_FORMAT, #[in] Flags: DWORD, #[in] lpBuffer: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetComputerNameExA(#[in] NameType: COMPUTER_NAME_FORMAT, #[in] lpBuffer: LPCSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetComputerNameExW(#[in] NameType: COMPUTER_NAME_FORMAT, #[in] lpBuffer: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetComputerNameW(#[in] lpComputerName: LPCWSTR) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetLocalTime(#[in] lpSystemTime: *const SYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetSystemTime(#[in] lpSystemTime: *const SYSTEMTIME) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetSystemTimeAdjustment(#[in] dwTimeAdjustment: DWORD, #[in] bTimeAdjustmentDisabled: BOOL) -> BOOL;
        #[library("api-ms-win-core-sysinfo-l1-2-4.dll")]
        extern fn SetSystemTimeAdjustmentPrecise(#[in] dwTimeAdjustment: DWORD64, #[in] bTimeAdjustmentDisabled: BOOL) -> BOOL;
        const USER_CET_ENVIRONMENT_SGX2_ENCLAVE: i32 = 2;
        const USER_CET_ENVIRONMENT_VBS_BASIC_ENCLAVE: i32 = 17;
        const USER_CET_ENVIRONMENT_VBS_ENCLAVE: i32 = 16;
        const USER_CET_ENVIRONMENT_WIN32_PROCESS: i32 = 0;
    }
}
