#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum DeviceDiscoveryMechanism {
            MulticastDiscovery = 0,
            DirectedDiscovery = 1,
            SecureDirectedDiscovery = 2,
        }
        const TYPE_ENCODING_WSD11_BYE: DWORD = 38;
        const TYPE_ENCODING_WSD11_HELLO: DWORD = 39;
        const TYPE_ENCODING_WSD11_PROBE: DWORD = 37;
        const TYPE_ENCODING_WSD11_PROBE_MATCH: DWORD = 35;
        const TYPE_ENCODING_WSD11_PROBE_MATCHES: DWORD = 36;
        const TYPE_ENCODING_WSD11_RESOLVE: DWORD = 34;
        const TYPE_ENCODING_WSD11_RESOLVE_MATCH: DWORD = 32;
        const TYPE_ENCODING_WSD11_RESOLVE_MATCHES: DWORD = 33;
        const TYPE_ENCODING_WSD_APP_SEQUENCE: DWORD = 9;
        const TYPE_ENCODING_WSD_BYE: DWORD = 19;
        const TYPE_ENCODING_WSD_ENDPOINT_REFERENCE: DWORD = 24;
        const TYPE_ENCODING_WSD_EVENTING_DELIVERY_MODE: DWORD = 30;
        const TYPE_ENCODING_WSD_EVENTING_DELIVERY_MODE_PUSH: DWORD = 29;
        const TYPE_ENCODING_WSD_EVENTING_EXPIRES: DWORD = 28;
        const TYPE_ENCODING_WSD_EVENTING_FILTER: DWORD = 27;
        const TYPE_ENCODING_WSD_EVENTING_FILTER_ACTION: DWORD = 26;
        const TYPE_ENCODING_WSD_HEADER_RELATESTO: DWORD = 10;
        const TYPE_ENCODING_WSD_HELLO: DWORD = 21;
        const TYPE_ENCODING_WSD_HOST_METADATA: DWORD = 1;
        const TYPE_ENCODING_WSD_LOCALIZED_STRING: DWORD = 31;
        const TYPE_ENCODING_WSD_METADATA_SECTION: DWORD = 25;
        const TYPE_ENCODING_WSD_PROBE: DWORD = 18;
        const TYPE_ENCODING_WSD_PROBE_MATCH: DWORD = 16;
        const TYPE_ENCODING_WSD_PROBE_MATCHES: DWORD = 17;
        const TYPE_ENCODING_WSD_REFERENCE_PARAMETERS: DWORD = 22;
        const TYPE_ENCODING_WSD_REFERENCE_PROPERTIES: DWORD = 23;
        const TYPE_ENCODING_WSD_RELATIONSHIP_METADATA: DWORD = 0;
        const TYPE_ENCODING_WSD_RESOLVE: DWORD = 15;
        const TYPE_ENCODING_WSD_RESOLVE_MATCH: DWORD = 14;
        const TYPE_ENCODING_WSD_RESOLVE_MATCHES: DWORD = 13;
        const TYPE_ENCODING_WSD_SCOPES: DWORD = 20;
        const TYPE_ENCODING_WSD_SERVICE_METADATA: DWORD = 2;
        const TYPE_ENCODING_WSD_SOAP_FAULT: DWORD = 8;
        const TYPE_ENCODING_WSD_SOAP_FAULT_CODE: DWORD = 7;
        const TYPE_ENCODING_WSD_SOAP_FAULT_REASON: DWORD = 5;
        const TYPE_ENCODING_WSD_SOAP_FAULT_SUBCODE: DWORD = 6;
        const TYPE_ENCODING_WSD_SOAP_HEADER: DWORD = 11;
        const TYPE_ENCODING_WSD_SOAP_MESSAGE: DWORD = 12;
        const TYPE_ENCODING_WSD_THIS_DEVICE_METADATA: DWORD = 3;
        const TYPE_ENCODING_WSD_THIS_MODEL_METADATA: DWORD = 4;
        #[repr(i32)]
        enum WSDEventType {
            WSDET_NONE = 0,
            WSDET_INCOMING_MESSAGE = 1,
            WSDET_INCOMING_FAULT = 2,
            WSDET_TRANSMISSION_FAILURE = 3,
            WSDET_RESPONSE_TIMEOUT = 4,
        }
        type WSD_APP_SEQUENCE = _WSD_APP_SEQUENCE;
        type WSD_EVENTING_EXPIRES = _WSD_EVENTING_EXPIRES;
        type WSD_EVENTING_FILTER = _WSD_EVENTING_FILTER;
        type WSD_EVENTING_FILTER_ACTION = _WSD_EVENTING_FILTER_ACTION;
        type WSD_HEADER_RELATESTO = _WSD_HEADER_RELATESTO;
        type WSD_LOCALIZED_STRING = _WSD_LOCALIZED_STRING;
        type WSD_LOCALIZED_STRING_LIST = _WSD_LOCALIZED_STRING_LIST;
        type WSD_NAME_LIST = _WSD_NAME_LIST;
        #[repr(i32)]
        enum WSD_PROTOCOL_TYPE {
            WSD_PT_NONE = 0,
            WSD_PT_UDP = 1,
            WSD_PT_HTTP = 2,
            WSD_PT_HTTPS = 4,
            WSD_PT_ALL = 255,
        }
        type WSD_SCOPES = _WSD_SCOPES;
        type WSD_SOAP_FAULT_CODE = _WSD_SOAP_FAULT_CODE;
        type WSD_SOAP_FAULT_REASON = _WSD_SOAP_FAULT_REASON;
        type WSD_SOAP_FAULT_SUBCODE = _WSD_SOAP_FAULT_SUBCODE;
        struct WSD_SYNCHRONOUS_RESPONSE_CONTEXT {
            hr: HRESULT,
            eventHandle: HANDLE,
            messageParameters: IWSDMessageParameters,
            results: *mut void,
        }
        type WSD_URI_LIST = _WSD_URI_LIST;
        struct _WSD_APP_SEQUENCE {
            InstanceId: ULONGLONG,
            SequenceId: *const WCHAR,
            MessageNumber: ULONGLONG,
        }
        struct _WSD_EVENTING_EXPIRES {
            Duration: *mut WSD_DURATION,
            DateTime: *mut WSD_DATETIME,
        }
        struct _WSD_EVENTING_FILTER {
            Dialect: *const WCHAR,
            FilterAction: *mut WSD_EVENTING_FILTER_ACTION,
            Data: *mut void,
        }
        struct _WSD_EVENTING_FILTER_ACTION {
            Actions: *mut WSD_URI_LIST,
        }
        struct _WSD_HEADER_RELATESTO {
            RelationshipType: *mut WSDXML_NAME,
            MessageID: *const WCHAR,
        }
        struct _WSD_LOCALIZED_STRING {
            lang: *const WCHAR,
            String: *const WCHAR,
        }
        struct _WSD_LOCALIZED_STRING_LIST {
            Next: *mut WSD_LOCALIZED_STRING_LIST,
            Element: *mut WSD_LOCALIZED_STRING,
        }
        struct _WSD_NAME_LIST {
            Next: *mut WSD_NAME_LIST,
            Element: *mut WSDXML_NAME,
        }
        struct _WSD_SCOPES {
            MatchBy: *const WCHAR,
            Scopes: *mut WSD_URI_LIST,
        }
        struct _WSD_SOAP_FAULT_CODE {
            Value: *mut WSDXML_NAME,
            Subcode: *mut WSD_SOAP_FAULT_SUBCODE,
        }
        struct _WSD_SOAP_FAULT_REASON {
            Text: *mut WSD_LOCALIZED_STRING_LIST,
        }
        struct _WSD_SOAP_FAULT_SUBCODE {
            Value: *mut WSDXML_NAME,
            Subcode: *mut WSD_SOAP_FAULT_SUBCODE,
        }
        struct _WSD_URI_LIST {
            Next: *mut WSD_URI_LIST,
            Element: *const WCHAR,
        }
    }
}
