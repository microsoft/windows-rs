#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CheckRemoteDebuggerPresent(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] hProcess: HANDLE, #[out] pbDebuggerPresent: PBOOL) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ContinueDebugEvent(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwProcessId: DWORD, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwThreadId: DWORD, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwContinueStatus: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn DebugActiveProcess(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwProcessId: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn DebugActiveProcessStop(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwProcessId: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn DebugBreak();
        #[library("KERNEL32.dll")]
        extern fn IsDebuggerPresent() -> BOOL;
        #[library("KERNEL32.dll", import = "OutputDebugStringA")]
        extern fn OutputDebugString(#[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpOutputString: LPCSTR);
        #[library("KERNEL32.dll")]
        extern fn OutputDebugStringA(#[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpOutputString: LPCSTR);
        #[library("KERNEL32.dll")]
        extern fn OutputDebugStringW(#[in] #[opt] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpOutputString: LPCWSTR);
        #[library("KERNEL32.dll")]
        extern fn WaitForDebugEvent(#[out] lpDebugEvent: LPDEBUG_EVENT, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwMilliseconds: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WaitForDebugEventEx(#[out] lpDebugEvent: LPDEBUG_EVENT, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] dwMilliseconds: DWORD) -> BOOL;
    }
}
