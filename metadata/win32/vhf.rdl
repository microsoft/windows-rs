#[win32]
mod Windows {
    mod Win32 {
        extern "C" fn EVT_VHF_ASYNC_OPERATION(#[in] VhfClientContext: PVOID, #[in] VhfOperationHandle: VHFOPERATIONHANDLE, #[in] #[opt] VhfOperationContext: PVOID, #[in] HidTransferPacket: PHID_XFER_PACKET);
        extern "C" fn EVT_VHF_CLEANUP(#[in] VhfClientContext: PVOID);
        extern "C" fn EVT_VHF_READY_FOR_NEXT_READ_REPORT(#[in] VhfClientContext: PVOID);
        extern "C" fn PEVT_VHF_ASYNC_OPERATION(#[in] VhfClientContext: PVOID, #[in] VhfOperationHandle: VHFOPERATIONHANDLE, #[in] #[opt] VhfOperationContext: PVOID, #[in] HidTransferPacket: PHID_XFER_PACKET);
        extern "C" fn PEVT_VHF_CLEANUP(#[in] VhfClientContext: PVOID);
        extern "C" fn PEVT_VHF_READY_FOR_NEXT_READ_REPORT(#[in] VhfClientContext: PVOID);
        type PVHF_CONFIG = *mut VHF_CONFIG;
        type VHFHANDLE = *mut void;
        type VHFOPERATIONHANDLE = *mut void;
        struct VHF_CONFIG {
            Size: ULONG,
            VhfClientContext: PVOID,
            OperationContextSize: ULONG,
            FileHandle: HANDLE,
            VendorID: USHORT,
            ProductID: USHORT,
            VersionNumber: USHORT,
            ContainerID: GUID,
            InstanceIDLength: USHORT,
            #[readable(bytes(InstanceIDLength))]
            #[writable(bytes(InstanceIDLength))]
            InstanceID: PWSTR,
            ReportDescriptorLength: USHORT,
            #[readable(ReportDescriptorLength)]
            #[writable(ReportDescriptorLength)]
            ReportDescriptor: PUCHAR,
            EvtVhfReadyForNextReadReport: PEVT_VHF_READY_FOR_NEXT_READ_REPORT,
            EvtVhfAsyncOperationGetFeature: PEVT_VHF_ASYNC_OPERATION,
            EvtVhfAsyncOperationSetFeature: PEVT_VHF_ASYNC_OPERATION,
            EvtVhfAsyncOperationWriteReport: PEVT_VHF_ASYNC_OPERATION,
            EvtVhfAsyncOperationGetInputReport: PEVT_VHF_ASYNC_OPERATION,
            EvtVhfCleanup: PEVT_VHF_CLEANUP,
            HardwareIDsLength: USHORT,
            #[readable(bytes(HardwareIDsLength))]
            #[writable(bytes(HardwareIDsLength))]
            HardwareIDs: PWSTR,
        }
    }
}
