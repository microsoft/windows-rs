#[win32]
mod Windows {
    mod Win32 {
        #[repr(i32)]
        enum D2D1_ALPHA_MODE {
            D2D1_ALPHA_MODE_UNKNOWN = 0,
            D2D1_ALPHA_MODE_PREMULTIPLIED = 1,
            D2D1_ALPHA_MODE_STRAIGHT = 2,
            D2D1_ALPHA_MODE_IGNORE = 3,
            D2D1_ALPHA_MODE_FORCE_DWORD = -1,
        }
        type D2D1_MATRIX_3X2_F = D2D_MATRIX_3X2_F;
        struct D2D1_PIXEL_FORMAT {
            format: DXGI_FORMAT,
            alphaMode: D2D1_ALPHA_MODE,
        }
        type D2D1_POINT_2F = D2D_POINT_2F;
        type D2D1_POINT_2L = D2D_POINT_2L;
        type D2D1_POINT_2U = D2D_POINT_2U;
        type D2D1_RECT_F = D2D_RECT_F;
        type D2D1_RECT_L = D2D_RECT_L;
        type D2D1_RECT_U = D2D_RECT_U;
        type D2D1_SIZE_F = D2D_SIZE_F;
        type D2D1_SIZE_U = D2D_SIZE_U;
        struct D2D_MATRIX_3X2_F {
            Anonymous: union {
                Anonymous: struct {
                    m11: FLOAT,
                    m12: FLOAT,
                    m21: FLOAT,
                    m22: FLOAT,
                    dx: FLOAT,
                    dy: FLOAT,
                },
                Anonymous2: struct {
                    _11: FLOAT,
                    _12: FLOAT,
                    _21: FLOAT,
                    _22: FLOAT,
                    _31: FLOAT,
                    _32: FLOAT,
                },
                m: [[FLOAT; 2]; 3],
            },
        }
        struct D2D_MATRIX_4X3_F {
            Anonymous: union {
                Anonymous: struct {
                    _11: FLOAT,
                    _12: FLOAT,
                    _13: FLOAT,
                    _21: FLOAT,
                    _22: FLOAT,
                    _23: FLOAT,
                    _31: FLOAT,
                    _32: FLOAT,
                    _33: FLOAT,
                    _41: FLOAT,
                    _42: FLOAT,
                    _43: FLOAT,
                },
                m: [[FLOAT; 3]; 4],
            },
        }
        struct D2D_MATRIX_4X4_F {
            Anonymous: union {
                Anonymous: struct {
                    _11: FLOAT,
                    _12: FLOAT,
                    _13: FLOAT,
                    _14: FLOAT,
                    _21: FLOAT,
                    _22: FLOAT,
                    _23: FLOAT,
                    _24: FLOAT,
                    _31: FLOAT,
                    _32: FLOAT,
                    _33: FLOAT,
                    _34: FLOAT,
                    _41: FLOAT,
                    _42: FLOAT,
                    _43: FLOAT,
                    _44: FLOAT,
                },
                m: [[FLOAT; 4]; 4],
            },
        }
        struct D2D_MATRIX_5X4_F {
            Anonymous: union {
                Anonymous: struct {
                    _11: FLOAT,
                    _12: FLOAT,
                    _13: FLOAT,
                    _14: FLOAT,
                    _21: FLOAT,
                    _22: FLOAT,
                    _23: FLOAT,
                    _24: FLOAT,
                    _31: FLOAT,
                    _32: FLOAT,
                    _33: FLOAT,
                    _34: FLOAT,
                    _41: FLOAT,
                    _42: FLOAT,
                    _43: FLOAT,
                    _44: FLOAT,
                    _51: FLOAT,
                    _52: FLOAT,
                    _53: FLOAT,
                    _54: FLOAT,
                },
                m: [[FLOAT; 4]; 5],
            },
        }
        struct D2D_POINT_2F {
            x: FLOAT,
            y: FLOAT,
        }
        type D2D_POINT_2L = POINT;
        struct D2D_POINT_2U {
            x: u32,
            y: u32,
        }
        struct D2D_RECT_F {
            left: FLOAT,
            top: FLOAT,
            right: FLOAT,
            bottom: FLOAT,
        }
        type D2D_RECT_L = RECT;
        struct D2D_RECT_U {
            left: u32,
            top: u32,
            right: u32,
            bottom: u32,
        }
        struct D2D_SIZE_F {
            width: FLOAT,
            height: FLOAT,
        }
        struct D2D_SIZE_U {
            width: u32,
            height: u32,
        }
        struct D2D_VECTOR_2F {
            x: FLOAT,
            y: FLOAT,
        }
        struct D2D_VECTOR_3F {
            x: FLOAT,
            y: FLOAT,
            z: FLOAT,
        }
        struct D2D_VECTOR_4F {
            x: FLOAT,
            y: FLOAT,
            z: FLOAT,
            w: FLOAT,
        }
        #[repr(u32)]
        #[flags]
        enum DWRITE_GLYPH_IMAGE_FORMATS {
            DWRITE_GLYPH_IMAGE_FORMATS_NONE = 0,
            DWRITE_GLYPH_IMAGE_FORMATS_TRUETYPE = 1,
            DWRITE_GLYPH_IMAGE_FORMATS_CFF = 2,
            DWRITE_GLYPH_IMAGE_FORMATS_COLR = 4,
            DWRITE_GLYPH_IMAGE_FORMATS_SVG = 8,
            DWRITE_GLYPH_IMAGE_FORMATS_PNG = 16,
            DWRITE_GLYPH_IMAGE_FORMATS_JPEG = 32,
            DWRITE_GLYPH_IMAGE_FORMATS_TIFF = 64,
            DWRITE_GLYPH_IMAGE_FORMATS_PREMULTIPLIED_B8G8R8A8 = 128,
            DWRITE_GLYPH_IMAGE_FORMATS_COLR_PAINT_TREE = 256,
        }
        #[repr(i32)]
        enum DWRITE_MEASURING_MODE {
            DWRITE_MEASURING_MODE_NATURAL = 0,
            DWRITE_MEASURING_MODE_GDI_CLASSIC = 1,
            DWRITE_MEASURING_MODE_GDI_NATURAL = 2,
        }
    }
}
