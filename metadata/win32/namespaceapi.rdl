    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn AddSIDToBoundaryDescriptor(#[in] #[out] BoundaryDescriptor: *mut HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] RequiredSid: PSID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ClosePrivateNamespace(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Handle: HANDLE, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] Flags: ULONG) -> BOOLEAN;
