#[win32]
mod Windows {
    mod Win32 {
        const IID_INSSBuffer: GUID = 0xe1cd3524_03d7_11d2_9eed_006097d2d7cf;
        const IID_INSSBuffer2: GUID = 0x4f528693_1035_43fe_b428_757561ad3a68;
        const IID_INSSBuffer3: GUID = 0xc87ceaaf_75be_4bc4_84eb_ac2798507672;
        const IID_INSSBuffer4: GUID = 0xb6b8fd5a_32e2_49d4_a910_c26cc85465ed;
        const IID_IWMSBuffer: GUID = 0xe1cd3524_03d7_11d2_9eed_006097d2d7cf;
        const IID_IWMSBufferAllocator: GUID = 0x61103ca4_2033_11d2_9ef1_006097d2d7cf;
        #[guid(0xe1cd3524_03d7_11d2_9eed_006097d2d7cf)]
        interface INSSBuffer: IUnknown {
            fn GetLength(&self, #[out] pdwLength: *mut DWORD) -> HRESULT;
            fn SetLength(&self, #[in] dwLength: DWORD) -> HRESULT;
            fn GetMaxLength(&self, #[out] pdwLength: *mut DWORD) -> HRESULT;
            fn GetBuffer(&self, #[out] ppdwBuffer: *mut *mut BYTE) -> HRESULT;
            fn GetBufferAndLength(&self, #[out] ppdwBuffer: *mut *mut BYTE, #[out] pdwLength: *mut DWORD) -> HRESULT;
        }
        #[guid(0x4f528693_1035_43fe_b428_757561ad3a68)]
        interface INSSBuffer2: INSSBuffer {
            fn GetSampleProperties(&self, #[in] cbProperties: DWORD, #[out] pbProperties: *mut BYTE) -> HRESULT;
            fn SetSampleProperties(&self, #[in] cbProperties: DWORD, #[in] pbProperties: *mut BYTE) -> HRESULT;
        }
        #[guid(0xc87ceaaf_75be_4bc4_84eb_ac2798507672)]
        interface INSSBuffer3: INSSBuffer2 {
            fn SetProperty(&self, #[in] guidBufferProperty: GUID, #[in] pvBufferProperty: *mut void, #[in] dwBufferPropertySize: DWORD) -> HRESULT;
            fn GetProperty(&self, #[in] guidBufferProperty: GUID, #[out] pvBufferProperty: *mut void, #[in] #[out] pdwBufferPropertySize: *mut DWORD) -> HRESULT;
        }
        #[guid(0xb6b8fd5a_32e2_49d4_a910_c26cc85465ed)]
        interface INSSBuffer4: INSSBuffer3 {
            fn GetPropertyCount(&self, #[out] pcBufferProperties: *mut DWORD) -> HRESULT;
            fn GetPropertyByIndex(&self, #[in] dwBufferPropertyIndex: DWORD, #[out] pguidBufferProperty: *mut GUID, #[out] pvBufferProperty: *mut void, #[in] #[out] pdwBufferPropertySize: *mut DWORD) -> HRESULT;
        }
        #[guid(0x61103ca4_2033_11d2_9ef1_006097d2d7cf)]
        interface IWMSBufferAllocator: IUnknown {
            fn AllocateBuffer(&self, #[in] dwMaxBufferSize: DWORD, #[out] ppBuffer: *mut INSSBuffer) -> HRESULT;
            fn AllocatePageSizeBuffer(&self, #[in] dwMaxBufferSize: DWORD, #[out] ppBuffer: *mut INSSBuffer) -> HRESULT;
        }
    }
}
