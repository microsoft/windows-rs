#[win32]
mod Windows {
    mod Win32 {
        #[library("CoreMessaging.dll")]
        extern fn CreateDispatcherQueueController(options: DispatcherQueueOptions, dispatcherQueueController: *mut super::System::IDispatcherQueueController) -> HRESULT;
        #[repr(i32)]
        enum DISPATCHERQUEUE_THREAD_APARTMENTTYPE {
            DQTAT_COM_NONE = 0,
            DQTAT_COM_ASTA = 1,
            DQTAT_COM_STA = 2,
        }
        #[repr(i32)]
        enum DISPATCHERQUEUE_THREAD_TYPE {
            DQTYPE_THREAD_DEDICATED = 1,
            DQTYPE_THREAD_CURRENT = 2,
        }
        struct DispatcherQueueOptions {
            dwSize: u32,
            threadType: DISPATCHERQUEUE_THREAD_TYPE,
            apartmentType: DISPATCHERQUEUE_THREAD_APARTMENTTYPE,
        }
    }
}
