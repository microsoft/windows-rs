            KeyLength: ULONG,
        }
        const EFS_METADATA_ADD_USER: i32 = 1;
        const EFS_METADATA_GENERAL_OP: i32 = 8;
        const EFS_METADATA_REMOVE_USER: i32 = 2;
        const EFS_METADATA_REPLACE_USER: i32 = 4;
        const EFS_PFILE_SUBVER_APPX: i32 = 3;
        const EFS_PFILE_SUBVER_RMS: i32 = 2;
        struct EFS_PIN_BLOB {
            cbPadding: DWORD,
            cbData: DWORD,
            pbData: PBYTE,
        }
        struct EFS_RPC_BLOB {
            cbData: DWORD,
            pbData: PBYTE,
        }
        const EFS_SUBVER_UNKNOWN: i32 = 0;
        struct EFS_VERSION_INFO {
            EfsVersion: DWORD,
            SubVersion: DWORD,
        }
        struct ENCRYPTED_FILE_METADATA_SIGNATURE {
            dwEfsAccessType: DWORD,
            pCertificatesAdded: PENCRYPTION_CERTIFICATE_HASH_LIST,
            pEncryptionCertificate: PENCRYPTION_CERTIFICATE,
            pEfsStreamSignature: PEFS_RPC_BLOB,
        }
        struct ENCRYPTION_CERTIFICATE {
            cbTotalLength: DWORD,
            pUserSid: *mut SID,
            pCertBlob: PEFS_CERTIFICATE_BLOB,
        }
        struct ENCRYPTION_CERTIFICATE_HASH {
            cbTotalLength: DWORD,
            pUserSid: *mut SID,
            pHash: PEFS_HASH_BLOB,
            lpDisplayInformation: LPWSTR,
        }
        struct ENCRYPTION_CERTIFICATE_HASH_LIST {
            nCert_Hash: DWORD,
            pUsers: *mut PENCRYPTION_CERTIFICATE_HASH,
        }
        struct ENCRYPTION_CERTIFICATE_LIST {
            nUsers: DWORD,
            pUsers: *mut PENCRYPTION_CERTIFICATE,
        }
        struct ENCRYPTION_PROTECTOR {
            cbTotalLength: DWORD,
            pUserSid: *mut SID,
            lpProtectorDescriptor: LPWSTR,
        }
        struct ENCRYPTION_PROTECTOR_LIST {
            nProtectors: DWORD,
            pProtectors: *mut PENCRYPTION_PROTECTOR,
        }
