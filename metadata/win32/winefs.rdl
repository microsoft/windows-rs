        extern fn RemoveUsersFromEncryptedFile(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] lpFileName: LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] pHashes: PENCRYPTION_CERTIFICATE_HASH_LIST) -> DWORD;
