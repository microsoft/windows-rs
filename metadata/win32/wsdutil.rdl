#[win32]
mod Windows {
    mod Win32 {
        const WSDAPI_OPTION_MAX_INBOUND_MESSAGE_SIZE: i32 = 1;
        const WSDAPI_OPTION_TRACE_XML_TO_DEBUGGER: i32 = 2;
        const WSDAPI_OPTION_TRACE_XML_TO_FILE: i32 = 3;
        #[library("wsdapi.dll")]
        extern fn WSDAllocateLinkedMemory(pParent: *mut void, cbSize: size_t) -> *mut void;
        #[library("wsdapi.dll")]
        extern fn WSDAttachLinkedMemory(pParent: *mut void, pChild: *mut void);
        #[library("wsdapi.dll")]
        extern fn WSDDetachLinkedMemory(pVoid: *mut void);
        #[library("wsdapi.dll")]
        extern fn WSDFreeLinkedMemory(pVoid: *mut void);
        #[library("wsdapi.dll")]
        extern fn WSDGetConfigurationOption(dwOption: DWORD, #[out] #[size_param(2)] pVoid: LPVOID, cbOutBuffer: DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDSetConfigurationOption(dwOption: DWORD, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[size_param(2)] pVoid: LPVOID, cbInBuffer: DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDUriDecode(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[len_param(1)] source: LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cchSource: DWORD, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_", "*cchDestOut", "*cchDestOut")] #[out] destOut: *mut LPWSTR, #[out] #[opt] cchDestOut: *mut DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDUriEncode(#[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] #[len_param(1)] source: LPCWSTR, #[in] #[Windows::Win32::Metadata::NativeInput(ReadOnly = true)] cchSource: DWORD, #[Windows::Win32::Metadata::NativeSal("2", "_Out_writes_", "*cchDestOut", "*cchDestOut")] #[out] destOut: *mut LPWSTR, #[out] #[opt] cchDestOut: *mut DWORD) -> HRESULT;
        #[encoding("utf-16")]
        const WSD_DEFAULT_EVENTING_ADDRESS: String = "http://*:5357/";
        #[encoding("utf-16")]
        const WSD_DEFAULT_HOSTING_ADDRESS: String = "http://*:5357/";
        #[encoding("utf-16")]
        const WSD_DEFAULT_SECURE_HOSTING_ADDRESS: String = "https://*:5358/";
    }
}
