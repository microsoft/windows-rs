#[win32]
mod Windows {
    mod Win32 {
        const WSDAPI_OPTION_MAX_INBOUND_MESSAGE_SIZE: i32 = 1;
        const WSDAPI_OPTION_TRACE_XML_TO_DEBUGGER: i32 = 2;
        const WSDAPI_OPTION_TRACE_XML_TO_FILE: i32 = 3;
        #[library("wsdapi.dll")]
        extern fn WSDAllocateLinkedMemory(pParent: *mut void, cbSize: size_t) -> *mut void;
        #[library("wsdapi.dll")]
        extern fn WSDAttachLinkedMemory(pParent: *mut void, pChild: *mut void);
        #[library("wsdapi.dll")]
        extern fn WSDDetachLinkedMemory(pVoid: *mut void);
        #[library("wsdapi.dll")]
        extern fn WSDFreeLinkedMemory(pVoid: *mut void);
        #[library("wsdapi.dll")]
        extern fn WSDGenerateFault(#[in] pszCode: LPCWSTR, #[in] #[opt] pszSubCode: LPCWSTR, #[in] pszReason: LPCWSTR, #[in] #[opt] pszDetail: LPCWSTR, #[in] pContext: IWSDXMLContext, #[out] #[out_ptr] ppFault: *mut *mut WSD_SOAP_FAULT) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDGenerateFaultEx(#[in] pCode: *mut WSDXML_NAME, #[in] #[opt] pSubCode: *mut WSDXML_NAME, #[in] pReasons: *mut WSD_LOCALIZED_STRING_LIST, #[in] #[opt] pszDetail: LPCWSTR, #[out] #[out_ptr] ppFault: *mut *mut WSD_SOAP_FAULT) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDGetConfigurationOption(dwOption: DWORD, #[out] #[writable(entry, bytes(cbOutBuffer))] pVoid: LPVOID, cbOutBuffer: DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDSetConfigurationOption(dwOption: DWORD, #[in] #[readable(entry, bytes(cbInBuffer))] pVoid: LPVOID, cbInBuffer: DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDUriDecode(#[in] #[readable(entry, cchSource)] source: LPCWSTR, #[in] cchSource: DWORD, #[out] #[writable(entry, if_present(*cchDestOut))] destOut: *mut LPWSTR, #[opt] #[out] cchDestOut: *mut DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDUriEncode(#[in] #[readable(entry, cchSource)] source: LPCWSTR, #[in] cchSource: DWORD, #[out] #[writable(entry, if_present(*cchDestOut))] destOut: *mut LPWSTR, #[opt] #[out] cchDestOut: *mut DWORD) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDXMLAddChild(pParent: *mut WSDXML_ELEMENT, pChild: *mut WSDXML_ELEMENT) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDXMLAddSibling(pFirst: *mut WSDXML_ELEMENT, pSecond: *mut WSDXML_ELEMENT) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDXMLBuildAnyForSingleElement(pElementName: *mut WSDXML_NAME, #[in] #[opt] pszText: LPCWSTR, #[out] #[out_ptr] ppAny: *mut *mut WSDXML_ELEMENT) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDXMLCleanupElement(pAny: *mut WSDXML_ELEMENT) -> HRESULT;
        #[library("wsdapi.dll")]
        extern fn WSDXMLGetValueFromAny(#[in] pszNamespace: LPCWSTR, #[in] pszName: LPCWSTR, pAny: *mut WSDXML_ELEMENT, #[out] #[out_ptr] ppszValue: *mut LPCWSTR) -> HRESULT;
        #[encoding("utf-16")]
        const WSD_DEFAULT_EVENTING_ADDRESS: String = "http://*:5357/";
        #[encoding("utf-16")]
        const WSD_DEFAULT_HOSTING_ADDRESS: String = "http://*:5357/";
        #[encoding("utf-16")]
        const WSD_DEFAULT_SECURE_HOSTING_ADDRESS: String = "https://*:5358/";
    }
}
