        const D3DVTXPCAPS_TEXGEN: i32 = 1;
        const D3DVTXPCAPS_TEXGEN_SPHEREMAP: i32 = 256;
        const D3DVTXPCAPS_TWEENING: i32 = 64;
    }
}
