#[win32]
mod Windows {
    mod Win32 {
        #[library("KERNEL32.dll")]
        extern fn CallbackMayRunLong(#[in] #[out] pci: PTP_CALLBACK_INSTANCE) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn CancelThreadpoolIo(#[in] #[out] pio: PTP_IO);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpool(#[in] #[out] ptpp: PTP_POOL);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpoolCleanupGroup(#[in] #[out] ptpcg: PTP_CLEANUP_GROUP);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpoolCleanupGroupMembers(#[in] #[out] ptpcg: PTP_CLEANUP_GROUP, #[in] fCancelPendingCallbacks: BOOL, #[in] #[out] #[opt] pvCleanupContext: PVOID);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpoolIo(#[in] #[out] pio: PTP_IO);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpoolTimer(#[in] #[out] pti: PTP_TIMER);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpoolWait(#[in] #[out] pwa: PTP_WAIT);
        #[library("KERNEL32.dll")]
        extern fn CloseThreadpoolWork(#[in] #[out] pwk: PTP_WORK);
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn CreateThreadpool(#[reserved] reserved: PVOID) -> PTP_POOL;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn CreateThreadpoolCleanupGroup() -> PTP_CLEANUP_GROUP;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn CreateThreadpoolIo(#[in] fl: HANDLE, #[in] pfnio: PTP_WIN32_IO_CALLBACK, #[in] #[out] #[opt] pv: PVOID, #[in] #[opt] pcbe: PTP_CALLBACK_ENVIRON) -> PTP_IO;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn CreateThreadpoolTimer(#[in] pfnti: PTP_TIMER_CALLBACK, #[in] #[out] #[opt] pv: PVOID, #[in] #[opt] pcbe: PTP_CALLBACK_ENVIRON) -> PTP_TIMER;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn CreateThreadpoolWait(#[in] pfnwa: PTP_WAIT_CALLBACK, #[in] #[out] #[opt] pv: PVOID, #[in] #[opt] pcbe: PTP_CALLBACK_ENVIRON) -> PTP_WAIT;
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn CreateThreadpoolWork(#[in] pfnwk: PTP_WORK_CALLBACK, #[in] #[out] #[opt] pv: PVOID, #[in] #[opt] pcbe: PTP_CALLBACK_ENVIRON) -> PTP_WORK;
        #[library("KERNEL32.dll")]
        extern fn DisassociateCurrentThreadFromCallback(#[in] #[out] pci: PTP_CALLBACK_INSTANCE);
        #[library("KERNEL32.dll")]
        extern fn FreeLibraryWhenCallbackReturns(#[in] #[out] pci: PTP_CALLBACK_INSTANCE, #[in] r#mod: HMODULE);
        #[library("KERNEL32.dll")]
        extern fn IsThreadpoolTimerSet(#[in] #[out] pti: PTP_TIMER) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn LeaveCriticalSectionWhenCallbackReturns(#[in] #[out] pci: PTP_CALLBACK_INSTANCE, #[in] #[out] pcs: PCRITICAL_SECTION);
        extern fn PTP_WIN32_IO_CALLBACK(#[in] #[out] Instance: PTP_CALLBACK_INSTANCE, #[in] #[out] #[opt] Context: PVOID, #[in] #[out] #[opt] Overlapped: PVOID, #[in] IoResult: ULONG, #[in] NumberOfBytesTransferred: ULONG_PTR, #[in] #[out] Io: PTP_IO);
        #[library("KERNEL32.dll")]
        extern fn QueryThreadpoolStackInformation(#[in] ptpp: PTP_POOL, #[out] ptpsi: PTP_POOL_STACK_INFORMATION) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn ReleaseMutexWhenCallbackReturns(#[in] #[out] pci: PTP_CALLBACK_INSTANCE, #[in] r#mut: HANDLE);
        #[library("KERNEL32.dll")]
        extern fn ReleaseSemaphoreWhenCallbackReturns(#[in] #[out] pci: PTP_CALLBACK_INSTANCE, #[in] sem: HANDLE, #[in] crel: DWORD);
        #[library("KERNEL32.dll")]
        extern fn SetEventWhenCallbackReturns(#[in] #[out] pci: PTP_CALLBACK_INSTANCE, #[in] evt: HANDLE);
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolStackInformation(#[in] #[out] ptpp: PTP_POOL, #[in] ptpsi: PTP_POOL_STACK_INFORMATION) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolThreadMaximum(#[in] #[out] ptpp: PTP_POOL, #[in] cthrdMost: DWORD);
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolThreadMinimum(#[in] #[out] ptpp: PTP_POOL, #[in] cthrdMic: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolTimer(#[in] #[out] pti: PTP_TIMER, #[in] #[opt] pftDueTime: PFILETIME, #[in] msPeriod: DWORD, #[in] #[opt] msWindowLength: DWORD);
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolTimerEx(#[in] #[out] pti: PTP_TIMER, #[in] #[opt] pftDueTime: PFILETIME, #[in] msPeriod: DWORD, #[in] #[opt] msWindowLength: DWORD) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolWait(#[in] #[out] pwa: PTP_WAIT, #[in] #[opt] h: HANDLE, #[in] #[opt] pftTimeout: PFILETIME);
        #[library("KERNEL32.dll")]
        extern fn SetThreadpoolWaitEx(#[in] #[out] pwa: PTP_WAIT, #[in] #[opt] h: HANDLE, #[in] #[opt] pftTimeout: PFILETIME, #[reserved] Reserved: PVOID) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn StartThreadpoolIo(#[in] #[out] pio: PTP_IO);
        #[library("KERNEL32.dll")]
        extern fn SubmitThreadpoolWork(#[in] #[out] pwk: PTP_WORK);
        #[must_use]
        #[library("KERNEL32.dll")]
        extern fn TrySubmitThreadpoolCallback(#[in] pfns: PTP_SIMPLE_CALLBACK, #[in] #[out] #[opt] pv: PVOID, #[in] #[opt] pcbe: PTP_CALLBACK_ENVIRON) -> BOOL;
        #[library("KERNEL32.dll")]
        extern fn WaitForThreadpoolIoCallbacks(#[in] #[out] pio: PTP_IO, #[in] fCancelPendingCallbacks: BOOL);
        #[library("KERNEL32.dll")]
        extern fn WaitForThreadpoolTimerCallbacks(#[in] #[out] pti: PTP_TIMER, #[in] fCancelPendingCallbacks: BOOL);
        #[library("KERNEL32.dll")]
        extern fn WaitForThreadpoolWaitCallbacks(#[in] #[out] pwa: PTP_WAIT, #[in] fCancelPendingCallbacks: BOOL);
        #[library("KERNEL32.dll")]
        extern fn WaitForThreadpoolWorkCallbacks(#[in] #[out] pwk: PTP_WORK, #[in] fCancelPendingCallbacks: BOOL);
    }
}
