#[win32]
mod Windows {
    mod Win32 {
        type PWINUSB_INTERFACE_HANDLE = *mut *mut void;
        type PWINUSB_ISOCH_BUFFER_HANDLE = *mut *mut void;
        type PWINUSB_SETUP_PACKET = *mut WINUSB_SETUP_PACKET;
        type WINUSB_INTERFACE_HANDLE = *mut void;
        type WINUSB_ISOCH_BUFFER_HANDLE = *mut void;
        #[packed(1)]
        struct WINUSB_SETUP_PACKET {
            RequestType: u8,
            Request: u8,
            Value: u16,
            Index: u16,
            Length: u16,
        }
        #[library("WINUSB.DLL")]
        extern fn WinUsb_AbortPipe(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ControlTransfer(InterfaceHandle: WINUSB_INTERFACE_HANDLE, SetupPacket: WINUSB_SETUP_PACKET, #[size_param(3)] #[out] #[opt] Buffer: PUCHAR, BufferLength: u32, #[out] #[opt] LengthTransferred: PULONG, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_FlushPipe(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_Free(InterfaceHandle: WINUSB_INTERFACE_HANDLE) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetAdjustedFrameNumber(#[in] #[out] CurrentFrameNumber: PULONG, TimeStamp: LARGE_INTEGER) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetAssociatedInterface(InterfaceHandle: WINUSB_INTERFACE_HANDLE, AssociatedInterfaceIndex: u8, #[out] AssociatedInterfaceHandle: PWINUSB_INTERFACE_HANDLE) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetCurrentAlternateSetting(InterfaceHandle: WINUSB_INTERFACE_HANDLE, #[out] SettingNumber: PUCHAR) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetCurrentFrameNumber(InterfaceHandle: WINUSB_INTERFACE_HANDLE, #[out] CurrentFrameNumber: PULONG, TimeStamp: *mut LARGE_INTEGER) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetCurrentFrameNumberAndQpc(InterfaceHandle: WINUSB_INTERFACE_HANDLE, FrameQpcInfo: PUSB_FRAME_NUMBER_AND_QPC_FOR_TIME_SYNC_INFORMATION) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetDescriptor(InterfaceHandle: WINUSB_INTERFACE_HANDLE, DescriptorType: u8, Index: u8, LanguageID: u16, #[size_param(5)] #[out] #[opt] Buffer: PUCHAR, BufferLength: u32, #[out] LengthTransferred: PULONG) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetOverlappedResult(InterfaceHandle: WINUSB_INTERFACE_HANDLE, lpOverlapped: LPOVERLAPPED, #[out] lpNumberOfBytesTransferred: LPDWORD, bWait: BOOL) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetPipePolicy(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8, PolicyType: u32, #[in] #[out] ValueLength: PULONG, #[size_param(3)] Value: *mut void) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_GetPowerPolicy(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PolicyType: u32, #[in] #[out] ValueLength: PULONG, #[size_param(2)] Value: *mut void) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_Initialize(DeviceHandle: HANDLE, #[out] InterfaceHandle: PWINUSB_INTERFACE_HANDLE) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ParseConfigurationDescriptor(ConfigurationDescriptor: PUSB_CONFIGURATION_DESCRIPTOR, #[in] StartPosition: *mut void, InterfaceNumber: i32, AlternateSetting: i32, InterfaceClass: i32, InterfaceSubClass: i32, InterfaceProtocol: i32) -> PUSB_INTERFACE_DESCRIPTOR;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ParseDescriptors(#[size_param(1)] #[in] DescriptorBuffer: *mut void, TotalLength: u32, #[in] StartPosition: *mut void, DescriptorType: i32) -> PUSB_COMMON_DESCRIPTOR;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_QueryDeviceInformation(InterfaceHandle: WINUSB_INTERFACE_HANDLE, InformationType: u32, #[in] #[out] BufferLength: PULONG, #[size_param(2)] Buffer: *mut void) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_QueryInterfaceSettings(InterfaceHandle: WINUSB_INTERFACE_HANDLE, AlternateInterfaceNumber: u8, #[out] UsbAltInterfaceDescriptor: PUSB_INTERFACE_DESCRIPTOR) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_QueryPipe(InterfaceHandle: WINUSB_INTERFACE_HANDLE, AlternateInterfaceNumber: u8, PipeIndex: u8, #[out] PipeInformation: PWINUSB_PIPE_INFORMATION) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_QueryPipeEx(InterfaceHandle: WINUSB_INTERFACE_HANDLE, AlternateSettingNumber: u8, PipeIndex: u8, #[out] PipeInformationEx: PWINUSB_PIPE_INFORMATION_EX) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ReadIsochPipe(BufferHandle: WINUSB_ISOCH_BUFFER_HANDLE, Offset: u32, Length: u32, #[in] #[out] FrameNumber: PULONG, NumberOfPackets: u32, #[len_param(4)] #[out] IsoPacketDescriptors: PUSBD_ISO_PACKET_DESCRIPTOR, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ReadIsochPipeAsap(BufferHandle: WINUSB_ISOCH_BUFFER_HANDLE, Offset: u32, Length: u32, ContinueStream: BOOL, NumberOfPackets: u32, #[len_param(4)] #[out] IsoPacketDescriptors: PUSBD_ISO_PACKET_DESCRIPTOR, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ReadPipe(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8, #[size_param(3)] #[out] #[opt] Buffer: PUCHAR, BufferLength: u32, #[out] #[opt] LengthTransferred: PULONG, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_RegisterIsochBuffer(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8, #[size_param(3)] #[in] #[out] Buffer: PUCHAR, BufferLength: u32, #[out] IsochBufferHandle: PWINUSB_ISOCH_BUFFER_HANDLE) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_ResetPipe(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_SetCurrentAlternateSetting(InterfaceHandle: WINUSB_INTERFACE_HANDLE, SettingNumber: u8) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_SetPipePolicy(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8, PolicyType: u32, ValueLength: u32, #[size_param(3)] #[in] Value: *mut void) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_SetPowerPolicy(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PolicyType: u32, ValueLength: u32, #[size_param(2)] #[in] Value: *mut void) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_StartTrackingForTimeSync(InterfaceHandle: WINUSB_INTERFACE_HANDLE, StartTrackingInfo: PUSB_START_TRACKING_FOR_TIME_SYNC_INFORMATION) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_StopTrackingForTimeSync(InterfaceHandle: WINUSB_INTERFACE_HANDLE, StopTrackingInfo: PUSB_STOP_TRACKING_FOR_TIME_SYNC_INFORMATION) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_UnregisterIsochBuffer(IsochBufferHandle: WINUSB_ISOCH_BUFFER_HANDLE) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_WriteIsochPipe(BufferHandle: WINUSB_ISOCH_BUFFER_HANDLE, Offset: u32, Length: u32, #[in] #[out] FrameNumber: PULONG, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_WriteIsochPipeAsap(BufferHandle: WINUSB_ISOCH_BUFFER_HANDLE, Offset: u32, Length: u32, ContinueStream: BOOL, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
        #[library("WINUSB.DLL")]
        extern fn WinUsb_WritePipe(InterfaceHandle: WINUSB_INTERFACE_HANDLE, PipeID: u8, #[size_param(3)] Buffer: PUCHAR, BufferLength: u32, #[out] #[opt] LengthTransferred: PULONG, #[opt] Overlapped: LPOVERLAPPED) -> BOOL;
    }
}
