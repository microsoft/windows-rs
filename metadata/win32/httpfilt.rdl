#[win32]
mod Windows {
    mod Win32 {
        #[library("RpcProxy.dll")]
        extern fn GetFilterVersion(pVer: *mut HTTP_FILTER_VERSION) -> BOOL;
        struct HTTP_FILTER_ACCESS_DENIED {
            pszURL: *const CHAR,
            pszPhysicalPath: *const CHAR,
            dwReason: DWORD,
        }
        struct HTTP_FILTER_AUTHENT {
            pszUser: *mut CHAR,
            cbUserBuff: DWORD,
            pszPassword: *mut CHAR,
            cbPasswordBuff: DWORD,
        }
        struct HTTP_FILTER_AUTH_COMPLETE_INFO {
            GetHeader: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPVOID, LPDWORD) -> BOOL,
            SetHeader: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPSTR) -> BOOL,
            AddHeader: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPSTR) -> BOOL,
            GetUserToken: extern fn(*mut HTTP_FILTER_CONTEXT, *mut HANDLE) -> BOOL,
            HttpStatus: DWORD,
            fResetAuth: BOOL,
            dwReserved: DWORD,
        }
        struct HTTP_FILTER_CONTEXT {
            cbSize: DWORD,
            Revision: DWORD,
            ServerContext: PVOID,
            ulReserved: DWORD,
            fIsSecurePort: BOOL,
            pFilterContext: PVOID,
            GetServerVariable: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPVOID, LPDWORD) -> BOOL,
            AddResponseHeaders: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, DWORD) -> BOOL,
            WriteClient: extern fn(*mut HTTP_FILTER_CONTEXT, LPVOID, LPDWORD, DWORD) -> BOOL,
            AllocMem: extern fn(*mut HTTP_FILTER_CONTEXT, DWORD, DWORD) -> *mut void,
            ServerSupportFunction: extern fn(*mut HTTP_FILTER_CONTEXT, SF_REQ_TYPE, PVOID, ULONG_PTR, ULONG_PTR) -> BOOL,
        }
        struct HTTP_FILTER_LOG {
            pszClientHostName: *const CHAR,
            pszClientUserName: *const CHAR,
            pszServerName: *const CHAR,
            pszOperation: *const CHAR,
            pszTarget: *const CHAR,
            pszParameters: *const CHAR,
            dwHttpStatus: DWORD,
            dwWin32Status: DWORD,
            dwBytesSent: DWORD,
            dwBytesRecvd: DWORD,
            msTimeForProcessing: DWORD,
        }
        struct HTTP_FILTER_PREPROC_HEADERS {
            GetHeader: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPVOID, LPDWORD) -> BOOL,
            SetHeader: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPSTR) -> BOOL,
            AddHeader: extern fn(*mut HTTP_FILTER_CONTEXT, LPSTR, LPSTR) -> BOOL,
            HttpStatus: DWORD,
            dwReserved: DWORD,
        }
        struct HTTP_FILTER_RAW_DATA {
            pvInData: PVOID,
            cbInData: DWORD,
            cbInBuffer: DWORD,
            dwReserved: DWORD,
        }
        const HTTP_FILTER_REVISION: LONG = 655360;
        type HTTP_FILTER_SEND_RESPONSE = HTTP_FILTER_PREPROC_HEADERS;
        struct HTTP_FILTER_URL_MAP {
            pszURL: *const CHAR,
            pszPhysicalPath: *mut CHAR,
            cbPathBuff: DWORD,
        }
        struct HTTP_FILTER_URL_MAP_EX {
            pszURL: *const CHAR,
            pszPhysicalPath: *mut CHAR,
            cbPathBuff: DWORD,
            dwFlags: DWORD,
            cchMatchingPath: DWORD,
            cchMatchingURL: DWORD,
            pszScriptMapEntry: *const CHAR,
        }
        struct HTTP_FILTER_VERSION {
            dwServerFilterVersion: DWORD,
            dwFilterVersion: DWORD,
            lpszFilterDesc: [CHAR; 257],
            dwFlags: DWORD,
        }
        #[library("RpcProxy.dll")]
        extern fn HttpFilterProc(pfc: *mut HTTP_FILTER_CONTEXT, NotificationType: DWORD, pvNotification: *mut void) -> DWORD;
        type PHTTP_FILTER_ACCESS_DENIED = *mut HTTP_FILTER_ACCESS_DENIED;
        type PHTTP_FILTER_AUTHENT = *mut HTTP_FILTER_AUTHENT;
        type PHTTP_FILTER_AUTH_COMPLETE_INFO = *mut HTTP_FILTER_AUTH_COMPLETE_INFO;
        type PHTTP_FILTER_CONTEXT = *mut HTTP_FILTER_CONTEXT;
        type PHTTP_FILTER_LOG = *mut HTTP_FILTER_LOG;
        type PHTTP_FILTER_PREPROC_HEADERS = *mut HTTP_FILTER_PREPROC_HEADERS;
        type PHTTP_FILTER_RAW_DATA = *mut HTTP_FILTER_RAW_DATA;
        type PHTTP_FILTER_SEND_RESPONSE = *mut HTTP_FILTER_PREPROC_HEADERS;
        type PHTTP_FILTER_URL_MAP = *mut HTTP_FILTER_URL_MAP;
        type PHTTP_FILTER_URL_MAP_EX = *mut HTTP_FILTER_URL_MAP_EX;
        type PHTTP_FILTER_VERSION = *mut HTTP_FILTER_VERSION;
        const SF_DENIED_APPLICATION: i32 = 8;
        const SF_DENIED_BY_CONFIG: i32 = 65536;
        const SF_DENIED_FILTER: i32 = 4;
        const SF_DENIED_LOGON: i32 = 1;
        const SF_DENIED_RESOURCE: i32 = 2;
        const SF_MAX_AUTH_TYPE: i32 = 33;
        const SF_MAX_FILTER_DESC_LEN: i32 = 257;
        const SF_MAX_PASSWORD: i32 = 257;
        const SF_MAX_USERNAME: i32 = 257;
        const SF_NOTIFY_ACCESS_DENIED: i32 = 2048;
        const SF_NOTIFY_AUTHENTICATION: i32 = 8192;
        const SF_NOTIFY_AUTH_COMPLETE: i32 = 67108864;
        const SF_NOTIFY_END_OF_NET_SESSION: i32 = 256;
        const SF_NOTIFY_END_OF_REQUEST: i32 = 128;
        const SF_NOTIFY_LOG: i32 = 512;
        const SF_NOTIFY_NONSECURE_PORT: i32 = 2;
        const SF_NOTIFY_ORDER_DEFAULT: i32 = 131072;
        const SF_NOTIFY_ORDER_HIGH: i32 = 524288;
        const SF_NOTIFY_ORDER_LOW: i32 = 131072;
        const SF_NOTIFY_ORDER_MASK: i32 = 917504;
        const SF_NOTIFY_ORDER_MEDIUM: i32 = 262144;
        const SF_NOTIFY_PREPROC_HEADERS: i32 = 16384;
        const SF_NOTIFY_READ_RAW_DATA: i32 = 32768;
        const SF_NOTIFY_SECURE_PORT: i32 = 1;
        const SF_NOTIFY_SEND_RAW_DATA: i32 = 1024;
        const SF_NOTIFY_SEND_RESPONSE: i32 = 64;
        const SF_NOTIFY_URL_MAP: i32 = 4096;
        #[repr(i32)]
        enum SF_PROPERTY_IIS {
            SF_PROPERTY_SSL_CTXT = 0,
            SF_PROPERTY_INSTANCE_NUM_ID = 1,
        }
        #[repr(i32)]
        enum SF_REQ_TYPE {
            SF_REQ_SEND_RESPONSE_HEADER = 0,
            SF_REQ_ADD_HEADERS_ON_DENIAL = 1,
            SF_REQ_SET_NEXT_READ_SIZE = 2,
            SF_REQ_SET_PROXY_INFO = 3,
            SF_REQ_GET_CONNID = 4,
            SF_REQ_SET_CERTIFICATE_INFO = 5,
            SF_REQ_GET_PROPERTY = 6,
            SF_REQ_NORMALIZE_URL = 7,
            SF_REQ_DISABLE_NOTIFICATIONS = 8,
        }
        #[repr(i32)]
        enum SF_STATUS_TYPE {
            SF_STATUS_REQ_FINISHED = 134217728,
            SF_STATUS_REQ_FINISHED_KEEP_CONN = 134217729,
            SF_STATUS_REQ_NEXT_NOTIFICATION = 134217730,
            SF_STATUS_REQ_HANDLED_NOTIFICATION = 134217731,
            SF_STATUS_REQ_ERROR = 134217732,
            SF_STATUS_REQ_READ_NEXT = 134217733,
        }
    }
}
