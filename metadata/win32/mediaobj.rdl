        }
        #[guid(0xd8ad0f58_5494_4102_97c5_ec798e59bcf4)]
        interface IMediaObject: IUnknown {
            fn GetStreamCount(&self, #[out] pcInputStreams: *mut DWORD, #[out] pcOutputStreams: *mut DWORD) -> HRESULT;
            fn GetInputStreamInfo(&self, dwInputStreamIndex: DWORD, #[out] pdwFlags: *mut DWORD) -> HRESULT;
            fn GetOutputStreamInfo(&self, dwOutputStreamIndex: DWORD, #[out] pdwFlags: *mut DWORD) -> HRESULT;
            fn GetInputType(&self, dwInputStreamIndex: DWORD, dwTypeIndex: DWORD, #[out] #[opt] pmt: *mut DMO_MEDIA_TYPE) -> HRESULT;
            fn GetOutputType(&self, dwOutputStreamIndex: DWORD, dwTypeIndex: DWORD, #[out] #[opt] pmt: *mut DMO_MEDIA_TYPE) -> HRESULT;
            fn SetInputType(&self, dwInputStreamIndex: DWORD, #[in] #[opt] pmt: *const DMO_MEDIA_TYPE, dwFlags: DWORD) -> HRESULT;
            fn SetOutputType(&self, dwOutputStreamIndex: DWORD, #[in] #[opt] pmt: *const DMO_MEDIA_TYPE, dwFlags: DWORD) -> HRESULT;
            fn GetInputCurrentType(&self, dwInputStreamIndex: DWORD, #[out] pmt: *mut DMO_MEDIA_TYPE) -> HRESULT;
            fn GetOutputCurrentType(&self, dwOutputStreamIndex: DWORD, #[out] pmt: *mut DMO_MEDIA_TYPE) -> HRESULT;
            fn GetInputSizeInfo(&self, dwInputStreamIndex: DWORD, #[out] pcbSize: *mut DWORD, #[out] pcbMaxLookahead: *mut DWORD, #[out] pcbAlignment: *mut DWORD) -> HRESULT;
            fn GetOutputSizeInfo(&self, dwOutputStreamIndex: DWORD, #[out] pcbSize: *mut DWORD, #[out] pcbAlignment: *mut DWORD) -> HRESULT;
            fn GetInputMaxLatency(&self, dwInputStreamIndex: DWORD, #[out] prtMaxLatency: *mut REFERENCE_TIME) -> HRESULT;
            fn SetInputMaxLatency(&self, dwInputStreamIndex: DWORD, rtMaxLatency: REFERENCE_TIME) -> HRESULT;
            fn Flush(&self) -> HRESULT;
            fn Discontinuity(&self, dwInputStreamIndex: DWORD) -> HRESULT;
            fn AllocateStreamingResources(&self) -> HRESULT;
            fn FreeStreamingResources(&self) -> HRESULT;
            fn GetInputStatus(&self, dwInputStreamIndex: DWORD, #[out] dwFlags: *mut DWORD) -> HRESULT;
            fn ProcessInput(&self, dwInputStreamIndex: DWORD, pBuffer: IMediaBuffer, dwFlags: DWORD, rtTimestamp: REFERENCE_TIME, rtTimelength: REFERENCE_TIME) -> HRESULT;
            fn ProcessOutput(&self, dwFlags: DWORD, cOutputBufferCount: DWORD, #[in] #[out] #[writable(entry, cOutputBufferCount)] pOutputBuffers: *mut DMO_OUTPUT_DATA_BUFFER, #[out] pdwStatus: *mut DWORD) -> HRESULT;
            fn Lock(&self, bLock: LONG) -> HRESULT;
        }
