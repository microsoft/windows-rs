        interface IEnumDMO: IUnknown {
            fn Next(&self, cItemsToFetch: DWORD, #[out] #[writable(entry, cItemsToFetch)] #[readable(success, *pcItemsFetched)] pCLSID: *mut CLSID, #[out] #[writable(entry, cItemsToFetch)] #[readable(success, *pcItemsFetched)] Names: *mut LPWSTR, #[out] pcItemsFetched: *mut DWORD) -> HRESULT;
