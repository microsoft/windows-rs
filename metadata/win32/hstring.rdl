#[win32]
mod Windows {
    mod Win32 {
        type HSTRING = *mut HSTRING__;
        type HSTRING_BUFFER = *mut HSTRING_BUFFER__;
        struct HSTRING_BUFFER__ {
            unused: i32,
        }
        #[arch(X64 | Arm64)]
        struct HSTRING_HEADER {
            Reserved: union {
                Reserved1: *mut void,
                Reserved2: [i8; 24],
            },
        }
        #[arch(X86)]
        struct HSTRING_HEADER {
            Reserved: union {
                Reserved1: *mut void,
                Reserved2: [i8; 20],
            },
        }
        struct HSTRING__ {
            unused: i32,
        }
    }
}
