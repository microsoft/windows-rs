#[win32]
mod Windows {
    mod Win32 {
        type LPVIDEOPARAMETERS = *mut VIDEOPARAMETERS;
        type PVIDEOPARAMETERS = *mut VIDEOPARAMETERS;
        struct VIDEOPARAMETERS {
            Guid: GUID,
            dwOffset: ULONG,
            dwCommand: ULONG,
            dwFlags: ULONG,
            dwMode: ULONG,
            dwTVStandard: ULONG,
            dwAvailableModes: ULONG,
            dwAvailableTVStandard: ULONG,
            dwFlickerFilter: ULONG,
            dwOverScanX: ULONG,
            dwOverScanY: ULONG,
            dwMaxUnscaledX: ULONG,
            dwMaxUnscaledY: ULONG,
            dwPositionX: ULONG,
            dwPositionY: ULONG,
            dwBrightness: ULONG,
            dwContrast: ULONG,
            dwCPType: ULONG,
            dwCPCommand: ULONG,
            dwCPStandard: ULONG,
            dwCPKey: ULONG,
            bCP_APSTriggerBits: ULONG,
            bOEMCopyProtection: [UCHAR; 256],
        }
        const VP_COMMAND_GET: i32 = 1;
        const VP_COMMAND_SET: i32 = 2;
        const VP_CP_CMD_ACTIVATE: i32 = 1;
        const VP_CP_CMD_CHANGE: i32 = 4;
        const VP_CP_CMD_DEACTIVATE: i32 = 2;
        const VP_CP_TYPE_APS_TRIGGER: i32 = 1;
        const VP_CP_TYPE_MACROVISION: i32 = 2;
        const VP_FLAGS_BRIGHTNESS: i32 = 64;
        const VP_FLAGS_CONTRAST: i32 = 128;
        const VP_FLAGS_COPYPROTECT: i32 = 256;
        const VP_FLAGS_FLICKER: i32 = 4;
        const VP_FLAGS_MAX_UNSCALED: i32 = 16;
        const VP_FLAGS_OVERSCAN: i32 = 8;
        const VP_FLAGS_POSITION: i32 = 32;
        const VP_FLAGS_TV_MODE: i32 = 1;
        const VP_FLAGS_TV_STANDARD: i32 = 2;
        const VP_MODE_TV_PLAYBACK: i32 = 2;
        const VP_MODE_WIN_GRAPHICS: i32 = 1;
        const VP_TV_STANDARD_NTSC_433: i32 = 65536;
        const VP_TV_STANDARD_NTSC_M: i32 = 1;
        const VP_TV_STANDARD_NTSC_M_J: i32 = 2;
        const VP_TV_STANDARD_PAL_60: i32 = 262144;
        const VP_TV_STANDARD_PAL_B: i32 = 4;
        const VP_TV_STANDARD_PAL_D: i32 = 8;
        const VP_TV_STANDARD_PAL_G: i32 = 131072;
        const VP_TV_STANDARD_PAL_H: i32 = 16;
        const VP_TV_STANDARD_PAL_I: i32 = 32;
        const VP_TV_STANDARD_PAL_M: i32 = 64;
        const VP_TV_STANDARD_PAL_N: i32 = 128;
        const VP_TV_STANDARD_SECAM_B: i32 = 256;
        const VP_TV_STANDARD_SECAM_D: i32 = 512;
        const VP_TV_STANDARD_SECAM_G: i32 = 1024;
        const VP_TV_STANDARD_SECAM_H: i32 = 2048;
        const VP_TV_STANDARD_SECAM_K: i32 = 4096;
        const VP_TV_STANDARD_SECAM_K1: i32 = 8192;
        const VP_TV_STANDARD_SECAM_L: i32 = 16384;
        const VP_TV_STANDARD_SECAM_L1: i32 = 524288;
        const VP_TV_STANDARD_WIN_VGA: i32 = 32768;
    }
}
