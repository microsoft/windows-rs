        const MM_STREAM_DONE: i32 = 982;
        const MM_STREAM_ERROR: i32 = 983;
        const MM_STREAM_OPEN: i32 = 980;
        const MM_WIM_CLOSE: i32 = 959;
        const MM_WIM_DATA: i32 = 960;
        const MM_WIM_OPEN: i32 = 958;
