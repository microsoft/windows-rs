        const MM_WOM_OPEN: i32 = 955;
        type NPMMTIME = *mut MMTIME;
        extern fn PDRVCALLBACK(hdrvr: HDRVR, uMsg: u32, dwUser: usize, dw1: usize, dw2: usize);
        type PMMTIME = *mut MMTIME;
        const TIMERR_BASE: i32 = 96;
        const TIME_BYTES: i32 = 4;
        const TIME_MIDI: i32 = 16;
        const TIME_MS: i32 = 1;
        const TIME_SAMPLES: i32 = 2;
        const TIME_SMPTE: i32 = 8;
        const TIME_TICKS: i32 = 32;
        const WAVERR_BASE: i32 = 32;
    }
}
