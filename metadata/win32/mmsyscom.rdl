        const JOYERR_BASE: i32 = 160;
        extern fn LPDRVCALLBACK(hdrvr: HDRVR, uMsg: u32, dwUser: usize, dw1: usize, dw2: usize);
        type LPMMTIME = *mut MMTIME;
        type LPUINT = *mut u32;
        const MAXERRORLENGTH: i32 = 256;
