        const MMSYSERR_WRITEERROR: i32 = 17;
        #[packed(1)]
        struct MMTIME {
            wType: u32,
            u: #[packed(1)] union {
                ms: u32,
                sample: u32,
                cb: u32,
                ticks: u32,
                smpte: struct {
                    hour: u8,
                    min: u8,
                    sec: u8,
                    frame: u8,
                    fps: u8,
                    dummy: u8,
                    pad: [u8; 2],
                },
                midi: #[packed(1)] struct {
                    songptrpos: u32,
                },
            },
        }
        type MMVERSION = u32;
        const MM_DRVM_CLOSE: i32 = 977;
        const MM_DRVM_DATA: i32 = 978;
        const MM_DRVM_ERROR: i32 = 979;
        const MM_DRVM_OPEN: i32 = 976;
        const MM_JOY1BUTTONDOWN: i32 = 949;
        const MM_JOY1BUTTONUP: i32 = 951;
        const MM_JOY1MOVE: i32 = 928;
        const MM_JOY1ZMOVE: i32 = 930;
        const MM_JOY2BUTTONDOWN: i32 = 950;
        const MM_JOY2BUTTONUP: i32 = 952;
