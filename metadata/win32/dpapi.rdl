#[win32]
mod Windows {
    mod Win32 {
        const CRYPTPROTECTMEMORY_BLOCK_SIZE: i32 = 16;
        const CRYPTPROTECTMEMORY_CROSS_PROCESS: i32 = 1;
        const CRYPTPROTECTMEMORY_SAME_LOGON: i32 = 2;
        const CRYPTPROTECTMEMORY_SAME_PROCESS: i32 = 0;
        const CRYPTPROTECT_AUDIT: i32 = 16;
        const CRYPTPROTECT_CRED_REGENERATE: i32 = 128;
        const CRYPTPROTECT_CRED_SYNC: i32 = 8;
        const CRYPTPROTECT_FIRST_RESERVED_FLAGVAL: i32 = 268435455;
        const CRYPTPROTECT_LAST_RESERVED_FLAGVAL: u32 = 4294967295;
        const CRYPTPROTECT_LOCAL_MACHINE: i32 = 4;
        const CRYPTPROTECT_NO_RECOVERY: i32 = 32;
        struct CRYPTPROTECT_PROMPTSTRUCT {
            cbSize: DWORD,
            dwPromptFlags: DWORD,
            hwndApp: HWND,
            szPrompt: LPCWSTR,
        }
        const CRYPTPROTECT_PROMPT_ON_PROTECT: i32 = 2;
        const CRYPTPROTECT_PROMPT_ON_UNPROTECT: i32 = 1;
        const CRYPTPROTECT_PROMPT_REQUIRE_STRONG: i32 = 16;
        const CRYPTPROTECT_PROMPT_RESERVED: i32 = 4;
        const CRYPTPROTECT_PROMPT_STRONG: i32 = 8;
        const CRYPTPROTECT_UI_FORBIDDEN: i32 = 1;
        const CRYPTPROTECT_VERIFY_PROTECTION: i32 = 64;
        #[library("CRYPT32.dll")]
        extern fn CryptProtectData(#[in] pDataIn: *mut DATA_BLOB, #[in] #[opt] szDataDescr: LPCWSTR, #[in] #[opt] pOptionalEntropy: *mut DATA_BLOB, #[reserved] pvReserved: PVOID, #[in] #[opt] pPromptStruct: *mut CRYPTPROTECT_PROMPTSTRUCT, #[in] dwFlags: DWORD, #[out] pDataOut: *mut DATA_BLOB) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptProtectMemory(#[in] #[out] pDataIn: LPVOID, #[in] cbDataIn: DWORD, #[in] dwFlags: DWORD) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptUnprotectData(#[in] pDataIn: *mut DATA_BLOB, #[nullable] #[opt] #[out] #[out_ptr] ppszDataDescr: *mut LPWSTR, #[in] #[opt] pOptionalEntropy: *mut DATA_BLOB, #[reserved] pvReserved: PVOID, #[in] #[opt] pPromptStruct: *mut CRYPTPROTECT_PROMPTSTRUCT, #[in] dwFlags: DWORD, #[out] pDataOut: *mut DATA_BLOB) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptUnprotectMemory(#[in] #[out] pDataIn: LPVOID, #[in] cbDataIn: DWORD, #[in] dwFlags: DWORD) -> BOOL;
        #[library("CRYPT32.dll")]
        extern fn CryptUpdateProtectedState(#[in] #[opt] pOldSid: PSID, #[in] #[opt] pwszOldPassword: LPCWSTR, #[in] dwFlags: DWORD, #[opt] #[out] pdwSuccessCount: *mut DWORD, #[opt] #[out] pdwFailureCount: *mut DWORD) -> BOOL;
        type PCRYPTPROTECT_PROMPTSTRUCT = *mut CRYPTPROTECT_PROMPTSTRUCT;
        const dwFORCE_KEY_PROTECTION_DISABLED: i32 = 0;
        const dwFORCE_KEY_PROTECTION_HIGH: i32 = 2;
        const dwFORCE_KEY_PROTECTION_USER_SELECT: i32 = 1;
        #[encoding("ansi")]
        const szFORCE_KEY_PROTECTION: String = "ForceKeyProtection";
    }
}
