// Hand-authored metadata vocabulary seed (NOT generated from headers).
//
// These attribute types live only in metadata, not in any C header, so the
// scraper cannot derive them. They are the `Windows.Win32.Metadata` attributes
// that the converter emits and that bindgen consumes, making the merged
// `Windows.Win32.winmd` self-contained without an upstream reference winmd.
//
// `Native` attributes preserve C/C++ declaration details: typedef identity, anonymous records,
// bitfields, 64-bit pointers, base storage and vtable slots.
// Unprefixed attributes state language-neutral API facts.
#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            // Associates integer storage with an enum without changing the native signature.
            // RDL: `#[associated_enum(EnumType)]` on parameters, returns and fields.
            attribute AssociatedEnumAttribute {
                fn(#[in] enumType: Type);
            }
            // Marks a function that never returns (`__declspec(noreturn)`). RDL: `#[noreturn]`.
            attribute DoesNotReturnAttribute {
                fn();
            }
            // The caller should use the callable's result rather than accidentally discard it.
            // This is not a success predicate, purity promise or change to the signature.
            // RDL: `#[must_use]`.
            attribute MustUseAttribute {
                fn();
            }
            // Records the character encoding of a string constant or field.
            // RDL: `#[encoding("...")]`.
            attribute EncodingAttribute {
                fn(#[in] encoding: String);
            }
            // Marks a typedef of a primitive that should retain its distinct identity.
            // RDL: written as the `type NAME = TYPE;` form.
            attribute NativeTypedefAttribute {
                fn();
            }
            // An unnamed nested record, identified by its first owning native field position.
            // Inline RDL records carry this implicitly; explicit declarations use anonymous(N).
            attribute NativeAnonymousAttribute {
                fn(#[in] position: i32);
            }
            // Required modifier after PTR for fixed 64-bit data-pointer storage.
            attribute NativePointer64Attribute {
                fn();
            }
            // Marks the return-value parameter of a COM method. RDL: `#[retval]`.
            attribute RetValAttribute {
                fn();
            }
            // Restricts a declaration to specific processor architectures.
            // RDL: `#[arch(X86|X64|Arm64)]`.
            attribute SupportedArchitectureAttribute {
                fn(#[in] architecture: i32);
            }
            // Raises record or member alignment without changing a member's type.
            // RDL: `#[align(N)]` on records and members.
            attribute AlignmentAttribute {
                fn(#[in] alignment: i32);
            }
            // Caller-supplied extent at entry. Direction and ownership are separate.
            // Exactly one count source is required; omitted Boolean properties are false.
            // RDL: `#[buffer(count)]`, `#[buffer(bytes(count))]`.
            attribute BufferAttribute {
                fn();
                CountConst: u64,
                CountParamIndex: u16,
                Dereference: bool,
                Bytes: bool,
            }
            // A buffer terminated by one zero element. Encoding, capacity and success are separate.
            // RDL: `#[null_terminated]`.
            attribute NullTerminatedAttribute {
                fn();
            }
            // A buffer terminated by two consecutive zero elements, typically a packed string list.
            // RDL: `#[null_null_terminated]`.
            attribute NullNullTerminatedAttribute {
                fn();
            }
            // Marks a parameter that is reserved and must be zero/null (SAL `_Reserved_`).
            // RDL: `#[reserved]`.
            attribute ReservedAttribute {
                fn();
            }
            // Marks a COM out-pointer parameter (SAL `_COM_Outptr_` and variants).
            // RDL: `#[iid_is]`.
            attribute ComOutPtrAttribute {
                fn();
            }
            // Marks an enum derived from a C++ scoped enum (`enum class`/`enum struct`),
            // which has distinct name-lookup/conversion semantics from a plain C enum.
            // RDL: `#[scoped]`.
            attribute ScopedEnumAttribute {
                fn();
            }
            // Records a bit-field member packed into a backing integer field. The C
            // bit-field concept has no winmd representation, so consecutive bit-fields
            // are coalesced into a single backing integer field (`_bitfield` /
            // `_bitfield1` / ...) and each logical member is recorded here, one
            // attribute instance per member, carrying the member's name, its bit
            // offset within the backing field, and its width in bits. bindgen reads
            // these to generate typed get/set accessors. Signedness of a multi-bit
            // member is taken from the backing field unless MemberType is supplied.
            // RDL: written as a C-like block on the backing field, e.g.
            // `_bitfield: u8 { Name: bool: 1, _: 3, Other: u8: 4 }` (padding is `_`).
            attribute NativeBitfieldAttribute {
                fn(#[in] name: String, #[in] offset: i64, #[in] length: i64);
                MemberType: Type,
            }
            // The header states contracts for this parameter that metadata does not express.
            // Consumers must not infer contracts from absent facts. RDL: `#[incomplete]`.
            attribute IncompleteAttribute {
                fn();
            }
            // Declaration deprecation with an optional message and relocated typedef ownership.
            // RDL: `#[deprecated]` or `#[deprecated("message")]`.
            attribute DeprecatedAttribute {
                fn();
                fn(#[in] message: String);
                TypedefName: String,
            }
            // Absolute inherited vtable slot. RDL: `#[override_slot(N)]`.
            attribute NativeOverrideSlotAttribute {
                fn(#[in] slot: u32);
            }
            // Marks native base storage, not an owning interface reference. Interface bases
            // contain one vptr; sequential fields and record packing determine their offsets.
            // RDL: `#[base]`.
            attribute NativeBaseAttribute {
                fn();
            }
        }
    }
}
