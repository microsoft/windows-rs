// Hand-authored metadata vocabulary seed (NOT generated from headers).
//
// These attribute types live only in metadata, not in any C header, so the
// scraper cannot derive them. They are the `Windows.Win32.Metadata` attributes
// that the converter emits and that bindgen consumes, making the merged
// `Windows.Win32.winmd` self-contained without an upstream reference winmd.
#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            // Marks a function that never returns (`__declspec(noreturn)`). RDL: `#[noreturn]`.
            attribute DoesNotReturnAttribute {
                fn();
            }
            // Records the native character encoding of a string constant or field.
            // RDL: `#[encoding("…")]`.
            attribute NativeEncodingAttribute {
                fn(encoding: String);
            }
            // Marks a typedef of a primitive that should retain its distinct identity.
            // RDL: written as the `type NAME = TYPE;` form.
            attribute NativeTypedefAttribute {
                fn();
            }
            // Marks the return-value parameter of a COM method. RDL: `#[retval]`.
            attribute RetValAttribute {
                fn();
            }
            // Restricts a declaration to specific processor architectures.
            // RDL: `#[arch(X86|X64|Arm64)]`.
            attribute SupportedArchitectureAttribute {
                fn(architecture: i32);
            }
            // Carries a raised structure alignment that packing alone cannot express.
            // RDL: `#[align(N)]`.
            attribute AlignmentAttribute {
                fn(alignment: i32);
            }
            // Records that a pointer parameter/field is a counted array. The element
            // count is either given by another parameter (`CountParamIndex`) or is a
            // compile-time constant (`CountConst`); derived from SAL `_*_reads_`/
            // `_*_writes_`/`_*_updates_` element-count macros.
            // RDL: `#[len_param(N)]` (CountParamIndex) or `#[len_const(N)]` (CountConst).
            attribute NativeArrayInfoAttribute {
                fn();
                CountParamIndex: i16,
                CountConst: i32,
                CountFieldName: String,
                // Also guarantees this capacity is writable on successful completion.
                PostWritable: bool,
            }
            // Records that a pointer parameter is a byte buffer whose size in bytes is
            // given by another parameter (`BytesParamIndex`); derived from SAL
            // `_*_bytes_` buffer macros.
            // RDL: `#[size_param(N)]`.
            attribute MemorySizeAttribute {
                fn();
                BytesParamIndex: i16,
            }
            // Buffer properties when the containing value is valid, not call pre/postconditions.
            // Names refer to direct integer fields of the same record. Capacity is writable;
            // ReadableFieldName, when present, gives the separately readable extent.
            // Null storage is permitted only with MayBeNull. No ownership or encoding is implied.
            attribute NativeFieldBufferAttribute {
                fn();
                CapacityFieldName: String,
                ReadableFieldName: String,
                IsByteCount: bool,
                MayBeNull: bool,
            }
            // Zero termination is independent of capacity and does not specify an encoding.
            // OnSuccess is a postcondition subject to the callable's success contract.
            attribute NativeNullTerminatedAttribute {
                fn();
                OnEntry: bool,
                OnSuccess: bool,
            }
            // Initialized length on successful completion, not allocated capacity.
            // CountParamIndex is zero-based. False IsByteCount means elements.
            // Dereference selects the pointed-to count and does not imply a non-null pointer.
            attribute NativeInitializedLengthAttribute {
                fn();
                CountParamIndex: i16,
                IsByteCount: bool,
                Dereference: bool,
                // With Dereference, use this by-value count when the count pointer is null.
                // Absence means there is no fallback; it is distinct from parameter index zero.
                NullFallbackParamIndex: i16,
            }
            // Valid input on entry. Pointer arguments are non-null unless optional.
            // ReadOnly records the additional SAL pointee-read-access contract. False does not
            // require writable storage. This does not change native qualifiers or imply a count.
            attribute NativeInputAttribute {
                fn();
                ReadOnly: bool,
            }
            // A parameter supplies storage for a returned pointer. If storage is supplied,
            // successful completion initializes it; a non-null result points to one readable
            // element. MayBeNull permits a null result on success, not a null storage argument.
            // NullOnFailure additionally requires a null result on failure. Success/failure
            // follows the callable's contract. This specifies no allocator or ownership transfer.
            attribute NativeReturnedPointerAttribute {
                fn();
                MayBeNull: bool,
                NullOnFailure: bool,
            }
            // Marks a parameter that is reserved and must be zero/null (SAL `_Reserved_`).
            // RDL: `#[reserved]`.
            attribute ReservedAttribute {
                fn();
            }
            // Marks a COM out-pointer parameter (SAL `_COM_Outptr_` and variants).
            // RDL: `#[iid_is]`.
            attribute ComOutPtrAttribute {
                fn();
            }
            // Marks an enum derived from a C++ scoped enum (`enum class`/`enum struct`),
            // which has distinct name-lookup/conversion semantics from a plain C enum.
            // RDL: `#[scoped]`.
            attribute ScopedEnumAttribute {
                fn();
            }
            // Records a bit-field member packed into a backing integer field. The C
            // bit-field concept has no winmd representation, so consecutive bit-fields
            // are coalesced into a single backing integer field (`_bitfield` /
            // `_bitfield1` / …) and each logical member is recorded here — one
            // attribute instance per member — carrying the member's name, its bit
            // offset within the backing field, and its width in bits. bindgen reads
            // these to generate typed get/set accessors. Signedness of a multi-bit
            // member is taken from the backing field unless MemberType is supplied.
            // RDL: written as a C-like block on the backing field, e.g.
            // `_bitfield: u8 { Name: 1, _: 3, Other: 4 }` (anonymous padding is `_`).
            attribute NativeBitfieldAttribute {
                fn(name: String, offset: i64, length: i64);
                MemberType: Type,
            }
            // Provisional native evidence emitted by windows-clang2.
            attribute NativeSalAttribute {
                fn(version: String, name: String, arguments: String, expanded: String);
                TypedefName: String,
            }
            attribute NativeDeprecatedAttribute {
                fn(message: String, replacement: String);
                TypedefName: String,
            }
            attribute NativeExceptionSpecificationAttribute {
                fn(specification: String);
            }
            attribute NativeDefaultArgumentAttribute {
                fn(expression: String);
            }
            attribute NativeConstMethodAttribute {
                fn();
            }
            attribute NativeOverrideSlotAttribute {
                fn(slot: u32);
            }
            attribute NativeBaseAttribute {
                fn();
            }
        }
    }
}
