// Hand-authored metadata vocabulary seed (NOT generated from headers).
//
// These attribute types live only in metadata, not in any C header, so the
// scraper cannot derive them. They are the `Windows.Win32.Metadata` attributes
// that the converter emits and that bindgen consumes, making the merged
// `Windows.Win32.winmd` self-contained without an upstream reference winmd.
#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            // Marks a function that never returns (`__declspec(noreturn)`). RDL: `#[noreturn]`.
            attribute DoesNotReturnAttribute {
                fn();
            }
            // Records the native character encoding of a string constant or field.
            // RDL: `#[encoding("…")]`.
            attribute NativeEncodingAttribute {
                fn(encoding: String);
            }
            // Marks a typedef of a primitive that should retain its distinct identity.
            // RDL: written as the `type NAME = TYPE;` form.
            attribute NativeTypedefAttribute {
                fn();
            }
            // Required signature modifier starting a mutable pointer run after an IsConst run.
            // Its meaning applies to that run only, not to parameter direction or optionality.
            attribute NativeMutableAttribute {
                fn();
            }
            // Required signature modifiers qualifying the following native type node.
            // RDL: `Const<T>` and `Volatile<T>`, independent of pointer runs and direction.
            attribute NativeConstAttribute {
                fn();
            }
            attribute NativeVolatileAttribute {
                fn();
            }
            // Raw evidence ordered within its source family on the owning declaration.
            attribute NativeAnnotationAttribute {
                fn(source: String, ordinal: i32, payload: String);
            }
            // Binds a source identifier in that annotation to an original parameter position.
            attribute NativeAnnotationBindingAttribute {
                fn(source: String, ordinal: i32, identifier: String, parameter: i32);
            }
            // Resolves a native record's nominal identity without exposing its storage.
            // RDL: `#[opaque] struct TAG {}` or `#[opaque] union TAG {}`.
            attribute NativeOpaqueAttribute {
                fn();
            }
            // Marks the return-value parameter of a COM method. RDL: `#[retval]`.
            attribute RetValAttribute {
                fn();
            }
            // Restricts a declaration to specific processor architectures.
            // RDL: `#[arch(X86|X64|Arm64)]`.
            attribute SupportedArchitectureAttribute {
                fn(architecture: i32);
            }
            // Carries a raised structure alignment that packing alone cannot express.
            // RDL: `#[align(N)]`.
            attribute AlignmentAttribute {
                fn(alignment: i32);
            }
            // Records that a pointer parameter/field is a counted array. The element
            // count is either given by another parameter (`CountParamIndex`) or is a
            // compile-time constant (`CountConst`); derived from SAL `_*_reads_`/
            // `_*_writes_`/`_*_updates_` element-count macros.
            // RDL: `#[len_param(N)]` (CountParamIndex) or `#[len_const(N)]` (CountConst).
            attribute NativeArrayInfoAttribute {
                fn();
                CountParamIndex: i16,
                CountConst: i32,
                CountFieldName: String,
            }
            // Records that a pointer parameter is a byte buffer whose size in bytes is
            // given by another parameter (`BytesParamIndex`); derived from SAL
            // `_*_bytes_` buffer macros.
            // RDL: `#[size_param(N)]`.
            attribute MemorySizeAttribute {
                fn();
                BytesParamIndex: i16,
            }
            // Marks a parameter that is reserved and must be zero/null (SAL `_Reserved_`).
            // RDL: `#[reserved]`.
            attribute ReservedAttribute {
                fn();
            }
            // Marks a COM out-pointer parameter (SAL `_COM_Outptr_` and variants).
            // RDL: `#[iid_is]`.
            attribute ComOutPtrAttribute {
                fn();
            }
            // Marks an enum derived from a C++ scoped enum (`enum class`/`enum struct`),
            // which has distinct name-lookup/conversion semantics from a plain C enum.
            // RDL: `#[scoped]`.
            attribute ScopedEnumAttribute {
                fn();
            }
            // Records a named logical member's interval within one backing field.
            // Companion descriptors retain its declared type, qualifiers, and raw evidence.
            // Without a type companion, the logical type is unspecified; legacy Rust
            // accessors use the backing type. Anonymous padding has no descriptor.
            // RDL: `bits: u8 { Name: i8: 1, _: 3, Other: 4 }`.
            attribute NativeBitfieldAttribute {
                fn(name: String, offset: i64, length: i64);
            }
            // Logical scalar/enum identity, separate from the backing allocation unit.
            attribute NativeBitfieldTypeAttribute {
                fn(name: String, logicalType: Type);
            }
            // Ordered Const/Volatile wrappers on that logical scalar: 1 = const, 2 = volatile.
            attribute NativeBitfieldQualifierAttribute {
                fn(name: String, ordinal: i32, qualifier: i32);
            }
            // Raw source evidence owned by a logical member, not by the backing unit.
            attribute NativeBitfieldAnnotationAttribute {
                fn(name: String, source: String, ordinal: i32, payload: String);
            }
            // Declaration-only data. Named exports use ordinal -1; ordinal imports use name "".
            // COFF import kinds: 1 = data, 2 = constant, independent of Const<T>.
            attribute NativeDataImportAttribute {
                fn(dll: String, name: String, ordinal: i32, kind: i32);
            }
            // Absolute native vtable extent and inherited prefix; not MethodDef row order.
            attribute NativeVtableAttribute {
                fn(size: i32, inherited: i32);
            }
            attribute NativeSlotAttribute {
                fn(index: i32);
            }
            // The same absolute slot on this inherited declaration owner.
            attribute NativeSlotReuseAttribute {
                fn(owner: Type);
            }
            // Versioned semantic initializer; payload is not an object-memory image.
            attribute NativeConstantAttribute {
                fn(version: i32, payload: String);
            }
        }
    }
}
