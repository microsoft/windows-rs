// Hand-authored metadata vocabulary seed (NOT generated from headers).
//
// These attribute types live only in metadata, not in any C header, so the
// scraper cannot derive them. They are the `Windows.Win32.Metadata` attributes
// that the converter emits and that bindgen consumes, making the merged
// `Windows.Win32.winmd` self-contained without an upstream reference winmd.
//
// `Native` attributes preserve C/C++ declaration details: typedef identity, anonymous records,
// bitfields, 64-bit pointers, base storage and vtable slots.
// Unprefixed attributes state language-neutral API facts.
#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            // Marks a function that never returns (`__declspec(noreturn)`). RDL: `#[noreturn]`.
            attribute DoesNotReturnAttribute {
                fn();
            }
            // The caller should use the callable's result rather than accidentally discard it.
            // This is not a success predicate, purity promise or change to the signature.
            // RDL: `#[must_use]`.
            attribute MustUseAttribute {
                fn();
            }
            #[repr(i32)]
            enum SuccessCondition {
                EqualZero = 0,
                NotEqualZero = 1,
                EqualOne = 2,
                Nonnegative = 3,
                Positive = 4,
            }
            // Conditions ordinary postconditions, not complete-operation success or infallibility.
            // On a callable this overrides its return type's default; on a value typedef it
            // supplies that default. Zero means null for pointer results.
            // RDL: `#[success(return >= 0)]`.
            attribute SuccessConditionAttribute {
                fn(#[in] condition: SuccessCondition);
            }
            // Records the character encoding of a string constant or field.
            // RDL: `#[encoding("...")]`.
            attribute EncodingAttribute {
                fn(#[in] encoding: String);
            }
            // Marks a typedef of a primitive that should retain its distinct identity.
            // RDL: written as the `type NAME = TYPE;` form.
            attribute NativeTypedefAttribute {
                fn();
            }
            // An unnamed nested record, identified by its first owning native field position.
            // Inline RDL records carry this implicitly; explicit declarations use anonymous(N).
            attribute NativeAnonymousAttribute {
                fn(#[in] position: i32);
            }
            // Required modifier after PTR for fixed 64-bit data-pointer storage.
            attribute NativePointer64Attribute {
                fn();
            }
            // Marks the return-value parameter of a COM method. RDL: `#[retval]`.
            attribute RetValAttribute {
                fn();
            }
            // Restricts a declaration to specific processor architectures.
            // RDL: `#[arch(X86|X64|Arm64)]`.
            attribute SupportedArchitectureAttribute {
                fn(#[in] architecture: i32);
            }
            // Raises record or member alignment without changing a member's type.
            // RDL: `#[align(N)]` on records and members.
            attribute AlignmentAttribute {
                fn(#[in] alignment: i32);
            }
            #[repr(i32)]
            enum BufferAccess {
                Read = 0,
                Write = 1,
            }
            #[repr(i32)]
            enum BufferPhase {
                Entry = 0,
                Success = 1,
                Value = 2,
            }
            #[repr(i32)]
            enum BufferUnits {
                Elements = 0,
                Bytes = 1,
            }
            // Typed postfix integer expressions, versioned independently of native SAL text.
            // Bounds compare the subject using C integer promotions and usual conversions.
            // RDL: `#[range(entry, 0..=14 - start)]`, `#[range(entry, >0)]`.
            attribute IntegerRangeAttribute {
                fn(#[in] phase: BufferPhase);
                Lower: String,
                Upper: String,
                LowerExclusive: bool,
                UpperExclusive: bool,
                Indirect: bool,
            }
            // An accessible extent of the annotated buffer, independent of direction and ownership.
            // Exactly one count source is required. Counts use the contract phase unless CountOnEntry.
            // Indirect selects initialized pointer storage at the contract phase: the incoming
            // pointer on entry, or the returned pointer on success.
            // An indirect pointer is non-null at the contract phase unless NullableAttribute is
            // present, even with an unavailable optional count.
            // RDL: `#[readable(...)]`, `#[writable(...)]`.
            attribute BufferExtentAttribute {
                fn(#[in] access: BufferAccess, #[in] phase: BufferPhase, #[in] units: BufferUnits);
                CountConst: u64,
                CountParamIndex: u16,
                CountFieldName: String,
                CountReturn: bool,
                // The extent exists but its count is not expressible; never means zero.
                CountUnknown: bool,
                // Typed integer expression; cannot combine with Offset or CountOptional.
                // Optional dereferences are expression leaves and make the whole count unavailable.
                CountExpression: String,
                Dereference: bool,
                CountOnEntry: bool,
                // Null count storage means unknown extent, not zero or a nullable buffer.
                CountOptional: bool,
                // Legacy adjustment; new arithmetic uses CountExpression.
                Offset: u64,
                // Guards the single dereferenced count, including inside an expression.
                NullFallbackParamIndex: u16,
                Indirect: bool,
            }
            // Zero termination is independent of capacity and does not specify an encoding.
            // OnSuccess is a postcondition subject to the callable's success contract.
            // DoubleNullOnEntry/DoubleNullOnSuccess require two trailing zero elements at that
            // phase; absence means single zero termination. The corresponding phase must be true.
            // Indirect selects the pointer stored in the parameter at each specified phase.
            // Termination applies when that pointer is non-null; nullability is a separate contract.
            // RDL: `#[null_terminated(entry, double_success)]`.
            attribute NullTerminatedAttribute {
                fn();
                OnEntry: bool,
                OnSuccess: bool,
                DoubleNullOnEntry: bool,
                DoubleNullOnSuccess: bool,
                Indirect: bool,
            }
            // A pointer the API gives the caller may be null: on an output parameter, the pointer
            // stored through it; on a return, the returned value; on a field, the field. Argument
            // storage the caller may omit is the separate Optional param flag. Absence leaves
            // nullability unspecified unless an indirect BufferExtent or ReturnedPointer
            // promises a non-null pointer. This does not promise initialized/readable storage.
            // RDL: `#[nullable]`.
            attribute NullableAttribute {
                fn();
            }
            // A parameter supplies storage for a returned pointer. If storage is supplied,
            // successful completion initializes it to a non-null pointer to one readable element,
            // unless NullableAttribute is present. NullOnFailure requires a null result on failure.
            // Success/failure follows the callable's contract. This specifies no allocator or
            // ownership transfer. RDL: `#[out_ptr]`, `#[out_ptr(null_on_failure)]`.
            attribute ReturnedPointerAttribute {
                fn();
                NullOnFailure: bool,
            }
            // Marks a parameter that is reserved and must be zero/null (SAL `_Reserved_`).
            // RDL: `#[reserved]`.
            attribute ReservedAttribute {
                fn();
            }
            // Marks a COM out-pointer parameter (SAL `_COM_Outptr_` and variants).
            // RDL: `#[iid_is]`.
            attribute ComOutPtrAttribute {
                fn();
            }
            // Marks an enum derived from a C++ scoped enum (`enum class`/`enum struct`),
            // which has distinct name-lookup/conversion semantics from a plain C enum.
            // RDL: `#[scoped]`.
            attribute ScopedEnumAttribute {
                fn();
            }
            // Records a bit-field member packed into a backing integer field. The C
            // bit-field concept has no winmd representation, so consecutive bit-fields
            // are coalesced into a single backing integer field (`_bitfield` /
            // `_bitfield1` / ...) and each logical member is recorded here, one
            // attribute instance per member, carrying the member's name, its bit
            // offset within the backing field, and its width in bits. bindgen reads
            // these to generate typed get/set accessors. Signedness of a multi-bit
            // member is taken from the backing field unless MemberType is supplied.
            // RDL: written as a C-like block on the backing field, e.g.
            // `_bitfield: u8 { Name: bool: 1, _: 3, Other: u8: 4 }` (padding is `_`).
            attribute NativeBitfieldAttribute {
                fn(#[in] name: String, #[in] offset: i64, #[in] length: i64);
                MemberType: Type,
            }
            // The header states contracts for this parameter that metadata does not express.
            // Consumers must not infer contracts from absent facts. RDL: `#[incomplete]`.
            attribute IncompleteAttribute {
                fn();
            }
            // Declaration deprecation with an optional message and relocated typedef ownership.
            // RDL: `#[deprecated]` or `#[deprecated("message")]`.
            attribute DeprecatedAttribute {
                fn();
                fn(#[in] message: String);
                TypedefName: String,
            }
            // Absolute inherited vtable slot. RDL: `#[override_slot(N)]`.
            attribute NativeOverrideSlotAttribute {
                fn(#[in] slot: u32);
            }
            // Marks native base storage, not an owning interface reference. Interface bases
            // contain one vptr; sequential fields and record packing determine their offsets.
            // RDL: `#[base]`.
            attribute NativeBaseAttribute {
                fn();
            }
        }
    }
}
