#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            // A character-pointer terminator contract. Phase: 0 unspecified, 1 pre, 2 post.
            // Count is 1 for a string and 2 for a sequence of NUL-terminated strings.
            attribute NativeStringTerminationAttribute {
                fn();
                Count: u8,
                Phase: u8,
            }

            // Valid bytes on success when the buffer and any dereferenced count are non-null.
            // This is not capacity. Count-pointer nullability is stored on its parameter.
            attribute MemoryWrittenAttribute {
                fn();
                BytesParamIndex: i16,
                Dereference: bool,
            }
        }
    }
}
