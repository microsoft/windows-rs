#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            // A character-pointer terminator contract. Phase: 0 unspecified, 1 pre, 2 post.
            // Count is 1 for a string and 2 for a sequence of NUL-terminated strings.
            attribute NativeStringTerminationAttribute {
                fn();
                Count: u8,
                Phase: u8,
            }

            // Valid bytes after a successful call, when the buffer is non-null, not capacity.
            // Dereference selects an output integer pointer; otherwise the count is by value.
            attribute MemoryWrittenAttribute {
                fn();
                BytesParamIndex: i16,
                Dereference: bool,
            }
        }
    }
}
