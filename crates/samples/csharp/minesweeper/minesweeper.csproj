<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>csharp_minesweeper</AssemblyName>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
  </PropertyGroup>

  <Target Name="GenerateWindowsProjection"
          BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="cargo build -p csharp_minesweeper --quiet"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\.." />
  </Target>
</Project>
