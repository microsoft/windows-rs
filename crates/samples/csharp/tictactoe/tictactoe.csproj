<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>csharp_tictactoe</AssemblyName>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <CargoTargetDir>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)cargo-target\$(Platform)\$(Configuration)</CargoTargetDir>
    <ReactorStageDir>$(CargoTargetDir)\x86_64-pc-windows-msvc\debug</ReactorStageDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <Target Name="GenerateWindowsProjection"
          BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="cargo build -p csharp_tictactoe --quiet --target x86_64-pc-windows-msvc --target-dir &quot;$(CargoTargetDir)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\..\..\.." />
  </Target>

  <Target Name="CopyReactorAssets"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="GenerateWindowsProjection"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(ReactorStageDir)\microsoft.windowsappruntime.bootstrap.dll;$(ReactorStageDir)\resources.pri"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
