use Windows::Foundation::*;
use Windows::Foundation::Metadata::*;

#[winrt]
mod Statics {
    // A class with only static members.
    #[Static(IWidgetStatics, 1)]
    class Widget {}

    #[ExclusiveTo(Widget)]
    interface IWidgetStatics {
        fn Add(&self, #[in] a: i32, #[in] b: i32) -> i32;

        // Setting `Value` raises `Changed` with the new value and a null sender.
        Value: i32;
        event Changed: EventHandler<i32>;
    }
}