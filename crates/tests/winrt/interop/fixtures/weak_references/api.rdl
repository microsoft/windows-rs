use Windows::Foundation::Metadata::*;

#[winrt]
mod WeakReferences {
    // Implemented by the clients.
    interface IObserver {
        fn Notify(&self, value: i32);
    }

    #[Activatable(1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        // Holds a weak reference to `observer`, so the widget does not keep it alive.
        fn Observe(&self, observer: IObserver);

        // Notifies the observer if it is still alive, and returns whether it was.
        fn Notify(&self, value: i32) -> bool;
    }
}