#[winrt]
mod Test {
    #[Windows::Foundation::Metadata::Activatable(1)]
    class Widget {
        IWidget,
    }

    #[Windows::Foundation::Metadata::ExclusiveTo(Widget)]
    interface IWidget {
        fn Numbers(&self) -> Windows::Foundation::Collections::IVector<i32>;
        fn Lookup(&self, map: Windows::Foundation::Collections::IMapView<String, i32>) -> i32;
        fn Values(&self) -> Windows::Foundation::Collections::IIterable<String>;
    }
}
