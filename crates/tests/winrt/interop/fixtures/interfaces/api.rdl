use Windows::Foundation::Metadata::*;

#[winrt]
mod Interfaces {
    // A non-default interface of `Widget`, also implemented by the clients.
    interface IShape {
        fn Area(&self) -> i32;
    }

    #[Activatable(1)]
    class Widget {
        IWidget,
        IShape,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        // Returns `shape`, so clients get back the object they passed.
        fn Echo(&self, shape: IShape) -> IShape;
    }
}
