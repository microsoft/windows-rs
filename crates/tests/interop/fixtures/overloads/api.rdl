use Windows::Foundation::Metadata::*;

#[winrt]
mod Overloads {
    #[Activatable(1)]
    class Widget {
        IWidget,
        IWidget2,
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        // MIDL-style names, numbered within each interface.
        #[Overload("Sum")]
        fn Sum(&self) -> i32;
        #[Overload("Sum2")]
        fn Sum(&self, #[in] a: i32) -> i32;

        // Explicit names. Overloads with the same arity need a default.
        #[DefaultOverload]
        #[Overload("Format")]
        fn Format(&self, #[in] value: i32) -> String;
        #[Overload("FormatText")]
        fn Format(&self, #[in] value: String) -> String;
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget2 {
        // MIDL numbers each interface on its own, so these names repeat those in `IWidget`.
        #[Overload("Sum")]
        fn Sum(&self, #[in] a: i32, #[in] b: i32) -> i32;
        #[Overload("Sum2")]
        fn Sum(&self, #[in] a: i32, #[in] b: i32, #[in] c: i32) -> i32;
    }
}
