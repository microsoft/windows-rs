use Windows::Foundation::Metadata::*;

#[winrt]
mod ArrayDelegates {
    struct Entry {
        Text: String,
        Value: i32,
    }

    // Clients copy input to output, and reverse input into fill and the return value.
    #[guid(auto)]
    delegate fn StringsHandler(
        #[in] input: [String], #[out] fill: [String], #[out] output: &mut [String]
    ) -> [String];
    #[guid(auto)]
    delegate fn EntriesHandler(
        #[in] input: [Entry], #[out] fill: [Entry], #[out] output: &mut [Entry]
    ) -> [Entry];

    #[Activatable(1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        // Calls each handler with empty and nonempty arrays and checks all three outputs.
        fn CheckStrings(&self, #[in] handler: StringsHandler);
        fn CheckEntries(&self, #[in] handler: EntriesHandler);
    }
}
