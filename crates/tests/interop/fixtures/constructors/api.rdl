use Windows::Foundation::Metadata::*;

#[winrt]
mod Constructors {
    #[Activatable(1)]
    #[Activatable(IWidgetFactory, 1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        #[get]
        Value: i32;
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidgetFactory {
        fn WithValue(&self, #[in] value: i32) -> Widget;
    }

    // A composable class's constructors take the outer object of a derived class, if any.
    #[unsealed]
    #[Composable(IBaseFactory, Public, 1)]
    #[Static(IBaseStatics, 1)]
    class Base {
        IBase,
    }

    // The number of live `Base` objects, so clients can check that constructors do not leak.
    #[ExclusiveTo(Base)]
    #[guid(auto)]
    interface IBaseStatics {
        #[get]
        Instances: i32;
    }

    #[ExclusiveTo(Base)]
    #[guid(auto)]
    interface IBase {
        #[get]
        Value: i32;
    }

    #[ExclusiveTo(Base)]
    #[guid(auto)]
    interface IBaseFactory {
        fn CreateInstance(&self, #[in] outer: Object, #[out] inner: &mut Object) -> Base;
        fn WithValue(&self, #[in] value: i32, #[in] outer: Object, #[out] inner: &mut Object) -> Base;
    }
}
