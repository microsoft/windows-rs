#[winrt]
mod Class {
    #[Windows::Foundation::Metadata::Activatable(1)]
    class Widget {
        IWidget,
    }

    #[Windows::Foundation::Metadata::ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        fn Add(&self, #[in] left: i32, #[in] right: i32) -> i32;
        Name: String;
        #[get]
        Count: i32;
    }
}
