use Windows::Foundation::Metadata::*;

#[winrt]
mod ErrorRelay {
    interface ICallback {
        fn Fail(&self, #[in] code: i32, #[in] message: String);
        fn Checkpoint(&self);
    }

    #[Activatable(1)]
    #[MarshalingBehavior(Agile)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        // Returns the error from callback.Fail without replacing its code or message.
        fn Relay(&self, #[in] callback: ICallback, #[in] code: i32, #[in] message: String);

        // Captures the requested failure, calls Fail again with E_INVALIDARG and "intervening",
        // then calls Checkpoint before returning the original error. Concurrent clients block
        // in Checkpoint until both calls hold their original error.
        fn RelayPreserved(&self, #[in] callback: ICallback, #[in] code: i32, #[in] message: String);
    }
}
