use Windows::Foundation::*;
use Windows::Foundation::Metadata::*;

#[winrt]
mod NontrivialArrays {
    struct Entry {
        Text: String,
        Code: Char16,
        Enabled: bool,
        Number: IReference<i32>,
    }

    interface IValue {
        #[get]
        Number: i32;
    }

    #[Activatable(1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        fn CreateValue(&self, #[in] number: i32) -> IValue;

        // Each method copies input to output, and reverses input into fill and the return value.
        // The caller allocates fill with the same length as input.
        fn Strings(
            &self, #[in] input: [String], #[out] fill: [String], #[out] output: &mut [String]
        ) -> [String];
        fn Entries(
            &self, #[in] input: [Entry], #[out] fill: [Entry], #[out] output: &mut [Entry]
        ) -> [Entry];
        fn Values(
            &self, #[in] input: [IValue], #[out] fill: [IValue], #[out] output: &mut [IValue]
        ) -> [IValue];
    }
}
