use Windows::Foundation::Metadata::*;

#[winrt]
mod Noexcept {
    // Members that cannot fail, so projections return values without an error path. Implemented
    // by both the clients and the component, so each calls the other's objects.
    #[guid(auto)]
    interface IValue {
        #[NoException]
        Number: i32;
        #[NoException]
        Text: String;
        #[NoException]
        Next: IValue;
        // Only the getter cannot fail, so the accessors are declared separately.
        #[get]
        #[NoException]
        Limit: i32;
        #[set]
        Limit: i32;
        #[NoException]
        fn Clear(&self);
    }

    #[Activatable(1)]
    class Widget {
        IWidget,
        IValue,
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        // Calls each member of the client's `value`, which must start empty.
        fn Check(&self, #[in] value: IValue);
    }

    #[Static(IStaticValue, 1)]
    class StaticValue {}

    #[ExclusiveTo(StaticValue)]
    #[guid(auto)]
    interface IStaticValue {
        #[NoException]
        Number: i32;
        #[NoException]
        #[get]
        Text: String;
        #[NoException]
        fn Object(&self, #[in] present: bool) -> IValue;
        #[NoException]
        fn Numbers(&self) -> [i32];
        fn Checked(&self, #[in] value: i32) -> i32;
    }

    // The component does not provide this factory.
    #[Static(IUnavailableStatics, 1)]
    class Unavailable {}

    #[ExclusiveTo(Unavailable)]
    #[guid(auto)]
    interface IUnavailableStatics {
        #[NoException]
        fn Value(&self) -> i32;
        fn Fallible(&self) -> i32;
    }
}
