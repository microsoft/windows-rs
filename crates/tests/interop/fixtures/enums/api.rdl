use Windows::Foundation::*;
use Windows::Foundation::Collections::*;
use Windows::Foundation::Metadata::*;

#[winrt]
mod Enums {
    #[repr(i32)]
    enum Color {
        Unknown = -1,
        Red = 0,
        Green = 1,
        Blue = 2,
    }

    #[repr(u32)]
    #[flags]
    enum Styles {
        None = 0,
        Bold = 1,
        Italic = 2,
        Underline = 0x80000000,
    }

    #[Activatable(1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        // Red -> Green -> Blue -> Red, and Unknown for any other value.
        fn Next(&self, #[in] color: Color) -> Color;

        // Initially Bold | Underline.
        Styles: Styles;

        // Enums as generic arguments.
        fn Colors(&self) -> IVectorView<Color>;
        fn Combine(&self, #[in] styles: IIterable<Styles>) -> Styles;

        // Boxes `color`, and unboxes a value boxed by the client.
        fn BoxColor(&self, #[in] color: Color) -> Object;
        fn UnboxStyles(&self, #[in] value: Object) -> Styles;
    }
}
