#[winrt]
mod EventDelegate {
    #[guid(auto)]
    delegate fn ChangedHandler(#[in] sender: Widget, #[in] value: i32);

    #[Windows::Foundation::Metadata::Activatable(1)]
    #[Windows::Foundation::Metadata::MarshalingBehavior(Agile)]
    class Widget {
        IWidget,
    }

    #[Windows::Foundation::Metadata::ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        event Changed: ChangedHandler;
        fn Raise(&self, #[in] value: i32);
    }
}
