use Windows::Foundation::*;
use Windows::Foundation::Metadata::*;

#[winrt]
mod Boxing {
    #[Activatable(1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        // Unboxes a value boxed by the client: "i32 1", "String a", or "null".
        fn Describe(&self, #[in] value: Object) -> String;

        // Values boxed by the component.
        fn BoxInt32(&self, #[in] value: i32) -> Object;
        fn BoxString(&self, #[in] value: String) -> Object;

        // A nullable value, initially null.
        Optional: IReference<i32>;
    }
}
