use Windows::Foundation::Metadata::*;

#[winrt]
mod BoxedArrays {
    #[Activatable(1)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        fn BoxNumbers(&self, values: [i32]) -> Object;
        fn BoxBooleans(&self, values: [bool]) -> Object;
        fn BoxStrings(&self, values: [String]) -> Object;

        fn Numbers(&self, value: Object) -> [i32];
        fn Booleans(&self, value: Object) -> [bool];
        fn Strings(&self, value: Object) -> [String];
    }
}
