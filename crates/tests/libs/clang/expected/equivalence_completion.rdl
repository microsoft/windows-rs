#[win32]
mod Test {
    type Alias1 = IFoo;
    type Alias2 = Alias1;
    type Alias3 = Alias2;
    extern "C" fn Callback(value: Alias3, slot: *mut Alias3) -> Alias3;
    #[no_guid]
    interface IFoo {
        fn Method(&self);
    }
    #[no_guid]
    interface IUse {
        fn Call(&self, value: Alias3) -> Alias3;
    }
    struct Inner {
        tag: IFoo,
        value: Alias3,
        slot: *mut Alias3,
        array: [Alias3; 2],
    }
    #[library("test.dll")]
    extern "C" fn Use(value: *mut Uses);
    struct Uses {
        next: *mut Uses,
        inner: Inner,
        tag: IFoo,
        callback: Callback,
        listener: IUse,
    }
}
