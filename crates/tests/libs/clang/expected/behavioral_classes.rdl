#[win32]
mod BehavioralClasses {
    struct BaseData {
        value: i32,
    }
    #[library("api.dll")]
    extern "C" fn UseConstructor(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseDerived(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseDestructor(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseMethod(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseNonPodWrapper(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UsePoint(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UsePrivate(value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseProtected(value: *mut void);
}
