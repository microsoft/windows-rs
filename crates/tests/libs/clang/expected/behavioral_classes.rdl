#[win32]
mod BehavioralClasses {
    struct BaseData {
        value: i32,
    }
    #[library("api.dll")]
    extern "C" fn UseConstructor(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseDerived(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseDestructor(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseMethod(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseNonPodWrapper(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UsePoint(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UsePrivate(#[out] value: *mut void);
    #[library("api.dll")]
    extern "C" fn UseProtected(#[out] value: *mut void);
}
