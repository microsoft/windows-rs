#[win32]
mod StringAliases {
    type PCSTR = *const i8;
    type PCWSTR = *const u16;
    type PSTR = *mut i8;
    type PWSTR = *mut u16;
    #[library("api.dll")]
    extern "C" fn Strings(#[in] legacy_input: PCSTR, #[out] legacy_output: PSTR, #[in] explicit_input: PSTR, #[in] wide_input: PCWSTR, #[out] wide_output: PWSTR);
}
