#[win32]
mod Test {
    #[no_guid]
    interface IFoo {
        fn Method(&self);
    }
    struct Left {
        next: *mut Right,
        value: IFoo,
        tag: IFoo,
    }
    struct Right {
        next: *mut Left,
        value: i32,
    }
    #[library("test.dll")]
    extern "C" fn Use(value: *mut Left);
}
