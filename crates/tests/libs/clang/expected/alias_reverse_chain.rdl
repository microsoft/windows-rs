#[win32]
mod Test {
    type LPCWSTR = *const u16;
    type LPSTR = *mut i8;
    type PCWSTR = LPCWSTR;
    type PSTR = LPSTR;
    #[library("test.dll")]
    extern "C" fn Strings(#[out] text: *mut LPSTR, #[out] wide: *mut LPCWSTR, #[in] direct: TEXT, #[in] wide_direct: PCWSTR);
    type TEXT = PSTR;
}
