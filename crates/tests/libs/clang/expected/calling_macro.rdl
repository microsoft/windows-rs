#[win32]
mod Calling {
    extern fn CALLBACK_TYPE(#[out] context: *mut void);
    extern fn PCALLBACK_TYPE(#[out] context: *mut void);
    #[library("api.dll", import = "?PlainCall@@YAXXZ")]
    extern "C" fn PlainCall();
    #[library("api.dll", import = "?SystemCall@@YAXXZ")]
    extern fn SystemCall();
}
