#[win32]
mod Windows {
    mod Win32 {
        #[guid(0xfd04e6e3_fe0c_4c3c_ab19_a07601a576ee)]
        interface ICompositionDrawingSurfaceInterop: IUnknown {
            fn BeginDraw(&self, #[in] #[opt] updateRect: *const RECT, #[in] iid: &IID, #[iid_is] #[out] #[out_ptr(null_on_failure)] updateObject: *mut *mut void, #[out] updateOffset: *mut POINT) -> HRESULT;
            fn EndDraw(&self) -> HRESULT;
