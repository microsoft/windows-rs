#[win32]
mod Fixture {
    #[align(16)]
    struct Aligned {
        value: i32,
    }
    struct Container {
        values: [PackedMixed; 2],
        tail: i8,
    }
    struct Inherited {
        value: Aligned,
    }
    #[packed(4)]
    struct PackedArray {
        tag: i8,
        values: [Aligned; 2],
    }
    #[packed(4)]
    struct PackedBitfields {
        tag: i8,
        _bitfield: u64 {
            low: 3,
            high: 5,
        },
        value: Aligned,
    }
    #[packed(4)]
    struct PackedChild {
        tag: i8,
        value: Aligned,
    }
    #[packed(4)]
    struct PackedInherited {
        tag: i8,
        value: Inherited,
    }
    #[packed(4)]
