#[winrt]
mod Test {
    attribute FirstAttribute {
        fn();
    }
    delegate fn Handler();
    interface IInterface {
        #[First]
        Both: i32;
        #[Second(1)]
        #[get]
        Getter: String;
        #[First]
        #[Second(2)]
        #[set]
        Setter: i32;
        #[First]
        #[get]
        Mismatched: i32;
        #[Second(3)]
        #[set]
        Mismatched: i32;
        #[First]
        event Changed: Handler;
        #[special]
        fn get_Indexed(&self, #[in] index: i32) -> i32;
        #[special]
        fn get_Annotated(&self) -> #[Second(4)] i32;
        #[special]
        fn put_Annotated(&self, #[First] #[in] value: i32);
        #[special]
        fn add_Custom(&self, #[in] handler: Handler) -> i32;
        #[special]
        fn remove_Custom(&self, #[in] token: i32);
    }
    attribute SecondAttribute {
        fn(#[in] value: i32);
    }
}
