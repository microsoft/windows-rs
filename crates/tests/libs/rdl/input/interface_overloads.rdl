#[winrt]
mod Test {
    interface IReader {
        fn Read(&self) -> u32;
        #[overload(Read)]
        fn ReadWithOptions(&self, options: u32) -> u32;
        #[overload(Read)]
        fn Read3(&self, options: u32, count: u32) -> u32;
        #[overload(Bind)]
        fn Bind(&self, value: i32);
        #[overload(Convert)]
        fn FromInt(&self, value: i32) -> u32;
        #[overload(Convert)]
        fn FromString(&self, value: String) -> u32;
        #[overload(r#type)]
        fn r#match(&self);
    }
}
