#[win32]
mod Test {
    #[arch(X64 | Arm64)]
    struct Holder {
        struct Nested {
            const Value: Holder::E = 4294967295;
        }
        #[repr(u32)]
        enum E {
            First = 4294967295,
        }
        const Value: Holder::E = 4294967295;
    }
    #[arch(X86)]
    struct Holder {
        struct Nested {
            const Value: Holder::E = -1;
        }
        #[repr(i32)]
        enum E {
            First = -1,
        }
        const Value: Holder::E = -1;
    }
    struct Shared {
        #[arch(X86)]
        const Signed: Holder::E = -1;
        #[arch(X64 | Arm64)]
        const Unsigned: Holder::E = 4294967295;
    }
    #[arch(X86)]
    const Signed: Holder::E = -1;
    #[arch(X64 | Arm64)]
    const Unsigned: Holder::E = 4294967295;
}
