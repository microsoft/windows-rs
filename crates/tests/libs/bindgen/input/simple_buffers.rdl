//! --filter Test --flat
#[win32]
mod Test {
    #[guid(auto)]
    interface Buffers {
        fn Input(&self, #[in] #[buffer(count)] values: *const u32, #[in] count: u32);
        fn Fixed(&self, #[in] #[buffer(4)] values: *const u32);
        fn InOut(&self, #[in] #[out] #[buffer(count)] values: *mut u32, #[in] count: u32);
        fn Optional(&self, #[in] #[opt] #[buffer(count)] values: *const u32, #[in] count: u32);
        fn Output(&self, #[out] #[buffer(count)] values: *mut u32, #[in] count: u32, #[out] written: *mut u32) -> HRESULT;
        fn Returned(&self, #[out] #[retval] #[incomplete] values: *mut *mut u32) -> HRESULT;
        fn Query(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr(null_on_failure)] result: *mut *mut void) -> HRESULT;
        fn QueryArray(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr(null_on_failure)] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn QueryWithBuffer(&self, #[in] #[buffer(count)] ids: *const GUID, #[in] count: u32, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn BufferResult(&self, #[out] #[retval] #[buffer(1)] value: *mut u32) -> HRESULT;
    }
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute BufferAttribute {
                fn();
                CountConst: u64,
                CountParamIndex: u16,
                Dereference: bool,
                Bytes: bool,
            }
            attribute IncompleteAttribute {
                fn();
            }
            attribute ReturnedPointerAttribute {
                fn();
                NullOnFailure: bool,
            }
        }
    }
}
