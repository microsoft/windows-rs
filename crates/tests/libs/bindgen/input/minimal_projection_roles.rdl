//! --filter Test.MemberOnly::Value --filter Test.Constructed::CreateInstance
//! --filter Test.Callable --filter Test.Implemented::{} --implement Test.Implemented
//! --minimal --flat
#[winrt]
mod Windows {
    mod Foundation {
        mod Metadata {
            #[repr(i32)]
            enum CompositionType {
                Protected = 1,
                Public = 2,
            }
            attribute ComposableAttribute {
                fn(#[in] factory_type: Type, #[in] composition_type: CompositionType, #[in] version: u32);
            }
        }
    }
}
#[winrt]
mod Test {
    #[Windows::Foundation::Metadata::Composable(IMemberOnlyFactory, Public, 1)]
    class MemberOnly {
        IMemberOnly,
    }
    #[guid(auto)]
    interface IMemberOnly {
        Value: i32;
    }
    #[guid(auto)]
    interface IMemberOnlyFactory {
        fn CreateInstance(&self, #[in] outer: Object, #[out] inner: &mut Object) -> MemberOnly;
    }

    #[Windows::Foundation::Metadata::Composable(IConstructedFactory, Public, 1)]
    class Constructed {
        IConstructed,
    }
    #[guid(auto)]
    interface IConstructed {}
    #[guid(auto)]
    interface IConstructedFactory {
        fn CreateInstance(&self, #[in] outer: Object, #[out] inner: &mut Object) -> Constructed;
        fn CreateInstanceWithValue(
            &self,
            #[in] value: i32,
            #[in] outer: Object,
            #[out] inner: &mut Object,
        ) -> Constructed;
    }

    #[guid(auto)]
    interface Callable {
        fn Invoke(&self) -> i32;
    }
    #[guid(auto)]
    interface Implemented {
        fn Invoke(&self) -> i32;
    }
