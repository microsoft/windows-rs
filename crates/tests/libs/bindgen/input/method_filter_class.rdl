//! --filter Test.Widget::Act --full
// A class member selection resolves to the declaring interface's method.
#[winrt]
mod Windows {
    mod Foundation {
        mod Metadata {
            attribute ActivatableAttribute {
                fn(#[in] version: u32);
            }
            attribute ExclusiveToAttribute {
                fn(#[in] r#type: Type);
            }
        }
    }
}
#[winrt]
mod Test {
    #[Windows::Foundation::Metadata::Activatable(1)]
    class Widget {
        IWidget,
    }
    #[Windows::Foundation::Metadata::ExclusiveTo(Widget)]
    #[guid(auto)]
    interface IWidget {
        fn Act(&self) -> i32;
        fn Unused(&self) -> i32;
    }
}
