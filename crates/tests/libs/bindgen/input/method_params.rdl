//! --filter Test --flat
#[win32]
mod Test {
    type BOOL = i32;

    struct Struct {
        x: i32,
        y: i32,
    }

    #[guid(auto)]
    interface Interface {
        fn IntoParam(&self, #[in] value: *const Struct);
        fn InputOutput(&self, #[in] #[out] value: *mut Struct);
        fn Optional(&self, #[in] #[opt] value: *const Struct);
        fn BoolParam(&self, #[in] value: BOOL);
        fn ValueType(&self, #[in] value: u32);
    }
}
