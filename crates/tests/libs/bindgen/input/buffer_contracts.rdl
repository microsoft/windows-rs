        fn Output(&self, #[in] count: u32, #[out] #[buffer(count)] values: *mut u32) -> HRESULT;
        fn Explicit(&self, #[out] #[retval] #[buffer(4)] values: *mut u32) -> HRESULT;
        fn Arithmetic(&self, #[in] count: u32, #[out] #[incomplete] values: *mut u32) -> HRESULT;
        fn Returned(&self, #[in] count: u32, #[out] #[incomplete] values: *mut *mut u32) -> HRESULT;
        fn OptionalCount(&self, #[in] #[opt] count: *const u32, #[out] #[incomplete] values: *mut u32) -> HRESULT;
        fn UnknownDirection(&self, #[in] count: u32, #[buffer(count)] values: *const u32);
        fn Residual(&self, #[in] count: u32, #[incomplete] #[out] values: *mut u32) -> HRESULT;
        fn ResidualInput(&self, #[in] count: u32, #[incomplete] #[in] #[buffer(count)] values: *const u32);
        fn ResidualCount(&self, #[incomplete] #[in] count: u32, #[in] #[buffer(count)] values: *const u32);
        fn Scalar(&self, #[out] value: *mut u32) -> HRESULT;
        fn Query(&self, #[in] riid: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn GuidBuffer(&self, #[in] count: u32, #[in] #[buffer(count)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn OutputBuffer(&self, #[in] riid: *const GUID, #[in] count: u32, #[out] #[iid_is] #[buffer(count)] results: *mut *mut void) -> HRESULT;
        fn ResidualQuery(&self, #[incomplete] #[in] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn ResidualOutput(&self, #[in] riid: *const GUID, #[incomplete] #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn UnknownSlot(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn UnknownEntry(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn UnknownWritable(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn UnknownWithoutReturnedContract(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn UnknownResidual(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn UnknownMixed(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[buffer(2)] result: *mut *mut void) -> HRESULT;
        fn KnownPointeeCount(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn ConstSlot(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] result: *const RawObject) -> HRESULT;
        fn ConstPointee(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] result: *mut ConstObject) -> HRESULT;
    }
    #[library("test.dll")]
    extern fn Output(#[in] count: u32, #[out] #[buffer(count)] values: *mut u32) -> HRESULT;
