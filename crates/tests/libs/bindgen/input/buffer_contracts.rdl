//! --filter Test --flat
#[win32]
mod Test {
    type RawObject = *mut void;
    type ConstObject = *const void;
    #[guid(0x6911d859_eae4_4a56_9076_76fc4227c710)]
    interface Tracked: Windows::Win32::IUnknown {}
    #[guid(auto)]
    interface ObjectContracts {
        fn Required(&self, #[incomplete] #[in] value: Tracked);
        fn Optional(&self, #[incomplete] #[in] #[opt] value: Tracked);
        fn Unspecified(&self, #[incomplete] value: Tracked);
    }
    #[guid(auto)]
    interface Buffers {
        fn Input(&self, #[in] count: u32, #[in] #[readable(entry, count)] values: *const u32);
        fn Output(&self, #[in] count: u32, #[out] #[writable(entry, count)] #[readable(success, count)] values: *mut u32) -> HRESULT;
        fn Explicit(&self, #[out] #[retval] #[writable(entry, 4)] values: *mut u32) -> HRESULT;
        fn Arithmetic(&self, #[in] count: u32, #[out] #[writable(entry, count + 1)] values: *mut u32) -> HRESULT;
        fn Returned(&self, #[in] count: u32, #[out] #[readable(success, count, indirect)] values: *mut *mut u32) -> HRESULT;
        fn OptionalCount(&self, #[in] #[opt] count: *const u32, #[out] #[writable(entry, if_present(*count))] values: *mut u32) -> HRESULT;
        fn UnknownDirection(&self, #[in] count: u32, #[readable(entry, count)] values: *const u32);
        fn Residual(&self, #[in] count: u32, #[incomplete] #[out] values: *mut u32) -> HRESULT;
        fn ResidualInput(&self, #[in] count: u32, #[incomplete] #[in] #[readable(entry, count)] values: *const u32);
        fn ResidualCount(&self, #[incomplete] #[in] count: u32, #[in] #[readable(entry, count)] values: *const u32);
        fn Scalar(&self, #[out] value: *mut u32) -> HRESULT;
        fn Query(&self, #[in] riid: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn GuidBuffer(&self, #[in] count: u32, #[in] #[readable(entry, count)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn OutputBuffer(&self, #[in] riid: *const GUID, #[in] count: u32, #[out] #[writable(entry, count)] #[iid_is] results: *mut *mut void) -> HRESULT;
        fn ResidualQuery(&self, #[incomplete] #[in] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn ResidualOutput(&self, #[in] riid: *const GUID, #[incomplete] #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn UnknownSlot(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(success, unknown())] result: *mut *mut void) -> HRESULT;
        fn UnknownEntry(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(entry, unknown(), indirect)] result: *mut *mut void) -> HRESULT;
        fn UnknownWritable(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[writable(success, unknown(), indirect)] result: *mut *mut void) -> HRESULT;
        fn UnknownWithoutReturnedContract(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[readable(success, unknown(), indirect)] result: *mut *mut void) -> HRESULT;
        fn UnknownResidual(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(success, unknown(), indirect)] #[incomplete] result: *mut *mut void) -> HRESULT;
        fn UnknownMixed(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(success, unknown(), indirect)] #[writable(entry, 2)] result: *mut *mut void) -> HRESULT;
        fn KnownPointeeCount(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(success, 2, indirect)] result: *mut *mut void) -> HRESULT;
        fn ConstSlot(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(success, unknown(), indirect)] result: *const RawObject) -> HRESULT;
        fn ConstPointee(&self, #[in] iid: *const GUID, #[out] #[iid_is] #[out_ptr] #[readable(success, unknown(), indirect)] result: *mut ConstObject) -> HRESULT;
    }
    #[library("test.dll")]
    extern fn Output(#[in] count: u32, #[out] #[writable(entry, count)] values: *mut u32) -> HRESULT;
}

#[win32]
mod Windows {
    mod Win32 {
        #[guid(auto)]
        interface IUnknown {}
        mod Metadata {
            #[repr(i32)]
            enum BufferAccess { Read = 0, Write = 1 }
            #[repr(i32)]
            enum BufferPhase { Entry = 0, Success = 1, Value = 2 }
            #[repr(i32)]
            enum BufferUnits { Elements = 0, Bytes = 1 }
            attribute BufferExtentAttribute {
                fn(#[in] access: BufferAccess, #[in] phase: BufferPhase, #[in] units: BufferUnits);
                CountConst: u64,
                CountUnknown: bool,
                CountParamIndex: u16,
                CountExpression: String,
                Dereference: bool,
                CountOptional: bool,
                Indirect: bool,
            }
            attribute IncompleteAttribute {
                fn();
            }
            attribute ReturnedPointerAttribute {
                fn();
                NullOnFailure: bool,
            }
        }
    }
}
