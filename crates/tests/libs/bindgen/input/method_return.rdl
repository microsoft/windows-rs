//! --filter Test --flat
#[win32]
mod Test {
    struct Struct {
        x: i32,
        y: i32,
    }

    struct Large {
        a: i32,
        b: i32,
        c: i32,
        d: i32,
        e: i32,
    }

    interface Interface {
        fn ResultVoid(&self, value: u32) -> HRESULT;
        fn ResultValue(&self, value: u32, result: *mut Struct) -> HRESULT;
        fn ReturnStruct(&self, value: u32, result: *mut Struct);
        fn ReturnValue(&self, value: u32, #[retval] result: *mut Struct);
        fn ExplicitAfterInputOutput(
            &self,
            #[in] #[out] state: *mut u32,
            #[retval] result: *mut Struct,
        ) -> HRESULT;
        fn HeuristicAfterInputOutput(
            &self,
            #[in] #[out] state: *mut u32,
            result: *mut Struct,
        ) -> HRESULT;
        fn RetvalInputOutput(
            &self,
            #[in] #[out] #[retval] result: *mut Struct,
        ) -> HRESULT;
        fn RetvalOptional(&self, #[opt] #[retval] result: *mut Struct) -> HRESULT;
        fn RetvalReserved(&self, #[reserved] #[retval] result: *mut Struct) -> HRESULT;
        fn RetvalArray(&self, #[len_const(1)] #[retval] result: *mut Struct) -> HRESULT;
        fn ExplicitLarge(&self, #[retval] result: *mut Large) -> HRESULT;
        fn HeuristicLarge(&self, result: *mut Large) -> HRESULT;
        fn ExplicitVoidPointer(
            &self,
            #[retval] result: *mut *mut void,
        ) -> HRESULT;
    }
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute ReservedAttribute {
                fn();
            }

            attribute NativeArrayInfoAttribute {
                fn();
                CountConst: i32,
            }
        }
    }
}
