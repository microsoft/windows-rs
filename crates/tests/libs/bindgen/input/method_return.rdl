//! --filter Test --flat
#[win32]
mod Test {
    struct Struct {
        x: i32,
        y: i32,
    }

    struct Large {
        a: i32,
        b: i32,
        c: i32,
        d: i32,
        e: i32,
    }

    #[guid(auto)]
    interface Interface {
        fn ResultVoid(&self, #[in] value: u32) -> HRESULT;
        fn ResultValue(&self, #[in] value: u32, #[out] result: *mut Struct) -> HRESULT;
        fn ReturnStruct(&self, #[in] value: u32, #[out] result: *mut Struct);
        fn ReturnValue(&self, #[in] value: u32, #[out] #[retval] result: *mut Struct);
        fn ExplicitAfterInputOutput(
            &self,
            #[in] #[out] state: *mut u32,
            #[out] #[retval] result: *mut Struct,
        ) -> HRESULT;
        fn RetvalInputOutput(
            &self,
            #[in] #[out] #[retval] result: *mut Struct,
        ) -> HRESULT;
        fn RetvalOptional(&self, #[out] #[opt] #[retval] result: *mut Struct) -> HRESULT;
        fn RetvalReserved(&self, #[out] #[reserved] #[retval] result: *mut Struct) -> HRESULT;
        fn RetvalArray(&self, #[out] #[writable(entry, 1)] #[retval] result: *mut Struct) -> HRESULT;
        fn ExplicitLarge(&self, #[out] #[retval] result: *mut Large) -> HRESULT;
        fn ExplicitVoidPointer(
            &self,
            #[out] #[retval] result: *mut *mut void,
        ) -> HRESULT;
    }

    #[library("test.dll")]
    extern fn Annotated(#[in] value: u32, #[out] #[retval] result: *mut Struct) -> HRESULT;
    #[library("test.dll")]
    extern fn Unannotated(#[in] value: u32, #[out] result: *mut Struct) -> HRESULT;
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute ReservedAttribute {
                fn();
            }

            #[repr(i32)]
            enum BufferAccess { Read = 0, Write = 1 }
            #[repr(i32)]
            enum BufferPhase { Entry = 0, Success = 1, Value = 2 }
            #[repr(i32)]
            enum BufferUnits { Elements = 0, Bytes = 1 }
            attribute BufferExtentAttribute {
                fn(#[in] access: BufferAccess, #[in] phase: BufferPhase, #[in] units: BufferUnits);
                CountConst: u64,
                CountParamIndex: u16,
            }
        }
    }
}
