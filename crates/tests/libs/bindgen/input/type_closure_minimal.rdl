//! --filter Test::IOuter
// The same filter in the default minimal style. `IOuter::GetInner` is callable and `IInner`
// is pulled in, but `IInner`'s own `Value` collapses to a name-only slot because
// minimal demotes methods on types that are only pulled in as dependencies.
// Contrast with `type_closure` (`--full`), where `IInner::Value` is emitted.
#[win32]
mod Test {
    #[guid(auto)]
    interface IOuter {
        fn GetInner(&self) -> IInner;
    }
    #[guid(auto)]
    interface IInner {
        fn Value(&self) -> i32;
    }
}
