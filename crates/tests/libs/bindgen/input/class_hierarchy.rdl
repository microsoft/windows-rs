//! --filter Test.Leaf
#[winrt]
mod Test {
    #[unsealed]
    class Base {
        IBase,
    }
    #[unsealed]
    class Middle: Base {
        IMiddle,
    }
    class Leaf: Middle {
        ILeaf,
    }
    #[guid(auto)]
    interface IBase {}
    #[guid(auto)]
    interface IMiddle {}
    #[guid(auto)]
    interface ILeaf {}
}
