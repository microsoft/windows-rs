//! --filter Test.IFoo --flat --minimal
#[winrt]
mod Test {
    interface IFoo {
        fn Bar(&self) -> i32;
        #[special]
        fn add_Click(&self, #[in] handler: Handler) -> i64;
        #[special]
        fn remove_Click(&self, #[in] token: i64);
        fn SetCompleted(&self, #[in] callback: CompletedCallback);
    }

    delegate fn Handler(#[in] sender: IFoo, #[in] args: i32);
    delegate fn CompletedCallback(#[in] result: i32);
}
