//! --filter Test --flat --minimal
#[winrt]
mod Test {
    #[guid(auto)]
    interface Interface {
        fn Method(&self) -> i32;
        #[special]
        fn add_Changed(&self, #[in] handler: Delegate) -> i64;
        #[special]
        fn remove_Changed(&self, #[in] token: i64);
    }
    #[guid(auto)]
    delegate fn Delegate(#[in] sender: i32);
}
