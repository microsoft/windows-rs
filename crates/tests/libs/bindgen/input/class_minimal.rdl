//! --filter Test --minimal --flat
#[winrt]
mod Windows {
    mod Foundation {
        mod Metadata {
            attribute ActivatableAttribute {
                fn(#[in] version: u32);
            }
            attribute ExclusiveToAttribute {
                fn(#[in] r#type: Type);
            }
            attribute StaticAttribute {
                fn(#[in] r#type: Type, #[in] version: u32);
            }
            attribute NoExceptionAttribute {
                fn();
            }
        }
    }
}
#[winrt]
mod Test {
    #[Windows::Foundation::Metadata::Activatable(1)]
    #[Windows::Foundation::Metadata::Static(IClassStatics, 1)]
    class Class {
        IClass,
    }
    #[Windows::Foundation::Metadata::ExclusiveTo(Class)]
    #[guid(auto)]
    interface IClass {
        fn Method(&self) -> i32;
        Name: String;
    }
    #[Windows::Foundation::Metadata::ExclusiveTo(Class)]
    #[guid(auto)]
    interface IClassStatics {
        fn Create(&self, #[in] value: i32) -> Class;
        #[Windows::Foundation::Metadata::NoException]
        Value: i32;
        #[Windows::Foundation::Metadata::NoException]
        #[get]
        Text: String;
        #[Windows::Foundation::Metadata::NoException]
        #[get]
        Next: IClass;
        #[Windows::Foundation::Metadata::NoException]
        fn Numbers(&self) -> [i32];
    }
}
