//! --filter Test --flat
#[win32]
mod Test {
    #[align(16)]
    struct M128A {
        Low: u64,
        High: i64,
    }
    struct XmmFrame {
        Xmm0: M128A,
        Flags: u32,
    }
    struct FieldAligned {
        First: u32,
        #[align(8)]
        Second: u32,
        #[align(8)]
        Third: u32,
        Pointer: *mut void,
    }
    struct ArrayFieldAligned {
        First: u8,
        Reserved: [u8; 3],
        #[align(8)]
        Value: u32,
    }
    #[arch(X86)]
    struct PointerFieldAligned {
        Pointer: *mut void,
        First: u32,
        Value: u32,
    }
    #[arch(X64 | Arm64)]
    struct PointerFieldAligned {
        Pointer: *mut void,
        First: u32,
        #[align(8)]
        Value: u32,
    }
    #[align(32)]
    struct OverAligned {
        value: i32,
    }
}
