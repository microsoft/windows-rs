//! --filter Test --flat
#[win32]
mod Test {
    #[align(16)]
    struct M128A {
        Low: u64,
        High: i64,
    }
    struct XmmFrame {
        Xmm0: M128A,
        Flags: u32,
    }
    struct FieldAligned {
        First: u32,
        #[align(8)]
        Second: u32,
        #[align(8)]
        Third: u32,
        Pointer: *mut void,
    }
    struct ArrayFieldAligned {
        First: u8,
        Reserved: [u8; 3],
        #[align(8)]
        Value: u32,
    }
    struct PointerFieldAligned {
        Pointer: *mut void,
        First: u32,
        #[align(8)]
        Value: u32,
    }
    struct CallbackFieldAligned {
        Callback: Callback,
        First: u32,
        #[align(8)]
        Value: u32,
    }
    struct WideFieldAligned {
        _alignment: u8,
        First: u32,
        #[align(16)]
        Value: u32,
    }
    struct ExtendedFieldAligned {
        First: u8,
        #[align(32)]
        Value: u32,
    }
    extern fn Callback();
    #[align(32)]
    struct OverAligned {
        value: i32,
    }
}
