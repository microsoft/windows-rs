//! --filter !Projected Native --sys --flat
#[winrt]
mod Projected {
    #[guid(auto)]
    interface IController {
        fn Value(&self) -> i32;
    }
}
#[win32]
mod Native {
    struct ControllerOptions {
        controller: *mut Projected::IController,
        value: u32,
    }
    #[library("test.dll")]
    extern fn CreateController(#[in] options: ControllerOptions, #[out] controller: *mut Projected::IController) -> HRESULT;
}
