//! --filter Test.ISource::Changed --flat
#[winrt]
mod Test {
    #[guid(auto)]
    interface ISource {
        #[special]
        fn add_Changed(&self, #[in] handler: Handler) -> i64;
        #[special]
        fn remove_Changed(&self, #[in] token: i64);
