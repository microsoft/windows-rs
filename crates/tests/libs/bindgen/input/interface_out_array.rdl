//! --filter Test --minimal --flat
#[win32]
mod Test {
    #[guid(auto)]
    interface Object {}

    #[guid(auto)]
    interface Interface {
        fn OutFixed(&self, #[out] #[len_const(4)] buffer: *mut u32) -> i32;
        fn OutLen(&self, #[in] count: u32, #[out] #[len_param(0)] buffer: *mut u32) -> i32;
        fn OutOpt(&self, #[in] count: u32, #[opt] #[out] #[len_param(0)] buffer: *mut u32) -> i32;
        fn OutBytes(&self, #[in] size: u32, #[out] #[size_param(0)] buffer: *mut u8) -> i32;
        fn OutInterfaces(
            &self,
            #[in] count: u32,
            #[out] #[len_param(0)] values: *mut Object,
        ) -> i32;
        fn InOutLen(
            &self,
            #[in] count: u32,
            #[in] #[out] #[len_param(0)] buffer: *mut u32,
        ) -> i32;
        fn SharedCount(
            &self,
            #[in] count: u32,
            #[in] #[len_param(0)] input: *const u32,
            #[out] #[len_param(0)] output: *mut u32,
        ) -> i32;
        fn InLen(&self, #[in] count: u32, #[in] #[len_param(0)] buffer: *const u32) -> i32;
        fn InSignedLen(&self, #[in] count: i32, #[in] #[len_param(0)] buffer: *const u32) -> i32;
        fn InOptionalSignedLen(
            &self,
            #[in] count: i32,
            #[opt] #[in] #[len_param(0)] buffer: *const u32,
        ) -> i32;
    }
}
#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute NativeArrayInfoAttribute {
                fn();
                CountParamIndex: i16,
                CountConst: i32,
                CountFieldName: String,
            }

            attribute MemorySizeAttribute {
                fn();
                BytesParamIndex: i16,
            }
        }
    }
}
