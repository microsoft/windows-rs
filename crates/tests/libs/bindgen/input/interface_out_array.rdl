//! --filter Test --minimal --flat
#[win32]
mod Test {
    #[guid(auto)]
    interface Object {}

    #[guid(auto)]
    interface Interface {
        fn OutFixed(&self, #[out] #[buffer(4)] buffer: *mut u32) -> i32;
        fn OutLen(&self, #[in] count: u32, #[out] #[buffer(count)] buffer: *mut u32) -> i32;
        fn OutOpt(&self, #[in] count: u32, #[opt] #[out] #[buffer(count)] buffer: *mut u32) -> i32;
        fn OutBytes(&self, #[in] size: u32, #[out] #[buffer(bytes(size))] buffer: *mut u8) -> i32;
        fn OutInterfaces(
            &self,
            #[in] count: u32,
            #[out] #[buffer(count)] values: *mut Object,
        ) -> i32;
        fn InOutLen(
            &self,
            #[in] count: u32,
            #[in] #[out] #[buffer(count)] buffer: *mut u32,
        ) -> i32;
        fn SharedCount(
            &self,
            #[in] count: u32,
            #[in] #[buffer(count)] input: *const u32,
            #[out] #[buffer(count)] output: *mut u32,
        ) -> i32;
        fn InLen(&self, #[in] count: u32, #[in] #[buffer(count)] buffer: *const u32) -> i32;
        fn InSignedLen(&self, #[in] count: i32, #[in] #[buffer(count)] buffer: *const u32) -> i32;
        fn InOptionalSignedLen(
            &self,
            #[in] count: i32,
            #[opt] #[in] #[buffer(count)] buffer: *const u32,
        ) -> i32;
    }
}
#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute BufferAttribute {
                fn();
                CountConst: u64,
                CountParamIndex: u16,
                Dereference: bool,
                Bytes: bool,
            }
        }
    }
}
