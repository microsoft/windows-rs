//! --filter Test --flat
#[win32]
mod Test {
    type IID = GUID;

    #[guid(auto)]
    interface Factory {
        fn Reference(&self, #[in] count: u32, #[in] #[buffer(count)] filters: *const GUID, #[in] riid: &IID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn BufferAfterId(&self, #[in] riid: *const GUID, #[in] count: u32, #[in] #[buffer(count)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn BufferOnly(&self, #[in] count: u32, #[in] #[buffer(count)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn ByteBuffer(&self, #[in] count: u32, #[in] #[buffer(bytes(count))] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn FixedBuffer(&self, #[in] #[buffer(1)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn OutputBuffer(&self, #[in] riid: *const GUID, #[in] count: u32, #[out] #[iid_is] #[buffer(count)] results: *mut *mut void) -> HRESULT;
    }
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute BufferAttribute {
                fn();
                CountConst: u64,
                CountParamIndex: u16,
                Dereference: bool,
                Bytes: bool,
            }
        }
    }
}
