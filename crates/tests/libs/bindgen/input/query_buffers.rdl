//! --filter Test --flat
#[win32]
mod Test {
    type IID = GUID;

    #[guid(auto)]
    interface Factory {
        fn Reference(&self, #[in] count: u32, #[in] #[readable(entry, count)] filters: *const GUID, #[in] riid: &IID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn BufferAfterId(&self, #[in] riid: *const GUID, #[in] count: u32, #[in] #[readable(entry, count)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn BufferOnly(&self, #[in] count: u32, #[in] #[readable(entry, count)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn ByteBuffer(&self, #[in] count: u32, #[in] #[readable(entry, bytes(count))] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn FixedBuffer(&self, #[in] #[readable(entry, 1)] filters: *const GUID, #[out] #[iid_is] result: *mut *mut void) -> HRESULT;
        fn OutputBuffer(&self, #[in] riid: *const GUID, #[in] count: u32, #[out] #[writable(entry, count)] #[iid_is] results: *mut *mut void) -> HRESULT;
    }
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            #[repr(i32)]
            enum BufferAccess { Read = 0, Write = 1 }
            #[repr(i32)]
            enum BufferPhase { Entry = 0, Success = 1, Value = 2 }
            #[repr(i32)]
            enum BufferUnits { Elements = 0, Bytes = 1 }
            attribute BufferExtentAttribute {
                fn(#[in] access: BufferAccess, #[in] phase: BufferPhase, #[in] units: BufferUnits);
                CountConst: u64,
                CountParamIndex: u16,
            }
        }
    }
}
