//! --filter Test --flat
#[win32]
mod Test {
    const PTR_SENTINEL: usize = 18446744073709551615;
    #[arch(X64 | Arm64)]
    const PTR_MAX: usize = 18446744073709551615u64;
    #[arch(X86)]
    const PTR_MAX: usize = 4294967295u32;
    const SIGNED_SENTINEL: isize = -1;
    #[arch(X64 | Arm64)]
    const SIGNED_MAX: isize = 9223372036854775807i64;
    #[arch(X86)]
    const SIGNED_MAX: isize = 2147483647i32;
    const SMALL_USIZE: usize = 4096;
    const SMALL_ISIZE: isize = -4096;
    type SOCKET = usize;
    const INVALID_SOCKET: SOCKET = -1;
}
