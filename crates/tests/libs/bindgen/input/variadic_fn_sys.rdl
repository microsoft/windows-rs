//! --filter Test --sys --flat
#[win32]
mod Test {
    #[library("test.dll")]
    extern "system" fn VariadicFunc(#[in] count: u32, ...) -> u32;

    #[library("test.dll")]
    extern "C" fn VariadicC(#[in] count: u32, ...) -> u32;

    #[library("test.dll")]
    extern "fastcall" fn VariadicFastcall(#[in] count: u32, ...) -> u32;

    #[library("test.dll")]
    extern fn Fixed(#[in] count: u32) -> u32;
}
