//! --minimal --filter Test --flat
#[win32]
mod Test {
    struct Values {
        matrix: Windows::Win32::dcommon::D2D1_MATRIX_3X2_F,
        point: Windows::Win32::dcommon::D2D_POINT_2F,
    }
}

#[win32]
mod Windows {
    mod Win32 {
        mod dcommon {
            struct D2D_MATRIX_3X2_F {
                value: [f32; 6],
            }
            type D2D1_MATRIX_3X2_F = D2D_MATRIX_3X2_F;
            struct D2D_POINT_2F {
                x: f32,
                y: f32,
            }
        }
    }
}

#[winrt]
mod Windows {
    mod Foundation {
        mod Numerics {
            struct Matrix3x2 {
                M11: f32,
                M12: f32,
                M21: f32,
                M22: f32,
                M31: f32,
                M32: f32,
            }
            struct Matrix4x4 {
                M11: f32,
                M12: f32,
                M13: f32,
                M14: f32,
                M21: f32,
                M22: f32,
                M23: f32,
                M24: f32,
                M31: f32,
                M32: f32,
                M33: f32,
                M34: f32,
                M41: f32,
                M42: f32,
                M43: f32,
                M44: f32,
            }
            struct Vector2 {
                X: f32,
                Y: f32,
            }
            struct Vector3 {
                X: f32,
                Y: f32,
                Z: f32,
            }
            struct Vector4 {
                X: f32,
                Y: f32,
                Z: f32,
                W: f32,
            }
        }
    }
}
