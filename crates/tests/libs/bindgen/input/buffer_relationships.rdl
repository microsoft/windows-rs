//! --filter Test --flat
#[win32]
mod Test {
    #[guid(auto)]
    interface Interface {
        fn ValidElements(&self, #[in] count: u32, #[in] #[readable(entry, count)] values: *const u32);
        fn SharedCount(
            &self,
            #[in] count: u32,
            #[in] #[readable(entry, count)] left: *const u32,
            #[in] #[readable(entry, count)] right: *const u32,
        );

        fn ValidBytes(&self, #[in] count: u32, #[in] #[readable(entry, bytes(count))] values: *const u8);

        fn ValidConstant(&self, #[in] #[readable(entry, 4)] values: *const u32);
        fn OutOfRangeConstant(
            &self,
            #[in] #[readable(entry, 2147483647)] values: *const u32,
        );
    }

    #[library("test.dll")]
    extern fn ValidFunction(#[in] count: u32, #[in] #[readable(entry, count)] values: *const u32);
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            #[repr(i32)]
            enum BufferAccess { Read = 0, Write = 1 }
            #[repr(i32)]
            enum BufferPhase { Entry = 0, Success = 1, Value = 2 }
            #[repr(i32)]
            enum BufferUnits { Elements = 0, Bytes = 1 }
            attribute BufferExtentAttribute {
                fn(#[in] access: BufferAccess, #[in] phase: BufferPhase, #[in] units: BufferUnits);
                CountConst: u64,
                CountParamIndex: u16,
            }
        }
    }
}
