//! --filter Test --flat
#[win32]
mod Test {
    interface Interface {
        fn ValidElements(&self, #[in] count: u32, #[in] #[len_param(0)] values: *const u32);
        fn NegativeElements(&self, #[in] count: u32, #[in] #[len_param(-1)] values: *const u32);
        fn OutOfRangeElements(&self, #[in] count: u32, #[in] #[len_param(2)] values: *const u32);
        fn SelfElements(&self, #[in] #[len_param(0)] values: *const u32);
        fn SharedCount(
            &self,
            #[in] count: u32,
            #[in] #[len_param(0)] left: *const u32,
            #[in] #[len_param(0)] right: *const u32,
        );

        fn ValidBytes(&self, #[in] count: u32, #[in] #[size_param(0)] values: *const u8);
        fn NegativeBytes(&self, #[in] count: u32, #[in] #[size_param(-1)] values: *const u8);
        fn OutOfRangeBytes(&self, #[in] count: u32, #[in] #[size_param(2)] values: *const u8);
        fn SelfBytes(&self, #[in] #[size_param(0)] values: *const u8);

        fn ValidConstant(&self, #[in] #[len_const(4)] values: *const u32);
        fn NegativeConstant(&self, #[in] #[len_const(-1)] values: *const u32);
        fn OutOfRangeConstant(
            &self,
            #[in] #[len_const(2147483647)] values: *const u32,
        );
    }

    #[library("test.dll")]
    extern fn ValidFunction(#[in] count: u32, #[in] #[len_param(0)] values: *const u32);

    #[library("test.dll")]
    extern fn InvalidFunction(#[in] count: u32, #[in] #[len_param(2)] values: *const u32);
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute NativeArrayInfoAttribute {
                fn();
                CountParamIndex: i16,
                CountConst: i32,
                CountFieldName: String,
            }

            attribute MemorySizeAttribute {
                fn();
                BytesParamIndex: i16,
            }
        }
    }
}
