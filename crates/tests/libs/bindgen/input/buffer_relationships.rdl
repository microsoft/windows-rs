//! --filter Test --flat
#[win32]
mod Test {
    #[guid(auto)]
    interface Interface {
        fn ValidElements(&self, #[in] count: u32, #[in] #[buffer(count)] values: *const u32);
        fn SharedCount(
            &self,
            #[in] count: u32,
            #[in] #[buffer(count)] left: *const u32,
            #[in] #[buffer(count)] right: *const u32,
        );

        fn ValidBytes(&self, #[in] count: u32, #[in] #[buffer(bytes(count))] values: *const u8);

        fn ValidConstant(&self, #[in] #[buffer(4)] values: *const u32);
        fn OutOfRangeConstant(
            &self,
            #[in] #[buffer(2147483647)] values: *const u32,
        );
    }

    #[library("test.dll")]
    extern fn ValidFunction(#[in] count: u32, #[in] #[buffer(count)] values: *const u32);
}

#[win32]
mod Windows {
    mod Win32 {
        mod Metadata {
            attribute BufferAttribute {
                fn();
                CountConst: u64,
                CountParamIndex: u16,
                Dereference: bool,
                Bytes: bool,
            }
        }
    }
}
