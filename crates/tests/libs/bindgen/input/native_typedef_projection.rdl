//! --filter Test --flat
#[win32]
mod Test {
    type DWORD = u32;
    type LPDWORD = *mut DWORD;

    struct SYSTEMTIME {
        value: u32,
    }

    type LPSYSTEMTIME = *mut SYSTEMTIME;
    type IID = GUID;
    type REFIID = *const IID;
    type PPVOID = *mut *mut void;

    #[library("test.dll")]
    extern fn GetTime(#[out] result: LPSYSTEMTIME);

    #[library("test.dll")]
    extern fn GetValue(#[out] result: LPDWORD) -> HRESULT;

    #[library("test.dll")]
    extern fn Create(riid: REFIID, #[out] #[iid_is] object: PPVOID) -> HRESULT;
}
