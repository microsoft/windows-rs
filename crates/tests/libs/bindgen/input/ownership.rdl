//! --filter Test TestNative --flat
#[winrt]
mod Test {
    #[guid(auto)]
    delegate fn Tracked();

    #[guid(auto)]
    delegate fn ArrayRoundtrip(
        #[in] input: [Tracked],
        #[out] fill: [Tracked],
        #[out] receive: &mut [Tracked],
    ) -> [Tracked];

    #[guid(auto)]
    delegate fn InterfaceOutputs(#[out] value: Tracked) -> Tracked;

    #[guid(auto)]
    delegate fn GenericOutputs<T>(#[out] fill: [T], #[out] value: T);

    #[guid(auto)]
    delegate fn EmptyArray() -> [u32];

    struct OwnedValue {
        text: String,
        enabled: bool,
        number: f64,
        object: Tracked,
    }

    #[guid(auto)]
    delegate fn OwnedRoundtrip(#[in] input: OwnedValue, #[out] output: OwnedValue) -> OwnedValue;

    #[guid(auto)]
    delegate fn GenericRoundtrip<T>(#[in] input: T, #[out] output: T) -> T;

    #[guid(auto)]
    interface OwnedResult {
        fn Get(&self) -> OwnedValue;
        #[Windows::Foundation::Metadata::NoException]
        fn Infallible(&self) -> OwnedValue;
        fn GetMany(&self) -> [OwnedValue];
        #[Windows::Foundation::Metadata::NoException]
        fn InfallibleMany(&self) -> [OwnedValue];
    }

    #[guid(auto)]
    interface GenericResult<T> {
        fn Get(&self) -> T;
        #[Windows::Foundation::Metadata::NoException]
        fn Infallible(&self) -> T;
    }
}

#[win32]
mod TestNative {
    #[guid(auto)]
    interface NativeResult: Windows::Win32::IUnknown {
        fn Get(&self, #[out] #[retval] value: *mut Test::OwnedValue) -> HRESULT;
        fn GetArray(&self, #[out] #[retval] value: *mut [Test::OwnedValue; 2]) -> HRESULT;
        fn GetNestedArray(&self, #[out] #[retval] value: *mut [[Test::OwnedValue; 2]; 2]) -> HRESULT;
    }

    #[library("bindgen_abi.dll")]
    extern fn GetOwned(#[in] status: HRESULT, #[out] #[retval] value: *mut Test::OwnedValue) -> HRESULT;
    #[library("bindgen_abi.dll")]
    extern fn GetOwnedArray(#[in] status: HRESULT, #[out] #[retval] value: *mut [Test::OwnedValue; 2]) -> HRESULT;
    #[library("bindgen_abi.dll")]
    extern fn GetOwnedNestedArray(#[in] status: HRESULT, #[out] #[retval] value: *mut [[Test::OwnedValue; 2]; 2]) -> HRESULT;
    #[library("bindgen_abi.dll")]
    extern fn BorrowOwned(#[in] value: *const Test::OwnedValue) -> *const Test::OwnedValue;
}

mod Windows {
    #[win32]
    mod Win32 {
        #[guid(0x00000000_0000_0000_c000_000000000046)]
        interface IUnknown {}
    }
    #[winrt]
    mod Foundation {
        mod Metadata {
            attribute NoExceptionAttribute { fn(); }
        }
    }
}
