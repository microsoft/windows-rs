//! --filter Test --flat
#[win32]
mod Test {
    #[library("test.dll")]
    #[must_use]
    extern fn Count() -> u32;

    #[library("test.dll")]
    #[must_use]
    extern fn Hresult() -> HRESULT;

    #[guid(0x10000000_0000_0000_0000_000000000001)]
    interface Value: Windows::Win32::IUnknown {
        #[must_use]
        fn Count(&self) -> u32;
        #[must_use]
        fn Get(&self, #[out] #[retval] value: *mut u32) -> HRESULT;
    }
}

#[win32]
mod Windows {
    mod Win32 {
        #[guid(0x00000000_0000_0000_c000_000000000046)]
        interface IUnknown {}
        mod Metadata {
            attribute MustUseAttribute { fn(); }
        }
