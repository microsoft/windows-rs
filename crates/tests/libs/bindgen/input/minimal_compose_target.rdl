#[winrt]
mod Windows {
    mod Foundation {
        mod Metadata {
            #[repr(i32)]
            enum CompositionType {
                Protected = 1,
                Public = 2,
            }
            attribute ComposableAttribute {
                fn(#[in] factory_type: Type, #[in] composition_type: CompositionType, #[in] version: u32);
            }
        }
    }
}
#[winrt]
mod Test {
    #[unsealed]
    #[Windows::Foundation::Metadata::Composable(IBaseFactory, Public, 1)]
    class Base {
        IOverrides,
    }
