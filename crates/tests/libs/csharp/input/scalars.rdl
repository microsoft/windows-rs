//! --filter Sample
use Windows::Foundation::Metadata::*;

#[winrt]
mod Sample {
    #[Activatable(1)]
    class Numbers {
        INumbers,
    }

    #[ExclusiveTo(Numbers)]
    interface INumbers {
        Int8: i8;
        UInt8: u8;
        Int16: i16;
        UInt16: u16;
        Int32: i32;
        UInt32: u32;
        Int64: i64;
        UInt64: u64;
        Single: f32;
        Double: f64;
        Boolean: bool;
        fn Sum(&self, a: i32, b: i64) -> i64;
        fn Not(&self, value: bool) -> bool;
    }
}
