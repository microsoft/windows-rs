//! --filter Sample
use Windows::Foundation::Metadata::*;

#[winrt]
mod Sample {
    #[Activatable(1)]
    class Formatter {
        IFormatter,
    }

    #[ExclusiveTo(Formatter)]
    interface IFormatter {
        fn Echo(&self, value: String) -> String;
        fn Concat(&self, a: String, b: String) -> String;
        fn Length(&self, value: String) -> i32;
        fn Label(&self, id: i32) -> String;
        fn Store(&self, value: String);
    }
}
