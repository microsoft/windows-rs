//! --filter Win32Test
#[win32]
mod Win32Test {
    const MAGIC: u32 = 0x12345678;

    const FLOAT_MAGIC: f32 = 1.5;

    #[arch(X86)]
    const X86_MAGIC: u32 = 86;

    #[repr(i32)]
    enum Mode {
        None = 0,
        Offset = 1,
    }

    struct Point {
        x: i32,
        y: i32,
    }

    struct FloatPair {
        x: f32,
        y: f32,
    }

    union Number {
        signed: i32,
        unsigned: u32,
        point: Point,
    }

    struct Variant {
        tag: u32,
        data: union {
            signed: i32,
            unsigned: u32,
        },
    }

    #[arch(X86)]
    #[packed(4)]
    struct ArchValue {
        value: u32,
    }

    #[arch(X64 | Arm64)]
    struct ArchValue {
        value: u64,
    }

    #[arch(X86)]
    struct X86Only {
        value: u32,
    }

    type HRESULT = i32;

    type BOOL = i32;

    // A genuine Win32 opaque handle: `NativeTypedefAttribute` with a single field named `Value`
    // resolving to `void*`. Exercises `CsType::Handle` end to end (see `native_handle_value`):
    // parameter, return, and a real user32 round trip at runtime.
    type HWND = *mut void;

    type HMODULE = *mut void;

    type PCWSTR = *const u16;

    type PWSTR = *mut u16;

    extern fn WNDENUMPROC(hwnd: HWND, lparam: isize) -> BOOL;

    struct Rect {
        left: i32,
        top: i32,
        right: i32,
        bottom: i32,
    }

    struct NativeState {
        ready: BOOL,
        data: *mut u8,
    }

    #[guid(0x12345678_1234_5678_90ab_cdef01234567)]
    interface ICounter : Windows::Win32::IUnknown {
        fn GetValue(&self) -> i32;
        fn Add(&self, value: i32) -> i32;
    }

    // Proves the generated COM ABI companion accepts a blittable handle wrapper directly.
    #[guid(0x11223344_5566_7788_90ab_cdef01234567)]
    interface IHandleConsumer : Windows::Win32::IUnknown {
        fn SetWindow(&self, value: HWND) -> HRESULT;
        fn CreateCounter(&self, seed: i32, counter: *mut ICounter) -> HRESULT;
    }

    #[guid(0x10203040_5060_7080_90ab_cdef01234567)]
    interface INativeAbiCases : Windows::Win32::IUnknown {
        fn GetPoint(&self) -> Point;
        fn GetFloatPair(&self) -> FloatPair;
        fn CreateCounter(
            &self,
            seed: i32,
            #[out] counter: *mut ICounter,
        ) -> HRESULT;
        fn UpdateCounter(
            &self,
            #[in] #[out] counter: *mut ICounter,
        ) -> HRESULT;
        fn TryCreateCounter(
            &self,
            #[out] #[opt] counter: *mut ICounter,
        ) -> HRESULT;
        fn ReservedCounter(
            &self,
            #[out] #[reserved] counter: *mut ICounter,
        ) -> HRESULT;
        fn CreateCounterBuffer(
            &self,
            #[len_param(1)] #[out] counters: *mut ICounter,
            count: u32,
        ) -> HRESULT;
        fn CreateTwoCounters(
            &self,
            #[out] first: *mut ICounter,
            #[out] second: *mut ICounter,
        ) -> HRESULT;
        fn CreateCounterWithStatus(
            &self,
            #[out] status: *mut u32,
            #[out] #[retval] counter: *mut ICounter,
        ) -> HRESULT;
    }

    #[guid(0x22334455_6677_8899_a0ab_cdef01234567)]
    interface IBufferOps : Windows::Win32::IUnknown {
        fn Sum(&self, #[size_param(1)] values: *const u8, count: u32) -> u32;
        fn Fill(&self, #[len_param(1)] #[out] values: *mut u32, count: u32) -> HRESULT;
    }

    #[guid(0x33445566_7788_99aa_b0ab_cdef01234567)]
    interface IBaseDependency : Windows::Win32::IUnknown {
        fn UsePoint(&self, value: Point) -> HRESULT;
    }

    #[guid(0x44556677_8899_aabb_c0ab_cdef01234567)]
    interface IDerivedDependency : IBaseDependency {
        fn UseMode(&self, value: Mode) -> HRESULT;
    }

    #[guid(0x55667788_99aa_bbcc_d0ab_cdef01234567)]
    interface IUnsupported : Windows::Win32::IUnknown {
        fn Text(&self, value: String) -> HRESULT;
    }

    #[guid(0x66778899_aabb_ccdd_e0ab_cdef01234567)]
    interface IUnsupportedBase : Windows::Win32::IUnknown {
        fn Text(&self, value: String) -> HRESULT;
    }

    #[guid(0x778899aa_bbcc_ddee_f0ab_cdef01234567)]
    interface IUnsupportedDerived : IUnsupportedBase {
        fn Good(&self, value: i32) -> HRESULT;
    }

    #[guid(0x0c733a30_2a1c_11ce_ade5_00aa0044773d)]
    interface ISequentialStream : Windows::Win32::IUnknown {
        fn Read(
            &self,
            #[size_param(1)] #[out] value: *mut u8,
            count: u32,
            read: *mut u32,
        ) -> HRESULT;
        fn Write(
            &self,
            #[size_param(1)] value: *const u8,
            count: u32,
            written: *mut u32,
        ) -> HRESULT;
    }

    #[guid(0x0000000c_0000_0000_c000_000000000046)]
    interface IStream : ISequentialStream {
        fn Seek(
            &self,
            offset: i64,
            origin: u32,
            position: *mut u64,
        ) -> HRESULT;
        fn SetSize(&self, size: u64) -> HRESULT;
    }

    #[library("kernel32.dll")]
    extern fn GetCurrentProcessId() -> u32;

    #[library("test.dll")]
    extern "C" fn VariadicFunction(count: u32, ...);

    #[library("test.dll")]
    extern fn ValidBuffer(count: u32, #[len_param(0)] values: *const u32) -> u32;

    #[library("test.dll")]
    extern fn NegativeBuffer(count: u32, #[len_param(-1)] values: *const u32) -> u32;

    #[library("test.dll")]
    extern fn OutOfRangeBuffer(count: u32, #[len_param(2)] values: *const u32) -> u32;

    #[library("test.dll")]
    extern fn SelfRelativeBuffer(#[len_param(0)] values: *const u32) -> u32;

    #[library("test.dll")]
    extern fn NegativeByteBuffer(count: u32, #[size_param(-1)] values: *const u8) -> u32;

    #[library("test.dll")]
    extern fn OutOfRangeByteBuffer(count: u32, #[size_param(2)] values: *const u8) -> u32;

    #[library("test.dll")]
    extern fn SelfByteBuffer(#[size_param(0)] values: *const u8) -> u32;

    #[library("test.dll")]
    extern fn NegativeConstantBuffer(#[len_const(-1)] values: *const u32) -> u32;

    #[library("test.dll")]
    extern fn ValidConstantBuffer(#[len_const(4)] values: *const u32) -> u32;

    // A real optional null-terminated UTF-16 input. The projection pins `string?` directly and
    // keeps the private import pointer-based.
    #[library("kernel32.dll")]
    extern fn GetModuleHandleW(#[opt] module_name: PCWSTR) -> HMODULE;

    // A real mutable UTF-16 output buffer with capacity supplied by another parameter.
    #[library("kernel32.dll")]
    extern fn GetTempPathW(
        buffer_length: u32,
        #[len_param(0)] #[out] #[opt] buffer: PWSTR,
    ) -> u32;

    // A real counted byte buffer. `MemorySizeAttribute` relates `source` to `length`; the public
    // projection derives the count from `ReadOnlySpan<byte>` and keeps the import pointer-based.
    #[library("ntdll.dll")]
    extern fn RtlCompareMemoryUlong(
        #[size_param(1)] source: *const void,
        length: usize,
        pattern: u32,
    ) -> usize;

    // Element-counted input and output buffers use spans and derive their count. These synthetic
    // calls are compiled but not invoked.
    #[library("test.dll")]
    extern fn SumPoints(#[len_param(1)] points: *const Point, count: u32) -> i32;

    #[library("test.dll")]
    extern fn FillValues(#[len_param(1)] #[out] values: *mut u32, count: u32) -> BOOL;

    // Optional storage uses an empty span for null+zero. Two buffers sharing one count stay raw
    // until their equal-length policy has an explicit public abstraction.
    #[library("test.dll")]
    extern fn FillOptional(
        #[len_param(1)] #[out] #[opt] values: *mut u32,
        count: u32,
    ) -> BOOL;

    #[library("test.dll")]
    extern fn CompareBuffers(
        #[len_param(2)] left: *const u8,
        #[len_param(2)] right: *const u8,
        count: u32,
    ) -> BOOL;

    #[library("test.dll")]
    extern fn CompareOptionalBuffer(
        #[len_param(2)] left: *const u8,
        #[len_param(2)] #[opt] right: *const u8,
        count: u32,
    ) -> BOOL;

    // A real Win32 export whose only parameter is `[out]` pointer to a blittable scalar
    // (`LARGE_INTEGER*`, canonicalized to `i64`): exercises the `out`/`ref` sugar against an
    // actual OS call at runtime, not just a synthetic shape.
    #[library("kernel32.dll")]
    extern fn QueryPerformanceCounter(#[out] value: *mut i64) -> BOOL;

    #[library("ole32.dll")]
    extern fn CreateStreamOnHGlobal(
        global: isize,
        delete_on_release: BOOL,
        stream: *mut IStream,
    ) -> HRESULT;

    #[library("test.dll")]
    extern fn Transform(value: Point, mode: Mode) -> Point;

    #[library("test.dll")]
    extern fn TransformNumber(value: Number) -> Number;

    #[library("test.dll")]
    extern fn TransformVariant(value: Variant) -> Variant;

    #[arch(X86)]
    #[library("test.dll")]
    extern fn TransformArch(value: ArchValue) -> ArchValue;

    #[arch(X64 | Arm64)]
    #[library("test.dll")]
    extern fn TransformArch(value: ArchValue) -> ArchValue;

    #[library("test.dll")]
    extern fn IsReady() -> BOOL;

    #[library("test.dll")]
    extern fn InspectState(value: NativeState) -> u32;

    #[library("test.dll")]
    extern fn UnsupportedString(value: String);

    #[arch(X86)]
    #[library("test.dll")]
    extern fn OnlyX86() -> u32;

    #[arch(X64 | Arm64)]
    #[library("test.dll")]
    extern fn UsesUnavailableType(value: X86Only) -> u32;

    // Synthetic exports covering the `out`/`ref` scalar and struct pointer sugar, including the
    // `BOOL`/`HRESULT` wrapper interaction. These are never invoked at runtime (there is no
    // `test.dll`); `win32_round_trip` only asserts on the generated source shape.
    #[library("test.dll")]
    extern fn GetCount(#[out] value: *mut u32) -> BOOL;

    #[library("test.dll")]
    extern fn AdjustCount(#[r#in] #[out] value: *mut u32) -> BOOL;

    #[library("test.dll")]
    extern fn GetPoint(#[out] value: *mut Point) -> HRESULT;

    #[library("test.dll")]
    extern fn AdjustPoint(#[r#in] #[out] value: *mut Point) -> HRESULT;

    // Not wrapped by a `BOOL`/`HRESULT` return today, so sugaring `value` is what makes this
    // function private-ABI-wrapped at all.
    #[library("test.dll")]
    extern fn GetMode(#[out] value: *mut Mode) -> u32;

    // An optional `[out]` pointer is never sugared (a caller-omittable output has no safe
    // non-nullable `out` surface yet), so `value` stays the raw ABI pointer.
    #[library("test.dll")]
    extern fn TryGetOptional(#[r#in] #[out] #[opt] value: *mut u32) -> BOOL;

    // A mutable pointer whose metadata carries only `[in]` (no `Out` flag) is an ambiguous
    // direction the projection does not guess at, so `value` also stays the raw ABI pointer.
    #[library("test.dll")]
    extern fn PeekValue(#[r#in] value: *mut u32) -> BOOL;

    // A real, no-UI user32 handle round trip: `GetDesktopWindow` never fails and never shows or
    // owns a window (it returns the existing desktop window handle), so the returned `HWND` can be
    // passed straight into `GetWindowRect` (`out Rect` sugar) without depending on a console
    // window or any visible UI.
    #[library("user32.dll")]
    extern fn GetDesktopWindow() -> HWND;

    #[library("user32.dll")]
    extern fn GetWindowRect(hwnd: HWND, #[out] rect: *mut Rect) -> BOOL;

    #[library("user32.dll")]
    extern fn EnumWindows(callback: WNDENUMPROC, lparam: isize) -> BOOL;
}
