//! --filter Sample
use Windows::Foundation::Metadata::*;

#[winrt]
mod Sample {
    #[Activatable(1)]
    class Store {
        IStore,
    }

    #[Activatable(1)]
    class Item {
        IItem,
    }

    #[ExclusiveTo(Item)]
    interface IItem {
        Value: i32;
    }

    #[ExclusiveTo(Store)]
    interface IStore {
        fn Items(&self, count: u32) -> Windows::Foundation::Collections::IVector<i32>;
        fn ObjectItems(&self) -> Windows::Foundation::Collections::IVector<Item>;
        fn InspectableItems(&self) -> Windows::Foundation::Collections::IVector<Object>;
        fn StringItems(&self) -> Windows::Foundation::Collections::IVector<String>;
        fn Lookup(&self, count: u32) -> Windows::Foundation::Collections::IMap<i32, i32>;
        fn StringLookup(&self) -> Windows::Foundation::Collections::IMap<String, i32>;
        fn StringValues(&self) -> Windows::Foundation::Collections::IMap<i32, String>;
        fn ObjectValues(&self) -> Windows::Foundation::Collections::IMap<i32, Item>;
        fn ObjectKeys(&self) -> Windows::Foundation::Collections::IMap<Item, i32>;
        fn ItemsView(&self, count: u32) -> Windows::Foundation::Collections::IVectorView<i32>;
        fn StringItemsView(&self) -> Windows::Foundation::Collections::IVectorView<String>;
        fn LookupView(&self, count: u32) -> Windows::Foundation::Collections::IMapView<i32, i32>;
        fn StringLookupView(&self) -> Windows::Foundation::Collections::IMapView<String, i32>;
        fn StringValuesView(&self) -> Windows::Foundation::Collections::IMapView<i32, String>;
        fn ObjectValuesView(&self) -> Windows::Foundation::Collections::IMapView<i32, Item>;
        fn ObjectKeysView(&self) -> Windows::Foundation::Collections::IMapView<Item, i32>;
    }
}
