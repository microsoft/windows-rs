//! --filter Sample
use Windows::Foundation::Metadata::*;

#[winrt]
mod Sample {
    #[repr(i32)]
    enum Mode {
        None = 0,
        One = 1,
    }

    struct State {
        enabled: bool,
        mode: Mode,
    }

    #[Activatable(1)]
    class Arrays {
        IArrays,
    }

    #[ExclusiveTo(Arrays)]
    interface IArrays {
        fn Sum(&self, values: [i32]) -> i32;
        fn Values(&self) -> [i32];
        fn GetValues(&self, values: &mut [i32]);
        fn CountTrue(&self, values: [bool]) -> u32;
        fn Booleans(&self) -> [bool];
        fn GetBooleans(&self, values: &mut [bool]);
        fn SumModes(&self, values: [Mode]) -> i32;
        fn Modes(&self) -> [Mode];
        fn GetModes(&self, values: &mut [Mode]);
        fn InspectState(&self, value: State) -> bool;
        fn CurrentState(&self) -> State;
        fn CountStringUnits(&self, values: [String]) -> u32;
        fn Strings(&self) -> [String];
        fn GetStrings(&self, values: &mut [String]);
        fn CountPeers(&self, values: [IArrayPeer]) -> u32;
        fn Peers(&self) -> [IArrayPeer];
        fn GetPeers(&self, values: &mut [IArrayPeer]);
        fn CountInspectables(&self, values: [Object]) -> u32;
        fn Inspectables(&self) -> [Object];
        fn GetInspectables(&self, values: &mut [Object]);
    }

    interface IArrayPeer {
        Id: i32;
    }
}
