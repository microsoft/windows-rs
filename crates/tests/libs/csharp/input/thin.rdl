//! --filter Thin
use Windows::Foundation::Metadata::*;

#[winrt]
mod Thin {
    #[Activatable(1)]
    #[MarshalingBehavior(Agile)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        Int32Property: i32;
        StringProperty: String;
        fn Add(&self, a: i32, b: i32) -> i32;
    }
}
