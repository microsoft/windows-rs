//! --filter Activation
use Windows::Foundation::Metadata::*;

#[winrt]
mod Activation {
    // A framework "start" callback, mirroring `Application.Start`'s initialization callback: it is
    // passed to a static method and invoked by the runtime.
    delegate fn StartCallback();

    // Default activation (`#[Activatable(1)]`) plus a typed creation factory
    // (`#[Activatable(IWidgetFactory, 1)]`) plus a static interface (`#[Static(IWidgetStatics, 1)]`).
    #[Activatable(1)]
    #[Activatable(IWidgetFactory, 1)]
    #[Static(IWidgetStatics, 1)]
    #[MarshalingBehavior(Agile)]
    class Widget {
        IWidget,
    }

    #[ExclusiveTo(Widget)]
    interface IWidget {
        Label: String;
        fn Poke(&self, delta: i32) -> i32;
    }

    #[ExclusiveTo(Widget)]
    interface IWidgetFactory {
        fn CreateWidget(&self, seed: i32) -> Widget;
        fn CreateConfigured(&self, options: Options) -> Widget;
    }

    #[ExclusiveTo(Widget)]
    interface IWidgetStatics {
        Count: i32;
        fn Start(&self, callback: StartCallback);
        fn Normalize(&self, options: Options) -> Options;
    }

    struct Options {
        Label: String,
    }

    // A composable factory (`#[Composable(IControlFactory, Public, 1)]`): the creation method's
    // trailing `outer`/`inner` aggregation parameters are dropped from the public constructor.
    #[Composable(IControlFactory, Public, 1)]
    #[MarshalingBehavior(Agile)]
    class Control {
        IControl,
    }

    #[ExclusiveTo(Control)]
    interface IControl {
        Tag: i32;
    }

    #[ExclusiveTo(Control)]
    interface IControlFactory {
        fn CreateInstance(&self, outer: Object, inner: &mut Object) -> Control;
    }

    // Some system runtime classes carry a public composable attribute with an empty factory
    // interface because instances are supplied by another API rather than a public constructor.
    #[Composable(IHostedFactory, Public, 1)]
    #[MarshalingBehavior(Agile)]
    class Hosted {
        IHosted,
    }

    #[ExclusiveTo(Hosted)]
    interface IHosted {
        Value: i32;
    }

    #[ExclusiveTo(Hosted)]
    interface IHostedFactory {}
}
