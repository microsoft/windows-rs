//! --filter Sample
use Windows::Foundation::Metadata::*;

#[winrt]
mod Sample {
    delegate fn ChangedHandler(value: i32);

    #[Activatable(1)]
    class Source {
        ISource,
    }

    #[ExclusiveTo(Source)]
    interface ISource {
        fn Signal(&self, value: i32);
        event Changed: ChangedHandler;
    }
}
