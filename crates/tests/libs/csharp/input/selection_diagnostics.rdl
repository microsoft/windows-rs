//! --filter SelectionDiagnostics
use Windows::Foundation::Metadata::*;

#[winrt]
mod SelectionDiagnostics {
    delegate fn SupportedCallback(value: i32) -> i32;
    delegate fn BooleanCallback(value: bool);
    delegate fn ArrayCallback(values: [i32]);
    delegate fn ConvertedStructCallback(value: TextValue);

    #[repr(i32)]
    enum Mode {
        Off = 0,
        On = 1,
    }

    struct Point {
        X: i32,
        Y: i32,
    }

    struct TextValue {
        Text: String,
    }

    union ConvertedUnion {
        Text: String,
        Value: i32,
    }

    class Diagnostics {
        IDiagnostics,
        IDiagnosticsExtra,
    }

    #[ExclusiveTo(Diagnostics)]
    interface IDiagnostics {
        fn Good(&self, callback: SupportedCallback, point: Point, mode: Mode) -> i32;
        fn UseBoolean(&self, callback: BooleanCallback);
        fn UseArray(&self, callback: ArrayCallback);
        fn UseConvertedStruct(&self, callback: ConvertedStructCallback);
        fn GoodVector(&self) -> Windows::Foundation::Collections::IVector<i32>;
        fn VectorArray(
            &self,
            values: [Windows::Foundation::Collections::IVector<i32>],
        ) -> u32;
        fn UnsupportedGeneric(&self) -> Windows::Foundation::Collections::IVector<bool>;
    }

    #[ExclusiveTo(Diagnostics)]
    interface IDiagnosticsExtra {
        fn ForwardedBoolean(&self, callback: BooleanCallback);
    }

    #[Activatable(IConstructedFactory, 1)]
    class Constructed {
        IConstructed,
    }

    #[ExclusiveTo(Constructed)]
    interface IConstructed {
        Value: i32;
    }

    #[ExclusiveTo(Constructed)]
    interface IConstructedFactory {
        fn Create(&self, callback: BooleanCallback) -> Constructed;
    }

    #[Static(IStaticDiagnostics, 1)]
    class StaticDiagnostics {
        IStaticDiagnosticsInstance,
    }

    #[ExclusiveTo(StaticDiagnostics)]
    interface IStaticDiagnosticsInstance {
        Value: i32;
    }

    #[ExclusiveTo(StaticDiagnostics)]
    interface IStaticDiagnostics {
        fn BadStatic(&self, callback: BooleanCallback);
    }
}
