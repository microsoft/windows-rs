//! --filter DelegateMarshalling
use Windows::Foundation::Metadata::*;

#[winrt]
mod DelegateMarshalling {
    delegate fn ScalarCallback(value: i32) -> i32;
    delegate fn StringCallback(value: String) -> String;
    delegate fn ObjectCallback(value: IDelegatePeer) -> IDelegatePeer;
    delegate fn UnsupportedCallback(values: [i32]);

    interface IDelegatePeer {
        Id: i32;
    }

    interface IDelegateHost {
        fn UseString(&self, callback: StringCallback);
        fn UseObject(&self, callback: ObjectCallback);
        fn UseUnsupported(&self, callback: UnsupportedCallback);
    }
}
