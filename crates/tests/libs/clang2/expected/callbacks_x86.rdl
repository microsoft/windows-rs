#[win32]
mod Test {
    extern "system" fn Callback(#[annotation("sal", "_In_")] #[in] value: *mut i32, #[annotation("sal", "_In_reads_($2)")] #[in] #[len_param(2)] data: *const i8, count: u32) -> i32;
    type CallbackAlias = Callback;
    type CallbackSlot = *mut Callback;
    struct Callbacks {
        callback: Callback,
        alias: Callback,
        slot: *mut Callback,
        factory: Factory,
        function: Function,
    }
    extern "system" fn Factory(callback: Callback) -> i32;
    extern "C" fn Function(#[annotation("sal", "_In_")] #[in] value: *mut i32) -> i32;
    extern "C" fn FunctionPointer(#[annotation("sal", "_In_")] #[in] value: *mut i32) -> i32;
    #[library("test.dll", import = "_Use@16")]
    extern "system" fn Use(#[annotation("sal", "_In_opt_")] #[in] #[opt] callback: Callback, slot: *mut Callback, function: Function, pointer: FunctionPointer) -> i32;
}
