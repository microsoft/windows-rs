#[win32]
mod Test {
    const ProfileValue: i32 = 23;
    struct Shared {
        value: i32,
    }
    struct Stable {
        value: i32,
    }
    #[library("test.dll", import = "UseSecondary")]
    extern "C" fn UseSecondary(value: *mut Shared);
    #[library("test.dll", import = "UseStable")]
    extern "C" fn UseStable(value: *mut Stable);
}
