#[win32]
mod Test {
    #[guid(0x12345678_1234_1234_1234_123456789abc)]
    interface IHandles {
        fn Set(&self, value: External::Handle, text: External::PCWSTR);
        fn Get(&self) -> External::Handle;
    }
    struct PointerRecord {
        handle: External::Handle,
        text: External::PCWSTR,
    }
    #[library("test.dll", import = "Use")]
    extern "C" fn Use(record: *mut PointerRecord, output: *mut External::Handle, text: *mut External::PCWSTR, input: *const External::PCWSTR) -> External::Handle;
}
