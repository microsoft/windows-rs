#[win32]
mod Test {
    #[library("test.dll", import = "Bytes")]
    extern "C" fn Bytes(#[annotation("sal", "_Out_writes_bytes_($1)")] #[out] #[size_param(1)] value: External::PWSTR, count: u32);
    #[library("test.dll", import = "Read")]
    extern "C" fn Read(#[annotation("sal", "_In_reads_($1)")] #[in] #[len_param(1)] value: External::PCWSTR, count: u32);
    #[library("test.dll", import = "Update")]
    extern "C" fn Update(#[annotation("sal", "_Inout_updates_($1)")] #[in] #[out] #[len_param(1)] value: External::PWSTR, count: u32);
}
