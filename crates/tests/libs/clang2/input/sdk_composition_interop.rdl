#[win32]
mod Windows {
    mod Win32 {
        #[guid(0xfd04e6e3_fe0c_4c3c_ab19_a07601a576ee)]
        interface ICompositionDrawingSurfaceInterop: IUnknown {
            fn BeginDraw(&self, #[opt] updateRect: *const RECT, iid: &IID, #[out_ptr(null_on_failure)] #[iid_is] updateObject: *mut *mut void, updateOffset: *mut POINT) -> HRESULT;
