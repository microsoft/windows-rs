#[win32]
mod Fixture {
    extern "C" fn CALLBACK(input: LPSTR, #[out] output: LPWSTR);
    type LPSTR = *mut i8;
    type LPWSTR = *mut u16;
    type PCSTR = *const i8;
    type PCWSTR = *const u16;
    type PSTR = *mut i8;
    type PWSTR = *mut u16;
    #[library("fixture.dll")]
    extern "C" fn Strings(legacy_input: LPSTR, #[out] legacy_output: LPSTR, explicit_input: PSTR, wide_input: LPWSTR, #[out] wide_output: PWSTR);
}
