mod Windows {
    mod Win32 {
        #[win32]
        mod Foundation {
            struct GUID { data1: u32, data2: u16, data3: u16, data4: [u8; 8], }
            type HRESULT = i32;
            type BOOL = i32;
        }
        mod System {
            #[win32]
            mod Com {
                #[guid(0x00000000_0000_0000_c000_000000000046)]
                interface IUnknown {
                    fn QueryInterface(&self, riid: *const super::super::Foundation::GUID, #[out] #[iid_is] object: *mut *mut void) -> super::super::Foundation::HRESULT;
                    fn AddRef(&self) -> u32;
                    fn Release(&self) -> u32;
                }
            }
        }
    }
}
